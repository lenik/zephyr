msgstr "Lägg till tests/smoke.sh och meson test() för stdin/stdout-kopia."

#: src/zfr_lib/lang/bash.py:65
#, python-format
msgid "src scripts: %s"
msgstr "src-skript: %s"

#: src/zfr_lib/lang/bash.py:78
msgid "root scripts: %s"
msgstr "src-skript: %s"

#: src/zfr_lib/lang/bash.py:89
#, python-format
