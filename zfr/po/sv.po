msgstr "setup -only paket (%s); inga bindir skriptbuffs"

#: src/zfr_lib/lang/bash.py:105
msgid "Meson executable + .c present; script .in not required"
msgstr "Meson exekvent + .c presente; skript .in inte behövs"

#: src/zfr_lib/lang/bash.py:114
msgid "no configure_file/executable; script .in not required"
msgstr "ingen configure_file/executable; skript .in inte behövs"

#: src/zfr_lib/lang/bash.py:121
msgid "no src/*.in or root *.in scripts"
msgstr "inga src/*.in-skript"

#: src/zfr_lib/lang/bash.py:124
msgid "Keep configured scripts as src/<puff>.in (preferred) or <puff>.in with @PACKAGE@/@VERSION@ and meson configure_file + install_mode rwxr-xr-x."
msgstr "Behåll konfigurerade skript som src/<puff>.in med @PACKAGE@/@VERSION@ och meson configure_file + install_mode rwxr-xr-x."

#: src/zfr_lib/lang/bison.py:45
msgid "Add tests/ with fixture checks for parser dump/format output."
msgstr "Lägg till tests/ med fixture-kontroller för parserns dump/format-utdata."

#: src/zfr_lib/lang/_c_bas.py:187
msgid "no int main() in src/; skip bas i18n main checks"
msgstr "Ingen int main() i src/; hoppa bas i18n huvudkontroller"

#: src/zfr_lib/lang/_c_bas.py:208
#, python-format
msgid "main missing bas i18n setup: %s"
msgstr "huvudsaklig bas i18n setup: %s"

#: src/zfr_lib/lang/_c_bas.py:211
msgid "In main: #include <bas/locale/i18n.h> and <bas/proc/env.h>; const char *exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR from meson config.h). Run `zfr ize`."
msgstr "I huvudsak: #include <bas/locale/i18n.h> och <bas/proc/env.h>; konst tecken *exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR från meson konfiguration.h). Kör `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:222
msgid "bas i18n main setup (self_exe + init_i18n)"
msgstr "bas i18n huvudsett (self_exe + init_i18n)"

#: src/zfr_lib/lang/_c_bas.py:233
msgid "no define_logger() in src/"
msgstr "ingen define_logger() i src/"

#: src/zfr_lib/lang/_c_bas.py:236
msgid "In one .c/.cpp: #include <bas/log/deflog.h> then define_logger(); libraries may use __attribute__((weak)) define_logger(); Run `zfr ize`."
msgstr "I en .c/.cpp: #include <bas/log/deflog.h> sedan define_logger(); bibliotek kan använda _attibute_(feak) define_logger(); Kör `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:250
msgid "define_logger() present"
msgstr "project() finns"

#: src/zfr_lib/lang/_c_bas.py:252
msgid "weak define_logger() present (library)"
msgstr "weak define_logger() finns (bibliotek)"

#: src/zfr_lib/lang/_c_bas.py:258
msgid "define_logger() without #include <bas/log/deflog.h>"
msgstr "define_logger() utan #include <bas/log/deflog.h>"

#: src/zfr_lib/lang/_c_bas.py:260
msgid "Add #include <bas/log/deflog.h> before define_logger();"
msgstr "Lägg till #include <bas/log/deflog.h> innan define_logger();"

#: src/zfr_lib/lang/_c_bas.py:276
msgid "meson.build missing LOCALEDIR in config.h"
msgstr "meson.build saknas LOCALEDIR i konfiguration.h"

#: src/zfr_lib/lang/_c_bas.py:279
msgid "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Run `zfr ize`."
msgstr "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Kör `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:289
msgid "meson LOCALEDIR present"
msgstr "meson LOCALEDIR finns"

#: src/zfr_lib/lang/_c_bas.py:306
#, python-format
msgid "gettext string has leading/trailing spaces: %r"
msgstr "gettext string har leading/trailing utrymme: %r"

#: src/zfr_lib/lang/_c_bas.py:310
msgid "Keep padding outside _(): e.g. fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\n\"), out);"
msgstr ""
"Håll uppfyllning utanför _(): t.ex. fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\\n"
"\"), out);"

#: src/zfr_lib/lang/_c_bas.py:320
msgid "gettext _() strings have no leading/trailing spaces"
msgstr "gettext _()-strengrar har inga leading/trailing-rom"

#: src/zfr_lib/lang/clib.py:45 src/zfr_lib/lang/cpplib.py:45
#: src/zfr_lib/lang/cpp.py:32 src/zfr_lib/lang/c.py:32
#: src/zfr_lib/lang/gcc.py:55
msgid "Add tests/ and meson test() entries like the C family templates."
msgstr "Lägg till tests/ och meson test()-poster som i C-familjens mallar."

#: src/zfr_lib/lang/cobol.py:37
msgid "no tests/ (cobol template uses cobc + meson test)"
msgstr "ingen tests/ (cobol-mallen använder cobc + meson test)"

#: src/zfr_lib/lang/cobol.py:39
msgid "Add tests/test_commons.sh or similar smoke test for cobc."
msgstr "Lägg till tests/test_commons.sh eller liknande röktest för cobc."

#: src/zfr_lib/lang/d.py:37
msgid "no tests/ (D template uses ldc/dmd + meson test)"
msgstr "ingen tests/ (D-mallen använder ldc/dmd + meson test)"

#: src/zfr_lib/lang/d.py:39
msgid "Add tests/test_commons.d and meson test() executable."
msgstr "Lägg till tests/test_commons.d och körbar meson test()."

#: src/zfr_lib/lang/fortran.py:37
msgid "no tests/ (fortran template uses gfortran + meson test)"
msgstr "ingen tests/ (fortran-mallen använder gfortran + meson test)"

#: src/zfr_lib/lang/fortran.py:39
msgid "Add tests/test_commons.f90 and meson test() executable."
msgstr "Lägg till tests/test_commons.f90 och körbar meson test()."

#: src/zfr_lib/lang/go.py:22
msgid "missing go.mod"
msgstr "go.mod saknas"

#: src/zfr_lib/lang/go.py:23
msgid "Add go.mod; meson should `go build` with -X main.buildVersion from meson.project_version()."
msgstr "Lägg till go.mod; meson ska köra `go build` med -X main.buildVersion från meson.project_version()."

#: src/zfr_lib/lang/kotlin.py:23
msgid "no tests/ (kotlin template uses kotlinc + meson test)"
msgstr "ingen tests/ (kotlin-mallen använder kotlinc + meson test)"

#: src/zfr_lib/lang/kotlin.py:24
msgid "Add tests/Test*.kt and meson test() compiling with kotlinc."
msgstr "Lägg till tests/Test*.kt och meson test() som kompileras med kotlinc."

#: src/zfr_lib/lang/lua.py:23
msgid "no tests/ (lua template uses lua tests + meson test)"
msgstr "ingen tests/ (lua-mallen använder lua-tester + meson test)"

#: src/zfr_lib/lang/lua.py:24
msgid "Add tests/test_*.lua and meson test() invoking lua with LUA_PATH=src/?.lua."
msgstr "Lägg till tests/test_*.lua och meson test() som kör lua med LUA_PATH=src/?.lua."

#: src/zfr_lib/lang/nim.py:25
msgid "no tests/ (nim template uses unittest + meson test)"
msgstr "ingen tests/ (nim-mallen använder unittest + meson test)"

