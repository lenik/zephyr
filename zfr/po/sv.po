msgid "%files covers gettext .mo catalogs Meson installs"
msgstr "%files täcker gettext .mo kataloger Meson installerar"

#: src/zfr_lib/lint/rpm.py:394
#, python-format
msgid "%files omits gettext .mo; rpmbuild will reject unpackaged locale/*/LC_MESSAGES/*.mo after meson install"
msgstr "%files utgår gettext .mo; rpmbuild kommer att avvisa också utpakkade locale/*/LC_MESSAGES/*.mo efter meson installation"

#: src/zfr_lib/lint/rpm.py:401
#, python-brace-format
msgid "%{_datadir}/locale/*/LC_MESSAGES/<domain>.mo  (i18n.gettext domain, not always the project name). Or run `zfr ize`."
msgstr "%{_datadir}/locale/*/LC_MESSAGES/<domain>.mo (i18n.gettext domän, inte alltid projektnamnet). Eller kör `zfr ize`."

#: src/zfr_lib/lint/rpm.py:417
#, no-python-format
msgid "%files covers locale man pages Meson installs"
msgstr "%files täcker lokal mansidor Meson installerar"

#: src/zfr_lib/lint/rpm.py:428
#, python-format
msgid "%files omits locale mans; rpmbuild will reject unpackaged $mandir/<locale>/manN pages after meson install"
msgstr "%files utgör lokala mans; rpmbuild kommer att avvisa depackade $mandir/<locale>/manN sidor efter meson installation"

#: src/zfr_lib/lint/rpm.py:435
#, python-brace-format
msgid "%{_mandir}/*/man1/<cmd>.1*  (docs/<lang>/*.adoc). Or run `zfr ize`."
msgstr "%{_mandir}/*/man1/<cmd>.1* (docs/<lang>/*.adoc). Eller kör `zfr ize`."

#: src/zfr_lib/lint/rpm.py:457
#, no-python-format
msgid "%files covers datadir/setup scripts Meson installs"
msgstr "%files täcker datadir/setup skript Meson installerar"

#: src/zfr_lib/lint/rpm.py:468
#, python-format
msgid "%files omits datadir/setup/*; rpmbuild will reject unpackaged postinst/prerm after meson install"
msgstr "%files utgår datadir/setup/*; rpmbuild kommer att avvisa opacked postinst/prerm efter meson installation"

#: src/zfr_lib/lint/rpm.py:474
#, no-python-format, python-brace-format
msgid "%{_datadir}/setup/%{name}/  (or run `zfr ize`)."
msgstr "%{_datadir}/setup/%{name}/ (eller kör `zfr ize`)."

#: src/zfr_lib/lint/rpm.py:509
#, python-format, python-brace-format
msgid "%files is missing paths Meson installs: {preview}{more} (rpmbuild will fail with unpackaged or File not found)"
msgstr "%files saknas vägar Meson installerar: {preview}{more} (rpmbuild kommer att misslycka med utpakkade eller fil som inte finns)"

#: src/zfr_lib/lint/rpm.py:516
#, python-format
msgid "Rewrite %files from Meson install rules (bindir, completions, manN, pkgdata, perl5, includedir, sysconfdir, shlib.d, setup/). Or run `zfr ize`."
msgstr "Reskriv %files från Meson installera regler (bindir, fullständiga, manN, pkgdata, perl5, includedir, sysconfdir, shlib.d, setup/). Eller kör `zfr ize`."

#: src/zfr_lib/lint/rpm.py:530
#, python-format
msgid "%files covers Meson install set ({} entries)"
msgstr "%files täcker Meson installeringssett ({} införningar)"

#: src/zfr_lib/lint/rpm.py:548
#, python-brace-format
msgid "%files lists %{_datadir}/%{name}/ but Meson does not install package data there (Directory not found)"
msgstr "%files förtecknar %{_datadir}/%{name}/ men Meson inte installerar paketdata där (direktor inte hittat)"

#: src/zfr_lib/lint/rpm.py:554
msgid "Remove the empty pkgdata line (Java template leftover). Or run `zfr ize`."
msgstr "Ta bort den tomma pkgdata-linje (Java-malen över). Eller kör `zfr ize`."

#: src/zfr_lib/lint/rpm.py:580
#, python-format
msgid "%files lists completion {listed!r} but Meson installs {want!r} (File not found)"
msgstr "%files Lista avslutning {listed!r} men Meson installerar {want!r} (Fil inte hittade)"

#: src/zfr_lib/lint/rpm.py:586
msgid "Use the installed basename ({}). Or run `zfr ize`."
msgstr "Använd det installerade basnamnet ({}). Eller kör `zfr ize`."

#: src/zfr_lib/lint/source_size.py:46
#, python-format
msgid "Extract cohesive sections into package subdirectory %(subdir)s (e.g. %(example)s) and keep a thin %(rel)s entry point."
msgstr "Uttryck kohesiva sektioner i paketsubdirector %(subdir)s (t.ex. %(example)s) och hålla ett tynkt %(rel)s-indragpunkt."

#: src/zfr_lib/lint/source_size.py:66
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); file is very long"
msgstr "%(rel)s är %(lines)d rader (>%(limit)d); filen är mycket lång"

#: src/zfr_lib/lint/source_size.py:78
msgid "%(rel)s is %(lines)d lines (>%(limit)d); consider splitting soon"
msgstr "%(rel)s är %(lines)d rader (>%(limit)d); överväg att modularisera snart"

#: src/zfr_lib/lint/source_size.py:86
msgid "no oversized source files"
msgstr "inga överstora källfiler"

