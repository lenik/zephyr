#, python-brace-format
msgid ""
"TOPDIR ?= $(shell rpm --eval '%{_topdir}' 2>/dev/null)\n"
"ifeq ($(strip $(TOPDIR)),)\n"
"TOPDIR := $(HOME)/rpmbuild\n"
"endif\n"
"And make clean remove only this package's artifacts (not rm -rf $(TOPDIR)). Or run `zfr ize`."
msgstr "TOPDIR$(shell rpm --eval '%{_topdir}' 2>/dev/null)이 ($(strip $(TOPDIR)) )TOPDIR* =$(HOME)/ 는rpmbuild그리고 깨끗하게 제거하십시오 이 패키지의 유물만 제거 (Rm 아닌)-rf $(TOPDIR)또는 달리기`zfr ize`는"

