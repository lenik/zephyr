msgstr "언어를 감지하고 pkgdatadir/<lang>에서 puff 추가."

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "새 puff 이름(snake_case 권장)"

#: src/build.py:15
