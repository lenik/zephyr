msgstr "pkgdatadir/<lang>에서 새 프로젝트 디렉터리 생성."

#: src/create.py:295
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "템플릿 언어(기본값: python; 다음 중 하나: %s)"

