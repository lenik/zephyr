#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "cetak informasi proyek saat ini (menelusuri induk dari cwd)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Cetak informasi tentang proyek zephyr saat ini (menelusuri dari cwd ke direktori induk). Warna CSR saat stdout adalah TTY. Bidang pengemasan umum diurai dari debian atau RPM."

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "tampilkan bidang pengemasan Debian yang diurai"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "tampilkan bidang pengemasan RPM yang diurai"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "penyorotan CSR (console SGR) (default: auto = TTY dan tanpa NO_COLOR)"

