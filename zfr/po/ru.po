msgid "Long files fight ownership"
msgstr "Длинные файлы мешают владению"

#: src/zfr_lib/lint/docs.py:27
msgid "Very long source files are hard to review, test, and own. Zephyr prefers cohesive modules under a package subdirectory with a thin entry-point file — the same shape create/ize expect."
msgstr "Очень длинные исходники трудно ревьюить, тестировать и «владеть». Zephyr предпочитает связные модули в подкаталоге пакета и тонкий файл точки входа — ту же форму, что ожидают create/ize."

#: src/zfr_lib/lint/docs.py:33
msgid "What improving it buys you"
msgstr "Что даёт улучшение"

#: src/zfr_lib/lint/docs.py:35
msgid "Smaller review diffs, clearer module boundaries, easier unit tests, and fewer merge conflicts on busy files."
msgstr "Меньше диффов на ревью, чётче границы модулей, проще юнит-тесты и меньше конфликтов слияния в часто меняемых файлах."

#: src/zfr_lib/lint/docs.py:40
msgid "Thresholds"
msgstr "Пороги"

#: src/zfr_lib/lint/docs.py:42
msgid "Lint counts non-empty lines (skipping build/debian/po/…). A note appears around ~600 lines; a warning around ~1000. Template example modules are skipped."
msgstr "Lint считает непустые строки (пропуская build/debian/po/…). Замечание появляется около ~600 строк; предупреждение — около ~1000. Примерные модули шаблонов пропускаются."

#: src/zfr_lib/lint/docs.py:48
msgid "Fixing is manual"
msgstr "Исправление вручную"

#: src/zfr_lib/lint/docs.py:50
msgid "Split the file and update meson/install/import lists yourself. `zfr ize` does not auto-split sources."
msgstr "Разделите файл и сами обновите списки meson/install/import. `zfr ize` не разбивает исходники автоматически."

#: src/zfr_lib/lint/docs.py:57
msgid "Hardcoded /usr breaks prefixes"
msgstr "Жёстко прописанный /usr ломает префиксы"

#: src/zfr_lib/lint/docs.py:59
msgid "Absolute FHS paths (/usr/share, /usr/bin, …) fail under DESTDIR, non-standard prefixes, and Meson configure_file staging."
msgstr "Абсолютные пути FHS (/usr/share, /usr/bin, …) ломаются при DESTDIR, нестандартных префиксах и staging через Meson configure_file."

#: src/zfr_lib/lint/docs.py:64
msgid "Preferred shape"
msgstr "Предпочтительная форма"

#: src/zfr_lib/lint/docs.py:66
msgid "Scripts use @PREFIX@ / @DATADIR@ / @LOCALEDIR@ (or equivalent) and are installed from *.in via Meson."
msgstr "Скрипты используют @PREFIX@ / @DATADIR@ / @LOCALEDIR@ (или эквивалент) и устанавливаются из *.in через Meson."

#: src/zfr_lib/lint/docs.py:71
msgid "What Solve does"
msgstr "Что делает Solve"

#: src/zfr_lib/lint/docs.py:73
msgid "Ize renames affected scripts to *.in and wires configure_file. Re-check shebangs and any tests that assumed live paths."
msgstr "Ize переименовывает затронутые скрипты в *.in и подключает configure_file. Перепроверьте shebang и тесты, которые предполагали «живые» пути."

#: src/zfr_lib/lint/docs.py:80
msgid "Version literals drift"
msgstr "Литералы версии расходятся"

#: src/zfr_lib/lint/docs.py:82
msgid "A hardcoded release string diverges from debian/changelog and Meson project_version() the moment you bump."
msgstr "Жёстко прописанная строка релиза расходится с debian/changelog и Meson project_version() в момент повышения версии."

#: src/zfr_lib/lint/docs.py:87
msgid "Single source of truth"
msgstr "Единый источник истины"

#: src/zfr_lib/lint/docs.py:89
msgid "Prefer @VERSION@ / PROJECT_VERSION substituted at build time so `--version`, wrappers, and packages stay aligned."
msgstr "Предпочитайте @VERSION@ / PROJECT_VERSION, подставляемые при сборке, чтобы `--version`, обёртки и пакеты оставались согласованными."

#: src/zfr_lib/lint/docs.py:94
msgid "Risks when converting"
msgstr "Риски при преобразовании"

#: src/zfr_lib/lint/docs.py:96
msgid "C/C++ usually needs config.h; scripts need *.in. Dry-run ize (`-n`) on large trees before writing."
msgstr "C/C++ обычно нужен config.h; скриптам — *.in. Перед записью прогоните dry-run ize (`-n`) на больших деревьях."

#: src/zfr_lib/lint/docs.py:103
msgid "Substitution without a consumer is incomplete"
msgstr "Подстановка без потребителя неполна"

#: src/zfr_lib/lint/docs.py:105
msgid "Meson must both define VERSION/PROJECT_VERSION and have sources that actually read it — otherwise packaged binaries still lie."
msgstr "Meson должен и определить VERSION/PROJECT_VERSION, и иметь исходники, которые его реально читают — иначе упакованные бинарники по-прежнему врут."

#: src/zfr_lib/lint/docs.py:110
msgid "How it is checked"
msgstr "Как проверяется"

#: src/zfr_lib/lint/docs.py:112
msgid "Looks for configuration_data keys and for @VERSION@ / PROJECT_VERSION usage in installed sources."
msgstr "Ищет ключи configuration_data и использование @VERSION@ / PROJECT_VERSION в устанавливаемых исходниках."

#: src/zfr_lib/lint/docs.py:117
msgid "Closing the loop"
msgstr "Замыкание цикла"

#: src/zfr_lib/lint/docs.py:119
msgid "Add the missing half (subst or consumer). Solve maps to the subst ize steps when available."
msgstr "Добавьте недостающую половину (подстановку или потребителя). Solve сопоставляется шагам subst ize, когда они доступны."

#: src/zfr_lib/lint/docs.py:126
msgid "Inline posync is unmaintainable"
msgstr "Встроенный posync неподдерживаем"

#: src/zfr_lib/lint/docs.py:128
msgid "A bash -euc heredoc inside meson.build duplicates across templates and is painful to debug. The contract is scripts/posync.sh + run_target('posync')."
msgstr "Heredoc bash -euc внутри meson.build дублируется по шаблонам и мучителен в отладке. Контракт — scripts/posync.sh + run_target('posync')."

#: src/zfr_lib/lint/docs.py:134
msgid "Payoff"
msgstr "Выгода"

#: src/zfr_lib/lint/docs.py:136
msgid "One script to run msgmerge/xgettext locally; ninja posync stays short; CI can call the script directly."
msgstr "Один скрипт для локального msgmerge/xgettext; ninja posync остаётся коротким; CI может вызывать скрипт напрямую."

#: src/zfr_lib/lint/docs.py:143
msgid "Ize extracts the body to scripts/posync.sh and points the run_target at it. Verify POTFILES and language flags afterward."
msgstr "Ize извлекает тело в scripts/posync.sh и направляет на него run_target. Затем проверьте POTFILES и флаги языков."

#: src/zfr_lib/lint/docs.py:150
msgid "Maintenance scripts belong under scripts/"
msgstr "Скрипты обслуживания живут в scripts/"

#: src/zfr_lib/lint/docs.py:152
msgid "look / install-symlinks / deploy helpers at the repo root clutter the packaging surface. Zephyr keeps them under scripts/."
msgstr "Хелперы look / install-symlinks / deploy в корне репозитория засоряют поверхность упаковки. Zephyr держит их в scripts/."

#: src/zfr_lib/lint/docs.py:157
msgid "Detection"
msgstr "Обнаружение"

#: src/zfr_lib/lint/docs.py:159
msgid "Flags root *.sh maintenance names and inline run_target bodies that should be externalized."
msgstr "Отмечает корневые имена обслуживающих *.sh и тела inline run_target, которые стоит вынести вовне."

#: src/zfr_lib/lint/docs.py:164
msgid "After moving"
msgstr "После переноса"

#: src/zfr_lib/lint/docs.py:166
msgid "Update docs and any CI that called the old paths. Solve rewrites Meson run_targets to scripts/…"
msgstr "Обновите документацию и CI, которые вызывали старые пути. Solve переписывает Meson run_targets на scripts/…"

#: src/zfr_lib/lint/docs.py:180
msgid "No Solve mapping"
msgstr "Нет сопоставления Solve"

#: src/zfr_lib/lint/docs.py:182
msgid "This finding has no `zfr ize --only …` shortcut. Follow the fix text (or a broader `zfr ize` if several related gaps exist), then re-lint."
msgstr "У этого замечания нет ярлыка `zfr ize --only …`. Следуйте тексту исправления (или более широкому `zfr ize`, если пробелов несколько), затем снова прогоните lint."

#: src/zfr_lib/lint/docs.py:190
msgid "Solve / ize"
msgstr "Solve и ize"

#: src/zfr_lib/lint/docs.py:192
#, python-format
msgid ""
"Clicking Solve runs only: %(targets)s.\n"
"Equivalent CLI: `%(cmd)s`\n"
"Use `-n` for a dry plan. Output is captured with fdmux (ordered stdout/stderr)."
msgstr ""
"Нажатие Solve запускает только: %(targets)s.\n"
"Эквивалентная CLI: `%(cmd)s`\n"
"Для сухого плана используйте `-n`. Вывод перехватывается через fdmux (упорядоченные stdout/stderr)."

#: src/zfr_lib/lint/docs.py:206 src/zfr_lib/lint/docs.py:407
msgid "varies"
msgstr "зависит"

#: src/zfr_lib/lint/docs.py:209
#, python-format
msgid "Checker `%s` in `zfr lint`."
msgstr "Проверка `%s` в `zfr lint`."

#: src/zfr_lib/lint/docs.py:212
msgid "Debian is the APT contract"
msgstr "Debian — контракт APT"

#: src/zfr_lib/lint/docs.py:214
msgid "control / rules / copyright / source format decide how the package builds and what users install. Zephyr standardizes on Meson + dh `--buildsystem=meson --builddirectory=debian/build`."
msgstr "control / rules / copyright / source format определяют, как пакет собирается и что ставят пользователи. Zephyr стандартизует Meson + dh `--buildsystem=meson --builddirectory=debian/build`."

#: src/zfr_lib/lint/docs.py:220 src/zfr_lib/lint/docs.py:251
#: src/zfr_lib/lint/docs.py:273 src/zfr_lib/lint/docs.py:296
#, python-format
msgid "This check: %s"
msgstr "Эта проверка: %s"

#: src/zfr_lib/lint/docs.py:221
#, python-format
msgid "Default severity hint: %s."
msgstr "Подсказка серьёзности по умолчанию: %s."

#: src/zfr_lib/lint/docs.py:224
msgid "Why it matters"
msgstr "Почему это важно"

#: src/zfr_lib/lint/docs.py:226
msgid "Wrong Architecture, missing Build-Depends, or a non-Meson rules file fail debuild or produce unloadable packages even when local compiles succeed."
msgstr "Неверная Architecture, отсутствующие Build-Depends или rules не на Meson ломают debuild или дают непригодные к установке пакеты даже при успешной локальной сборке."

#: src/zfr_lib/lint/docs.py:232
msgid "When editing packaging"
msgstr "При правке упаковки"

#: src/zfr_lib/lint/docs.py:234
msgid "Ize may rewrite from templates — always diff Maintainer, Depends, and Architecture before upload."
msgstr "Ize может переписать из шаблонов — перед загрузкой всегда сверьте diff Maintainer, Depends и Architecture."

#: src/zfr_lib/lint/docs.py:240
#, python-format
msgid "Checker `%s`."
msgstr "Проверка `%s`."

#: src/zfr_lib/lint/docs.py:243
msgid "RPM must mirror Meson/Debian"
msgstr "RPM должен зеркалить Meson/Debian"

#: src/zfr_lib/lint/docs.py:245
#, python-format
msgid "spec %files, BuildArch, and Version have to describe the same payload Meson installs. Project-local rpmbuild TOPDIR and stale file lists are common failure modes."
msgstr "В spec %files, BuildArch и Version должны описывать тот же payload, что ставит Meson. Локальный rpmbuild TOPDIR проекта и устаревшие списки файлов — частые причины сбоев."

#: src/zfr_lib/lint/docs.py:252
#, python-format
msgid "Severity hint: %s."
msgstr "Подсказка серьёзности: %s."

#: src/zfr_lib/lint/docs.py:255
msgid "Typical fallout"
msgstr "Типичные последствия"

#: src/zfr_lib/lint/docs.py:257
msgid "Unpackaged files, wrong noarch/ELF, leftover rpmbuild/, or Debian substvars copied into Requires."
msgstr "Неупакованные файлы, неверный noarch/ELF, оставшийся rpmbuild/ или Debian substvars, скопированные в Requires."

#: src/zfr_lib/lint/docs.py:265
msgid "Meson is the build system of record"
msgstr "Meson — эталонная система сборки"

#: src/zfr_lib/lint/docs.py:267
msgid "Identity, license, version source, man pages, completion, and look/posync targets live in meson.build. Drift here breaks Debian and RPM alike."
msgstr "Идентичность, лицензия, источник версии, man-страницы, дополнение и цели look/posync живут в meson.build. Расхождения здесь ломают и Debian, и RPM."

#: src/zfr_lib/lint/docs.py:275
#, python-format
msgid "Parses meson.build for `%s` expectations."
msgstr "Разбирает meson.build на предмет ожиданий `%s`."

#: src/zfr_lib/lint/docs.py:278
msgid "Editing tips"
msgstr "Советы по правке"

#: src/zfr_lib/lint/docs.py:280
msgid "Ize patches meson.build; reconcile custom targets with template blocks and re-configure after large edits."
msgstr "Ize патчит meson.build; согласуйте свои цели с блоками шаблона и переконфигурируйте после крупных правок."

#: src/zfr_lib/lint/docs.py:288
msgid "Locales are a product surface"
msgstr "Локали — поверхность продукта"

#: src/zfr_lib/lint/docs.py:290
msgid "Gettext catalogs and whole-document man/<locale>/ pages gate what users see at the configured l10n level (`-l` / lint.options)."
msgstr "Каталоги Gettext и целые страницы man/<locale>/ определяют, что видят пользователи на настроенном уровне l10n (`-l` / lint.options)."

#: src/zfr_lib/lint/docs.py:299
msgid "Looks at LINGUAS, .po wrap/quality, and man coverage."
msgstr "Смотрит LINGUAS, перенос/качество .po и покрытие man."

#: src/zfr_lib/lint/docs.py:303
msgid "Human work remains"
msgstr "Ручная работа остаётся"

#: src/zfr_lib/lint/docs.py:305
msgid "Ize can stub .po files and fix wrap style; real translation and man localization still need people (or `zfr translate`)."
msgstr "Ize может создать заготовки .po и поправить стиль переноса; настоящий перевод и локализация man по-прежнему требуют людей (или `zfr translate`)."

#: src/zfr_lib/lint/docs.py:313
msgid "Shared layout keeps tools oriented"
msgstr "Общая раскладка ориентирует инструменты"

#: src/zfr_lib/lint/docs.py:315
msgid "LICENSE, man/, VERSION, hooks, completion, and scripts/ are the landmarks create/ize/lint/release expect."
msgstr "LICENSE, man/, VERSION, hooks, completion и scripts/ — ориентиры, которые ожидают create/ize/lint/release."

#: src/zfr_lib/lint/docs.py:320
#, python-format
msgid "Missing or wrong: %s"
msgstr "Отсутствует или неверно: %s"

#: src/zfr_lib/lint/docs.py:323
#, python-format
msgid "`%s` checks presence/content against the language template."
msgstr "`%s` проверяет наличие/содержимое по языковому шаблону."

#: src/zfr_lib/lint/docs.py:328
msgid "Scaffold refresh"
msgstr "Обновление каркаса"

#: src/zfr_lib/lint/docs.py:330
msgid "Solve may install or refresh files from the template (.githooks, LICENSE, cursor rules, …). Review before commit."
msgstr "Solve может установить или обновить файлы из шаблона (.githooks, LICENSE, cursor rules, …). Проверьте перед коммитом."

#: src/zfr_lib/lint/docs.py:338
msgid "Language-template expectations"
msgstr "Ожидания языкового шаблона"

#: src/zfr_lib/lint/docs.py:340
#, python-format
msgid "%(title)s. Each language keeps idiomatic markers (tests/, Cargo.toml, bas i18n helpers, bash *.in, …) so the tree stays packagable."
msgstr "%(title)s. Каждый язык хранит идиоматические маркеры (tests/, Cargo.toml, bas-хелперы i18n, bash *.in, …), чтобы дерево оставалось упаковываемым."

#: src/zfr_lib/lint/docs.py:347
msgid "Details"
msgstr "Подробности"

#: src/zfr_lib/lint/docs.py:350
#, python-format
msgid "Implemented as `%s`; severity hint %s."
msgstr "Реализовано как `%s`; подсказка серьёзности %s."

#: src/zfr_lib/lint/docs.py:358
msgid "One name across ecosystems"
msgstr "Одно имя во всех экосистемах"

#: src/zfr_lib/lint/docs.py:360
msgid "Directory name, meson project(), debian Source, and RPM Name must agree. Mismatches confuse rename, release, and repos."
msgstr "Имя каталога, meson project(), debian Source и RPM Name должны совпадать. Расхождения путают rename, release и репозитории."

#: src/zfr_lib/lint/docs.py:365
#, python-format
msgid "Check: %s"
msgstr "Проверка: %s"

#: src/zfr_lib/lint/docs.py:366
#, python-format
msgid "`%s` compares identity fields."
msgstr "`%s` сравнивает поля идентичности."

#: src/zfr_lib/lint/docs.py:372
msgid "Source hygiene"
msgstr "Гигиена исходников"

#: src/zfr_lib/lint/docs.py:374
#, python-format
msgid "%(title)s. Covers length and hardcoded paths/versions that break relocatable installs."
msgstr "%(title)s. Покрывает длину и жёстко прописанные пути/версии, ломающие переносимые установки."

#: src/zfr_lib/lint/docs.py:380
msgid "How lint looks"
msgstr "Как смотрит lint"

#: src/zfr_lib/lint/docs.py:383
msgid "Counts lines and/or scans for FHS paths and version tokens."
msgstr "Считает строки и/или сканирует пути FHS и токены версии."

#: src/zfr_lib/lint/docs.py:396
#, python-format
msgid "`%s` keeps templates instantiable and apps free of leftover placeholders / banners."
msgstr "`%s` сохраняет шаблоны инстанцируемыми и приложения свободными от оставшихся плейсхолдеров / баннеров."

#: src/zfr_lib/lint/docs.py:411
#, python-format
msgid "Implemented under `%s` in `zfr lint`. Findings carry a concrete fix string when possible. Remap severity with `-w` / `-e` / `--strict`."
msgstr "Реализовано под `%s` в `zfr lint`. Замечания по возможности несут конкретную строку исправления. Переназначьте серьёзность через `-w` / `-e` / `--strict`."

#: src/zfr_lib/lint/docs.py:421
#, python-format
msgid "Rule %(id)s (`%(code)s`) is part of the zephyr packaging/layout contract. Default severity hint: %(sev)s."
msgstr "Правило %(id)s (`%(code)s`) — часть контракта упаковки/раскладки zephyr. Подсказка серьёзности по умолчанию: %(sev)s."

#: src/zfr_lib/lint/docs.py:427
msgid "What lint does"
msgstr "Что делает lint"

#: src/zfr_lib/lint/docs.py:431
msgid "Changing the tree"
msgstr "Изменение дерева"

#: src/zfr_lib/lint/docs.py:433
#, python-format
msgid "Fixes may touch packaging, meson.build, sources, or scaffold copies. Diff Maintainer, Depends, %files, and *.in scripts before upload."
msgstr "Исправления могут затронуть упаковку, meson.build, исходники или копии каркаса. Перед загрузкой сверьте diff Maintainer, Depends, %files и скриптов *.in."

#: src/zfr_lib/lint/gitignore.py:94
msgid "missing root .gitignore"
msgstr "отсутствует Cargo.toml"

#: src/zfr_lib/lint/gitignore.py:97
msgid "Add a root .gitignore covering node_modules/, dist/, and other build artifacts. Component dirs (backend/, web/, …) should get their own .gitignore too."
msgstr "Добавить корен.gitignore, охватывающий node_modules/, dist/ и другие строительные артефакты. Компонентные директии (backend/, web/, ...) должны также получать свои собственные.gitignore."

#: src/zfr_lib/lint/gitignore.py:107
msgid "root .gitignore present"
msgstr "корневой .gitignore есть"

#: src/zfr_lib/lint/gitignore.py:116
#, python-format
msgid "root .gitignore missing common patterns: %s"
msgstr "корен .gitignore пропускает общие модели: %s"

#: src/zfr_lib/lint/gitignore.py:118
#, python-format
msgid "Add %s to the project-root .gitignore."
msgstr "Добавить %s к проекту -root .gitignore."

#: src/zfr_lib/lint/gitignore.py:126
msgid "root .gitignore covers node_modules/ and dist/"
msgstr "коренный .gitignore охватывает node_modules/ и dist/"

#: src/zfr_lib/lint/gitignore.py:136
#, python-format
msgid "root .gitignore could also ignore: %s"
msgstr "корен .gitignore может также игнорировать: %s"

#: src/zfr_lib/lint/gitignore.py:153
#, python-format
msgid "missing %s (component directory exists)"
msgstr "продолжает %s (существует компонентный каталог)"

#: src/zfr_lib/lint/gitignore.py:155
#, python-format
msgid "Add %s covering: %s"
msgstr "Добавить %s объема: %s"

#: src/zfr_lib/lint/gitignore.py:166
#, fuzzy, python-format
msgid "%s missing patterns: %s"
msgstr "нет %s"

#: src/zfr_lib/lint/gitignore.py:168
#, python-format
msgid "Add to %s: %s"
msgstr "Добавить в %s: %s"

#: src/zfr_lib/lint/gitignore.py:176
#, python-format
msgid "%s covers required patterns"
msgstr "%s охватывает необходимые модули"

#: src/zfr_lib/lint/hardcoded.py:161
msgid "zfr CLI package uses configure_file wrappers for install paths"
msgstr "пакет CLI zfr использует обёртки configure_file для путей установки"

#: src/zfr_lib/lint/hardcoded.py:191
#, python-format
msgid "hardcoded install path %(sample)s in %(rel)s"
msgstr "жёстко заданный путь установки %(sample)s в %(rel)s"

#: src/zfr_lib/lint/hardcoded.py:196 src/zfr_lib/lint/i18n_check.py:289
#: src/zfr_lib/lint/i18n_check.py:327 src/zfr_lib/lint/i18n_check.py:345
#: src/zfr_lib/lint/leftovers.py:127 src/zfr_lib/lint/template.py:194
#: src/zfr_lib/lint/template.py:209 src/zfr_lib/lint/template.py:215
#, python-format
msgid " (+%d more)"
msgstr " (+ещё %d)"

#: src/zfr_lib/lint/hardcoded.py:205
msgid "Replace with meson configure_file placeholders (@PREFIX@, @DATADIR@, @BINDIR@, @LIBDIR@, @LOCALEDIR@, @PKGDATADIR@): rename to *.in and run `zfr ize`."
msgstr "Замените на плейсхолдеры meson configure_file (@PREFIX@, @DATADIR@, @BINDIR@, @LIBDIR@, @LOCALEDIR@, @PKGDATADIR@): переименуйте в *.in и выполните `zfr ize`."

#: src/zfr_lib/lint/hardcoded.py:219
#, python-format
msgid "hardcoded version %(sample)s in %(rel)s"
msgstr "жёстко заданная версия %(sample)s в %(rel)s"

#: src/zfr_lib/lint/hardcoded.py:224
msgid "Use @VERSION@ (scripts → *.in + configure_file) or PROJECT_VERSION from config.h (C/C++). Run `zfr ize`."
msgstr "Используйте @VERSION@ (scripts → *.in + configure_file) или PROJECT_VERSION из config.h (C/C++). Выполните `zfr ize`."

#: src/zfr_lib/lint/hardcoded.py:236
msgid "no hardcoded install paths or project version strings in sources"
msgstr "в исходниках нет жёстко заданных путей установки и строк версии проекта"

#: src/zfr_lib/lint/i18n_check.py:62
#, python-format
msgid "l10n level %s: no locale coverage required"
msgstr "уровень l10n %s: покрытие локалей не требуется"

#: src/zfr_lib/lint/i18n_check.py:71
#, python-format
msgid "l10n level %(level)s (%(count)d locales)"
msgstr "уровень l10n %(level)s (%(count)d локалей)"

#: src/zfr_lib/lint/i18n_check.py:84
msgid "no po/ directory (optional unless the project uses gettext)"
msgstr "нет каталога po/ (необязательно, если проект не использует gettext)"

#: src/zfr_lib/lint/i18n_check.py:85
#, python-format
msgid "If the app is translated, add po/ with LINGUAS + *.po and i18n.gettext() in meson.build. Required locales at %(level)s: %(locales)s (source language %(source)s)."
msgstr "Если приложение переведено, добавьте po/ с LINGUAS + *.po и i18n.gettext() в meson.build. Требуемые локали на %(level)s: %(locales)s (язык источника %(source)s)."

#: src/zfr_lib/lint/i18n_check.py:103
msgid "po/ exists but po/LINGUAS is missing or empty"
msgstr "po/ есть, но po/LINGUAS отсутствует или пуст"

#: src/zfr_lib/lint/i18n_check.py:105
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"Создайте po/LINGUAS со списком как минимум:\n"
"%(locales)s\n"
"(английский/%(source)s — источник msgid и в список не входит.)"

#: src/zfr_lib/lint/i18n_check.py:124
#, python-format
msgid "po/LINGUAS missing %(level)s locale(s): %(locales)s"
msgstr "в po/LINGUAS нет локалей %(level)s: %(locales)s"

