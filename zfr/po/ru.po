#: src/zfr_lib/lint/report.py:97
msgid ""
"License AGPL-3.0-or-later (meson license, debian/copyright AGPL-3+, rpm "
"License)."
msgstr ""
"Лицензия AGPL-3.0-or-later (meson license, debian/copyright AGPL-3+, rpm "
"License)."

#: src/zfr_lib/lint/report.py:98
msgid ""
"Build with Meson; debian/rules uses dh --buildsystem=meson --"
"builddirectory=debian/build."
msgstr ""
"Сборка через Meson; debian/rules использует dh --buildsystem=meson --"
"builddirectory=debian/build."

#: src/zfr_lib/lint/report.py:99
msgid ""
"project() version from `zfr version`; keep fallback v=\"0.0.0\" # FIXED TO "
"0.0.0, DO NOT MODIFY."
msgstr ""
"версия project() из `zfr version`; оставьте запасное v=\"0.0.0\" # FIXED TO "
"0.0.0, DO NOT MODIFY."

#: src/zfr_lib/lint/report.py:100
msgid ""
"Man pages: docs/*.adoc + asciidoctor -b manpage; translated pages under "
"share/man/<locale>/man1 (whole-document adoc, not po4a)."
msgstr ""
"Man-страницы: docs/*.adoc + asciidoctor -b manpage; переводы в share/man/"
"<locale>/man1 (adoc всего документа, не po4a)."

#: src/zfr_lib/lint/report.py:101
msgid ""
"Packaging: debian/control Build-Depends meson, ninja-build, asciidoctor; "
"optional rpm/ aligned with debian."
msgstr ""
"Упаковка: debian/control Build-Depends meson, ninja-build, asciidoctor; "
"необязательный rpm/, согласованный с debian."

#: src/zfr_lib/lint/report.py:102
msgid ""
"i18n: English source; zfr lint -l/--l10n-level L0–L3 (default L1). L1=10 "
"locales, L2=20, L3=30. Defaults in .config/zfr/lint.options."
msgstr ""
"i18n: английский оригинал; zfr lint -l/--l10n-level L0–L3 (по умолчанию L1). "
"L1=10 локалей, L2=20, L3=30. Значения по умолчанию в .config/zfr/"
"lint.options."

#: src/zfr_lib/lint/report.py:103
msgid ""
"Apps: `zfr rename <dir>` then `zfr add <puff>`; VERSION matches debian/"
"changelog (git describe may differ)."
msgstr ""
"Приложения: `zfr rename <dir>`, затем `zfr add <puff>`; VERSION совпадает с "
"debian/changelog (git describe может отличаться)."

#: src/zfr_lib/lint/report.py:116
msgid "error"
msgstr "ошибка"

#: src/zfr_lib/lint/report.py:117
msgid "warn"
msgstr "предупреждение"

#: src/zfr_lib/lint/report.py:118
msgid "note"
msgstr "заметка"

#: src/zfr_lib/lint/report.py:119
msgid "ok"
msgstr "ок"

#: src/zfr_lib/lint/report.py:132
msgid "fix:"
msgstr "исправление:"

#: src/zfr_lib/lint/report.py:139
msgid "Next steps (zephyr style)"
msgstr "Следующие шаги (стиль zephyr)"

#: src/zfr_lib/lint/report.py:145
msgid ""
"Hint: after edits, re-run `zfr lint` from the project (or a subdirectory). "
"`zfr about -d -r` dumps packaging fields. Version for Meson/RPM is `zfr "
"version`. `zfr ize` applies missing debian/rpm/meson/man/version-subst "
"upgrades."
msgstr ""
"Подсказка: после правок снова запустите `zfr lint` из проекта (или "
"подкаталога). `zfr about -d -r` выводит поля упаковки. Версия для Meson/RPM "
"— `zfr version`. `zfr ize` применяет недостающие обновления debian/rpm/meson/"
"man/version-subst."

#: src/zfr_lib/lint/rpm.py:41
msgid "no rpm/*.spec (optional, but zephyr style includes RPM next to debian/)"
msgstr ""
"нет rpm/*.spec (необязательно, но стиль zephyr кладёт RPM рядом с debian/)"

#: src/zfr_lib/lint/rpm.py:44
#, no-python-format
msgid ""
"Copy rpm/ from a language template; name the spec after the package (rpm/"
"<Source>.spec, not zephyr.spec) and keep a Makefile using `zfr version`. "
"Align Name/Summary/Requires/URL with debian/control. Or run `zfr ize`."
msgstr ""
"Скопируйте rpm/ из языкового шаблона; назовите spec по пакету (rpm/"
"<Source>.spec, не zephyr.spec) и оставьте Makefile с `zfr version`. "
"Согласуйте Name/Summary/Requires/URL с debian/control. Или запустите `zfr "
"ize`."

#: src/zfr_lib/lint/rpm.py:63
#, no-python-format, python-brace-format
msgid "spec Version is dynamic %{version}"
msgstr "Version в spec динамический %{version}"

#: src/zfr_lib/lint/rpm.py:72
msgid "spec Version is hardcoded; zephyr style injects `zfr version`"
msgstr "Version в spec зашит; стиль zephyr подставляет `zfr version`"

#: src/zfr_lib/lint/rpm.py:76
#, no-python-format
msgid ""
"Use Version: %{version} with %{!?version:%global version 0.0.0} and freeze "
"via rpm/Makefile (`zfr version` / `zfr version -r`)."
msgstr ""
"Используйте Version: %{version} с %{!?version:%global version 0.0.0} и "
"зафиксируйте через rpm/Makefile (`zfr version` / `zfr version -r`)."

#: src/zfr_lib/lint/rpm.py:82
#, python-format
msgid "License %s"
msgstr "Лицензия %s"

#: src/zfr_lib/lint/rpm.py:88
msgid "spec License is not AGPL-3.0-or-later"
msgstr "License в spec не AGPL-3.0-or-later"

#: src/zfr_lib/lint/rpm.py:91
#, python-format
msgid "License:        %s"
msgstr "License:        %s"

#: src/zfr_lib/lint/rpm.py:102
#, python-format
msgid "spec URL=%(url)r != debian Homepage=%(homepage)r"
msgstr "spec URL=%(url)r != debian Homepage=%(homepage)r"

#: src/zfr_lib/lint/rpm.py:105
msgid "Set URL: to the same Homepage as debian/control."
msgstr "Задайте URL: тем же Homepage, что в debian/control."

#: src/zfr_lib/lint/rpm.py:117
msgid "spec Summary does not match debian Description first line"
msgstr "Summary в spec не совпадает с первой строкой debian Description"

#: src/zfr_lib/lint/rpm.py:120
#, python-format
msgid "Summary:        %s"
msgstr "Summary:        %s"

#: src/zfr_lib/lint/rpm.py:125
msgid "spec uses Meson (not autotools)"
msgstr "spec использует Meson (не autotools)"

#: src/zfr_lib/lint/rpm.py:131
msgid "spec still uses autotools; zephyr packages build with Meson"
msgstr "spec всё ещё использует autotools; пакеты zephyr собираются Meson"

#: src/zfr_lib/lint/rpm.py:134
#, no-python-format, python-brace-format
msgid ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"
msgstr ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"

#: src/zfr_lib/lint/rpm.py:142
msgid "Makefile uses `zfr version`"
msgstr "Makefile использует `zfr version`"

#: src/zfr_lib/lint/rpm.py:149
msgid "rpm/Makefile does not call `zfr version`"
msgstr "rpm/Makefile не вызывает `zfr version`"

#: src/zfr_lib/lint/rpm.py:152
#, no-python-format
msgid ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"
msgstr ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"

#: src/zfr_lib/lint/rpm.py:161
msgid "no rpm/Makefile convenience targets"
msgstr "нет удобных целей в rpm/Makefile"

#: src/zfr_lib/lint/rpm.py:163
msgid "Copy bash/rpm/Makefile (srpm/rpm via zfr version)."
msgstr "Скопируйте bash/rpm/Makefile (srpm/rpm через zfr version)."

#: src/zfr_lib/lint/rpm.py:172
msgid "bash spec Requires missing bash-shlib"
msgstr "в bash spec нет Requires bash-shlib"

#: src/zfr_lib/lint/rpm.py:174
msgid "Requires:       bash-shlib  (same as debian Depends)"
msgstr "Requires:       bash-shlib  (как debian Depends)"

#: src/zfr_lib/lint/source_size.py:55
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); file is very long"
msgstr "%(rel)s — %(lines)d строк (>%(limit)d); файл очень длинный"

#: src/zfr_lib/lint/source_size.py:59
msgid ""
"Split this file into smaller modules; keep each unit focused and testable."
msgstr ""
"Разбейте этот файл на меньшие модули; каждая единица должна быть "
"сфокусированной и проверяемой."

#: src/zfr_lib/lint/source_size.py:67
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); consider modularizing soon"
msgstr "%(rel)s — %(lines)d строк (>%(limit)d); скоро стоит модулировать"

#: src/zfr_lib/lint/source_size.py:71
msgid "Plan extraction of helpers or submodules before the file grows further."
msgstr ""
"Запланируйте выделение помощников или подмодулей, пока файл не вырос дальше."

#: src/zfr_lib/lint/source_size.py:75
msgid "no oversized source files"
msgstr "нет чрезмерно больших исходников"

#: src/zfr_lib/lint/template.py:51
msgid "zfr CLI package is not a language template"
msgstr "пакет zfr CLI — не языковой шаблон"

#: src/zfr_lib/lint/template.py:93
msgid "structural files from the language template are present"
msgstr "структурные файлы языкового шаблона на месте"

#: src/zfr_lib/lint/template.py:100
#, python-format
msgid ""
"language template %(lang)s has extra scaffolding not in this tree: "
"%(preview)s%(more)s"
msgstr ""
"языковой шаблон %(lang)s содержит каркас, которого нет в этом дереве: "
"%(preview)s%(more)s"

#: src/zfr_lib/lint/template.py:102
#, python-format
msgid ""
"Compare with the %(lang)s template under pkgdatadir. Copy missing debian/"
"docs/src/rpm files (rpm/ uses %(name)s.spec, not zephyr.spec), or `zfr add` "
"puffs. Do not copy build/ or debian leftover stamp files. Example commons "
"modules are optional."
msgstr ""
"Сравните с шаблоном %(lang)s в pkgdatadir. Скопируйте недостающие файлы "
"debian/docs/src/rpm (rpm/ использует %(name)s.spec, не zephyr.spec) или `zfr "
"add` puff. Не копируйте build/ и остаточные stamp-файлы debian. Примерные "
"модули commons необязательны."

