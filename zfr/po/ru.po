#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "вывести информацию о текущем проекте (обход родителей от cwd)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Вывести информацию о текущем проекте zephyr (обход от cwd к родительским каталогам). Цвета CSR, когда stdout — TTY. Общие поля упаковки читаются из debian или RPM."

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "показать разобранные поля упаковки Debian"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "показать разобранные поля упаковки RPM"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "подсветка CSR (console SGR) (по умолчанию: auto = TTY и без NO_COLOR)"

#: src/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "создать экземпляр puff из языкового шаблона"

#: src/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Определить язык и добавить puff из pkgdatadir/<lang>."

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "имя(ена) нового puff (рекомендуется snake_case)"

#: src/build.py:15
msgid "detect build system and compile the project"
msgstr "определить систему сборки и скомпилировать проект"

#: src/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "Определяет систему сборки проекта (meson, cmake, autotools, cargo, go, npm, make) и запускает локальную компиляцию."

#: src/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "перейти в DIR перед определением системы сборки"

#: src/build.py:35
msgid "build directory (default: <project>/build)"
msgstr "каталог сборки Meson (по умолчанию: /build если соответствует этому дереву исходников, иначе <project>/build)"

#: src/build.py:42 src/package.py:120
msgid "print planned commands without running them"
msgstr "вывести запланированные изменения без записи файлов"

#: src/build.py:48
msgid "verbose build output where supported"
msgstr "подробный вывод сборки, где поддерживается"

#: src/build.py:53
msgid "print detected build system and exit"
msgstr "вывести обнаруженную систему сборки и выйти"

#: src/build.py:58
msgid "preview files meson would install (DESTDIR tree; replaces scripts/look.sh)"
msgstr "просмотр файлов, которые meson установит (дерево DESTDIR; заменяет scripts/look.sh)"

#: src/build.py:67
msgid "with --look, limit tree depth to N levels (implies --look; default is unlimited)"
msgstr "с --look ограничить глубину дерева до N уровней (подразумевает --look; по умолчанию без лимита)"

#: src/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "показать или удалить lint.comments проекта/пользователя с подсказкой работы для ИИ"

#: src/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr "Показывает комментарии с предложениями lint из .config/zfr/lint.comments (проект) и ~/.config/zfr/lint.comments (пользователь), затем подсказку ИИ применить предложения и удалить использованные файлы комментариев. Необязательные аргументы ZLxxxx фильтруют, какие разделы показывать. Типичный запрос: «do zfr-comments work.»"

#: src/comments_cmd.py:35
msgid "only these rule ids (default: all)"
msgstr "порог bool 0-100 (по умолчанию: %s)"

#: src/comments_cmd.py:42 src/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "каталог проекта (по умолчанию: обход вверх от cwd)"

#: src/comments_cmd.py:49
msgid "user comments only (~/.config/zfr/lint.comments)"
msgstr "только комментарии пользователя (~/.config/zfr/lint.comments)"

#: src/comments_cmd.py:55
msgid "project comments only (.config/zfr/lint.comments)"
msgstr "только комментарии проекта (.config/zfr/lint.comments)"

#: src/comments_cmd.py:61
msgid "delete matching comments (files or selected sections)"
msgstr "удалить совпадающие комментарии (файлы или выбранные разделы)"

#: src/comments_cmd.py:67
msgid "omit the AI hint trailer"
msgstr "не добавлять завершающую подсказку ИИ"

#: src/comments_cmd.py:93
msgid "No matching lint.comments to delete."
msgstr "Нет совпадающих lint.comments для удаления."

#: src/comments_cmd.py:96
#, python-format
msgid "Deleted: %s"
msgstr "есть: %s"

#: src/create.py:287
