msgstr ""
"Auffüllung außerhalb _(): z.B. fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\\n"
"\"), out);"

#: src/zfr_lib/lang/_c_bas.py:320
msgid "gettext _() strings have no leading/trailing spaces"
msgstr "gettext _()-Schringe haben keine leading/trailing-Flacher"

