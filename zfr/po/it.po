msgstr "localedir = prefix / get_option(localedir); config_h.set_quoted('LOCALEDIR', localedir); Executa `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:289
msgid "meson LOCALEDIR present"
msgstr "LOCALEDIR meson presente"

