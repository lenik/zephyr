#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "scrivi l'archivio in DIR (predefinito: meson-dist, o %_topdir/SOURCES ($HOME/rpmbuild) con --rpm)"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "directory di build Meson (predefinito: /build se corrisponde a questo albero sorgente, altrimenti <project>/build)"

