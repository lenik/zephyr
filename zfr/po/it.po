msgstr "nessuna directory tests/"

#: src/zfr_lib/lang/antlr.py:49
msgid "Add tests/TestCommons.java or fixture checks for parser output."
msgstr ""
"Aggiungere tests/TestCommons.java o controlli fixture per l’output del "
"parser."

#: src/zfr_lib/lang/as.py:37
msgid "Add tests/smoke.sh and meson test() for stdin/stdout copy."
msgstr "Aggiungere tests/smoke.sh e meson test() per la copia stdin/stdout."

#: src/zfr_lib/lang/bash.py:45
#, python-format
msgid "src scripts: %s"
msgstr "script in src: %s"

#: src/zfr_lib/lang/bash.py:46
msgid "no src/*.in scripts"
msgstr "nessuno script src/*.in"

#: src/zfr_lib/lang/bash.py:47
msgid ""
"Keep configured scripts as src/<puff>.in with @PACKAGE@/@VERSION@ and meson "
"configure_file + install_mode rwxr-xr-x."
msgstr ""
"Mantenere gli script configurati come src/<puff>.in con @PACKAGE@/@VERSION@ "
"e meson configure_file + install_mode rwxr-xr-x."

#: src/zfr_lib/lang/bison.py:45
msgid "Add tests/ with fixture checks for parser dump/format output."
msgstr ""
"Aggiungere tests/ con controlli fixture per l’output dump/format del parser."

#: src/zfr_lib/lang/clib.py:36 src/zfr_lib/lang/cpplib.py:36
#: src/zfr_lib/lang/cpp.py:23 src/zfr_lib/lang/c.py:23
#: src/zfr_lib/lang/gcc.py:55
msgid "Add tests/ and meson test() entries like the C family templates."
msgstr ""
"Aggiungere tests/ e voci meson test() come nei modelli della famiglia C."

#: src/zfr_lib/lang/cobol.py:37
msgid "no tests/ (cobol template uses cobc + meson test)"
msgstr "nessun tests/ (il modello cobol usa cobc + meson test)"

#: src/zfr_lib/lang/cobol.py:39
msgid "Add tests/test_commons.sh or similar smoke test for cobc."
msgstr "Aggiungere tests/test_commons.sh o un smoke test analogo per cobc."

#: src/zfr_lib/lang/d.py:37
msgid "no tests/ (D template uses ldc/dmd + meson test)"
msgstr "nessun tests/ (il modello D usa ldc/dmd + meson test)"

#: src/zfr_lib/lang/d.py:39
msgid "Add tests/test_commons.d and meson test() executable."
msgstr "Aggiungere tests/test_commons.d e l’eseguibile meson test()."

#: src/zfr_lib/lang/fortran.py:37
msgid "no tests/ (fortran template uses gfortran + meson test)"
msgstr "nessun tests/ (il modello fortran usa gfortran + meson test)"

#: src/zfr_lib/lang/fortran.py:39
msgid "Add tests/test_commons.f90 and meson test() executable."
msgstr "Aggiungere tests/test_commons.f90 e l’eseguibile meson test()."

#: src/zfr_lib/lang/go.py:22
msgid "missing go.mod"
msgstr "go.mod mancante"

#: src/zfr_lib/lang/go.py:23
msgid ""
"Add go.mod; meson should `go build` with -X main.buildVersion from "
"meson.project_version()."
msgstr ""
"Aggiungere go.mod; meson deve eseguire `go build` con -X main.buildVersion "
"da meson.project_version()."

#: src/zfr_lib/lang/kotlin.py:23
msgid "no tests/ (kotlin template uses kotlinc + meson test)"
msgstr "nessun tests/ (il modello kotlin usa kotlinc + meson test)"

#: src/zfr_lib/lang/kotlin.py:24
msgid "Add tests/Test*.kt and meson test() compiling with kotlinc."
msgstr "Aggiungere tests/Test*.kt e meson test() compilando con kotlinc."

#: src/zfr_lib/lang/lua.py:23
msgid "no tests/ (lua template uses lua tests + meson test)"
msgstr "nessun tests/ (il modello lua usa test lua + meson test)"

#: src/zfr_lib/lang/lua.py:24
msgid ""
"Add tests/test_*.lua and meson test() invoking lua with LUA_PATH=src/?.lua."
msgstr ""
"Aggiungere tests/test_*.lua e meson test() che invoca lua con "
"LUA_PATH=src/?.lua."

#: src/zfr_lib/lang/nim.py:25
msgid "no tests/ (nim template uses unittest + meson test)"
msgstr "nessun tests/ (il modello nim usa unittest + meson test)"

#: src/zfr_lib/lang/nim.py:26
msgid "Add tests/test_*.nim and meson test() with nim r."
msgstr "Aggiungere tests/test_*.nim e meson test() con nim r."

#: src/zfr_lib/lang/pascal.py:37
msgid "no tests/ (pascal template uses fpc + meson test)"
msgstr "nessun tests/ (il modello pascal usa fpc + meson test)"

#: src/zfr_lib/lang/pascal.py:39
msgid "Add tests/test_commons.pas and meson test() with fpc."
msgstr "Aggiungere tests/test_commons.pas e meson test() con fpc."

#: src/zfr_lib/lang/python.py:22
msgid "no tests/ (python template uses unittest + meson test)"
msgstr "nessun tests/ (il modello python usa unittest + meson test)"

#: src/zfr_lib/lang/python.py:23
msgid "Add tests/test_*.py and meson test() with PYTHONPATH=src."
msgstr "Aggiungere tests/test_*.py e meson test() con PYTHONPATH=src."

#: src/zfr_lib/lang/rust.py:22
msgid "missing Cargo.toml"
msgstr "Cargo.toml mancante"

#: src/zfr_lib/lang/rust.py:23
msgid ""
"Rust zephyr projects keep Cargo.toml plus meson custom_target for the binary."
msgstr ""
"I progetti zephyr in Rust tengono Cargo.toml più meson custom_target per il "
"binario."

#: src/zfr_lib/lang/zig.py:23
msgid "missing build.zig"
msgstr "build.zig mancante"

#: src/zfr_lib/lang/zig.py:24
msgid "Add build.zig; meson should invoke `zig build -Doptimize=ReleaseFast`."
msgstr ""
"Aggiungere build.zig; meson deve invocare `zig build -Doptimize=ReleaseFast`."

#: src/zfr_lib/lint/debian.py:42
#, python-format
msgid "Build-Depends has %s"
msgstr "Build-Depends include %s"

#: src/zfr_lib/lint/debian.py:48
#, python-format
msgid "Build-Depends missing %s"
msgstr "manca %s in Build-Depends"

#: src/zfr_lib/lint/debian.py:50
#, python-format
msgid ""
"Add %s to Build-Depends (zephyr packages build with Meson + AsciiDoc man "
"pages)."
msgstr ""
"Aggiungere %s a Build-Depends (i pacchetti zephyr si compilano con Meson e "
"pagine man AsciiDoc)."

#: src/zfr_lib/lint/debian.py:54
msgid "debhelper-compat present"
msgstr "debhelper-compat presente"

#: src/zfr_lib/lint/debian.py:60
msgid "Build-Depends missing debhelper-compat (= 13)"
msgstr "manca debhelper-compat (= 13) in Build-Depends"

#: src/zfr_lib/lint/debian.py:62
msgid "Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"
msgstr ""
"Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"

#: src/zfr_lib/lint/debian.py:72
msgid "Package stanza missing Architecture"
msgstr "la stanza Package è senza Architecture"

#: src/zfr_lib/lint/debian.py:74
msgid "Architecture: all  (scripts) or any (compiled)."
msgstr "Architecture: all  (script) oppure any (compilato)."

#: src/zfr_lib/lint/debian.py:82
#, python-format
msgid "bash packages should be Architecture: all (got %s)"
msgstr "i pacchetti bash devono essere Architecture: all (ottenuto %s)"

#: src/zfr_lib/lint/debian.py:84
msgid "Architecture: all"
msgstr "Architecture: all"

#: src/zfr_lib/lint/debian.py:92
#, python-format
msgid "%s packages are usually Architecture: any (got all)"
msgstr "i pacchetti %s di solito sono Architecture: any (ottenuto all)"

#: src/zfr_lib/lint/debian.py:94
msgid "Architecture: any"
msgstr "Architecture: any"

#: src/zfr_lib/lint/debian.py:98
#, python-format
msgid "Architecture: %s"
msgstr "campo Architecture: %s"

#: src/zfr_lib/lint/debian.py:102
#, python-format
msgid "Homepage: %s"
msgstr "campo Homepage: %s"

#: src/zfr_lib/lint/debian.py:108
msgid "no Homepage"
msgstr "nessun Homepage"

#: src/zfr_lib/lint/debian.py:110
msgid "Set Homepage: to the project URL."
msgstr "Impostare Homepage: sull’URL del progetto."

#: src/zfr_lib/lint/debian.py:116
msgid "dh meson debian/build"
msgstr "dh con meson in debian/build"

#: src/zfr_lib/lint/debian.py:122
msgid ""
"debian/rules is not dh --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"debian/rules non è dh --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:125
#, no-python-format
msgid ""
"Use:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"Utilizzare:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:131
msgid "copyright mentions AGPL"
msgstr "il copyright menziona AGPL"

#: src/zfr_lib/lint/debian.py:137
msgid "debian/copyright does not mention AGPL"
msgstr "debian/copyright non menziona AGPL"

#: src/zfr_lib/lint/debian.py:139
msgid "Use the template debian/copyright (License: AGPL-3+)."
msgstr "Usa il modello debian/copyright (License: AGPL-3+)."

#: src/zfr_lib/lint/debian.py:145
#, python-format
msgid "source format %s"
msgstr "formato sorgente %s"

#: src/zfr_lib/lint/debian.py:154
#, python-format
msgid "VERSION=%(file)r != changelog %(changelog)r"
msgstr "VERSION=%(file)r != registro modifiche %(changelog)r"

#: src/zfr_lib/lint/debian.py:156
msgid ""
"VERSION should match the latest debian/changelog entry (pre-commit hook "
"updates it). Git describe may still differ."
msgstr ""
"VERSION deve coincidere con la voce più recente di debian/changelog (il "
"gancio pre-commit la aggiorna). Git describe può ancora differire."

#: src/zfr_lib/lint/debian.py:162
#, python-format
msgid "VERSION matches changelog %s"
msgstr "VERSION coincide con il registro %s"

#: src/zfr_lib/lint/debian.py:172
msgid "bash project Depends missing bash-shlib"
msgstr "progetto bash: manca bash-shlib in Depends"

#: src/zfr_lib/lint/debian.py:174
msgid "Depends: bash, bash-shlib, ${misc:Depends}"
msgstr "Depends: bash, bash-shlib, ${misc:Depends}"

#: src/zfr_lib/lint/debian.py:178
msgid "Depends includes bash-shlib"
msgstr "Depends include bash-shlib"

#: src/zfr_lib/lint/i18n_check.py:56
#, python-format
msgid "l10n level %s: no locale coverage required"
msgstr "livello l10n %s: nessuna copertura delle locale richiesta"

#: src/zfr_lib/lint/i18n_check.py:65
#, python-format
msgid "l10n level %(level)s (%(count)d locales)"
msgstr "livello l10n %(level)s (%(count)d locale)"

#: src/zfr_lib/lint/i18n_check.py:78
msgid "no po/ directory (optional unless the project uses gettext)"
msgstr "nessuna directory po/ (facoltativa se il progetto non usa gettext)"

#: src/zfr_lib/lint/i18n_check.py:79
#, python-format
msgid ""
"If the app is translated, add po/ with LINGUAS + *.po and i18n.gettext() in "
"meson.build. Required locales at %(level)s: %(locales)s (source language "
"%(source)s)."
msgstr ""
"Se l’app è tradotta, aggiungi po/ con LINGUAS + *.po e i18n.gettext() in "
"meson.build. Locale richieste a %(level)s: %(locales)s (lingua sorgente "
"%(source)s)."

#: src/zfr_lib/lint/i18n_check.py:97
msgid "po/ exists but po/LINGUAS is missing or empty"
msgstr "po/ esiste ma po/LINGUAS manca o è vuoto"

#: src/zfr_lib/lint/i18n_check.py:99
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"Crea po/LINGUAS elencando almeno:\n"
"%(locales)s\n"
"(l’inglese/%(source)s è la fonte dei msgid e non viene elencato.)"

#: src/zfr_lib/lint/i18n_check.py:114
#, python-format
msgid "po/LINGUAS missing %(level)s locale(s): %(locales)s"
msgstr "in po/LINGUAS mancano locale %(level)s: %(locales)s"

#: src/zfr_lib/lint/i18n_check.py:117
#, python-format
msgid ""
"Level %(level)s requires: %(locales)s (source %(source)s; zh-cn→zh_CN, zh-"
"tw→zh_TW). Append the missing lines to LINGUAS and add matching po/"
"<locale>.po."
msgstr ""
"Il livello %(level)s richiede: %(locales)s (sorgente %(source)s; zh-"
"cn→zh_CN, zh-tw→zh_TW). Aggiungi le righe mancanti a LINGUAS e i po/"
"<locale>.po corrispondenti."

#: src/zfr_lib/lint/i18n_check.py:132
#, python-format
msgid "po/LINGUAS covers %s locale set"
msgstr "po/LINGUAS copre l’insieme di locale %s"

#: src/zfr_lib/lint/i18n_check.py:147
#, python-format
msgid "LINGUAS entries without po/<locale>.po: %s"
msgstr "voci LINGUAS senza po/<locale>.po: %s"

#: src/zfr_lib/lint/i18n_check.py:149
msgid ""
"For each locale: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-"
"translator && msgmerge -U po/<locale>.po <domain>.pot"
msgstr ""
"Per ogni locale: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-"
"translator && msgmerge -U po/<locale>.po <domain>.pot"

#: src/zfr_lib/lint/i18n_check.py:160
#, python-format
