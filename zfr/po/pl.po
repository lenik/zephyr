#: src/zfr_lib/lint/__init__.py:167
msgid "hide zephyr style-contract / next-steps blurbs (default for plain interactive shell)"
msgstr "Stil-Vertrags-/Nächste-Schritte-Blöcke ausblenden (Standard für normale interaktive Shell)"

