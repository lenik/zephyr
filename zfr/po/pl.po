msgid "Keep configured scripts as src/<puff>.in (preferred) or <puff>.in with @PACKAGE@/@VERSION@ and meson configure_file + install_mode rwxr-xr-x."
msgstr "Zachowaj skonfigurowane skrypty jako src/<puff>.in z @PACKAGE@/@VERSION@ oraz meson configure_file + install_mode rwxr-xr-x."

#: src/zfr_lib/lang/bison.py:45
msgid "Add tests/ with fixture checks for parser dump/format output."
msgstr "Dodaj tests/ z testami fixture dla wyjścia dump/format parsera."

#: src/zfr_lib/lang/_c_bas.py:187
msgid "no int main() in src/; skip bas i18n main checks"
msgstr "żadne int main() w src/; przeskoczyć bas i18n główne kontrole"

#: src/zfr_lib/lang/_c_bas.py:208
#, python-format
msgid "main missing bas i18n setup: %s"
msgstr "główny brak bas i18n setuation: %s"

#: src/zfr_lib/lang/_c_bas.py:211
msgid "In main: #include <bas/locale/i18n.h> and <bas/proc/env.h>; const char *exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR from meson config.h). Run `zfr ize`."
msgstr "Głównie: #include <bas/locale/i18n.h> i <bas/proc/env.h>; konst charakter * exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR z meson konfiguracji.h). Runk `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:222
msgid "bas i18n main setup (self_exe + init_i18n)"
msgstr "bas i18n główny setup (self_exe + init_i18n)"

#: src/zfr_lib/lang/_c_bas.py:233
msgid "no define_logger() in src/"
msgstr "brak define_logger() w src/"

#: src/zfr_lib/lang/_c_bas.py:236
msgid "In one .c/.cpp: #include <bas/log/deflog.h> then define_logger(); libraries may use __attribute__((weak)) define_logger(); Run `zfr ize`."
msgstr "W jednym .c/.cpp: #include <bas/log/deflog.h> potem define_logger(); bibliotek mogą użyć _attribute_(weak) define_logger(); Run `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:250
msgid "define_logger() present"
msgstr "project() obecny"

#: src/zfr_lib/lang/_c_bas.py:252
msgid "weak define_logger() present (library)"
msgstr "jest weak define_logger() (biblioteka)"

#: src/zfr_lib/lang/_c_bas.py:258
msgid "define_logger() without #include <bas/log/deflog.h>"
msgstr "define_logger() bez #include <bas/log/deflog.h>"

#: src/zfr_lib/lang/_c_bas.py:260
msgid "Add #include <bas/log/deflog.h> before define_logger();"
msgstr "Dodać #include <bas/log/deflog.h> przed define_logger();"

#: src/zfr_lib/lang/_c_bas.py:276
msgid "meson.build missing LOCALEDIR in config.h"
msgstr "meson.build brak LOCALEDIR w konfiguracji.h"

#: src/zfr_lib/lang/_c_bas.py:279
msgid "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Run `zfr ize`."
msgstr "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Runk `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:289
msgid "meson LOCALEDIR present"
msgstr "meson LOCALEDIR obecny"

#: src/zfr_lib/lang/_c_bas.py:306
#, python-format
msgid "gettext string has leading/trailing spaces: %r"
msgstr "Zgłos gettext ma leading/trailing przestrzeni: %r"

#: src/zfr_lib/lang/_c_bas.py:310
msgid "Keep padding outside _(): e.g. fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\n\"), out);"
msgstr ""
"Zatrzymać poza _(): np. fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\\n"
"\"), out);"

#: src/zfr_lib/lang/_c_bas.py:320
msgid "gettext _() strings have no leading/trailing spaces"
msgstr "gettext _() nie ma przeciwów leading/trailing"

#: src/zfr_lib/lang/clib.py:45 src/zfr_lib/lang/cpplib.py:45
