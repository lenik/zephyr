msgid "Print the detected language of the current project and layout details on stderr."
msgstr "Wypisuje wykryty język bieżącego projektu i szczegóły układu na stderr."

#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "zapisz archiwum do DIR (domyślnie: meson-dist lub %_topdir/SOURCES ($HOME/rpmbuild) z --rpm)"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "Katalog build Meson (domyślnie: /build gdy pasuje do tego drzewa źródeł, inaczej <project>/build)"

#: src/dist.py:81
msgid "archive format (default: xz)"
msgstr "format archiwum (domyślnie: xz)"

#: src/dist.py:87
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "nazwij archiwum NAME-VERSION.tar.xz i zapisz do %_topdir/SOURCES ($HOME/rpmbuild), chyba że podano -o"

#: src/dist.py:96
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "przekaż --allow-dirty do meson dist (domyślnie: zezwól)"

#: src/dist.py:101
msgid "run tests during meson dist (default: --no-tests)"
msgstr "uruchom testy podczas meson dist (domyślnie: --no-tests)"

#: src/dist.py:418
msgid "build a source tarball (meson dist, or this project only)"
msgstr "zbuduj tarball źródeł (meson dist lub tylko ten projekt)"

#: src/dist.py:420
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. When ``.tarignore`` exists (gitignore-style), always pack the project tree and apply those excludes. Prints the archive path on stdout."
msgstr "Buduje archiwum źródeł bieżącego projektu zephyr (szuka w górę od cwd). Używa meson dist, gdy ten katalog jest korzeniem projektu git; w przeciwnym razie pakuje tylko ten projekt, aby zagnieżdżone szablony językowe nie zawierały nadrzędnego meta-repo. Wypisuje ścieżkę archiwum na stdout."

