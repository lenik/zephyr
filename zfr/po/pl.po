msgstr "Dodaj tests/smoke.sh i meson test() do kopiowania stdin/stdout."

#: src/zfr_lib/lang/bash.py:65
#, python-format
msgid "src scripts: %s"
msgstr "skrypty src: %s"

#: src/zfr_lib/lang/bash.py:78
msgid "root scripts: %s"
msgstr "skrypty src: %s"

#: src/zfr_lib/lang/bash.py:89
#, python-format
msgid "setup-only package (%s); no bindir script puffs"
msgstr "opcja -only (%s); bez świetów skriptów bindir"

