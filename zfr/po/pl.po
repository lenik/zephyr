#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "wypisz informacje o bieżącym projekcie (szuka w górę od cwd)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Wypisuje informacje o bieżącym projekcie zephyr (szuka w górę od cwd). Kolory CSR, gdy stdout jest TTY. Wspólne pola pakietowania są odczytywane z debian lub RPM."

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "pokaż przeanalizowane pola pakietowania Debian"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "pokaż przeanalizowane pola pakietowania RPM"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "podświetlanie CSR (console SGR) (domyślnie: auto = TTY i brak NO_COLOR)"

#: src/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "utwórz puff(y) z szablonu językowego"

#: src/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Wykrywa język i dodaje puff(y) z pkgdatadir/<lang>."

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "nowe nazwy puff(ów) (zalecane snake_case)"

#: src/build.py:15
msgid "detect build system and compile the project"
msgstr "wykryj system budowania i skompiluj projekt"

#: src/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "Wykryj system budowania projektu (meson, cmake, autotools, cargo, go, npm, make) i uruchom lokalną kompilację."

#: src/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "zmień na DIR przed wykryciem systemu budowania"

#: src/build.py:35
msgid "build directory (default: <project>/build)"
msgstr "Katalog build Meson (domyślnie: /build gdy pasuje do tego drzewa źródeł, inaczej <project>/build)"

#: src/build.py:42 src/package.py:120
msgid "print planned commands without running them"
msgstr "wypisz planowane zmiany bez zapisywania plików"

#: src/build.py:48
msgid "verbose build output where supported"
msgstr "szczegółowy wynik kompilacji tam, gdzie jest obsługiwany"

#: src/build.py:53
msgid "print detected build system and exit"
msgstr "wyświetl wykryty system budowania i zakończ"

#: src/build.py:58
msgid "preview files meson would install (DESTDIR tree; replaces scripts/look.sh)"
msgstr "podgląd plików, które meson zainstalowałby (drzewo DESTDIR; zastępuje scripts/look.sh)"

#: src/build.py:67
msgid "with --look, limit tree depth to N levels (implies --look; default is unlimited)"
msgstr "z --look ogranicza głębokość drzewa do N poziomów (implikuje --look; domyślnie bez limitu)"

#: src/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "wydrukuj lub usuń komentarze lint projektu/użytkownika z sugestią pracy AI"

#: src/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr "Wydrukuj komentarze z sugestiami lintera z .config/zfr/lint.comments (projekt) i ~/.config/zfr/lint.comments (użytkownik), następnie wskazówkę AI, aby zastosować sugestie i usunąć pliki z wykorzystanymi komentarzami. Opcjonalne argumenty ZLxxxx filtrują, które sekcje pokazać. Typowy prompt: „do zfr-comments work.”"

#: src/comments_cmd.py:35
msgid "only these rule ids (default: all)"
msgstr "próg bool 0-100 (domyślnie: %s)"

#: src/comments_cmd.py:42 src/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "katalog projektu (domyślnie: rozpocznij od bieżącego katalogu)"

#: src/comments_cmd.py:49
msgid "user comments only (~/.config/zfr/lint.comments)"
msgstr "tylko komentarze użytkowników (~/.config/zfr/lint.comments)"

#: src/comments_cmd.py:55
msgid "project comments only (.config/zfr/lint.comments)"
msgstr "tylko komentarze projektu (.config/zfr/lint.comments)"

#: src/comments_cmd.py:61
msgid "delete matching comments (files or selected sections)"
msgstr "usuń pasujące komentarze (pliki lub wybrane sekcje)"

#: src/comments_cmd.py:67
msgid "omit the AI hint trailer"
msgstr "pomiń zapowiedź wskazówki AI"

#: src/comments_cmd.py:93
msgid "No matching lint.comments to delete."
msgstr "Nie znaleziono pasujących komentarzy lint do usunięcia."

#: src/comments_cmd.py:96
msgid "Deleted: %s"
msgstr "obecny: %s"

