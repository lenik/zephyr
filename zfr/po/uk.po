#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "вивести інформацію про поточний проєкт (обхід батьків від cwd)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Вивести інформацію про поточний проєкт zephyr (обхід від cwd до батьківських каталогів). Кольори CSR, коли stdout — TTY. Загальні поля пакування читаються з debian або RPM."

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "показати розібрані поля пакування Debian"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "показати розібрані поля пакування RPM"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "підсвітка CSR (console SGR) (за замовчуванням: auto = TTY і без NO_COLOR)"

#: src/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "створити екземпляр puff з мовного шаблону"

#: src/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Визначити мову та додати puff з pkgdatadir/<lang>."

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "ім'я(ена) нового puff (рекомендується snake_case)"

#: src/build.py:15
msgid "detect build system and compile the project"
msgstr "виявити систему збірки та скомпілювати проект"

#: src/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "Визначте систему збірки проекту (meson, cmake, autotools, cargo, go, npm, make) і запустіть локальну компіляцію."

#: src/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "змініть на DIR перед виявленням системи збірки"

#: src/build.py:35
msgid "build directory (default: <project>/build)"
msgstr "каталог збірки Meson (за замовчуванням: /build якщо відповідає цьому дереву вихідного коду, інакше <project>/build)"

#: src/build.py:42 src/package.py:120
msgid "print planned commands without running them"
msgstr "вивести заплановані зміни без запису файлів"

#: src/build.py:48
msgid "verbose build output where supported"
msgstr "детальний вихід збірки там, де підтримується"

#: src/build.py:53
msgid "print detected build system and exit"
msgstr "вивести виявлену систему збірки та вийти"

#: src/build.py:58
msgid "preview files meson would install (DESTDIR tree; replaces scripts/look.sh)"
msgstr "перегляд файлів, які meson встановить (дерево DESTDIR; замінює scripts/look.sh)"

#: src/build.py:67
msgid "with --look, limit tree depth to N levels (implies --look; default is unlimited)"
msgstr "з --look обмежити глибину дерева до N рівнів (передбачає --look; типово без обмежень)"

#: src/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "друкувати або видаляти коментарі lint проекту/користувача з підказкою AI"

#: src/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr "Виведіть коментарі пропозицій lint від .config/zfr/lint.comments (проект) та ~/.config/zfr/lint.comments (користувач), потім підказку від ШІ застосувати пропозиції та видалити використані файли коментарів. Необов’язкові аргументи ZLxxxx фільтрують, які секції показувати. Типовий запит: «do zfr-comments work.»"

#: src/comments_cmd.py:35
msgid "only these rule ids (default: all)"
msgstr "поріг bool 0-100 (за замовчуванням: %s)"

#: src/comments_cmd.py:42 src/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "каталог проекту (за замовчуванням: йти від поточного каталогу)"

#: src/comments_cmd.py:49
msgid "user comments only (~/.config/zfr/lint.comments)"
msgstr "тільки коментарі користувачів (~/.config/zfr/lint.comments)"

#: src/comments_cmd.py:55
msgid "project comments only (.config/zfr/lint.comments)"
msgstr "тільки коментарі до проекту (.config/zfr/lint.comments)"

#: src/comments_cmd.py:61
msgid "delete matching comments (files or selected sections)"
msgstr "видалити відповідні коментарі (файли або вибрані розділи)"

#: src/comments_cmd.py:67
msgid "omit the AI hint trailer"
msgstr "опустіть трейлер із підказкою ШІ"

#: src/comments_cmd.py:93
msgid "No matching lint.comments to delete."
msgstr "Не знайдено відповідних lint.comments для видалення."

#: src/comments_cmd.py:96
msgid "Deleted: %s"
msgstr "наявний: %s"

#: src/create.py:287
msgid "create a new project from a language template"
msgstr "створити новий проєкт з мовного шаблону"

#: src/create.py:288
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "Створити новий каталог проєкту з pkgdatadir/<lang>."

#: src/create.py:295
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "мова шаблону (за замовчуванням: python; одна з: %s)"

#: src/create.py:299
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "дистрибутив debian changelog (за замовчуванням: %s)"

#: src/create.py:303
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "початкова версія пакета та тег git (за замовчуванням: %s)"

#: src/create.py:307
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "ім'я автора changelog/git (за замовчуванням: %s)"

#: src/create.py:311
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "email автора changelog/git (за замовчуванням: %s)"

#: src/create.py:317
msgid "do not instantiate a default puff (leave some_puff1 tokens for a later zfr add)"
msgstr "не створюйте стандартний puff (залиште деякі токени some_puff1 для пізнішого додавання zfr)"

#: src/create.py:321
msgid "new project directory name"
msgstr "ім'я нового каталогу проєкту"

#: src/create.py:325
msgid "puff names (default: one puff named like the package; use --no-puff for none)"
msgstr "імена затяжок (за замовчуванням: одна затяжка з ім’ям, як у пакунку; використовуйте --no-puff для відсутності)"

#: src/detect.py:15
msgid "print detected language for the current directory"
msgstr "вивести виявлену мову для поточного каталогу"

#: src/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "Вивести виявлену мову поточного проєкту та відомості про структуру в stderr."

#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "записати архів у DIR (за замовчуванням: meson-dist або %_topdir/SOURCES ($HOME/rpmbuild) з --rpm)"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "каталог збірки Meson (за замовчуванням: /build якщо відповідає цьому дереву вихідного коду, інакше <project>/build)"

#: src/dist.py:81
msgid "archive format (default: xz)"
msgstr "формат архіву (за замовчуванням: xz)"

#: src/dist.py:87
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "назвати архів NAME-VERSION.tar.xz і записати в %_topdir/SOURCES ($HOME/rpmbuild), якщо не вказано -o"

#: src/dist.py:96
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "передати --allow-dirty у meson dist (за замовчуванням: дозволити)"

#: src/dist.py:101
msgid "run tests during meson dist (default: --no-tests)"
msgstr "запускати тести під час meson dist (за замовчуванням: --no-tests)"

#: src/dist.py:418
msgid "build a source tarball (meson dist, or this project only)"
msgstr "зібрати вихідний tarball (meson dist або лише цей проєкт)"

#: src/dist.py:420
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. When ``.tarignore`` exists (gitignore-style), always pack the project tree and apply those excludes. Prints the archive path on stdout."
msgstr "Зібрати архів вихідного коду поточного проєкту zephyr (обхід від cwd до батьківських каталогів). Використовує meson dist, коли цей каталог — корінь git-проєкту; інакше пакує лише цей проєкт, щоб вкладені мовні шаблони не включали батьківський meta-repo. Виводить шлях архіву в stdout."

