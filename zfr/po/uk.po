msgstr "бюджет роботи: пропустити або передати -j окремо для авто (debuild/dpkg-buildpackage отримати чистий -j); -j N контактів загальний бюджет, розподілений між одночасно запланованими працівниками"

#: src/lang/_c_bas.py:187
msgid "no int main() in src/; skip bas i18n main checks"
msgstr "ніякого int main() у src/; перепустити головні перевірки басу i18n"

#: src/lang/_c_bas.py:208
#, python-format
msgid "main missing bas i18n setup: %s"
msgstr "головний налаштування бас i18n: %s"

#: src/lang/_c_bas.py:211
msgid "In main: #include <bas/locale/i18n.h> and <bas/proc/env.h>; const char *exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR from meson config.h). Run `zfr ize`."
msgstr "У головному: #include <bas/locale/i18n.h> і <bas/proc/env.h>; конст знак * exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR з meson налаштування.h). Запустити `zfr ize`."

#: src/lang/_c_bas.py:222
msgid "bas i18n main setup (self_exe + init_i18n)"
msgstr "головний налаштування bas i18n (self_exe + init_i18n)"

#: src/lang/_c_bas.py:233
msgid "no define_logger() in src/"
msgstr "немає define_logger() у src/"

#: src/lang/_c_bas.py:236
msgid "In one .c/.cpp: #include <bas/log/deflog.h> then define_logger(); libraries may use __attribute__((weak)) define_logger(); Run `zfr ize`."
msgstr "У одному .c/.cpp: #include <bas/log/deflog.h> потім define_logger(); бібліотеки можуть використовувати _attribute_( слав) define_logger(); Запустити `zfr ize`."

#: src/lang/_c_bas.py:250
msgid "define_logger() present"
msgstr "project() наявний"

#: src/lang/_c_bas.py:252
msgid "weak define_logger() present (library)"
msgstr "є weak define_logger() (бібліотека)"

#: src/lang/_c_bas.py:258
msgid "define_logger() without #include <bas/log/deflog.h>"
msgstr "define_logger () без #include <bas/log/deflog.h>"

#: src/lang/_c_bas.py:260
msgid "Add #include <bas/log/deflog.h> before define_logger();"
msgstr "Додати #include <bas/log/deflog.h> перед define_logger();"

#: src/lang/_c_bas.py:276
msgid "meson.build missing LOCALEDIR in config.h"
msgstr "meson.build не вдалося LOCALEDIR у налаштувані.h"

#: src/lang/_c_bas.py:279
msgid "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Run `zfr ize`."
msgstr "localedir = prefix / get_ option(localedir); config_h.set_quoted('LOCALEDIR', localedir); Запустити `zfr ize`."

#: src/lang/_c_bas.py:289
msgid "meson LOCALEDIR present"
msgstr "meson LOCALEDIR наявний"

