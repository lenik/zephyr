msgstr "будуватиме файл(-и) локального файла %d"

#: src/i18n/cmd.py:167
msgid "manage implemented gettext locales"
msgstr "керування запланованім локальами gettext"

#: src/i18n/cmd.py:169
msgid "List, add, delete, and build derived locales in the current project. Use zfr translate to query or update message strings."
msgstr "Список, додати, вилучити і збудувати позначені локальні локальки у поточному проекті. Використовувати zfr перекладатиметься для запитання або обновлення рядків повідомлень."

#: src/i18n/cmd.py:179
msgid "list all implemented locales in this project"
msgstr "список всіх виконуваних локаль у цьому проекті"

#: src/i18n/cmd.py:185
msgid "delete a locale (LINGUAS, .po, man/)"
msgstr "вилучити локальну локальну (LINGUAS, .po, docs/)"

#: src/i18n/cmd.py:191
msgid "add a new locale"
msgstr "додати новий локаль"

#: src/i18n/cmd.py:197
msgid "build derived locale PO/man files from parents (skip locales in LINGUAS)"
msgstr "збудувати потрібні локалі PO/man файли батьків (скриптувати локальні локалі у LINGUAS)"

#: src/i18n/cmd.py:202
msgid "output directory for derived .po files (default: build/po or $MESON_BUILD_ROOT/po)"
msgstr "каталог виводу для вихідних файлів .po (типовий: build/po або $MESON_BUILD_ROOT/po)"

#: src/i18n/cmd.py:207
msgid "write a stamp file listing derived paths (for Meson custom_target)"
msgstr "записати список файлів мімпів, показаних шляхів (до Meson custom_target)"

#: src/i18n/cmd.py:212
msgid "with --build, also msgfmt derived .po into LC_MESSAGES (for Meson)"
msgstr "з --build, також msgfmt приносений .po в LC_MESSAGES (до Meson)"

#: src/i18n/cmd.py:217
msgid "gettext domain for --compile-mo / --install-derived"
msgstr "Домен gettext для --compile-mo / --install-derived"

#: src/i18n/cmd.py:223
msgid "install derived .mo from --po-dir into $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"
msgstr "встановити .mo з --po-dir на $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"

#: src/i18n/cmd.py:231
msgid "with --install-derived, locale subdirectory under prefix (default: share/locale)"
msgstr "з --install-derived, підкаталогом локального каталогу під prefix (типовим: share/locale)"

#: src/i18n/cmd.py:233
msgid "with --build, print only"
msgstr "з --build, друк лише"

#: src/i18n/cmd.py:234
msgid "with --build, overwrite existing"
msgstr "з --build, перезаписати існує"

#: src/i18n/cmd.py:235
msgid "locale to inspect"
msgstr "локаль для перевірки"

#: src/i18n/cmd.py:241
msgid "--install-derived requires --po-dir and --domain"
msgstr "--install-derived вимагає --po-dir і --domain"

#: src/ize/__init__.py:76
msgid "refactor this project to current zephyr style"
msgstr "рефакторинг цього проєкту під поточний стиль zephyr"

#: src/ize/__init__.py:77
msgid "Refactor the current project to match current zephyr style: missing debian/rpm files, meson targets, AsciiDoc man pages, Meson version substitutions, and lint-level gettext coverage (LINGUAS + .po). Does not scaffold man/<locale> man translations. Walks from cwd toward parents."
msgstr "Рефакторинг поточного проєкту під поточний стиль zephyr: відсутні файли debian/rpm, цілі meson, man-сторінки AsciiDoc та підстановки версій Meson. Обхід від cwd до батьків."

#: src/ize/__init__.py:81
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "мовний шаблон для вирівнювання (за замовчуванням: detect; одна з: %s)"

#: src/ize/__init__.py:82
msgid "print planned changes without writing files"
msgstr "вивести заплановані зміни без запису файлів"

#: src/ize/__init__.py:87
msgid "list numbered ize standards (ZI*) as a table and exit"
msgstr "список значення з цифрового стандарта (ZI*) як таблиця і вийти"

#: src/ize/__init__.py:93
msgid "show details for ize standard NUM (e.g. ZI0015, 15) and exit"
msgstr "показувати подробиці для ize стандартного NUM (наприклад, ZI0015, 15) і вийти"

#: src/ize/__init__.py:100
msgid "bump patch version (debian/changelog + VERSION), git add -A, and commit ize changes with a verbose message"
msgstr "версія бурп-пласт (debian/changelog + VERSION), git додати -A, і змінити з діабором звістку"

#: src/ize/__init__.py:109
msgid "changelog author for --commit (Name or 'Name <email>'); default: reuse the previous debian/changelog trailer"
msgstr "автор запису за зміну --commit (Ім’ я або «Нема <email>»); типовий: використовувати попередній debian/changelog приєднання"

#: src/ize/__init__.py:113
msgid "also print skipped files"
msgstr "також вивести пропущені файли"

#: src/ize/__init__.py:119
msgid "run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr "запустити 2meson для перетворення Autotools/CMake на Meson за наявності (за замовчуванням: увімк.)"

#: src/ize/__init__.py:121
msgid "do not convert groff .1 man pages to man/*.adoc"
msgstr "не конвертувати man-сторінки groff .1 у docs/*.adoc"

#: src/ize/__init__.py:122
msgid "do not turn hardcoded versions/paths into @VERSION@/@PREFIX@ / config.h"
msgstr "не перетворювати захардкожені версії на @VERSION@ / config.h"

