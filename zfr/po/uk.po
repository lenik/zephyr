#: src/zfr_lib/dist.py:70
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "каталог збірки Meson (за замовчуванням: /build якщо відповідає цьому дереву вихідного коду, інакше <project>/build)"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "формат архіву (за замовчуванням: xz)"

