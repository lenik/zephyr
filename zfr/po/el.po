msgstr "επισήμανση CSR (console SGR) (προεπιλογή: auto)"

#: src/ize/__init__.py:151
#, python-format
msgid "unknown ize standard: %s"
msgstr "άγνωστο πρότυπο ize: %s"

#: src/ize/engine/__init__.py:86
msgid "not selected via --only"
msgstr "δεν επιλέχθηκε μέσω --only"

#: src/ize/engine/__init__.py:90
msgid "suppressed via -u/--uncheck"
msgstr "απενεργοποιήθηκε μέσω -u/--uncheck"

#: src/ize/engine/scripts.py:178
msgid "run_target('%s') → %s"
msgstr "run_target('%s') → scripts/%s.sh"

#: src/ize/engine/scripts.py:212
#, python-format
msgid "run_target('%s') → scripts/%s.sh"
msgstr "run_target('%s') → scripts/%s.sh"

#: src/jobs.py:30
msgid "job budget: omit or pass -j alone for auto (debuild/dpkg-buildpackage get bare -j); -j N pins a total budget split across concurrent planned workers"
msgstr "Προϋπολογισμός εργασίας: παραλείψτε ή περάστε μόνο το -j για το αυτοκίνητο (debuild/dpkg-buildpackage γυμνώστε το -j). -j Το N καρφιτσώνει έναν συνολικό προϋπολογισμό που κατανέμεται σε ταυτόχρονους προγραμματισμένους εργαζόμενους"

#: src/lang/_c_bas.py:187
msgid "no int main() in src/; skip bas i18n main checks"
msgstr "χωρίς int main() σε src/; ξεκινήστε κύριες ελέγχες bas i18n"

#: src/lang/_c_bas.py:208
#, python-format
msgid "main missing bas i18n setup: %s"
msgstr "κύριο χωρίς άλλο κατ' νύχτα bas i18n: %s"

#: src/lang/_c_bas.py:211
msgid "In main: #include <bas/locale/i18n.h> and <bas/proc/env.h>; const char *exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR from meson config.h). Run `zfr ize`."
msgstr "Στο κύριο: #include <bas/locale/i18n.h> και <bas/proc/env.h>; χαρακτήρα *exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR από meson configuration.h). Διαμερήστε `zfr ize`."

#: src/lang/_c_bas.py:222
msgid "bas i18n main setup (self_exe + init_i18n)"
msgstr "βασ i18n κύριο ρυθμίζιμα (self_exe + init_i18n)"

#: src/lang/_c_bas.py:233
msgid "no define_logger() in src/"
msgstr "δεν υπάρχει define_logger() στο src/"

#: src/lang/_c_bas.py:236
msgid "In one .c/.cpp: #include <bas/log/deflog.h> then define_logger(); libraries may use __attribute__((weak)) define_logger(); Run `zfr ize`."
msgstr "Σε ένα .c/.cpp: #include <bas/log/deflog.h> μετά define_logger(); τα βιβλιογραφικά μπορούν να χρησιμοποιούνται _attribute_((weak)) define_logger(); Διαμείνει `zfr ize`."

#: src/lang/_c_bas.py:250
msgid "define_logger() present"
msgstr "το project() υπάρχει"

#: src/lang/_c_bas.py:252
msgid "weak define_logger() present (library)"
msgstr "υπάρχει weak define_logger() (βιβλιοθήκη)"

#: src/lang/_c_bas.py:258
msgid "define_logger() without #include <bas/log/deflog.h>"
msgstr "define_logger() χωρίς #include <bas/log/deflog.h>"

