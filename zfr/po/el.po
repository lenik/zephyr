msgstr "po stats: %(translated)d/%(total)d μεταφοράς, %(missing)d λείπει"

#: src/i18n/cmd.py:75
msgid "no .po catalog in this project"
msgstr "χωρίς .po κατάλογο σε αυτό το έργο"

#: src/i18n/cmd.py:93
#, python-format
msgid "locale not found: %s"
msgstr "το λογαριασμό δεν βρήκε: %s"

#: src/i18n/cmd.py:147
#, python-format
msgid "would build %d derived locale file(s)"
msgstr "θα δημιουργήσει %d που προχωρήθηκε το αρχείο(ες)"

#: src/i18n/cmd.py:167
msgid "manage implemented gettext locales"
msgstr "χορηγήση εφαρμογής gettext λογαριασμού"

#: src/i18n/cmd.py:169
msgid "List, add, delete, and build derived locales in the current project. Use zfr translate to query or update message strings."
msgstr "Κατάλογος, προσθέτηση, αφήστευση και δημιουργείτε προσαρμογμένες λογαριασίες στο τρέχονιο έργο. Χρησιμοποιείτε zfr μεταφορά για να ζητήσ"

#: src/i18n/cmd.py:179
msgid "list all implemented locales in this project"
msgstr "κατάλογο όλων των εφαρμογμένων λογαριασμών σε αυτό το έργο"

#: src/i18n/cmd.py:185
msgid "delete a locale (LINGUAS, .po, man/)"
msgstr "άλλαξα ένα λογαριασμό (LINGUAS, .po, docs/)"

#: src/i18n/cmd.py:191
msgid "add a new locale"
msgstr "προστίθεται ένα νέο λογαριασμό"

#: src/i18n/cmd.py:197
msgid "build derived locale PO/man files from parents (skip locales in LINGUAS)"
msgstr "σχετικά με το χαρακτήρα PO/man από τους γονείς (χαλλικά λογαριασμού σε LINGUAS)"

#: src/i18n/cmd.py:202
msgid "output directory for derived .po files (default: build/po or $MESON_BUILD_ROOT/po)"
msgstr "Άγγελμα εκδοτής για τα αρχεία .po (αθροπείο: build/po ή $MESON_BUILD_ROOT/po)"

#: src/i18n/cmd.py:207
msgid "write a stamp file listing derived paths (for Meson custom_target)"
msgstr "γραφεί ένα κατάλογο αρχείων που προβλέπονται από τα τρόπο (από Meson custom_target)"

#: src/i18n/cmd.py:212
msgid "with --build, also msgfmt derived .po into LC_MESSAGES (for Meson)"
msgstr "με --build, επίσης msgfmt προσαρμογμένο .po σε LC_MESSAGES (από Meson)"

#: src/i18n/cmd.py:217
msgid "gettext domain for --compile-mo / --install-derived"
msgstr "Διαχείριση gettext για --compile-mo / --install-derived"

#: src/i18n/cmd.py:223
msgid "install derived .mo from --po-dir into $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"
msgstr "εγκαταστάσεις .mo από --po-dir σε $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"

#: src/i18n/cmd.py:231
msgid "with --install-derived, locale subdirectory under prefix (default: share/locale)"
msgstr "με --install-derived, υποκατακτήριο λογαριασμού υποχρεωτικά prefix (επιθύμητο: share/locale)"

#: src/i18n/cmd.py:233
msgid "with --build, print only"
msgstr "με --build, τύπο μόνο"

#: src/i18n/cmd.py:234
msgid "with --build, overwrite existing"
msgstr "με --build, ανεκτιμώνει ισχύος"

#: src/i18n/cmd.py:235
msgid "locale to inspect"
msgstr "θέση για επιθεωρήσεις"

#: src/i18n/cmd.py:241
msgid "--install-derived requires --po-dir and --domain"
msgstr "--install-derived απαιτεί --po-dir και --domain"

#: src/ize/__init__.py:76
msgid "refactor this project to current zephyr style"
msgstr "αναδιάρθρωση αυτού του έργου στο τρέχον στυλ zephyr"

#: src/ize/__init__.py:77
msgid "Refactor the current project to match current zephyr style: missing debian/rpm files, meson targets, AsciiDoc man pages, Meson version substitutions, and lint-level gettext coverage (LINGUAS + .po). Does not scaffold man/<locale> man translations. Walks from cwd toward parents."
msgstr "Αναδιαρθρώνει το τρέχον έργο σύμφωνα με το τρέχον στυλ zephyr: ελλείποντα αρχεία debian/rpm, στόχοι meson, σελίδες man AsciiDoc και αντικαταστάσεις έκδοσης Meson. Αναζήτηση προς τα πάνω από cwd."

#: src/ize/__init__.py:81
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "γλωσσικό πρότυπο προς ευθυγράμμιση (προεπιλογή: detect· ένα από: %s)"

#: src/ize/__init__.py:82
msgid "print planned changes without writing files"
msgstr "εκτύπωση προγραμματισμένων αλλαγών χωρίς εγγραφή αρχείων"

#: src/ize/__init__.py:87
msgid "list numbered ize standards (ZI*) as a table and exit"
msgstr "Λίστα αρχείων ισέ (ZI*) ως πίνακα και εξαγωγής"

#: src/ize/__init__.py:93
msgid "show details for ize standard NUM (e.g. ZI0015, 15) and exit"
msgstr "δείξτε λεπτομέρειες για το ισέ προτύπο NUM (π.χ. ZI0015, 15) και έξω"

#: src/ize/__init__.py:100
msgid "bump patch version (debian/changelog + VERSION), git add -A, and commit ize changes with a verbose message"
msgstr "τμήμα τροποποίηση (debian/changelog + VERSION), git προσθέτει -A και δεχτείτε αλλαγές με άλλο μήνυμα"

#: src/ize/__init__.py:109
msgid "changelog author for --commit (Name or 'Name <email>'); default: reuse the previous debian/changelog trailer"
msgstr "Υπογραφείς τροπολογίας για --commit (Ονομα ή 'Ονομα <email>'); προσδιορισμός: ανακατέργαζε το προηγούμενο τραβίλιο debian/changelog"

#: src/ize/__init__.py:113
msgid "also print skipped files"
msgstr "εκτύπωση και των παραλειφθέντων αρχείων"

#: src/ize/__init__.py:119
msgid "run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr "ξεκινήστε 2meson για να μετατροπεί Autotools/CMake σε Meson όταν παρουσιάζει (επιθύμητο: on)"

#: src/ize/__init__.py:121
msgid "do not convert groff .1 man pages to man/*.adoc"
msgstr "μη μετατρέπεις σελίδες man groff .1 σε docs/*.adoc"

#: src/ize/__init__.py:122
msgid "do not turn hardcoded versions/paths into @VERSION@/@PREFIX@ / config.h"
msgstr "μη μετατρέπεις σκληρά κωδικοποιημένες εκδόσεις σε @VERSION@ / config.h"

#: src/ize/__init__.py:129
msgid "suppress ize rule ID(s) or code(s), comma-separated (repeatable)"
msgstr "κατ' αυτήν την άποψη κανονισμού ή κωδικός(-α), κομμά -separated (καπανιστάθημα)"

#: src/ize/__init__.py:137
msgid "run only these ize rule ID(s) or code(s), comma-separated (repeatable)"
msgstr "κατ' αυτήν την άποψη κανονισμού ή κωδικός(-α), κομμά -separated (καπανιστάθημα)"

#: src/ize/__init__.py:139 src/lint/__init__.py:248
#: src/translate/__init__.py:223
