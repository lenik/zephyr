#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "εκτύπωση πληροφοριών τρέχοντος έργου (αναζήτηση προς τα πάνω από cwd)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Εκτυπώνει πληροφορίες για το τρέχον έργο zephyr (αναζήτηση προς τα πάνω από cwd). Χρώματα CSR όταν το stdout είναι TTY. Κοινά πεδία συσκευασίας αναλύονται από debian ή RPM."

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "εμφάνιση αναλυμένων πεδίων συσκευασίας Debian"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "εμφάνιση αναλυμένων πεδίων συσκευασίας RPM"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "επισήμανση CSR (console SGR) (προεπιλογή: auto = TTY και χωρίς NO_COLOR)"

#: src/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "δημιουργία puff(s) από το γλωσσικό πρότυπο"

#: src/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Ανιχνεύει τη γλώσσα και προσθέτει puff(s) από pkgdatadir/<lang>."

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "νέα ονόματα puff(s) (συνιστάται snake_case)"

#: src/build.py:15
msgid "detect build system and compile the project"
msgstr "εντοπίστε το σύστημα κατασκευής και μεταγλωττίστε το έργο"

#: src/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "Ανιχνεύστε το σύστημα οικοδόμησης έργου (meson, cmake, autotools, cargo, go, npm, make) και εκτελέστε μια τοπική μεταγλώττιση."

#: src/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "αλλάξτε σε DIR πριν τον εντοπισμό του συστήματος κατασκευής"

#: src/build.py:35
msgid "build directory (default: <project>/build)"
msgstr "Κατάλογος build Meson (προεπιλογή: /build όταν ταιριάζει με αυτό το δέντρο πηγαίου, αλλιώς <project>/build)"

#: src/build.py:42 src/package.py:120
msgid "print planned commands without running them"
msgstr "εκτύπωση προγραμματισμένων αλλαγών χωρίς εγγραφή αρχείων"

#: src/build.py:48
msgid "verbose build output where supported"
msgstr "εκτενής έξοδος κατασκευής όπου υποστηρίζεται"

#: src/build.py:53
msgid "print detected build system and exit"
msgstr "εκτύπωσε το ανιχνευμένο σύστημα κατασκευής και βγες"

#: src/build.py:58
msgid "preview files meson would install (DESTDIR tree; replaces scripts/look.sh)"
msgstr "προεπισκόπηση αρχείων που θα εγκαταστήσει το meson (δέντρο DESTDIR· αντικαθιστά scripts/look.sh)"

#: src/build.py:67
msgid "with --look, limit tree depth to N levels (implies --look; default is unlimited)"
msgstr "με --look, περιορισμός βάθους δέντρου σε N επίπεδα (υπονοεί --look· προεπιλογή απεριόριστο)"

#: src/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "εκτύπωσε ή διέγραψε σχόλια lint του έργου/χρήστη με υπόδειξη εργασίας AI"

#: src/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr "Τυπώστε σχόλια προτάσεων lint από .config/zfr/lint.comments (έργο) και ~/.config/zfr/lint.comments (χρήστη), στη συνέχεια μια υπόδειξη AI να εφαρμόσει τις προτάσεις και να διαγράψει τα αρχεία σχολίων που χρησιμοποιήθηκαν. Προαιρετικά, τα επιχειρήματα ZLxxxx φιλτράρουν ποιες ενότητες θα εμφανιστούν. Τυπικό μήνυμα: «λειτουργούν τα σχόλια zfr;»"

#: src/comments_cmd.py:35
msgid "only these rule ids (default: all)"
msgstr "bool κατώφλι 0-100 (προεπιλογή: %s)"

#: src/comments_cmd.py:42 src/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "κατάλογος έργου (προεπιλογή: ξεκινά από τον τρέχοντα κατάλογο εργασίας)"

#: src/comments_cmd.py:49
msgid "user comments only (~/.config/zfr/lint.comments)"
msgstr "μόνο σχόλια χρηστών (~/.config/zfr/lint.comments)"

#: src/comments_cmd.py:55
msgid "project comments only (.config/zfr/lint.comments)"
msgstr "μόνο σχόλια έργου (.config/zfr/lint.comments)"

#: src/comments_cmd.py:61
msgid "delete matching comments (files or selected sections)"
msgstr "διαγραφή ταιριαστών σχολίων (αρχείων ή επιλεγμένων τμημάτων)"

#: src/comments_cmd.py:67
msgid "omit the AI hint trailer"
msgstr "παράλειψη του προωθητικού υλικού υπόδειξης τεχνητής νοημοσύνης"

#: src/comments_cmd.py:93
msgid "No matching lint.comments to delete."
msgstr "Δεν βρέθηκαν αντίστοιχα lint.comments για διαγραφή."

#: src/comments_cmd.py:96
msgid "Deleted: %s"
msgstr "υπάρχει: %s"

#: src/create.py:287
msgid "create a new project from a language template"
msgstr "δημιουργία νέου έργου από γλωσσικό πρότυπο"

#: src/create.py:288
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "Δημιουργεί νέο κατάλογο έργου από pkgdatadir/<lang>."

#: src/create.py:295
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "γλώσσα προτύπου (προεπιλογή: python· ένα από: %s)"

#: src/create.py:299
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "διανομή debian changelog (προεπιλογή: %s)"

#: src/create.py:303
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "αρχική έκδοση πακέτου και ετικέτα git (προεπιλογή: %s)"

#: src/create.py:307
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "όνομα συγγραφέα changelog/git (προεπιλογή: %s)"

#: src/create.py:311
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "email συγγραφέα changelog/git (προεπιλογή: %s)"

#: src/create.py:317
msgid "do not instantiate a default puff (leave some_puff1 tokens for a later zfr add)"
msgstr "μην δημιουργήσεις μια προεπιλεγμένη φούσκα (άφησε μερικά tokens some_puff1 για μια μελλοντική προσθήκη zfr)"

#: src/create.py:321
msgid "new project directory name"
msgstr "όνομα νέου καταλόγου έργου"

#: src/create.py:325
msgid "puff names (default: one puff named like the package; use --no-puff for none)"
msgstr "ονόματα puff (προεπιλογή: ένα puff με το ίδιο όνομα όπως η συσκευασία· χρησιμοποιήστε --no-puff για κανένα)"

#: src/detect.py:15
msgid "print detected language for the current directory"
msgstr "εκτύπωση ανιχνευμένης γλώσσας για τον τρέχοντα κατάλογο"

#: src/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "Εκτυπώνει την ανιχνευμένη γλώσσα του τρέχοντος έργου και λεπτομέρειες διάταξης στο stderr."

#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "εγγραφή αρχείου σε DIR (προεπιλογή: meson-dist ή %_topdir/SOURCES ($HOME/rpmbuild) με --rpm)"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "Κατάλογος build Meson (προεπιλογή: /build όταν ταιριάζει με αυτό το δέντρο πηγαίου, αλλιώς <project>/build)"

#: src/dist.py:81
msgid "archive format (default: xz)"
msgstr "μορφή αρχείου (προεπιλογή: xz)"

#: src/dist.py:87
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "ονομάζει το αρχείο NAME-VERSION.tar.xz και το γράφει σε %_topdir/SOURCES ($HOME/rpmbuild), εκτός αν δοθεί -o"

#: src/dist.py:96
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "περνά --allow-dirty στο meson dist (προεπιλογή: επιτρέπεται)"

#: src/dist.py:101
msgid "run tests during meson dist (default: --no-tests)"
msgstr "εκτέλεση δοκιμών κατά meson dist (προεπιλογή: --no-tests)"

#: src/dist.py:418
msgid "build a source tarball (meson dist, or this project only)"
msgstr "δημιουργία tarball πηγαίου κώδικα (meson dist ή μόνο αυτό το έργο)"

#: src/dist.py:420
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. When ``.tarignore`` exists (gitignore-style), always pack the project tree and apply those excludes. Prints the archive path on stdout."
msgstr "Δημιουργεί αρχείο πηγαίου του τρέχοντος έργου zephyr (αναζήτηση προς τα πάνω από cwd). Χρησιμοποιεί meson dist όταν αυτός ο κατάλογος είναι η ρίζα git έργου· αλλιώς πακετάρει μόνο αυτό το έργο, ώστε τα ένθετα γλωσσικά πρότυπα να μην συμπεριλαμβάνουν το γονικό meta-repo. Εκτυπώνει τη διαδρομή αρχείου στο stdout."

#: src/i18n/cmd.py:42
