#: src/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "afficher ou supprimer les lint.comments projet/utilisateur avec une indication de travail pour l’IA"

#: src/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr "Affiche les commentaires de suggestion lint depuis .config/zfr/lint.comments (projet) et ~/.config/zfr/lint.comments (utilisateur), puis une indication IA pour appliquer les suggestions et supprimer les fichiers de commentaires consommés. Les arguments ZLxxxx optionnels filtrent les sections à afficher. Invite typique : « do zfr-comments work. »"

#: src/comments_cmd.py:35
msgid "only these rule ids (default: all)"
msgstr "seuil bool 0-100 (par défaut : %s)"

#: src/comments_cmd.py:42 src/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "répertoire du projet (par défaut : remonter depuis le cwd)"

