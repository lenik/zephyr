#: src/zfr:51
msgid "Zephyr template helper (CLI name: zfr). Create projects and manage example puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr "Assistant de modèles Zephyr (nom CLI : zfr). Créer des projets et gérer les puffs d'exemple. Les arbres instanciés continuent d'appeler zfr ; zfr n'est pas un jeton de renommage."

#: src/zfr:66
msgid "show this help"
msgstr "afficher cette aide"

#: src/zfr_lib/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "afficher les informations du projet actuel (remonte les parents depuis cwd)"

#: src/zfr_lib/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Afficher les informations sur le projet zephyr actuel (remonte depuis cwd vers les répertoires parents). Couleurs CSR lorsque stdout est un TTY. Les champs d'empaquetage courants sont lus depuis debian ou RPM."

#: src/zfr_lib/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "afficher les champs d'empaquetage Debian analysés"

#: src/zfr_lib/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "afficher les champs d'empaquetage RPM analysés"

#: src/zfr_lib/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "colorisation CSR (console SGR) (par défaut : auto = TTY et pas de NO_COLOR)"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "instancier des puff(s) à partir du modèle de langue"

