msgstr "மொழி வார்ப்புருவிலிருந்து rpm/ நகலெடுக்கவும்; spec-ஐத் தொகுப்புப் பெயரில் வைக்கவும் (rpm/<Source>.spec, zephyr.spec அல்ல) மற்றும் `zfr version` பயன்படுத்தும் Makefile வைத்திருக்கவும். Name/Summary/Requires/URL-ஐ debian/control-உடன் சீரமைக்கவும். அல்லது `zfr ize` இயக்கவும்."

#: src/zfr_lib/lint/rpm.py:72
msgid "packaging/rpm/Makefile uses project-local <project>/rpmbuild; zephyr style uses %_topdir ($HOME/rpmbuild, override via ~/.rpmmacros)"
msgstr "packaging/rpm/Makefile திட்டத்தை -local <project>/rpmbuild பயன்படுத்துவது; zephyr பாணி %_topdir ($HOME/rpmbuild, ~/.rpmmacros மொத்தமாக மேல் மேல் மேல் செய்துவிடும்)"

#: src/zfr_lib/lint/rpm.py:80
#, python-brace-format
msgid ""
"TOPDIR ?= $(shell rpm --eval '%{_topdir}' 2>/dev/null)\n"
"ifeq ($(strip $(TOPDIR)),)\n"
"TOPDIR := $(HOME)/rpmbuild\n"
"endif\n"
"And make clean remove only this package's artifacts (not rm -rf $(TOPDIR)). Or run `zfr ize`."
msgstr "TOPDIR ?= $(shell rpm --eval '%{_topdir}' 2>/dev/null), ifeq ($(strip $(TOPDIR)), TOPDIR := $(HOME)/rpmbuild entif ? மற்றும் இந்த தொகுப்புகளின் காட்சிகளை மட்டுமே நீக்கவும் (rm -rf $(TOPDIR) இல்லை). அல்லது `zfr ize` இயக்கு."

#: src/zfr_lib/lint/rpm.py:95
#, no-python-format
msgid "packaging/rpm/Makefile TOPDIR uses %_topdir / $HOME/rpmbuild"
msgstr "packaging/rpm/Makefile TOPDIR %_topdir / $HOME/rpmbuild பயன்படுத்துகிறது"

#: src/zfr_lib/lint/rpm.py:105
msgid "packaging/rpm/Makefile `clean` does rm -rf $(TOPDIR); unsafe when TOPDIR is $HOME/rpmbuild"
msgstr "packaging/rpm/Makefile `clean` rm -rf $(TOPDIR); TOPDIR $HOME/rpmbuild போது அச்சுறுத்தப்படும்"

#: src/zfr_lib/lint/rpm.py:111
msgid "Remove only this package's SPECS/SOURCES/RPMS/SRPMS/BUILD/BUILDROOT entries under $(TOPDIR). Or run `zfr ize`."
msgstr "இந்த தொகுப்பு SPECS/SOURCES/RPMS/SRPMS/BUILD/BUILDROOT என்பதை $(TOPDIR) கீழ் மட்டுமே நீக்கு. அல்லது `zfr ize` இயக்கு."

#: src/zfr_lib/lint/rpm.py:124
msgid "project-local rpmbuild/ directory present; builds should use %_topdir ($HOME/rpmbuild)"
msgstr "திட்டம் -local rpmbuild/ அடைவு உள்ளது; கட்டியல்கள் %_topdir ($HOME/rpmbuild) பயன்படுத்த வேண்டும்"

#: src/zfr_lib/lint/rpm.py:128
msgid "Remove rpmbuild/ after migrating; safe to delete."
msgstr "மாற்றி வரும் பிறகு rpmbuild/ நீக்கு; நீக்க பாதுகாப்பானது."

#: src/zfr_lib/lint/rpm.py:139
#, no-python-format, python-brace-format
msgid "spec Version is dynamic %{version}"
msgstr "spec Version மாறும் %{version}"

#: src/zfr_lib/lint/rpm.py:148
msgid "spec Version is hardcoded; zephyr style injects `zfr version`"
msgstr "spec Version நிலையாக எழுதப்பட்டுள்ளது; zephyr பாணி `zfr version` செலுத்தும்"

#: src/zfr_lib/lint/rpm.py:153
msgid "Use Version: %{version} with %{!?version:%global version 0.0.0} and freeze via packaging/rpm/Makefile (`zfr version` / `zfr version -r`)."
msgstr "Version: %{version}-ஐ %{!?version:%global version 0.0.0}-உடன் பயன்படுத்தி rpm/Makefile வழியாக நிலைநிறுத்தவும் (`zfr version` / `zfr version -r`)."

#: src/zfr_lib/lint/rpm.py:161
msgid "License {}"
msgstr "உரிமம் %s"

#: src/zfr_lib/lint/rpm.py:168
msgid "spec License is not AGPL-3.0-or-later"
msgstr "spec License AGPL-3.0-or-later அல்ல"

#: src/zfr_lib/lint/rpm.py:171
msgid "License:        {}"
msgstr "License:        %s"

#: src/zfr_lib/lint/rpm.py:182
msgid "spec URL={!r} != debian Homepage={!r}"
msgstr "spec URL=%(url)r != debian Homepage=%(homepage)r"

#: src/zfr_lib/lint/rpm.py:186
msgid "Set URL: to the same Homepage as debian/control."
msgstr "URL:-ஐ debian/control-இன் Homepage-உடன் ஒன்றாக அமைக்கவும்."

#: src/zfr_lib/lint/rpm.py:198
msgid "spec Summary does not match debian Description first line"
msgstr "spec Summary debian Description முதல் வரியுடன் பொருந்தவில்லை"

#: src/zfr_lib/lint/rpm.py:201
msgid "Summary:        {}"
msgstr "Summary:        %s"

#: src/zfr_lib/lint/rpm.py:207
msgid "spec uses Meson (not autotools)"
msgstr "spec Meson பயன்படுத்துகிறது (autotools அல்ல)"

#: src/zfr_lib/lint/rpm.py:214
msgid "spec still uses autotools; zephyr packages build with Meson"
msgstr "spec இன்னும் autotools பயன்படுத்துகிறது; zephyr தொகுப்புகள் Meson கொண்டு கட்டப்படும்"

#: src/zfr_lib/lint/rpm.py:218
#, python-brace-format
msgid ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"
msgstr ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"

#: src/zfr_lib/lint/rpm.py:231
msgid "Makefile uses `zfr version`"
msgstr "Makefile `zfr version` பயன்படுத்துகிறது"

#: src/zfr_lib/lint/rpm.py:240
msgid "packaging/rpm/Makefile does not call `zfr version`"
msgstr "rpm/Makefile `zfr version`-ஐ அழைக்கவில்லை"

#: src/zfr_lib/lint/rpm.py:244
msgid ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"
msgstr ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"

#: src/zfr_lib/lint/rpm.py:254
msgid "no packaging/rpm/Makefile convenience targets"
msgstr "rpm/Makefile-இல் வசதி இலக்குகள் இல்லை"

#: src/zfr_lib/lint/rpm.py:256
msgid "Copy bash/packaging/rpm/Makefile (srpm/rpm via zfr version)."
msgstr "bash/rpm/Makefile நகலெடுக்கவும் (srpm/rpm zfr version வழியாக)."

#: src/zfr_lib/lint/rpm.py:268
msgid "bash-shlib used in sources but missing from Requires"
msgstr "bash-shlib மூலங்களில் பயன்படுத்தப்பட்டது ஆனால் Requires இல்லை"

#: src/zfr_lib/lint/rpm.py:270
msgid "Requires:       bash-shlib  (same as debian Depends)"
msgstr "Requires:       bash-shlib  (debian Depends போல)"

#: src/zfr_lib/lint/rpm.py:284
msgid "{} still contains Debian ${{…}} substvars (rpmbuild treats them as literal deps)"
msgstr "{} இப்போது டெபியன் ${{…}} ஸ்பஸ்ட்வர்ஸ் உள்ளது (rpmbuild அவற்றை உண்மை டிப்ஸ் என கருதிக்கிறது)"

#: src/zfr_lib/lint/rpm.py:290
msgid "Strip ${misc:Depends} / ${shlibs:Depends} etc. (or run `zfr ize`)."
msgstr "${misc:Depends} / ${shlibs:Depends} மற்றும் மற்றும் (அதாவது `zfr ize` இயக்கு)."

#: src/zfr_lib/lint/rpm.py:305
msgid "BuildArch: noarch but Meson has executable(); rpmbuild rejects arch-dependent binaries in a noarch package"
msgstr "BuildArch: noarch ஆனால் Meson காணப்படும் (); rpmbuild ஒரு noarch தொகுதியில் பெருக்கல் -dependent பெயர்களை மறுக்கிறது"

#: src/zfr_lib/lint/rpm.py:312
#, python-brace-format
msgid "Remove BuildArch: noarch (and %global debug_package %{nil} if present). Or run `zfr ize`."
msgstr "BuildArch: noarch (மற்றும் %global debug_package %{nil} இல்லையானால்) நீக்கு. அல்லது `zfr ize` இயக்கு."

#: src/zfr_lib/lint/rpm.py:326
#, python-brace-format
msgid "%global debug_package %{nil} on a package with Meson executable() — debuginfo would be useful"
msgstr "Meson executable() - debuginfo கொண்டு ஒரு தொகுதியில் %global debug_package %{nil} பயனுள்ளது"

#: src/zfr_lib/lint/rpm.py:331
#, no-python-format, python-brace-format
msgid "Drop %global debug_package %{nil} for ELF packages."
msgstr "ELF தொகுப்புகளுக்கு %global debug_package %{nil} இழுத்து"

#: src/zfr_lib/lint/rpm.py:344
#, python-format
msgid "script-only package lacks BuildArch: noarch; rpmbuild then builds an empty debuginfo and fails (Empty %files file debugfiles.list)"
msgstr "ஸ்கிப்ட்-only தொகுப்பு BuildArch இல்லை: noarch; rpmbuild பிறகு வெற்று debuginfo கட்டும் தோல்வியுற்றது (காலியான %files கோப்பு வழுநீக்கு கோப்புகள்.list)"

#: src/zfr_lib/lint/rpm.py:352
#, python-brace-format
msgid "Add `BuildArch: noarch` and `%global debug_package %{nil}` (or run `zfr ize`)."
msgstr "`BuildArch: noarch` மற்றும் `%global debug_package %{nil}` (அதாவது `zfr ize` இயக்கு)."

#: src/zfr_lib/lint/rpm.py:364
#, python-format
msgid "RPM %files still lists template puff {}"
msgstr "RPM %files இப்போது பிஃப் {} வார்ப்புரு பட்டியல்கள்"

#: src/zfr_lib/lint/rpm.py:370
msgid "Replace {} with real command names (or run `zfr ize`)."
msgstr "{} ஐ உண்மையான கட்டளை பெயர்களுடன் மாற்றுக (அதாவது `zfr ize` இயக்கு)."

#: src/zfr_lib/lint/rpm.py:383
#, no-python-format
msgid "%files covers gettext .mo catalogs Meson installs"
msgstr "%files gettext .mo கருவிகள் Meson நிறுவப்படுகிறது"

#: src/zfr_lib/lint/rpm.py:394
#, python-format
msgid "%files omits gettext .mo; rpmbuild will reject unpackaged locale/*/LC_MESSAGES/*.mo after meson install"
msgstr "%files gettext .mo; rpmbuild நிறுவப்பட்ட பின் meson பிறகு துண்டுபட்ட locale/*/LC_MESSAGES/*.mo ஐ நிறுத்துவதில்லை"

#: src/zfr_lib/lint/rpm.py:401
#, python-brace-format
msgid "%{_datadir}/locale/*/LC_MESSAGES/<domain>.mo  (i18n.gettext domain, not always the project name). Or run `zfr ize`."
msgstr "%{_datadir}/locale/*/LC_MESSAGES/<domain>.mo (i18n.gettext டோமென், எப்போதும் திட்ட பெயர் அல்ல). அல்லது `zfr ize` இயக்கு."

#: src/zfr_lib/lint/rpm.py:417
#, no-python-format
msgid "%files covers locale man pages Meson installs"
msgstr "%files இடம் மனி பக்கங்கள் Meson நிறுவுகிறது"

#: src/zfr_lib/lint/rpm.py:428
#, python-format
msgid "%files omits locale mans; rpmbuild will reject unpackaged $mandir/<locale>/manN pages after meson install"
msgstr "%filesஇடம் மனிதர்களை விட்டுவிடும்;rpmbuildபிடித்த டாலர் மாற்றப்படும்mandir/<locale>/manNபக்கங்கள் பின்mesonநிறுவவும்"

#: src/zfr_lib/lint/rpm.py:435
#, fuzzy, python-brace-format
msgid "%{_mandir}/*/man1/<cmd>.1*  (man/<lang>/*.adoc). Or run `zfr ize`."
msgstr "%{_mandir}/*/man1/<cmd>.1* (docs/<lang>/*.adoc). அல்லது `zfr ize` இயக்கு."

#: src/zfr_lib/lint/rpm.py:457
#, no-python-format
msgid "%files covers datadir/setup scripts Meson installs"
msgstr "%files datadir/setup ஸ்கிரிப்ட் Meson நிறுவுகிறது"

#: src/zfr_lib/lint/rpm.py:468
#, python-format
msgid "%files omits datadir/setup/*; rpmbuild will reject unpackaged postinst/prerm after meson install"
msgstr "%files datadir/setup/* காணப்படும்; rpmbuild meson நிறுவப்பட்ட பின் பிறகு குறைந்தது postinst/prerm ஐ நிறுத்து"

#: src/zfr_lib/lint/rpm.py:474
#, no-python-format, python-brace-format
msgid "%{_datadir}/setup/%{name}/  (or run `zfr ize`)."
msgstr "%{_datadir}/setup/%{name}/ (அதாவது `zfr ize` இயக்கு)."

#: src/zfr_lib/lint/rpm.py:509
#, python-format, python-brace-format
msgid "%files is missing paths Meson installs: {preview}{more} (rpmbuild will fail with unpackaged or File not found)"
msgstr "%files இல்லை பாதைகள் Meson நிறுவுகிறது: {preview}{more} (rpmbuild குறுக்கப்படும் அல்லது கோப்பு காணப்படவில்லை)"

#: src/zfr_lib/lint/rpm.py:516
#, python-format
msgid "Rewrite %files from Meson install rules (bindir, completions, manN, pkgdata, perl5, includedir, sysconfdir, shlib.d, setup/). Or run `zfr ize`."
msgstr "Meson இல் %files விதிகளை நிறுவுக (bindir, முடிவுகள், manN, pkgdata, perl5, includedir, sysconfdir, shlib.d, setup/) ஐ மீண்டும் எழுது. அல்லது `zfr ize` இயக்கு."

#: src/zfr_lib/lint/rpm.py:530
#, python-format
msgid "%files covers Meson install set ({} entries)"
msgstr "%files Meson அமைப்பு நிறுவுகிறது ({} உள்ளீடுகள்)"

#: src/zfr_lib/lint/rpm.py:548
#, python-brace-format
msgid "%files lists %{_datadir}/%{name}/ but Meson does not install package data there (Directory not found)"
msgstr "%files %{_datadir}/%{name}/ ஆனால் Meson தொகுப்பு தரவை அங்கு நிறுவு செய்யவில்லை (அடைவு காணவில்லை)"

