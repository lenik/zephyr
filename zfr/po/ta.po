#: src/zfr_lib/lint/i18n_check.py:127
#, python-format
msgid "Level %(level)s requires primaries: %(locales)s (source %(source)s; legacy es→es_MX, pt→pt_BR). Run `zfr i18n -b` to auto-generate child locales."
msgstr "நிலை %(level)s தேவை: %(locales)s (மூலம் %(source)s; zh-cn→zh_CN, zh-tw→zh_TW). விடுபட்ட வரிகளை LINGUAS-இல் சேர்த்து பொருந்தும் po/<locale>.po சேர்க்கவும்."

#: src/zfr_lib/lint/i18n_check.py:142
#, python-format
msgid "po/LINGUAS covers %s primary locale set"
msgstr "po/LINGUAS %s மொழிக்கூறு தொகுப்பை உள்ளடக்குகிறது"

#: src/zfr_lib/lint/i18n_check.py:159
