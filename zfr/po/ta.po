#: src/zfr_lib/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "நடப்புத் திட்டத் தகவலைக் காட்டு (நடப்பு அடைவிலிருந்து மேலே தேடும்)"

#: src/zfr_lib/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "நடப்பு zephyr திட்டத் தகவலைக் காட்டுகிறது (நடப்பு அடைவிலிருந்து மேல் அடைவுகளைத் தேடும்). stdout முனையம் என்றால் CSR நிறங்கள். பொதுவான தொகுப்புப் புலங்கள் debian அல்லது RPM-இலிருந்து படிக்கப்படும்."

#: src/zfr_lib/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "Debian தொகுப்புப் புலங்களைக் காட்டு"

#: src/zfr_lib/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "RPM தொகுப்புப் புலங்களைக் காட்டு"

#: src/zfr_lib/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (கன்சோல் SGR) நிறம் (இயல்பு: auto = முனையம் மற்றும் NO_COLOR இல்லை)"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "மொழி வார்ப்புருவிலிருந்து puff-களைச் சேர்"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "மொழியைக் கண்டுபிடித்து pkgdatadir/<lang>-இலிருந்து puff-களைச் சேர்."

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "புதிய puff பெயர்கள் (snake_case பரிந்துரை)"

#: src/zfr_lib/build.py:15
msgid "detect build system and compile the project"
msgstr "கட்டுமான அமைப்பை கண்டறிந்து திட்டத்தை திருத்தவும்"

#: src/zfr_lib/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "திட்ட உருவாக்கும் அமைப்பை (meson, cmake, autotools, cargo, go, npm, make) கண்டறிந்து உள்ளூர் தொகுப்பை இயக்குங்கள்."

#: src/zfr_lib/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "பில்டு சிஸ்டத்தை கண்டறியும்முன் DIRக்கு மாற்றவும்"

#: src/zfr_lib/build.py:35
#, fuzzy
msgid "build directory (default: <project>/build)"
msgstr "Meson உருவாக்க அடைவு (இந்த மூல மரத்துக்குப் பொருந்தினால் இயல்பு /build, இல்லையெனில் <project>/build)"

#: src/zfr_lib/build.py:42 src/zfr_lib/package.py:120
#, fuzzy
msgid "print planned commands without running them"
msgstr "கோப்புகளை எழுதாமல் திட்டத்தைக் காட்டு"

#: src/zfr_lib/build.py:48
msgid "verbose build output where supported"
msgstr "ஆதரிக்கப்படும் இடங்களில் விரிவான கட்டுமான வெளியீடு"

#: src/zfr_lib/build.py:53
msgid "print detected build system and exit"
msgstr "பிடிக்கப்பட்ட கட்டமைப்பு முறைமையை அச்சிடி வெளியேறு"

#: src/zfr_lib/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "AI வேலை குறிப்பு கொண்டு திட்டம்/பயனர் lint.comments ஐ அச்சிடவோ அல்லது நீக்கவோ செய்யவும்"

#: src/zfr_lib/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr ".config/zfr/lint.comments (ப்ராஜெக்ட்) மற்றும் ~/.config/zfr/lint.comments (பயனர்) என்ற இடங்களில் இருந்து லின்ட் பரிந்துரை கருத்துக்களை அச்சிடுக, அதன் பிறகு பரிந்துரைகளை பயன்படுத்துவதற்கான ஒரு AI குறிப்பு மற்றும் பயன்படுத்தப்பட்ட கருத்துக் கோப்புகளை நீக்குக. விருப்பமான ZLxxxx_arguments எந்த பகுதிகளை காட்டுவது என்பதை வடிகட்டுகிறது. சாதாரண உத்தரவு: “do zfr-comments work.”"

#: src/zfr_lib/comments_cmd.py:35
#, fuzzy
msgid "only these rule ids (default: all)"
msgstr "பூலியன் வரம்பு 0–100 (இயல்பு: %s)"

#: src/zfr_lib/comments_cmd.py:42 src/zfr_lib/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "திட்ட அடைவை (இயல்புநிலை: தற்போதைய வேலை அடைவிலிருந்து நடைபயணம்)"

#: src/zfr_lib/comments_cmd.py:49
msgid "user comments only (~/.config/zfr/lint.comments)"
msgstr "பயனர் கருத்துக்கள் மட்டும் (~/.config/zfr/lint.comments)"

#: src/zfr_lib/comments_cmd.py:55
msgid "project comments only (.config/zfr/lint.comments)"
msgstr "திட்ட குறிக்கோள் மட்டும் (.config/zfr/lint.comments)"

#: src/zfr_lib/comments_cmd.py:61
msgid "delete matching comments (files or selected sections)"
msgstr "இணைமையான கருத்துகளை நீக்கு (கோப்புகள் அல்லது தேர்ந்தெடுக்கப்பட்ட பகுதிகள்)"

#: src/zfr_lib/comments_cmd.py:67
msgid "omit the AI hint trailer"
msgstr "ஏ.ஐ. குறிப்பு டிரெய்லரை தவிர்க்கவும்"

#: src/zfr_lib/comments_cmd.py:93
msgid "No matching lint.comments to delete."
msgstr "அணைத்து அழிக்க பொருந்தும் lint.comments எதுவும் இல்லை."

#: src/zfr_lib/comments_cmd.py:96
#, fuzzy, python-format
msgid "Deleted: %s"
msgstr "உள்ளது: %s"

#: src/zfr_lib/create.py:287
