#: src/zfr_lib/translate/__init__.py:143
msgid "Look up translations for TEXT across implemented locales, or update a single locale catalog. Remaining arguments are joined with spaces."
msgstr "TEXT மொழிபெயர்ப்புகளை செயல்படுத்தப்பட்டுள்ள இடங்களில் தேடவும், அல்லது ஒரு ஒரே இட பட்டியலை புதுப்பிக்கவும். மீண்டும் குறும்படம் இடைவெளிகளுடன் சேர்க்கப்பட்டுள்ளது."

#: src/zfr_lib/translate/__init__.py:155
msgid "use poedit to import edits from FILE"
msgstr "கோப்பு இருந்து திருத்துவதை இறக்குமதி செய்ய poedit ஐ பயன்படுத்து"

#: src/zfr_lib/translate/__init__.py:161
