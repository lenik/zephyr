msgid "Remove the empty pkgdata line (Java template leftover). Or run `zfr ize`."
msgstr "வெற்று pkgdata வரி (Java வார்ப்புரு மீண்டும்) நீக்கு. அல்லது `zfr ize` இயக்கு."

#: src/zfr_lib/lint/rpm.py:580
#, python-format
msgid "%files lists completion {listed!r} but Meson installs {want!r} (File not found)"
msgstr "%files முடிவு {listed!r} ஆனால் Meson நிறுவுகிறது {want!r} (கோப்பு காணப்படவில்லை)"

#: src/zfr_lib/lint/rpm.py:586
msgid "Use the installed basename ({}). Or run `zfr ize`."
msgstr "நிறுவப்பட்ட அடிப்படை பெயரை பயன்படுத்து ({}) அல்லது `zfr ize` இயக்கு"

#: src/zfr_lib/lint/scripts_check.py:171
#, python-format
msgid "VERSION/PROJECT_VERSION substituted and used in %s"
msgstr "பதிப்பு/PROJECT_VERSION மாற்றி %s இல் பயன்படுத்தப்பட்டது"

#: src/zfr_lib/lint/scripts_check.py:180
msgid "meson configures VERSION/PROJECT_VERSION but no source uses it"
msgstr "meson VERSION/PROJECT_VERSION ஐ கட்டமைக்கிறது ஆனால் எதும் அதை பயன்படுத்துவதில்லை"

#: src/zfr_lib/lint/scripts_check.py:183
msgid "Reference @VERSION@ (scripts → *.in + configure_file) or PROJECT_VERSION from config.h in at least one source. Or run `zfr ize`."
msgstr "குறிப்பு @VERSION@ (scripts → *.in + configure_file) அல்லது குறைந்தது ஒரு மூலத்தில் config.h இருந்து PROJECT_VERSION. அல்லது `zfr ize` இயக்கவும்."

#: src/zfr_lib/lint/scripts_check.py:194
msgid "sources use @VERSION@/PROJECT_VERSION but meson does not substitute it"
msgstr "மூலங்கள் @VERSION@/PROJECT_VERSION என்பதனை பயன்படுத்துகின்றன ஆனால் மெசான் அதைக் மாற்றவில்லை"

#: src/zfr_lib/lint/scripts_check.py:197
msgid "Add configuration_data set('VERSION', …) / set_quoted('PROJECT_VERSION', …) and configure_file. Or run `zfr ize`."
msgstr "configuration_data set('VERSION', …) / set_quoted('PROJECT_VERSION', …) மற்றும் configure_file சேர்க்கவும். அல்லது `zfr ize` இயக்கவும்."

#: src/zfr_lib/lint/scripts_check.py:208
msgid "no Meson VERSION/PROJECT_VERSION substitution found"
msgstr "Meson பதிப்பு/PROJECT_VERSION பிரதিস্থாபனை கண்டுபிடிக்க முடியவில்லை"

#: src/zfr_lib/lint/scripts_check.py:211
msgid "Wire meson configuration_data for VERSION and use it in a source. Or run `zfr ize`."
msgstr "VERSION க்காக மின்னுயிர்மாம் configuration_data ஐ பயன்படுத்தி அதை ஒரு மூலத்தில் பயன்படுத்தவும். அல்லது `zfr ize` ஐ இயக்கவும்."

#: src/zfr_lib/lint/scripts_check.py:233
msgid "po/ present but no run_target('posync')"
msgstr "po/ தற்போது உள்ளது ஆனால் run_target('posync') இல்லை"

#: src/zfr_lib/lint/scripts_check.py:235
msgid "Add run_target posync calling scripts/posync.sh. Or run `zfr ize`."
msgstr "scripts/posync.sh. ஐ அழைக்கும் run_target posync ஐச் சேர்க்கவும் அல்லது `zfr ize` ஐ இயக்கவும்."

#: src/zfr_lib/lint/scripts_check.py:245
msgid "posync externalized as scripts/posync.sh"
msgstr "posync scripts/posync.sh என வெளிப்படுத்தப்பட்டது"

#: src/zfr_lib/lint/scripts_check.py:254
msgid "scripts/posync.sh exists but meson posync does not call it"
msgstr "scripts/posync.sh உள்ளது ஆனால் மெசான் போசாய்ன்க் அதை அழைக்காது"

#: src/zfr_lib/lint/scripts_check.py:256
msgid "Point run_target('posync') at scripts/posync.sh. Or run `zfr ize`."
msgstr "புள்ளி run_target('posync') இல் scripts/posync.sh. அல்லது ஓடு `zfr ize`."

#: src/zfr_lib/lint/scripts_check.py:263
msgid "posync is inline in meson.build; externalize to scripts/posync.sh"
msgstr "posync என்பது meson.build இல் நேரடியாகச் செயற்படுகிறது; scripts/posync.sh க்கு வெளிப்படுத்தவும்"

