#: src/zfr_lib/lint/i18n_check.py:103
msgid "po/ exists but po/LINGUAS is missing or empty"
msgstr "po/ உள்ளது ஆனால் po/LINGUAS இல்லை அல்லது காலி"

#: src/zfr_lib/lint/i18n_check.py:105
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"குறைந்தது இவற்றைப் பட்டியலிடும் po/LINGUAS உருவாக்கவும்:\n"
"%(locales)s\n"
"(ஆங்கிலம்/%(source)s msgid மூலம்; பட்டியலில் இல்லை.)"

