#: src/zfr_lib/version.py:51
msgid "print current project version (walks parents from cwd)"
msgstr "நடப்புத் திட்டப் பதிப்பைக் காட்டு (நடப்பு அடைவிலிருந்து மேலே தேடும்)"

#: src/zfr_lib/version.py:52
msgid "Print the current project version (walks from cwd toward parent directories)."
msgstr "நடப்புத் திட்டப் பதிப்பைக் காட்டுகிறது (நடப்பு அடைவிலிருந்து மேல் அடைவுகளைத் தேடும்)."

#: src/zfr_lib/version.py:57
msgid "use git describe (default when git and .git are available)"
msgstr "git describe பயன்படுத்து (git மற்றும் .git இருந்தால் இயல்பு)"

#: src/zfr_lib/version.py:58
msgid "use debian/changelog (default when git or .git is unavailable)"
msgstr "debian/changelog பயன்படுத்து (git அல்லது .git இல்லையெனில் இயல்பு)"

#: src/zfr_lib/version.py:59
msgid "print an RPM-compatible Version (hyphens mapped to underscores)"
msgstr "RPM-க்கு ஏற்ற Version காட்டு (ஹைபன்கள் அடிக்கோடுகள்)"

