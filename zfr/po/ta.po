"optional rpm/ aligned with debian."
msgstr ""
"தொகுப்பு: debian/control Build-Depends meson, ninja-build, asciidoctor; "
"விருப்ப rpm/ debian-உடன் சீரமைக்கப்படும்."

#: src/zfr_lib/lint/report.py:102
msgid ""
"i18n: English source; zfr lint -l/--l10n-level L0–L3 (default L1). L1=10 "
"locales, L2=20, L3=30. Defaults in .config/zfr/lint.options."
msgstr ""
"i18n: ஆங்கில மூலம்; zfr lint -l/--l10n-level L0–L3 (இயல்பு L1). L1=10 மொழிகள், "
"L2=20, L3=30. இயல்புகள் .config/zfr/lint.options."

#: src/zfr_lib/lint/report.py:103
msgid ""
"Apps: `zfr rename <dir>` then `zfr add <puff>`; VERSION matches debian/"
"changelog (git describe may differ)."
msgstr ""
"பயன்பாடுகள்: `zfr rename <dir>` பின் `zfr add <puff>`; VERSION debian/changelog-"
"உடன் பொருந்தும் (git describe வேறுபடலாம்)."

#: src/zfr_lib/lint/report.py:116
msgid "error"
msgstr "பிழை"

#: src/zfr_lib/lint/report.py:117
msgid "warn"
msgstr "எச்சரிக்கை"

#: src/zfr_lib/lint/report.py:118
msgid "note"
msgstr "குறிப்பு"

#: src/zfr_lib/lint/report.py:119
msgid "ok"
msgstr "சரி"

#: src/zfr_lib/lint/report.py:132
msgid "fix:"
msgstr "சரிசெய்:"

#: src/zfr_lib/lint/report.py:139
msgid "Next steps (zephyr style)"
msgstr "அடுத்த படிகள் (zephyr பாணி)"

#: src/zfr_lib/lint/report.py:145
msgid ""
"Hint: after edits, re-run `zfr lint` from the project (or a subdirectory). "
"`zfr about -d -r` dumps packaging fields. Version for Meson/RPM is `zfr "
"version`. `zfr ize` applies missing debian/rpm/meson/man/version-subst "
"upgrades."
msgstr ""
"குறிப்பு: திருத்தங்களுக்குப் பின் திட்டத்திலிருந்து (அல்லது துணை அடைவிலிருந்து) `zfr "
"lint` மீண்டும் இயக்கவும். `zfr about -d -r` தொகுப்புப் புலங்களைக் காட்டும். Meson/RPM-"
"க்கான பதிப்பு `zfr version`. `zfr ize` விடுபட்ட debian/rpm/meson/man/version-"
"subst மேம்பாடுகளைப் பயன்படுத்தும்."

#: src/zfr_lib/lint/rpm.py:41
msgid "no rpm/*.spec (optional, but zephyr style includes RPM next to debian/)"
msgstr ""
"rpm/*.spec இல்லை (விருப்பம், ஆனால் zephyr பாணி debian/-இன் அருகில் RPM வைக்கும்)"

#: src/zfr_lib/lint/rpm.py:44
#, no-python-format
msgid ""
"Copy rpm/ from a language template; name the spec after the package (rpm/"
"<Source>.spec, not zephyr.spec) and keep a Makefile using `zfr version`. "
"Align Name/Summary/Requires/URL with debian/control. Or run `zfr ize`."
msgstr ""
"மொழி வார்ப்புருவிலிருந்து rpm/ நகலெடுக்கவும்; spec-ஐத் தொகுப்புப் பெயரில் வைக்கவும் "
"(rpm/<Source>.spec, zephyr.spec அல்ல) மற்றும் `zfr version` பயன்படுத்தும் Makefile "
"வைத்திருக்கவும். Name/Summary/Requires/URL-ஐ debian/control-உடன் சீரமைக்கவும். "
"அல்லது `zfr ize` இயக்கவும்."

#: src/zfr_lib/lint/rpm.py:63
#, no-python-format, python-brace-format
msgid "spec Version is dynamic %{version}"
msgstr "spec Version மாறும் %{version}"

#: src/zfr_lib/lint/rpm.py:72
msgid "spec Version is hardcoded; zephyr style injects `zfr version`"
msgstr "spec Version நிலையாக எழுதப்பட்டுள்ளது; zephyr பாணி `zfr version` செலுத்தும்"

#: src/zfr_lib/lint/rpm.py:76
#, no-python-format
msgid ""
"Use Version: %{version} with %{!?version:%global version 0.0.0} and freeze "
"via rpm/Makefile (`zfr version` / `zfr version -r`)."
msgstr ""
"Version: %{version}-ஐ %{!?version:%global version 0.0.0}-உடன் பயன்படுத்தி rpm/"
"Makefile வழியாக நிலைநிறுத்தவும் (`zfr version` / `zfr version -r`)."

#: src/zfr_lib/lint/rpm.py:82
#, python-format
msgid "License %s"
msgstr "உரிமம் %s"

#: src/zfr_lib/lint/rpm.py:88
msgid "spec License is not AGPL-3.0-or-later"
msgstr "spec License AGPL-3.0-or-later அல்ல"

#: src/zfr_lib/lint/rpm.py:91
#, python-format
msgid "License:        %s"
msgstr "License:        %s"

#: src/zfr_lib/lint/rpm.py:102
#, python-format
msgid "spec URL=%(url)r != debian Homepage=%(homepage)r"
msgstr "spec URL=%(url)r != debian Homepage=%(homepage)r"

#: src/zfr_lib/lint/rpm.py:105
msgid "Set URL: to the same Homepage as debian/control."
msgstr "URL:-ஐ debian/control-இன் Homepage-உடன் ஒன்றாக அமைக்கவும்."

#: src/zfr_lib/lint/rpm.py:117
msgid "spec Summary does not match debian Description first line"
msgstr "spec Summary debian Description முதல் வரியுடன் பொருந்தவில்லை"

#: src/zfr_lib/lint/rpm.py:120
#, python-format
msgid "Summary:        %s"
msgstr "Summary:        %s"

#: src/zfr_lib/lint/rpm.py:125
msgid "spec uses Meson (not autotools)"
msgstr "spec Meson பயன்படுத்துகிறது (autotools அல்ல)"

#: src/zfr_lib/lint/rpm.py:131
msgid "spec still uses autotools; zephyr packages build with Meson"
msgstr ""
"spec இன்னும் autotools பயன்படுத்துகிறது; zephyr தொகுப்புகள் Meson கொண்டு கட்டப்படும்"

#: src/zfr_lib/lint/rpm.py:134
#, no-python-format, python-brace-format
msgid ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"
msgstr ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"

#: src/zfr_lib/lint/rpm.py:142
msgid "Makefile uses `zfr version`"
msgstr "Makefile `zfr version` பயன்படுத்துகிறது"

#: src/zfr_lib/lint/rpm.py:149
msgid "rpm/Makefile does not call `zfr version`"
msgstr "rpm/Makefile `zfr version`-ஐ அழைக்கவில்லை"

#: src/zfr_lib/lint/rpm.py:152
#, no-python-format
msgid ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"
msgstr ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"

#: src/zfr_lib/lint/rpm.py:161
msgid "no rpm/Makefile convenience targets"
msgstr "rpm/Makefile-இல் வசதி இலக்குகள் இல்லை"

#: src/zfr_lib/lint/rpm.py:163
msgid "Copy bash/rpm/Makefile (srpm/rpm via zfr version)."
msgstr "bash/rpm/Makefile நகலெடுக்கவும் (srpm/rpm zfr version வழியாக)."

#: src/zfr_lib/lint/rpm.py:172
msgid "bash spec Requires missing bash-shlib"
msgstr "bash spec-இல் Requires bash-shlib இல்லை"

#: src/zfr_lib/lint/rpm.py:174
msgid "Requires:       bash-shlib  (same as debian Depends)"
msgstr "Requires:       bash-shlib  (debian Depends போல)"

#: src/zfr_lib/lint/source_size.py:55
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); file is very long"
msgstr "%(rel)s %(lines)d வரிகள் (>%(limit)d); கோப்பு மிக நீளம்"

#: src/zfr_lib/lint/source_size.py:59
msgid ""
"Split this file into smaller modules; keep each unit focused and testable."
msgstr ""
"இந்தக் கோப்பைச் சிறிய தொகுதிகளாகப் பிரிக்கவும்; ஒவ்வொரு அலகும் குவியமும் "
"சோதனைக்குரியதாகவும் இருக்கட்டும்."

#: src/zfr_lib/lint/source_size.py:67
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); consider modularizing soon"
msgstr ""
"%(rel)s %(lines)d வரிகள் (>%(limit)d); விரைவில் தொகுதிகளாகப் பிரிப்பதைப் "
"பரிசீலிக்கவும்"

#: src/zfr_lib/lint/source_size.py:71
msgid "Plan extraction of helpers or submodules before the file grows further."
msgstr ""
"கோப்பு மேலும் வளரும் முன் உதவிகள் அல்லது துணைத் தொகுதிகளைப் பிரித்தெடுக்கத் திட்டமிடுங்கள்."

#: src/zfr_lib/lint/source_size.py:75
msgid "no oversized source files"
msgstr "அளவுக்கு மீறிய மூலக் கோப்புகள் இல்லை"

#: src/zfr_lib/lint/template.py:51
msgid "zfr CLI package is not a language template"
msgstr "zfr CLI தொகுப்பு மொழி வார்ப்புரு அல்ல"

#: src/zfr_lib/lint/template.py:93
msgid "structural files from the language template are present"
msgstr "மொழி வார்ப்புருவின் கட்டமைப்புக் கோப்புகள் உள்ளன"

#: src/zfr_lib/lint/template.py:100
#, python-format
msgid ""
"language template %(lang)s has extra scaffolding not in this tree: "
"%(preview)s%(more)s"
msgstr ""
"மொழி வார்ப்புரு %(lang)s-இல் இந்த மரத்தில் இல்லாத கூடுதல் சாரங்கள் உள்ளன: "
"%(preview)s%(more)s"

#: src/zfr_lib/lint/template.py:102
#, python-format
msgid ""
"Compare with the %(lang)s template under pkgdatadir. Copy missing debian/"
"docs/src/rpm files (rpm/ uses %(name)s.spec, not zephyr.spec), or `zfr add` "
"puffs. Do not copy build/ or debian leftover stamp files. Example commons "
"modules are optional."
msgstr ""
"pkgdatadir கீழுள்ள %(lang)s வார்ப்புருவுடன் ஒப்பிடவும். விடுபட்ட debian/docs/src/rpm "
"கோப்புகளை நகலெடுக்கவும் (rpm/ %(name)s.spec பயன்படுத்தும், zephyr.spec அல்ல), அல்லது "
"`zfr add` puff-கள். build/ அல்லது debian மீதமுள்ள முத்திரைக் கோப்புகளை நகலெடுக்க "
"வேண்டாம். எடுத்துக்காட்டு commons தொகுதிகள் விருப்பம்."

#: src/zfr_lib/release.py:26
msgid "Debian binary-only build (no .dsc)"
msgstr "Debian இருமம் மட்டும் (.dsc இல்லை)"

#: src/zfr_lib/release.py:32
msgid "Reuse build cache"
msgstr "உருவாக்கத் தற்காலிக நினைவை மீண்டும் பயன்படுத்து"

#: src/zfr_lib/release.py:38
msgid "Reuse existing artifacts; build only if missing"
msgstr "உள்ள உருவாக்க முடிவுகளை மீண்டும் பயன்படுத்து; இல்லையெனில் மட்டும் உருவாக்கு"

#: src/zfr_lib/release.py:43
msgid "Build unsigned packages"
msgstr "கையொப்பமில்லா தொகுப்புகளை உருவாக்கு"

#: src/zfr_lib/release.py:50
msgid "dput upload host for .changes (debian)"
msgstr ".changes-க்கான dput பதிவேற்றப் புரவலன் (debian)"

#: src/zfr_lib/release.py:56
msgid "Build debian package with build4 (Docker)"
msgstr "build4 (Docker) கொண்டு debian தொகுப்பை உருவாக்கு"

#: src/zfr_lib/release.py:63
#, python-format
msgid "build4 target image (default: %s)"
msgstr "build4 இலக்குப் படிமம் (இயல்பு: %s)"

#: src/zfr_lib/release.py:70
msgid "Run build4 over SSH on SERVER (implies -d)"
msgstr "SERVER-இல் SSH வழியாக build4 இயக்கு (-d குறிக்கும்)"

#: src/zfr_lib/release.py:76
msgid "Build in local, no tag/push/release"
msgstr "உள்ளூரில் மட்டும் உருவாக்கு; குறிச்சொல், தள்ளுதல், GitHub வெளியீடு வேண்டாம்"

#: src/zfr_lib/release.py:82
msgid "Replace existing release and tag if present"
msgstr "உள்ள வெளியீட்டையும் குறிச்சொல்லையும் மாற்று"

#: src/zfr_lib/release.py:88
msgid "Skip sudo dpkg -i (still find debs/changes)"
msgstr "sudo dpkg -i-ஐத் தவிர் (இருந்தாலும் debs/changes கண்டுபிடிக்கும்)"

#: src/zfr_lib/release.py:94
msgid "Skip git tag create/push"
msgstr "git குறிச்சொல் உருவாக்கம்/தள்ளுதலைத் தவிர்"

#: src/zfr_lib/release.py:100
msgid "Skip dput upload to deb pool (-u reuses build artifacts)"
msgstr ""
"deb குளத்துக்கு dput பதிவேற்றத்தைத் தவிர் (-u உள்ள உருவாக்க முடிவுகளை மீண்டும் "
"பயன்படுத்தும்)"

#: src/zfr_lib/release.py:106
msgid "Skip GitHub release"
msgstr "GitHub வெளியீட்டைத் தவிர்"

#: src/zfr_lib/release.py:112
msgid "Skip VSIX marketplace publish"
msgstr "VSIX சந்தை வெளியீட்டைத் தவிர்"

#: src/zfr_lib/release.py:118
msgid "Skip RPM build (rpm/Makefile)"
msgstr "RPM உருவாக்கத்தைத் தவிர் (rpm/Makefile)"

#: src/zfr_lib/release.py:124
msgid "Skip Debian debuild"
msgstr "Debian debuild-ஐத் தவிர்"

#: src/zfr_lib/release.py:131
msgid "Verbose logging"
msgstr "விரிவான பதிவு"

#: src/zfr_lib/release.py:138
msgid "Less output"
msgstr "குறைந்த வெளியீடு"

#: src/zfr_lib/release.py:205
msgid "create a GitHub release (parse options, exec gh-makerelease)"
msgstr "GitHub வெளியீடு உருவாக்கு (விருப்பங்களைப் படித்து gh-makerelease-ஐ இயக்கு)"

#: src/zfr_lib/release.py:207
msgid ""
"Parse gh-makerelease options, rebuild argv, and exec gh-makerelease. Does "
"not implement tagging, packaging, or uploads."
msgstr ""
"gh-makerelease விருப்பங்களைப் படித்து argv-ஐ மீண்டும் கட்டி gh-makerelease-ஐ இயக்கும். "
"குறிச்சொல், தொகுத்தல், பதிவேற்றம் இங்கு நடக்காது."

#: src/zfr_lib/remove.py:20
msgid "remove puff(s) from the current project"
msgstr "நடப்புத் திட்டத்திலிருந்து puff-களை நீக்கு"

#: src/zfr_lib/remove.py:21
msgid "Remove puff files for NAME(s) from the current project."
msgstr "நடப்புத் திட்டத்திலிருந்து NAME puff கோப்புகளை நீக்கு."

#: src/zfr_lib/remove.py:25
msgid "puff name(s) to remove"
msgstr "நீக்க வேண்டிய puff பெயர்கள்"

#: src/zfr_lib/rename.py:51
msgid "rename zephyr project and example puff names"
msgstr "zephyr திட்டத்தையும் மாதிரி puff பெயர்களையும் மறுபெயரிடு"

#: src/zfr_lib/rename.py:52
msgid "Rename zephyr → ProjectName and some_puff1 → example names."
msgstr "zephyr-ஐத் திட்டப் பெயராகவும் some_puff1-ஐ மாதிரிப் பெயர்களாகவும் மாற்று."

#: src/zfr_lib/rename.py:56
msgid "new project name (replaces 'zephyr')"
msgstr "புதிய திட்டப் பெயர் ('zephyr'-ஐ மாற்றும்)"

#: src/zfr_lib/rename.py:57
msgid "new example names (each replaces template some_puff1)"
msgstr "புதிய மாதிரிப் பெயர்கள் (ஒவ்வொன்றும் வார்ப்புரு some_puff1-ஐ மாற்றும்)"

#: src/zfr_lib/shape.py:263
msgid ""
"print zephyr package shape score 0-100 (packagedir vs repodir in monorepos)"
msgstr ""
"zephyr தொகுப்பு வடிவ மதிப்பெண் 0–100 காட்டு (ஒரே களஞ்சியத்தில் packagedir vs "
"repodir)"

#: src/zfr_lib/shape.py:265
msgid ""
"Score how completely the current directory matches zephyr package style "
"(0-100). In monorepos, scores the packagedir."
msgstr ""
"நடப்பு அடைவு zephyr தொகுப்புப் பாணிக்கு எவ்வளவு நெருக்கமோ 0–100 மதிப்பெண். ஒரே "
"களஞ்சியத்தில் packagedir-க்கு மதிப்பெண்."

#: src/zfr_lib/shape.py:271
msgid "print 1 if score >= threshold, else 0"
msgstr "மதிப்பெண் வரம்புக்குக் குறையாவிட்டால் 1, இல்லையெனில் 0 காட்டு"

#: src/zfr_lib/shape.py:272
msgid "print packagedir/repodir/role on stderr"
msgstr "packagedir/repodir/role-ஐ stderr-இல் காட்டு"

#: src/zfr_lib/shape.py:273
#, python-format
msgid "bool threshold 0-100 (default: %s)"
msgstr "பூலியன் வரம்பு 0–100 (இயல்பு: %s)"

#: src/zfr_lib/version.py:51
msgid "print current project version (walks parents from cwd)"
msgstr "நடப்புத் திட்டப் பதிப்பைக் காட்டு (நடப்பு அடைவிலிருந்து மேலே தேடும்)"

#: src/zfr_lib/version.py:52
msgid ""
"Print the current project version (walks from cwd toward parent directories)."
msgstr ""
"நடப்புத் திட்டப் பதிப்பைக் காட்டுகிறது (நடப்பு அடைவிலிருந்து மேல் அடைவுகளைத் தேடும்)."

#: src/zfr_lib/version.py:57
msgid "use git describe (default when git and .git are available)"
msgstr "git describe பயன்படுத்து (git மற்றும் .git இருந்தால் இயல்பு)"

#: src/zfr_lib/version.py:58
msgid "use debian/changelog (default when git or .git is unavailable)"
msgstr "debian/changelog பயன்படுத்து (git அல்லது .git இல்லையெனில் இயல்பு)"

#: src/zfr_lib/version.py:59
msgid "print an RPM-compatible Version (hyphens mapped to underscores)"
msgstr "RPM-க்கு ஏற்ற Version காட்டு (ஹைபன்கள் அடிக்கோடுகள்)"
