msgstr "సంతకం లేని ప్యాకేజీలు నిర్మించు"

#: src/release/__init__.py:78
msgid "Build debian package with build4 (Docker)"
msgstr "build4 (Docker)తో debian ప్యాకేజీ నిర్మించు"

#: src/release/__init__.py:92
msgid "Run build4 over SSH on SERVER (implies -d)"
msgstr "SERVERపై SSH ద్వారా build4 నడుపు (-d అర్థం)"

#: src/release/__init__.py:98
msgid "Build in local, no tag/push/GitHub release (implies -U)"
msgstr "స్థానికంగా మాత్రమే నిర్మించు; ట్యాగ్, పుష్, GitHub విడుదల వద్దు"

#: src/release/__init__.py:104
msgid "Alias for -l -I (local build, skip install)"
msgstr "-l -I కొరకు లియమ్ (స్థానిక బైల్డ్, స్థానం ను దాటవేయండి)"

#: src/release/__init__.py:110
msgid "Replace existing release and tag if present"
msgstr "ఉన్న విడుదల మరియు ట్యాగ్‌ను భర్తీ చేయి"

#: src/release/__init__.py:116
msgid "Skip sudo dpkg -i (still find debs/changes)"
msgstr "sudo dpkg -i దాటవేయి (అయినా debs/changes కనుగొంటుంది)"

#: src/release/__init__.py:122
msgid "Skip git tag create/push"
msgstr "git ట్యాగ్ సృష్టి/పుష్ దాటవేయి"

#: src/release/__init__.py:128
msgid "Skip dput / private-cloud upload (-u reuses build artifacts)"
msgstr "deb పూల్‌కు dput పంపడం దాటవేయి (-u ఉన్న నిర్మాణ ఫలితాలను మళ్లీ వాడుతుంది)"

#: src/release/__init__.py:134
msgid "Skip GitHub release"
msgstr "GitHub విడుదలను దాటవేయి"

#: src/release/__init__.py:140
msgid "Skip RPM build (packaging/rpm/Makefile)"
msgstr "RPM నిర్మాణం దాటవేయి (rpm/Makefile)"

#: src/release/__init__.py:146
msgid "Skip Debian debuild"
msgstr "Debian debuild దాటవేయి"

#: src/release/__init__.py:153
msgid "Verbose logging"
msgstr "వివరమైన లాగ్"

#: src/release/__init__.py:160
msgid "Less output"
msgstr "తక్కువ అవుట్‌పుట్"

#: src/remove.py:20
msgid "remove puff(s) from the current project"
msgstr "ప్రస్తుత ప్రాజెక్టు నుండి puffలను తొలగించు"

#: src/remove.py:21
msgid "Remove puff files for NAME(s) from the current project."
msgstr "ప్రస్తుత ప్రాజెక్టు నుండి NAME puff ఫైళ్లను తొలగించు."

#: src/remove.py:25
msgid "puff name(s) to remove"
msgstr "తొలగించాల్సిన puff పేర్లు"

#: src/rename.py:51
msgid "rename zephyr project and example puff names"
msgstr "zephyr ప్రాజెక్టు మరియు నమూనా puff పేర్లను మార్చు"

#: src/rename.py:52
msgid "Rename zephyr → ProjectName and some_puff1 → example names."
msgstr "zephyrను ప్రాజెక్టు పేరుగా, some_puff1ను నమూనా పేర్లుగా మార్చు."

#: src/rename.py:56
msgid "new project name (replaces 'zephyr')"
msgstr "కొత్త ప్రాజెక్టు పేరు ('zephyr' స్థానంలో)"

#: src/rename.py:57
msgid "new example names (each replaces template some_puff1)"
msgstr "కొత్త నమూనా పేర్లు (ప్రతిదీ మూస some_puff1 స్థానంలో)"

#: src/shape.py:275
msgid "print zephyr package shape score 0-100 (packagedir vs repodir in monorepos)"
msgstr "zephyr ప్యాకేజీ ఆకార స్కోరు 0–100 చూపించు (ఒకే నిల్వలో packagedir vs repodir)"

#: src/shape.py:277
msgid "Score how completely the current directory matches zephyr package style (0-100). In monorepos, scores the packagedir."
msgstr "ప్రస్తుత సంచయం zephyr ప్యాకేజీ శైలికి ఎంత దగ్గరగా ఉందో 0–100 స్కోరు. ఒకే నిల్వలో packagedirకు స్కోరు ఇస్తుంది."

#: src/shape.py:283
msgid "print 1 if score >= threshold, else 0"
msgstr "స్కోరు గడువుకు తక్కువ కాకపోతే 1, లేకపోతే 0 చూపించు"

#: src/shape.py:284
msgid "print packagedir/repodir/role on stderr"
msgstr "packagedir/repodir/roleను stderrపై చూపించు"

#: src/shape.py:285
#, python-format
msgid "bool threshold 0-100 (default: %s)"
msgstr "బూలియన్ గడువు 0–100 (అప్రమేయం: %s)"

