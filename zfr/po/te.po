msgstr ""
"VERSION తాజా debian/changelog ఎంట్రీతో సరిపోలాలి (pre-commit హుక్ దాన్ని నవీకరిస్తుంది). Git "
"describe ఇంకా భిన్నంగా ఉండవచ్చు."

#: src/zfr_lib/lint/debian.py:162
#, python-format
msgid "VERSION matches changelog %s"
msgstr "VERSION చేంజ్‌లాగ్ %sతో సరిపోలుతుంది"

#: src/zfr_lib/lint/debian.py:172
