#: src/zfr:32
msgid ""
"Zephyr template helper (CLI name: zfr). Create projects and manage example "
"puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr ""
"Zephyr テンプレートヘルパー（CLI 名: zfr）。プロジェクトを作成し、サンプル "
"puff を管理します。インスタンス化されたツリーは引き続き zfr を呼び出します。"
"zfr はリネームトークンではありません。"

#: src/zfr:46
msgid "show this help"
msgstr "このヘルプを表示"

#: src/zfr_lib/about.py:496
msgid "print current project information (walks parents from cwd)"
msgstr "現在のプロジェクト情報を表示（cwd から親ディレクトリをたどる）"

#: src/zfr_lib/about.py:498
msgid ""
"Print information about the current zephyr project (walks from cwd toward "
"parent directories). CSR colors when stdout is a TTY. Common packaging "
"fields are parsed from debian or RPM."
msgstr ""
"現在の zephyr プロジェクトの情報を表示（cwd から親ディレクトリへたどる）。"
"stdout が TTY のとき CSR 色。debian または RPM から一般的なパッケージング"
"フィールドを解析。"

#: src/zfr_lib/about.py:505
msgid "show parsed Debian packaging fields"
msgstr "解析済み Debian パッケージングフィールドを表示"

#: src/zfr_lib/about.py:506
msgid "show parsed RPM packaging fields"
msgstr "解析済み RPM パッケージングフィールドを表示"

#: src/zfr_lib/about.py:511
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr ""
"CSR (console SGR) ハイライト（デフォルト: auto = TTY かつ NO_COLOR なし）"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "言語テンプレートから puff をインスタンス化"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "言語を検出し、pkgdatadir/<lang> から puff を追加。"

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "新しい puff 名（snake_case 推奨）"

#: src/zfr_lib/create.py:311
msgid "create a new project from a language template"
msgstr "言語テンプレートから新しいプロジェクトを作成"

#: src/zfr_lib/create.py:312
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "pkgdatadir/<lang> から新しいプロジェクトディレクトリを作成。"

#: src/zfr_lib/create.py:319
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "テンプレート言語（デフォルト: python; 次のいずれか: %s）"

#: src/zfr_lib/create.py:323
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "debian changelog ディストリビューション（デフォルト: %s）"

#: src/zfr_lib/create.py:327
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "初期パッケージバージョンと git タグ（デフォルト: %s）"

#: src/zfr_lib/create.py:331
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "changelog/git 著者名（デフォルト: %s）"

#: src/zfr_lib/create.py:335
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "changelog/git 著者メール（デフォルト: %s）"

#: src/zfr_lib/create.py:337
msgid "new project directory name"
msgstr "新しいプロジェクトディレクトリ名"

#: src/zfr_lib/create.py:340
msgid "optional puff names to add after creating the project"
msgstr "プロジェクト作成後に追加する任意の puff 名"

#: src/zfr_lib/detect.py:15
msgid "print detected language for the current directory"
msgstr "現在のディレクトリの検出言語を表示"

#: src/zfr_lib/detect.py:16
msgid ""
"Print the detected language of the current project and layout details on "
"stderr."
msgstr "現在のプロジェクトの検出言語とレイアウト詳細を stderr に表示。"

#: src/zfr_lib/dist.py:60
msgid ""
"write the archive into DIR (default: meson-dist, or %_topdir/SOURCES with --"
"rpm; usually $HOME/rpmbuild)"
msgstr ""
"アーカイブを DIR に書き込む（デフォルト: meson-dist、または --rpm で "
"%_topdir/SOURCES ($HOME/rpmbuild)）"

#: src/zfr_lib/dist.py:70
msgid ""
"Meson build directory (default: /build when it matches this source tree, "
"else <project>/build)"
msgstr ""
"Meson ビルドディレクトリ（デフォルト: このソースツリーに一致する場合 /build、"
"それ以外 <project>/build）"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "アーカイブ形式（デフォルト: xz）"

#: src/zfr_lib/dist.py:86
msgid ""
"name the archive NAME-VERSION.tar.xz and write it to %_topdir/SOURCES "
"($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr ""
"アーカイブを NAME-VERSION.tar.xz と命名し、-o がなければ %_topdir/SOURCES ($HOME/rpmbuild) に"
"書き込む"

#: src/zfr_lib/dist.py:94
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "meson dist に --allow-dirty を渡す（デフォルト: allow）"

#: src/zfr_lib/dist.py:99
msgid "run tests during meson dist (default: --no-tests)"
msgstr "meson dist 中にテストを実行（デフォルト: --no-tests）"

#: src/zfr_lib/dist.py:343
msgid "build a source tarball (meson dist, or this project only)"
msgstr "ソース tarball をビルド（meson dist、またはこのプロジェクトのみ）"

#: src/zfr_lib/dist.py:345
msgid ""
"Build a source archive of the current zephyr project (walks from cwd toward "
"parent directories). Uses meson dist when this directory is the git project "
"root; otherwise packs this project only so nested language templates do not "
"ship the parent meta-repo. Prints the archive path on stdout."
msgstr ""
"現在の zephyr プロジェクトのソースアーカイブをビルド（cwd から親ディレクトリ"
"へたどる）。このディレクトリが git プロジェクトルートのとき meson dist を使"
"用；それ以外はこのプロジェクトのみパックし、ネストした言語テンプレートが親 "
"meta-repo を同梱しないようにする。アーカイブパスを stdout に表示。"

#: src/zfr_lib/ize/__init__.py:65
msgid "refactor this project to current zephyr style"
msgstr "このプロジェクトを現在の zephyr スタイルにリファクタリング"

#: src/zfr_lib/ize/__init__.py:66
msgid ""
"Refactor the current project to match current zephyr style: missing debian/"
"rpm files, meson targets, AsciiDoc man pages, and Meson version "
"substitutions. Walks from cwd toward parents."
msgstr ""
"現在のプロジェクトを現在の zephyr スタイルに合わせてリファクタリング：不足し"
"ている debian/rpm ファイル、meson ターゲット、AsciiDoc man ページ、Meson バー"
"ジョン置換。cwd から親へたどる。"

#: src/zfr_lib/ize/__init__.py:70
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "合わせる言語テンプレート（デフォルト: detect; 次のいずれか: %s）"

#: src/zfr_lib/ize/__init__.py:71
msgid "print planned changes without writing files"
msgstr "ファイルを書き込まずに予定された変更を表示"

#: src/zfr_lib/ize/__init__.py:72
msgid "also print skipped files"
msgstr "スキップしたファイルも表示"

#: src/zfr_lib/ize/__init__.py:78
msgid ""
"run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr "Autotools/CMake がある場合に 2meson で Meson へ変換する（既定: オン）"

#: src/zfr_lib/ize/__init__.py:80
msgid "do not convert groff .1 man pages to docs/*.adoc"
msgstr "groff .1 man ページを docs/*.adoc に変換しない"

#: src/zfr_lib/ize/__init__.py:81
msgid "do not turn hardcoded versions into @VERSION@ / config.h"
msgstr "ハードコードされたバージョンを @VERSION@ / config.h に変換しない"

#: src/zfr_lib/ize/__init__.py:82 src/zfr_lib/lint/__init__.py:115
msgid "CSR (console SGR) highlighting (default: auto)"
msgstr "CSR (console SGR) ハイライト（デフォルト: auto）"

#: src/zfr_lib/l10n.py:93
#, python-format
msgid "l10n level must be L0–L3 (or 0–3), not %r"
msgstr "l10n レベルは L0–L3（または 0–3）である必要があります。%r は使えません"

#: src/zfr_lib/lang/antlr.py:42 src/zfr_lib/lang/as.py:30
#: src/zfr_lib/lang/bison.py:38 src/zfr_lib/lang/clib.py:34
#: src/zfr_lib/lang/cobol.py:32 src/zfr_lib/lang/cpplib.py:34
#: src/zfr_lib/lang/cpp.py:21 src/zfr_lib/lang/c.py:21 src/zfr_lib/lang/d.py:32
#: src/zfr_lib/lang/fortran.py:32 src/zfr_lib/lang/gcc.py:48
#: src/zfr_lib/lang/kotlin.py:22 src/zfr_lib/lang/lua.py:22
#: src/zfr_lib/lang/nim.py:24 src/zfr_lib/lang/pascal.py:32
#: src/zfr_lib/lang/python.py:21
msgid "tests/ present"
msgstr "tests/ あり"

#: src/zfr_lib/lang/antlr.py:47 src/zfr_lib/lang/as.py:35
#: src/zfr_lib/lang/bison.py:43 src/zfr_lib/lang/clib.py:35
#: src/zfr_lib/lang/cpplib.py:35 src/zfr_lib/lang/cpp.py:22
#: src/zfr_lib/lang/c.py:22 src/zfr_lib/lang/gcc.py:53
msgid "no tests/ directory"
msgstr "tests/ ディレクトリがありません"

#: src/zfr_lib/lang/antlr.py:49
msgid "Add tests/TestCommons.java or fixture checks for parser output."
msgstr ""
"tests/TestCommons.java を追加するか、パーサー出力のフィクスチャ検査を入れてく"
"ださい。"

#: src/zfr_lib/lang/as.py:37
msgid "Add tests/smoke.sh and meson test() for stdin/stdout copy."
msgstr ""
"stdin/stdout のコピー用に tests/smoke.sh と meson test() を追加してください。"

#: src/zfr_lib/lang/bash.py:45
#, python-format
msgid "src scripts: %s"
msgstr "src のスクリプト: %s"

#: src/zfr_lib/lang/bash.py:46
msgid "no src/*.in scripts"
msgstr "src/*.in スクリプトがありません"

#: src/zfr_lib/lang/bash.py:47
msgid ""
"Keep configured scripts as src/<puff>.in with @PACKAGE@/@VERSION@ and meson "
"configure_file + install_mode rwxr-xr-x."
msgstr ""
"設定対象のスクリプトは src/<puff>.in のまま @PACKAGE@/@VERSION@ を含め、"
"meson configure_file + install_mode rwxr-xr-x を使ってください。"

#: src/zfr_lib/lang/bison.py:45
msgid "Add tests/ with fixture checks for parser dump/format output."
msgstr ""
"パーサーの dump/format 出力向けのフィクスチャ検査を tests/ に追加してくださ"
"い。"

#: src/zfr_lib/lang/clib.py:36 src/zfr_lib/lang/cpplib.py:36
#: src/zfr_lib/lang/cpp.py:23 src/zfr_lib/lang/c.py:23
#: src/zfr_lib/lang/gcc.py:55
msgid "Add tests/ and meson test() entries like the C family templates."
msgstr ""
"C 系テンプレートと同様に tests/ と meson test() エントリを追加してください。"

#: src/zfr_lib/lang/cobol.py:37
msgid "no tests/ (cobol template uses cobc + meson test)"
msgstr ""
"tests/ がありません（cobol テンプレートは cobc + meson test を使います）"

#: src/zfr_lib/lang/cobol.py:39
msgid "Add tests/test_commons.sh or similar smoke test for cobc."
msgstr ""
"cobc 向けに tests/test_commons.sh か同様のスモークテストを追加してください。"

#: src/zfr_lib/lang/d.py:37
msgid "no tests/ (D template uses ldc/dmd + meson test)"
msgstr ""
"tests/ がありません（D テンプレートは ldc/dmd + meson test を使います）"

#: src/zfr_lib/lang/d.py:39
msgid "Add tests/test_commons.d and meson test() executable."
msgstr ""
"tests/test_commons.d と meson test() の実行ファイルを追加してください。"

#: src/zfr_lib/lang/fortran.py:37
msgid "no tests/ (fortran template uses gfortran + meson test)"
msgstr ""
"tests/ がありません（fortran テンプレートは gfortran + meson test を使いま"
"す）"

#: src/zfr_lib/lang/fortran.py:39
msgid "Add tests/test_commons.f90 and meson test() executable."
msgstr ""
"tests/test_commons.f90 と meson test() の実行ファイルを追加してください。"

#: src/zfr_lib/lang/go.py:22
msgid "missing go.mod"
msgstr "go.mod がありません"

#: src/zfr_lib/lang/go.py:23
msgid ""
"Add go.mod; meson should `go build` with -X main.buildVersion from "
"meson.project_version()."
msgstr ""
"go.mod を追加し、meson は meson.project_version() 由来の -X "
"main.buildVersion 付きで `go build` を実行してください。"

#: src/zfr_lib/lang/kotlin.py:23
msgid "no tests/ (kotlin template uses kotlinc + meson test)"
msgstr ""
"tests/ がありません（kotlin テンプレートは kotlinc + meson test を使います）"

#: src/zfr_lib/lang/kotlin.py:24
msgid "Add tests/Test*.kt and meson test() compiling with kotlinc."
msgstr ""
"kotlinc でコンパイルする tests/Test*.kt と meson test() を追加してください。"

#: src/zfr_lib/lang/lua.py:23
msgid "no tests/ (lua template uses lua tests + meson test)"
msgstr ""
"tests/ がありません（lua テンプレートは lua テスト + meson test を使います）"

#: src/zfr_lib/lang/lua.py:24
msgid ""
"Add tests/test_*.lua and meson test() invoking lua with LUA_PATH=src/?.lua."
msgstr ""
"LUA_PATH=src/?.lua で lua を起動する tests/test_*.lua と meson test() を追加"
"してください。"

#: src/zfr_lib/lang/nim.py:25
msgid "no tests/ (nim template uses unittest + meson test)"
msgstr ""
"tests/ がありません（nim テンプレートは unittest + meson test を使います）"

#: src/zfr_lib/lang/nim.py:26
msgid "Add tests/test_*.nim and meson test() with nim r."
msgstr "nim r を使う tests/test_*.nim と meson test() を追加してください。"

#: src/zfr_lib/lang/pascal.py:37
msgid "no tests/ (pascal template uses fpc + meson test)"
msgstr ""
"tests/ がありません（pascal テンプレートは fpc + meson test を使います）"

#: src/zfr_lib/lang/pascal.py:39
msgid "Add tests/test_commons.pas and meson test() with fpc."
msgstr "fpc を使う tests/test_commons.pas と meson test() を追加してください。"

#: src/zfr_lib/lang/python.py:22
msgid "no tests/ (python template uses unittest + meson test)"
msgstr ""
"tests/ がありません（python テンプレートは unittest + meson test を使います）"

#: src/zfr_lib/lang/python.py:23
msgid "Add tests/test_*.py and meson test() with PYTHONPATH=src."
msgstr "PYTHONPATH=src で tests/test_*.py と meson test() を追加してください。"

#: src/zfr_lib/lang/rust.py:22
msgid "missing Cargo.toml"
msgstr "Cargo.toml がありません"

#: src/zfr_lib/lang/rust.py:23
msgid ""
"Rust zephyr projects keep Cargo.toml plus meson custom_target for the binary."
msgstr ""
"Rust の zephyr プロジェクトは Cargo.toml に加え、バイナリ用の meson "
"custom_target を置きます。"

#: src/zfr_lib/lang/zig.py:23
msgid "missing build.zig"
msgstr "build.zig がありません"

#: src/zfr_lib/lang/zig.py:24
msgid "Add build.zig; meson should invoke `zig build -Doptimize=ReleaseFast`."
msgstr ""
"build.zig を追加し、meson は `zig build -Doptimize=ReleaseFast` を実行してく"
"ださい。"

#: src/zfr_lib/lint/debian.py:42
#, python-format
msgid "Build-Depends has %s"
msgstr "Build-Depends に %s があります"

#: src/zfr_lib/lint/debian.py:48
#, python-format
msgid "Build-Depends missing %s"
msgstr "Build-Depends に %s がありません"

#: src/zfr_lib/lint/debian.py:50
#, python-format
msgid ""
"Add %s to Build-Depends (zephyr packages build with Meson + AsciiDoc man "
"pages)."
msgstr ""
"Build-Depends に %s を追加してください（zephyr パッケージは Meson と "
"AsciiDoc の man ページで構築します）。"

#: src/zfr_lib/lint/debian.py:54
msgid "debhelper-compat present"
msgstr "debhelper-compat あり"

#: src/zfr_lib/lint/debian.py:60
msgid "Build-Depends missing debhelper-compat (= 13)"
msgstr "Build-Depends に debhelper-compat (= 13) がありません"

#: src/zfr_lib/lint/debian.py:62
msgid "Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"
msgstr ""
"Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"

#: src/zfr_lib/lint/debian.py:72
msgid "Package stanza missing Architecture"
msgstr "Package スタンザに Architecture がありません"

#: src/zfr_lib/lint/debian.py:74
msgid "Architecture: all  (scripts) or any (compiled)."
msgstr "Architecture: all  （スクリプト）または any（コンパイル済み）。"

#: src/zfr_lib/lint/debian.py:82
#, python-format
msgid "bash packages should be Architecture: all (got %s)"
msgstr "bash パッケージは Architecture: all であるべきです（実際は %s）"

#: src/zfr_lib/lint/debian.py:84
msgid "Architecture: all"
msgstr "Architecture: all"

#: src/zfr_lib/lint/debian.py:92
#, python-format
msgid "%s packages are usually Architecture: any (got all)"
msgstr "%s パッケージは通常 Architecture: any です（実際は all）"

#: src/zfr_lib/lint/debian.py:94
msgid "Architecture: any"
msgstr "Architecture: any"

#: src/zfr_lib/lint/debian.py:98
#, python-format
msgid "Architecture: %s"
msgstr "フィールド Architecture: %s"

#: src/zfr_lib/lint/debian.py:102
#, python-format
msgid "Homepage: %s"
msgstr "フィールド Homepage: %s"

#: src/zfr_lib/lint/debian.py:108
msgid "no Homepage"
msgstr "Homepage がありません"

#: src/zfr_lib/lint/debian.py:110
msgid "Set Homepage: to the project URL."
msgstr "Homepage: をプロジェクトの URL に設定してください。"

#: src/zfr_lib/lint/debian.py:116
msgid "dh meson debian/build"
msgstr "dh が meson と debian/build を使用"

#: src/zfr_lib/lint/debian.py:122
msgid ""
"debian/rules is not dh --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"debian/rules が dh --buildsystem=meson --builddirectory=debian/build ではあり"
"ません"

#: src/zfr_lib/lint/debian.py:125
#, no-python-format
msgid ""
"Use:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"次を使用してください:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:131
msgid "copyright mentions AGPL"
msgstr "copyright に AGPL の記載あり"

#: src/zfr_lib/lint/debian.py:137
msgid "debian/copyright does not mention AGPL"
msgstr "debian/copyright に AGPL の記載がない"

#: src/zfr_lib/lint/debian.py:139
msgid "Use the template debian/copyright (License: AGPL-3+)."
msgstr "テンプレート debian/copyright を使用してください (License: AGPL-3+)。"

#: src/zfr_lib/lint/debian.py:145
#, python-format
msgid "source format %s"
msgstr "ソース形式 %s"

#: src/zfr_lib/lint/debian.py:154
#, python-format
msgid "VERSION=%(file)r != changelog %(changelog)r"
msgstr "VERSION=%(file)r != 変更履歴 %(changelog)r"

#: src/zfr_lib/lint/debian.py:156
msgid ""
"VERSION should match the latest debian/changelog entry (pre-commit hook "
"updates it). Git describe may still differ."
msgstr ""
"VERSION は debian/changelog の最新エントリと一致する必要があります（pre-"
"commit フックが更新します）。Git describe はまだ異なる場合があります。"

#: src/zfr_lib/lint/debian.py:162
#, python-format
msgid "VERSION matches changelog %s"
msgstr "VERSION は変更履歴 %s と一致"

#: src/zfr_lib/lint/debian.py:172
msgid "bash project Depends missing bash-shlib"
msgstr "bash プロジェクトの Depends に bash-shlib がない"

#: src/zfr_lib/lint/debian.py:174
msgid "Depends: bash, bash-shlib, ${misc:Depends}"
msgstr "Depends: bash, bash-shlib, ${misc:Depends}"

#: src/zfr_lib/lint/debian.py:178
msgid "Depends includes bash-shlib"
msgstr "Depends に bash-shlib が含まれる"

#: src/zfr_lib/lint/i18n_check.py:56
#, python-format
msgid "l10n level %s: no locale coverage required"
msgstr "l10n レベル %s: ロケール対応は不要"

#: src/zfr_lib/lint/i18n_check.py:65
#, python-format
msgid "l10n level %(level)s (%(count)d locales)"
msgstr "l10n レベル %(level)s（%(count)d ロケール）"

#: src/zfr_lib/lint/i18n_check.py:78
msgid "no po/ directory (optional unless the project uses gettext)"
msgstr "po/ ディレクトリなし（プロジェクトが gettext を使わない限り任意）"

#: src/zfr_lib/lint/i18n_check.py:79
#, python-format
msgid ""
"If the app is translated, add po/ with LINGUAS + *.po and i18n.gettext() in "
"meson.build. Required locales at %(level)s: %(locales)s (source language "
"%(source)s)."
msgstr ""
"アプリが翻訳されている場合は、po/ に LINGUAS + *.po を置き、meson.build で "
"i18n.gettext() を呼び出してください。%(level)s で必要なロケール: %(locales)s"
"（ソース言語 %(source)s）。"

#: src/zfr_lib/lint/i18n_check.py:97
msgid "po/ exists but po/LINGUAS is missing or empty"
msgstr "po/ はあるが po/LINGUAS がないか空"

#: src/zfr_lib/lint/i18n_check.py:99
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"po/LINGUAS を作成し、少なくとも次を列挙してください:\n"
"%(locales)s\n"
"（英語/%(source)s は msgid のソースであり、一覧には入れません。）"

#: src/zfr_lib/lint/i18n_check.py:114
#, python-format
msgid "po/LINGUAS missing %(level)s locale(s): %(locales)s"
msgstr "po/LINGUAS に %(level)s のロケールが不足: %(locales)s"

#: src/zfr_lib/lint/i18n_check.py:117
#, python-format
msgid ""
"Level %(level)s requires: %(locales)s (source %(source)s; zh-cn→zh_CN, zh-"
"tw→zh_TW). Append the missing lines to LINGUAS and add matching po/"
"<locale>.po."
msgstr ""
"レベル %(level)s が必要とするロケール: %(locales)s（ソース %(source)s。zh-"
"cn→zh_CN, zh-tw→zh_TW）。欠けている行を LINGUAS に追記し、対応する po/"
"<locale>.po を追加してください。"

#: src/zfr_lib/lint/i18n_check.py:132
#, python-format
msgid "po/LINGUAS covers %s locale set"
msgstr "po/LINGUAS はロケール集合 %s を満たす"

#: src/zfr_lib/lint/i18n_check.py:147
#, python-format
msgid "LINGUAS entries without po/<locale>.po: %s"
msgstr "po/<locale>.po のない LINGUAS エントリ: %s"

#: src/zfr_lib/lint/i18n_check.py:149
msgid ""
"For each locale: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-"
"translator && msgmerge -U po/<locale>.po <domain>.pot"
msgstr ""
"各ロケールについて: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --"
"no-translator && msgmerge -U po/<locale>.po <domain>.pot"

#: src/zfr_lib/lint/i18n_check.py:160
#, python-format
msgid "%(level)s locale .po files present (%(count)d)"
msgstr "%(level)s のロケール .po ファイルあり（%(count)d）"

#: src/zfr_lib/lint/i18n_check.py:192
#, python-format
msgid "missing whole-document man translations for %(level)s: %(files)s"
msgstr "%(level)s の文書全体 man 翻訳が不足: %(files)s"

#: src/zfr_lib/lint/i18n_check.py:195
#, python-format
msgid ""
"Hand-translate docs/<locale>/<name>.adoc (full document, not po4a). "
"%(level)s requires: %(locales)s."
msgstr ""
"docs/<locale>/<name>.adoc を手訳してください（文書全体。po4a ではありませ"
"ん）。%(level)s が必要とするロケール: %(locales)s。"

#: src/zfr_lib/lint/i18n_check.py:205
#, python-format
msgid "%s whole-document man translations present"
msgstr "%s の文書全体 man 翻訳あり"

#: src/zfr_lib/lint/i18n_check.py:214
#, python-format
msgid "man translation still contains the English Name line: %s"
msgstr "man 翻訳にまだ英語の Name 行が残っています: %s"

#: src/zfr_lib/lint/i18n_check.py:217
msgid "Translate the Name line; do not leave the English wording."
msgstr "Name 行を翻訳し、英語のまま残さないでください。"

#: src/zfr_lib/lint/identity.py:57
#, python-format
msgid "%(label)s is %(val)r, expected %(expected)r (directory name)"
msgstr "%(label)s は %(val)r、期待値は %(expected)r（ディレクトリ名）"

#: src/zfr_lib/lint/identity.py:60
#, python-format
msgid ""
"Set %(label)s to %(expected)r, or rename the directory. Use `zfr rename "
"%(expected)s` if leftover template names remain."
msgstr ""
"%(label)s を %(expected)r にするか、ディレクトリ名を変更してください。テンプ"
"レート名が残っている場合は `zfr rename %(expected)s` を使います。"

#: src/zfr_lib/lint/identity.py:66
#, python-format
msgid "%(label)s=%(val)s"
msgstr "%(label)s=%(val)s"

#: src/zfr_lib/lint/identity.py:69
#, python-format
msgid "meson project name=%s"
msgstr "meson プロジェクト名=%s"

#: src/zfr_lib/lint/identity.py:75
#, python-format
msgid "debian Source=%(source)r != meson project=%(meson)r"
msgstr "debian Source=%(source)r != meson プロジェクト=%(meson)r"

#: src/zfr_lib/lint/identity.py:78
msgid "Keep Source, Package, and meson project() name identical."
msgstr "Source、Package、meson project() 名を同一にしてください。"

#: src/zfr_lib/lint/identity.py:82
#, python-format
msgid "Source=%s"
msgstr "Source=%s"

#: src/zfr_lib/lint/identity.py:95
#, python-format
msgid "spec Name=%(spec)r != debian/meson name %(want)r"
msgstr "spec Name=%(spec)r != debian/meson 名 %(want)r"

#: src/zfr_lib/lint/identity.py:99
#, python-format
msgid "Set Name: %s in the spec (same as debian Source)."
msgstr "spec に Name: %s を設定してください（debian Source と同じ）。"

#: src/zfr_lib/lint/identity.py:103
#, python-format
msgid "spec Name=%s"
msgstr "spec Name=%s"

#: src/zfr_lib/lint/__init__.py:99
msgid "validate project packaging and zephyr layout (walks parents from cwd)"
msgstr ""
"プロジェクトのパッケージングと zephyr レイアウトを検証（cwd から親ディレクト"
"リをたどる）"

#: src/zfr_lib/lint/__init__.py:100
msgid ""
"Check the current zephyr project for missing files and packaging/style "
"mistakes. Walks from cwd toward parent directories. CSR colors when stdout "
"is a TTY."
msgstr ""
"現在の zephyr プロジェクトの欠落ファイルとパッケージング/スタイルの誤りを確"
"認。cwd から親ディレクトリへたどる。stdout が TTY のとき CSR 色。"

#: src/zfr_lib/lint/__init__.py:104
msgid "show passing checks too"
msgstr "合格したチェックも表示"

#: src/zfr_lib/lint/__init__.py:105
msgid "only print errors"
msgstr "エラーのみ表示"

#: src/zfr_lib/lint/__init__.py:106
msgid "treat warnings as failures (exit 1)"
msgstr "警告を失敗として扱う（exit 1）"

#: src/zfr_lib/lint/__init__.py:113
msgid ""
"required gettext/manpage locale coverage L0–L3 (default: L1; project file "
"may override)"
msgstr ""
"必要な gettext/マニュアルの locale 範囲 L0–L3（既定 L1；プロジェクトファイル"
"で上書き可）"

#: src/zfr_lib/lint/lang_bits.py:31
#, python-format
msgid "legacy example module %s; use commons or a specific name"
msgstr "旧来のサンプルモジュール %s。commons か具体的な名前を使ってください"

#: src/zfr_lib/lint/lang_bits.py:33
msgid ""
"Rename to src/commons.* (template convention) or a project-specific module "
"name."
msgstr ""
"src/commons.*（テンプレートの慣習）かプロジェクト固有のモジュール名に変更して"
"ください。"

#: src/zfr_lib/lint/lang_bits.py:44
#, python-format
msgid "%s is only a template example for shared helpers"
msgstr "%s は共有ヘルパーのテンプレート例にすぎません"

#: src/zfr_lib/lint/lang_bits.py:46
msgid ""
"common_lib / commons mean “extract reusable pieces”, but filenames should be "
"concrete. Rename to a specific module in real projects (e.g. stream_copy.py, "
"bulk.h). clib/cpplib keep lib.c/lib.cpp as their shared library entry."
msgstr ""
"common_lib / commons は「再利用できる部分を切り出す」という意味ですが、ファイ"
"ル名は具体的にしてください。実プロジェクトでは特定モジュール名に変更します"
"（例: stream_copy.py、bulk.h）。clib/cpplib は共有ライブラリの入口として "
"lib.c/lib.cpp を残します。"

#: src/zfr_lib/lint/layout.py:35
msgid "Add a top-level meson.build with project(...)."
msgstr "最上位に project(...) を含む meson.build を追加してください。"

#: src/zfr_lib/lint/layout.py:36
msgid "Copy LICENSE from the language template (AGPL-3.0-or-later)."
msgstr ""
"言語テンプレートから LICENSE をコピーしてください（AGPL-3.0-or-later）。"

#: src/zfr_lib/lint/layout.py:37
msgid "Add README.md describing this project."
msgstr "このプロジェクトを説明する README.md を追加してください。"

#: src/zfr_lib/lint/layout.py:38
msgid "Add README-zh.md (Chinese summary), matching other zephyr templates."
msgstr ""
"他の zephyr テンプレートに合わせて README-zh.md（中国語要約）を追加してくださ"
"い。"

#: src/zfr_lib/lint/layout.py:39
msgid "Add debian/ packaging (copy debian/ from the language template)."
msgstr ""
"debian/ パッケージングを追加してください（言語テンプレートから debian/ をコ"
"ピー）。"

#: src/zfr_lib/lint/layout.py:40
msgid "Add debian/changelog (zfr create writes one; or use dch)."
msgstr ""
"debian/changelog を追加してください（zfr create が書き出します。または "
"dch）。"

#: src/zfr_lib/lint/layout.py:41
msgid "Add debian/copyright in machine-readable format, License: AGPL-3+."
msgstr "機械可読形式の debian/copyright を追加してください。License: AGPL-3+。"

#: src/zfr_lib/lint/layout.py:42
msgid ""
"Add debian/rules using dh --buildsystem=meson --builddirectory=debian/build."
msgstr ""
"dh --buildsystem=meson --builddirectory=debian/build を使う debian/rules を追"
"加してください。"

#: src/zfr_lib/lint/layout.py:43
msgid "Add debian/source/format (typically '3.0 (native)')."
msgstr "debian/source/format を追加してください（通常は '3.0 (native)'）。"

#: src/zfr_lib/lint/layout.py:47
#, python-format
msgid "present: %s"
msgstr "あり: %s"

#: src/zfr_lib/lint/layout.py:50
#, python-format
msgid "missing %s"
msgstr "%s がありません"

#: src/zfr_lib/lint/layout.py:56
#, python-format
msgid "AsciiDoc man sources: %s"
msgstr "AsciiDoc man ソース: %s"

#: src/zfr_lib/lint/layout.py:63
msgid "no docs/*.adoc man page source"
msgstr "docs/*.adoc の man ページソースがありません"

#: src/zfr_lib/lint/layout.py:65
msgid ""
"Add docs/<puff>.adoc and a meson custom_target with asciidoctor -b manpage "
"(see any language template)."
msgstr ""
"docs/<puff>.adoc と asciidoctor -b manpage を使う meson custom_target を追加"
"してください（任意の言語テンプレートを参照）。"

#: src/zfr_lib/lint/layout.py:78
#, python-format
msgid "bash completion: %s"
msgstr "bash 補完: %s"

#: src/zfr_lib/lint/layout.py:86
msgid "no *.bash bash-completion script at project root"
msgstr "プロジェクトルートに *.bash の bash-completion スクリプトがありません"

#: src/zfr_lib/lint/layout.py:87
msgid ""
"Add <puff>.bash and install it to datadir/bash-completion/completions "
"renamed to the command name (see meson.build in the template)."
msgstr ""
"<puff>.bash を追加し、コマンド名にリネームして datadir/bash-completion/"
"completions にインストールしてください（テンプレートの meson.build を参照）。"

#: src/zfr_lib/lint/layout.py:93
msgid "VERSION file present"
msgstr "VERSION ファイルあり"

#: src/zfr_lib/lint/layout.py:99
msgid "no VERSION file (changelog snapshot for tarball builds)"
msgstr ""
"VERSION ファイルがありません（tarball ビルド用の changelog スナップショット）"

#: src/zfr_lib/lint/layout.py:101
msgid ""
"Create VERSION with the latest debian/changelog version (one line). "
"Enable .githooks/pre-commit: git config core.hooksPath .githooks"
msgstr ""
"最新の debian/changelog バージョンで VERSION を作成してください（1 "
"行）。.githooks/pre-commit を有効化: git config core.hooksPath .githooks"

#: src/zfr_lib/lint/layout.py:195
msgid "no .githooks/pre-commit to sync VERSION from debian/changelog"
msgstr ""
"debian/changelog から VERSION を同期する .githooks/pre-commit がありません"

#: src/zfr_lib/lint/layout.py:197
msgid ""
"Walk up to the directory that contains .git, then put pre-commit in that "
"tree's .githooks (or core.hooksPath). The hook must update VERSION from "
"debian/changelog. `zfr create` copies one and sets git config "
"core.hooksPath .githooks."
msgstr ""
".git を含むディレクトリまで遡り、そのツリーの .githooks（または "
"core.hooksPath）に pre-commit を置いてください。フックは debian/changelog か"
"ら VERSION を更新しなければなりません。`zfr create` が一つコピーし、git "
"config core.hooksPath .githooks を設定します。"

#: src/zfr_lib/lint/layout.py:210
#, python-format
msgid "pre-commit syncs VERSION from debian/changelog (%s)"
msgstr "pre-commit が debian/changelog から VERSION を同期します (%s)"

#: src/zfr_lib/lint/layout.py:218
#, python-format
msgid "%s exists but does not sync VERSION from debian/changelog"
msgstr "%s は存在しますが debian/changelog から VERSION を同期しません"

#: src/zfr_lib/lint/layout.py:220
msgid ""
"The hook should read debian/changelog (dpkg-parsechangelog) and write "
"VERSION. See the zephyr .githooks/pre-commit template."
msgstr ""
"フックは debian/changelog を読み (dpkg-parsechangelog)、VERSION を書き込む必"
"要があります。zephyr の .githooks/pre-commit テンプレートを参照してください。"

#: src/zfr_lib/lint/leftovers.py:49
#, python-format
msgid "%s keeps the template placeholder banner (apps must rewrite it)"
msgstr ""
"%s はテンプレートのプレースホルダーバナーを残しています（アプリは書き換える必"
"要があります）"

#: src/zfr_lib/lint/leftovers.py:52
msgid ""
"After `zfr create`/`zfr rename`, rewrite this README and remove the "
"generated-from-template banner. Templates should keep this banner."
msgstr ""
"`zfr create`/`zfr rename` の後、この README を書き直し、generated-from-"
"template バナーを削除してください。テンプレートはこのバナーを残すべきです。"

#: src/zfr_lib/lint/leftovers.py:61
#, python-format
msgid "%s still has the template placeholder banner"
msgstr "%s にはまだテンプレートのプレースホルダーバナーがあります"

#: src/zfr_lib/lint/leftovers.py:64
#, python-format
msgid ""
"Rewrite %s for this project. Remove the generated-from-template banner and "
"describe the real commands, build, and license."
msgstr ""
"このプロジェクト向けに %s を書き直してください。generated-from-template バ"
"ナーを削除し、実際のコマンド、ビルド、ライセンスを説明します。"

#: src/zfr_lib/lint/leftovers.py:69
#, python-format
msgid "%s has no template banner"
msgstr "%s にテンプレートバナーはありません"

#: src/zfr_lib/lint/leftovers.py:101
#, python-format
msgid "%s tree may contain zephyr/some_puff1 placeholders (expected)"
msgstr ""
"%s ツリーには zephyr/some_puff1 プレースホルダーが含まれていても構いません"
"（想定どおり）"

#: src/zfr_lib/lint/leftovers.py:127 src/zfr_lib/lint/template.py:95
#, python-format
msgid " (+%d more)"
msgstr " (他 +%d)"

#: src/zfr_lib/lint/leftovers.py:132
#, python-format
msgid ""
"found %(hits)d leftover template token(s) (zephyr/%(token)s): "
"%(preview)s%(more)s"
msgstr ""
"残ったテンプレートトークンが %(hits)d 件 (zephyr/%(token)s): "
"%(preview)s%(more)s"

#: src/zfr_lib/lint/leftovers.py:134
msgid ""
"Run `zfr rename <project> [puff ...]` or replace remaining zephyr/some_puff1 "
"identifiers. After create, leftover tokens mean instantiation failed."
msgstr ""
"`zfr rename <project> [puff ...]` を実行するか、残っている zephyr/some_puff1 "
"識別子を置き換えてください。create 後にトークンが残っていればインスタンス化に"
"失敗しています。"

#: src/zfr_lib/lint/leftovers.py:138
msgid "no leftover zephyr/some_puff1 tokens"
msgstr "残った zephyr/some_puff1 トークンはありません"

#: src/zfr_lib/lint/meson.py:41
msgid "project() present"
msgstr "project() あり"

#: src/zfr_lib/lint/meson.py:47
msgid "meson.build has no project() call"
msgstr "meson.build に project() 呼び出しがありません"

#: src/zfr_lib/lint/meson.py:49
msgid ""
"project() must be the first Meson call. Copy the header from the language "
"template."
msgstr ""
"project() は最初の Meson 呼び出しでなければなりません。言語テンプレートから"
"ヘッダーをコピーしてください。"

#: src/zfr_lib/lint/meson.py:54
#, python-format
msgid "license %s"
msgstr "ライセンス %s"

#: src/zfr_lib/lint/meson.py:60
msgid "meson license is not AGPL-3.0-or-later"
msgstr "meson のライセンスが AGPL-3.0-or-later ではありません"

#: src/zfr_lib/lint/meson.py:63
#, python-format
msgid "Set license: '%s' in project()."
msgstr "project() で license: '%s' を設定してください。"

#: src/zfr_lib/lint/meson.py:69
#, python-format
msgid "%s set"
msgstr "%s 設定済み"

#: src/zfr_lib/lint/meson.py:75
#, python-format
msgid "missing %s (used for man pages)"
msgstr "%s がありません（man ページ用）"

#: src/zfr_lib/lint/meson.py:77
#, python-format
msgid ""
"Set %s next to project(), then pass -a project-author/email/year to "
"asciidoctor."
msgstr ""
"project() の隣に %s を設定し、asciidoctor に -a project-author/email/year を"
"渡してください。"

#: src/zfr_lib/lint/meson.py:82
msgid "version uses `zfr version`"
msgstr "バージョンは `zfr version` を使用します"

#: src/zfr_lib/lint/meson.py:88
msgid "version still uses inline git describe; zephyr style is `zfr version`"
msgstr ""
"バージョンはまだインラインの git describe を使っています。zephyr 流は `zfr "
"version` です"

#: src/zfr_lib/lint/meson.py:91
msgid ""
"In project(version: run_command(...)), prefer:\n"
"  v=$(zfr version 2>/dev/null || true)\n"
"  with fallback v=\"0.0.0\" # FIXED TO 0.0.0, DO NOT MODIFY\n"
"See bash/meson.build in the zephyr tree."
msgstr ""
"project(version: run_command(...)) では次を推奨します:\n"
"  v=$(zfr version 2>/dev/null || true)\n"
"  フォールバックは v=\"0.0.0\" # FIXED TO 0.0.0, DO NOT MODIFY\n"
"zephyr ツリーの bash/meson.build を参照してください。"

#: src/zfr_lib/lint/meson.py:102
msgid "could not find `zfr version` or git describe in project version"
msgstr ""
"プロジェクトのバージョンに `zfr version` も git describe も見つかりません"

#: src/zfr_lib/lint/meson.py:104
msgid "Use `zfr version` for project() version (see bash/meson.build)."
msgstr ""
"project() のバージョンには `zfr version` を使ってください（bash/meson.build "
"を参照）。"

#: src/zfr_lib/lint/meson.py:109
msgid "0.0.0 fallback present"
msgstr "0.0.0 フォールバックあり"

#: src/zfr_lib/lint/meson.py:115
msgid "no explicit 0.0.0 fallback for missing git/VERSION"
msgstr "git/VERSION 欠落時の明示的な 0.0.0 フォールバックがありません"

#: src/zfr_lib/lint/meson.py:117
msgid "Keep fallback v=\"0.0.0\" # FIXED TO 0.0.0, DO NOT MODIFY"
msgstr ""
"フォールバックを維持してください v=\"0.0.0\" # FIXED TO 0.0.0, DO NOT MODIFY"

#: src/zfr_lib/lint/meson.py:122
msgid "asciidoctor man pages"
msgstr "asciidoctor による man ページ"

#: src/zfr_lib/lint/meson.py:128
msgid "meson.build does not invoke asciidoctor"
msgstr "meson.build は asciidoctor を呼び出していません"

#: src/zfr_lib/lint/meson.py:130
msgid ""
"find_program('asciidoctor') and custom_target(..., '-b', 'manpage', ...)."
msgstr ""
"find_program('asciidoctor') と custom_target(..., '-b', 'manpage', ...)。"

#: src/zfr_lib/lint/meson.py:135
msgid "run_target look present"
msgstr "run_target look あり"

#: src/zfr_lib/lint/meson.py:141
msgid "no run_target('look') DESTDIR preview"
msgstr "run_target('look') の DESTDIR プレビューがありません"

#: src/zfr_lib/lint/meson.py:143
msgid ""
"Add run_target look that meson install's into a tempdir and runs tree (see "
"templates)."
msgstr ""
"tempdir へ meson install し tree を実行する run_target look を追加してくださ"
"い（テンプレート参照）。"

#: src/zfr_lib/lint/meson.py:148
msgid "installs bash-completion"
msgstr "bash-completion をインストールします"

#: src/zfr_lib/lint/meson.py:154
msgid "does not install bash-completion"
msgstr "bash-completion をインストールしません"

#: src/zfr_lib/lint/meson.py:156
msgid ""
"install_data(..., install_dir: datadir / 'bash-completion' / 'completions', "
"rename: command)."
msgstr ""
"install_data(..., install_dir: datadir / 'bash-completion' / 'completions', "
"rename: command). を使ってください。"

#: src/zfr_lib/lint/report.py:73
msgid "FAIL"
msgstr "失敗"

#: src/zfr_lib/lint/report.py:73
msgid "PASS"
msgstr "成功"

#: src/zfr_lib/lint/report.py:82
msgid "status:"
msgstr "状態:"

#: src/zfr_lib/lint/report.py:83
#, python-format
msgid "errors=%s"
msgstr "エラー=%s"

#: src/zfr_lib/lint/report.py:84
#, python-format
msgid "warnings=%s"
msgstr "警告=%s"

#: src/zfr_lib/lint/report.py:85
#, python-format
msgid "notes=%s"
msgstr "注記=%s"

#: src/zfr_lib/lint/report.py:89
msgid "zephyr meta-repo (templates + CLI tools)"
msgstr "zephyr メタリポジトリ（テンプレート + CLI ツール）"

#: src/zfr_lib/lint/report.py:90
msgid ""
"language template inside the meta-repo (placeholders like zephyr/some_puff1 "
"are expected)"
msgstr ""
"メタリポジトリ内の言語テンプレート（zephyr/some_puff1 のようなプレースホルダ"
"は想定どおり）"

#: src/zfr_lib/lint/report.py:91
msgid ""
"project instantiated from a language template (directory name must match "
"meson/debian; no leftover zephyr/some_puff1 tokens)"
msgstr ""
"言語テンプレートから実体化したプロジェクト（ディレクトリ名は meson/debian と"
"一致必須。zephyr/some_puff1 トークンの取り残しなし）"

#: src/zfr_lib/lint/report.py:93
#, python-format
msgid "role: %s"
msgstr "役割: %s"

#: src/zfr_lib/lint/report.py:95
msgid "Zephyr style (finish the project to this contract)"
msgstr "Zephyr スタイル（この契約までプロジェクトを仕上げる）"

#: src/zfr_lib/lint/report.py:97
msgid ""
"License AGPL-3.0-or-later (meson license, debian/copyright AGPL-3+, rpm "
"License)."
msgstr ""
"ライセンス AGPL-3.0-or-later（meson license、debian/copyright AGPL-3+、rpm "
"License）。"

#: src/zfr_lib/lint/report.py:98
msgid ""
"Build with Meson; debian/rules uses dh --buildsystem=meson --"
"builddirectory=debian/build."
msgstr ""
"Meson でビルド。debian/rules は dh --buildsystem=meson --"
"builddirectory=debian/build を使う。"

#: src/zfr_lib/lint/report.py:99
msgid ""
"project() version from `zfr version`; keep fallback v=\"0.0.0\" # FIXED TO "
"0.0.0, DO NOT MODIFY."
msgstr ""
"project() の version は `zfr version` から。フォールバックは v=\"0.0.0\" # "
"FIXED TO 0.0.0, DO NOT MODIFY."

#: src/zfr_lib/lint/report.py:100
msgid ""
"Man pages: docs/*.adoc + asciidoctor -b manpage; translated pages under "
"share/man/<locale>/man1 (whole-document adoc, not po4a)."
msgstr ""
"マニュアル: docs/*.adoc + asciidoctor -b manpage。翻訳は share/man/<locale>/"
"man1（文書全体の adoc。po4a ではない）。"

#: src/zfr_lib/lint/report.py:101
msgid ""
"Packaging: debian/control Build-Depends meson, ninja-build, asciidoctor; "
"optional rpm/ aligned with debian."
msgstr ""
"パッケージ: debian/control Build-Depends meson, ninja-build, asciidoctor。任"
"意の rpm/ は debian と揃える。"

#: src/zfr_lib/lint/report.py:102
msgid ""
"i18n: English source; zfr lint -l/--l10n-level L0–L3 (default L1). L1=10 "
"locales, L2=20, L3=30. Defaults in .config/zfr/lint.options."
msgstr ""
"i18n: 英語が原文。zfr lint -l/--l10n-level L0–L3（既定 L1）。L1=10 ロケール、"
"L2=20、L3=30。既定は .config/zfr/lint.options。"

#: src/zfr_lib/lint/report.py:103
msgid ""
"Apps: `zfr rename <dir>` then `zfr add <puff>`; VERSION matches debian/"
"changelog (git describe may differ)."
msgstr ""
"アプリ: `zfr rename <dir>` のあと `zfr add <puff>`。VERSION は debian/"
"changelog と一致（git describe は異なる場合あり）。"

#: src/zfr_lib/lint/report.py:116
msgid "error"
msgstr "エラー"

#: src/zfr_lib/lint/report.py:117
msgid "warn"
msgstr "警告"

#: src/zfr_lib/lint/report.py:118
msgid "note"
msgstr "注記"

#: src/zfr_lib/lint/report.py:119
msgid "ok"
msgstr "正常"

#: src/zfr_lib/lint/report.py:132
msgid "fix:"
msgstr "修正:"

#: src/zfr_lib/lint/report.py:139
msgid "Next steps (zephyr style)"
msgstr "次の手順（zephyr スタイル）"

#: src/zfr_lib/lint/report.py:145
msgid ""
"Hint: after edits, re-run `zfr lint` from the project (or a subdirectory). "
"`zfr about -d -r` dumps packaging fields. Version for Meson/RPM is `zfr "
"version`. `zfr ize` applies missing debian/rpm/meson/man/version-subst "
"upgrades."
msgstr ""
"ヒント: 編集後はプロジェクト（またはその下のディレクトリ）から `zfr lint` を"
"再実行。`zfr about -d -r` はパッケージ欄を出す。Meson/RPM の版は `zfr "
"version`。`zfr ize` は不足している debian/rpm/meson/man/version-subst の更新"
"を適用する。"

#: src/zfr_lib/lint/rpm.py:41
msgid "no rpm/*.spec (optional, but zephyr style includes RPM next to debian/)"
msgstr ""
"rpm/*.spec がない（任意だが、zephyr スタイルは debian/ の隣に RPM を置く）"

#: src/zfr_lib/lint/rpm.py:44
#, no-python-format
msgid ""
"Copy rpm/ from a language template; name the spec after the package (rpm/"
"<Source>.spec, not zephyr.spec) and keep a Makefile using `zfr version`. "
"Align Name/Summary/Requires/URL with debian/control. Or run `zfr ize`."
msgstr ""
"言語テンプレートから rpm/ をコピー。spec はパッケージ名に合わせる（rpm/"
"<Source>.spec。zephyr.spec ではない）。Makefile は `zfr version` を使う。"
"Name/Summary/Requires/URL を debian/control と揃える。または `zfr ize`。"

#: src/zfr_lib/lint/rpm.py:63
#, no-python-format, python-brace-format
msgid "spec Version is dynamic %{version}"
msgstr "spec の Version は動的 %{version}"

#: src/zfr_lib/lint/rpm.py:72
msgid "spec Version is hardcoded; zephyr style injects `zfr version`"
msgstr "spec の Version が直書き。zephyr スタイルは `zfr version` を入れる"

#: src/zfr_lib/lint/rpm.py:76
#, no-python-format
msgid ""
"Use Version: %{version} with %{!?version:%global version 0.0.0} and freeze "
"via rpm/Makefile (`zfr version` / `zfr version -r`)."
msgstr ""
"Version: %{version} を %{!?version:%global version 0.0.0} とともに使い、rpm/"
"Makefile で固定する（`zfr version` / `zfr version -r`）。"

#: src/zfr_lib/lint/rpm.py:82
#, python-format
msgid "License %s"
msgstr "ライセンス %s"

#: src/zfr_lib/lint/rpm.py:88
msgid "spec License is not AGPL-3.0-or-later"
msgstr "spec の License が AGPL-3.0-or-later ではない"

#: src/zfr_lib/lint/rpm.py:91
#, python-format
msgid "License:        %s"
msgstr "License:        %s"

#: src/zfr_lib/lint/rpm.py:102
#, python-format
msgid "spec URL=%(url)r != debian Homepage=%(homepage)r"
msgstr "spec URL=%(url)r != debian Homepage=%(homepage)r"

#: src/zfr_lib/lint/rpm.py:105
msgid "Set URL: to the same Homepage as debian/control."
msgstr "URL: を debian/control の Homepage と同じにする。"

#: src/zfr_lib/lint/rpm.py:117
msgid "spec Summary does not match debian Description first line"
msgstr "spec の Summary が debian Description の先頭行と一致しない"

#: src/zfr_lib/lint/rpm.py:120
#, python-format
msgid "Summary:        %s"
msgstr "Summary:        %s"

#: src/zfr_lib/lint/rpm.py:125
msgid "spec uses Meson (not autotools)"
msgstr "spec は Meson を使う（autotools ではない）"

#: src/zfr_lib/lint/rpm.py:131
msgid "spec still uses autotools; zephyr packages build with Meson"
msgstr ""
"spec がまだ autotools を使っている。zephyr パッケージは Meson でビルドする"

#: src/zfr_lib/lint/rpm.py:134
#, no-python-format, python-brace-format
msgid ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"
msgstr ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"

#: src/zfr_lib/lint/rpm.py:142
msgid "Makefile uses `zfr version`"
msgstr "Makefile は `zfr version` を使う"

#: src/zfr_lib/lint/rpm.py:149
msgid "rpm/Makefile does not call `zfr version`"
msgstr "rpm/Makefile が `zfr version` を呼び出していない"

#: src/zfr_lib/lint/rpm.py:152
#, no-python-format
msgid ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"
msgstr ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"

#: src/zfr_lib/lint/rpm.py:161
msgid "no rpm/Makefile convenience targets"
msgstr "rpm/Makefile に便利なターゲットがない"

#: src/zfr_lib/lint/rpm.py:163
msgid "Copy bash/rpm/Makefile (srpm/rpm via zfr version)."
msgstr "bash/rpm/Makefile をコピー（srpm/rpm は zfr version 経由）。"

#: src/zfr_lib/lint/rpm.py:172
msgid "bash spec Requires missing bash-shlib"
msgstr "bash spec の Requires に bash-shlib がない"

#: src/zfr_lib/lint/rpm.py:174
msgid "Requires:       bash-shlib  (same as debian Depends)"
msgstr "Requires:       bash-shlib  （debian Depends と同じ）"

#: src/zfr_lib/lint/source_size.py:55
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); file is very long"
msgstr "%(rel)s は %(lines)d 行（>%(limit)d）。ファイルが非常に長い"

#: src/zfr_lib/lint/source_size.py:59
msgid ""
"Split this file into smaller modules; keep each unit focused and testable."
msgstr ""
"このファイルを小さなモジュールに分割し、各単位を焦点を絞ってテスト可能にす"
"る。"

#: src/zfr_lib/lint/source_size.py:67
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); consider modularizing soon"
msgstr "%(rel)s は %(lines)d 行（>%(limit)d）。早めのモジュール化を検討"

#: src/zfr_lib/lint/source_size.py:71
msgid "Plan extraction of helpers or submodules before the file grows further."
msgstr ""
"ファイルがさらに大きくなる前に、ヘルパーやサブモジュールの切り出しを計画す"
"る。"

#: src/zfr_lib/lint/source_size.py:75
msgid "no oversized source files"
msgstr "過大なソースファイルはない"

#: src/zfr_lib/lint/template.py:51
msgid "zfr CLI package is not a language template"
msgstr "zfr CLI パッケージは言語テンプレートではない"

#: src/zfr_lib/lint/template.py:93
msgid "structural files from the language template are present"
msgstr "言語テンプレートの構造ファイルは揃っている"

#: src/zfr_lib/lint/template.py:100
#, python-format
msgid ""
"language template %(lang)s has extra scaffolding not in this tree: "
"%(preview)s%(more)s"
msgstr ""
"言語テンプレート %(lang)s に、このツリーに無い追加の足場がある: "
"%(preview)s%(more)s"

#: src/zfr_lib/lint/template.py:102
#, python-format
msgid ""
"Compare with the %(lang)s template under pkgdatadir. Copy missing debian/"
"docs/src/rpm files (rpm/ uses %(name)s.spec, not zephyr.spec), or `zfr add` "
"puffs. Do not copy build/ or debian leftover stamp files. Example commons "
"modules are optional."
msgstr ""
"pkgdatadir 下の %(lang)s テンプレートと比較。欠けている debian/docs/src/rpm "
"ファイルをコピー（rpm/ は %(name)s.spec。zephyr.spec ではない）。または `zfr "
"add` で puff。build/ や debian の残りスタンプはコピーしない。例示の commons "
"モジュールは任意。"

#: src/zfr_lib/release.py:26
msgid "Debian binary-only build (no .dsc)"
msgstr "Debian バイナリのみビルド（.dsc なし）"

#: src/zfr_lib/release.py:32
msgid "Reuse build cache"
msgstr "ビルドキャッシュを再利用"

#: src/zfr_lib/release.py:38
msgid "Reuse existing artifacts; build only if missing"
msgstr "既存のアーティファクトを再利用；不足時のみビルド"

#: src/zfr_lib/release.py:43
