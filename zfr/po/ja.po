#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "changelog/git 著者名（デフォルト: %s）"

#: src/create.py:311
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "changelog/git 著者メール（デフォルト: %s）"

