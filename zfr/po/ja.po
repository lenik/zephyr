msgstr "テンプレート言語（デフォルト: python; 次のいずれか: %s）"

#: src/create.py:299
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "debian changelog ディストリビューション（デフォルト: %s）"

#: src/create.py:303
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "初期パッケージバージョンと git タグ（デフォルト: %s）"

