#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "เขียนแอร์ไคฟ์ไปที่ DIR (ค่าเริ่มต้น: meson-dist หรือ %_topdir/SOURCES ($HOME/rpmbuild) ด้วย --rpm)"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "ไดเรกทอรี build Meson (ค่าเริ่มต้น: /build เมื่อตรงกับ source tree นี้ มิฉะนั้น <project>/build)"

#: src/dist.py:81
msgid "archive format (default: xz)"
msgstr "รูปแบบแอร์ไคฟ์ (ค่าเริ่มต้น: xz)"

#: src/dist.py:87
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "ตั้งชื่อแอร์ไคฟ์ NAME-VERSION.tar.xz และเขียนไป %_topdir/SOURCES ($HOME/rpmbuild) เว้นแต่ระบุ -o"

#: src/dist.py:96
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "ส่ง --allow-dirty ไปยัง meson dist (ค่าเริ่มต้น: allow)"

