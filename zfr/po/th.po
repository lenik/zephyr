#: src/zfr_lib/lang/python.py:21
msgid "tests/ present"
msgstr "มี tests/"

#: src/zfr_lib/lang/antlr.py:47 src/zfr_lib/lang/as.py:35
#: src/zfr_lib/lang/bison.py:43 src/zfr_lib/lang/clib.py:35
#: src/zfr_lib/lang/cpplib.py:35 src/zfr_lib/lang/cpp.py:22
#: src/zfr_lib/lang/c.py:22 src/zfr_lib/lang/gcc.py:53
msgid "no tests/ directory"
msgstr "ไม่มีไดเรกทอรี tests/"

#: src/zfr_lib/lang/antlr.py:49
msgid "Add tests/TestCommons.java or fixture checks for parser output."
msgstr "เพิ่ม tests/TestCommons.java หรือการตรวจ fixture สำหรับเอาต์พุตของ parser"

#: src/zfr_lib/lang/as.py:37
msgid "Add tests/smoke.sh and meson test() for stdin/stdout copy."
msgstr "เพิ่ม tests/smoke.sh และ meson test() สำหรับการคัดลอก stdin/stdout"

#: src/zfr_lib/lang/bash.py:45
#, python-format
msgid "src scripts: %s"
msgstr "สคริปต์ใน src: %s"

#: src/zfr_lib/lang/bash.py:46
msgid "no src/*.in scripts"
msgstr "ไม่มีสคริปต์ src/*.in"

#: src/zfr_lib/lang/bash.py:47
msgid ""
"Keep configured scripts as src/<puff>.in with @PACKAGE@/@VERSION@ and meson "
"configure_file + install_mode rwxr-xr-x."
msgstr ""
"คงสคริปต์ที่ตั้งค่าไว้เป็น src/<puff>.in พร้อม @PACKAGE@/@VERSION@ และ meson "
"configure_file + install_mode rwxr-xr-x"

#: src/zfr_lib/lang/bison.py:45
msgid "Add tests/ with fixture checks for parser dump/format output."
msgstr "เพิ่ม tests/ พร้อมการตรวจ fixture สำหรับเอาต์พุต dump/format ของ parser"

#: src/zfr_lib/lang/clib.py:36 src/zfr_lib/lang/cpplib.py:36
#: src/zfr_lib/lang/cpp.py:23 src/zfr_lib/lang/c.py:23
#: src/zfr_lib/lang/gcc.py:55
msgid "Add tests/ and meson test() entries like the C family templates."
msgstr "เพิ่ม tests/ และรายการ meson test() แบบเดียวกับเทมเพลตตระกูล C"

#: src/zfr_lib/lang/cobol.py:37
msgid "no tests/ (cobol template uses cobc + meson test)"
msgstr "ไม่มี tests/ (เทมเพลต cobol ใช้ cobc + meson test)"

#: src/zfr_lib/lang/cobol.py:39
msgid "Add tests/test_commons.sh or similar smoke test for cobc."
msgstr "เพิ่ม tests/test_commons.sh หรือการทดสอบควันที่คล้ายกันสำหรับ cobc"

#: src/zfr_lib/lang/d.py:37
msgid "no tests/ (D template uses ldc/dmd + meson test)"
msgstr "ไม่มี tests/ (เทมเพลต D ใช้ ldc/dmd + meson test)"

#: src/zfr_lib/lang/d.py:39
msgid "Add tests/test_commons.d and meson test() executable."
msgstr "เพิ่ม tests/test_commons.d และไฟล์ปฏิบัติการ meson test()"

#: src/zfr_lib/lang/fortran.py:37
msgid "no tests/ (fortran template uses gfortran + meson test)"
msgstr "ไม่มี tests/ (เทมเพลต fortran ใช้ gfortran + meson test)"

#: src/zfr_lib/lang/fortran.py:39
msgid "Add tests/test_commons.f90 and meson test() executable."
msgstr "เพิ่ม tests/test_commons.f90 และไฟล์ปฏิบัติการ meson test()"

#: src/zfr_lib/lang/go.py:22
msgid "missing go.mod"
msgstr "ไม่มี go.mod"

#: src/zfr_lib/lang/go.py:23
msgid ""
"Add go.mod; meson should `go build` with -X main.buildVersion from "
"meson.project_version()."
msgstr ""
"เพิ่ม go.mod; meson ควรเรียก `go build` พร้อม -X main.buildVersion จาก "
"meson.project_version()"

#: src/zfr_lib/lang/kotlin.py:23
msgid "no tests/ (kotlin template uses kotlinc + meson test)"
msgstr "ไม่มี tests/ (เทมเพลต kotlin ใช้ kotlinc + meson test)"

#: src/zfr_lib/lang/kotlin.py:24
msgid "Add tests/Test*.kt and meson test() compiling with kotlinc."
msgstr "เพิ่ม tests/Test*.kt และ meson test() ที่คอมไพล์ด้วย kotlinc"

#: src/zfr_lib/lang/lua.py:23
msgid "no tests/ (lua template uses lua tests + meson test)"
msgstr "ไม่มี tests/ (เทมเพลต lua ใช้การทดสอบ lua + meson test)"

#: src/zfr_lib/lang/lua.py:24
msgid ""
"Add tests/test_*.lua and meson test() invoking lua with LUA_PATH=src/?.lua."
msgstr "เพิ่ม tests/test_*.lua และ meson test() ที่เรียก lua ด้วย LUA_PATH=src/?.lua"

#: src/zfr_lib/lang/nim.py:25
msgid "no tests/ (nim template uses unittest + meson test)"
msgstr "ไม่มี tests/ (เทมเพลต nim ใช้ unittest + meson test)"

#: src/zfr_lib/lang/nim.py:26
msgid "Add tests/test_*.nim and meson test() with nim r."
msgstr "เพิ่ม tests/test_*.nim และ meson test() ด้วย nim r"

#: src/zfr_lib/lang/pascal.py:37
msgid "no tests/ (pascal template uses fpc + meson test)"
msgstr "ไม่มี tests/ (เทมเพลต pascal ใช้ fpc + meson test)"

#: src/zfr_lib/lang/pascal.py:39
msgid "Add tests/test_commons.pas and meson test() with fpc."
msgstr "เพิ่ม tests/test_commons.pas และ meson test() ด้วย fpc"

#: src/zfr_lib/lang/python.py:22
msgid "no tests/ (python template uses unittest + meson test)"
msgstr "ไม่มี tests/ (เทมเพลต python ใช้ unittest + meson test)"

#: src/zfr_lib/lang/python.py:23
msgid "Add tests/test_*.py and meson test() with PYTHONPATH=src."
msgstr "เพิ่ม tests/test_*.py และ meson test() ด้วย PYTHONPATH=src"

#: src/zfr_lib/lang/rust.py:22
msgid "missing Cargo.toml"
msgstr "ไม่มี Cargo.toml"

#: src/zfr_lib/lang/rust.py:23
msgid ""
"Rust zephyr projects keep Cargo.toml plus meson custom_target for the binary."
msgstr ""
"โครงการ zephyr ภาษา Rust คง Cargo.toml พร้อม meson custom_target สำหรับไบนารี"

#: src/zfr_lib/lang/zig.py:23
msgid "missing build.zig"
msgstr "ไม่มี build.zig"

#: src/zfr_lib/lang/zig.py:24
msgid "Add build.zig; meson should invoke `zig build -Doptimize=ReleaseFast`."
msgstr "เพิ่ม build.zig; meson ควรเรียก `zig build -Doptimize=ReleaseFast`"

#: src/zfr_lib/lint/debian.py:42
#, python-format
msgid "Build-Depends has %s"
msgstr "Build-Depends มี %s"

#: src/zfr_lib/lint/debian.py:48
#, python-format
msgid "Build-Depends missing %s"
msgstr "Build-Depends ไม่มี %s"

#: src/zfr_lib/lint/debian.py:50
#, python-format
msgid ""
"Add %s to Build-Depends (zephyr packages build with Meson + AsciiDoc man "
"pages)."
msgstr ""
"เพิ่ม %s ใน Build-Depends (แพ็กเกจ zephyr สร้างด้วย Meson และหน้า man ของ AsciiDoc)"

#: src/zfr_lib/lint/debian.py:54
msgid "debhelper-compat present"
msgstr "มี debhelper-compat"

#: src/zfr_lib/lint/debian.py:60
msgid "Build-Depends missing debhelper-compat (= 13)"
msgstr "Build-Depends ไม่มี debhelper-compat (= 13)"

#: src/zfr_lib/lint/debian.py:62
msgid "Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"
msgstr ""
"Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"

#: src/zfr_lib/lint/debian.py:72
msgid "Package stanza missing Architecture"
msgstr "บท Package ไม่มี Architecture"

#: src/zfr_lib/lint/debian.py:74
msgid "Architecture: all  (scripts) or any (compiled)."
msgstr "Architecture: all  (สคริปต์) หรือ any (คอมไพล์แล้ว)"

#: src/zfr_lib/lint/debian.py:82
#, python-format
msgid "bash packages should be Architecture: all (got %s)"
msgstr "แพ็กเกจ bash ควรเป็น Architecture: all (ได้ %s)"

#: src/zfr_lib/lint/debian.py:84
msgid "Architecture: all"
msgstr "Architecture: all"

#: src/zfr_lib/lint/debian.py:92
#, python-format
msgid "%s packages are usually Architecture: any (got all)"
msgstr "แพ็กเกจ %s มักเป็น Architecture: any (ได้ all)"

#: src/zfr_lib/lint/debian.py:94
msgid "Architecture: any"
msgstr "Architecture: any"

#: src/zfr_lib/lint/debian.py:98
#, python-format
msgid "Architecture: %s"
msgstr "ฟิลด์ Architecture: %s"

#: src/zfr_lib/lint/debian.py:102
#, python-format
msgid "Homepage: %s"
msgstr "ฟิลด์ Homepage: %s"

#: src/zfr_lib/lint/debian.py:108
msgid "no Homepage"
msgstr "ไม่มี Homepage"

#: src/zfr_lib/lint/debian.py:110
msgid "Set Homepage: to the project URL."
msgstr "ตั้ง Homepage: เป็น URL ของโครงการ"

#: src/zfr_lib/lint/debian.py:116
msgid "dh meson debian/build"
msgstr "dh ใช้ meson ที่ debian/build"

#: src/zfr_lib/lint/debian.py:122
msgid ""
"debian/rules is not dh --buildsystem=meson --builddirectory=debian/build"
msgstr "debian/rules ไม่ใช่ dh --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:125
#, no-python-format
msgid ""
"Use:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"ใช้:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:131
msgid "copyright mentions AGPL"
msgstr "copyright กล่าวถึง AGPL"

#: src/zfr_lib/lint/debian.py:137
msgid "debian/copyright does not mention AGPL"
msgstr "debian/copyright ไม่ได้กล่าวถึง AGPL"

#: src/zfr_lib/lint/debian.py:139
msgid "Use the template debian/copyright (License: AGPL-3+)."
msgstr "ใช้เทมเพลต debian/copyright (License: AGPL-3+)"

#: src/zfr_lib/lint/debian.py:145
#, python-format
msgid "source format %s"
msgstr "รูปแบบแหล่ง %s"

#: src/zfr_lib/lint/debian.py:154
#, python-format
msgid "VERSION=%(file)r != changelog %(changelog)r"
msgstr "VERSION=%(file)r != บันทึกการเปลี่ยนแปลง %(changelog)r"

#: src/zfr_lib/lint/debian.py:156
msgid ""
"VERSION should match the latest debian/changelog entry (pre-commit hook "
"updates it). Git describe may still differ."
msgstr ""
"VERSION ต้องตรงกับรายการล่าสุดใน debian/changelog (ฮุก pre-commit เป็นผู้ปรับปรุง) Git "
"describe อาจยังต่างอยู่"

#: src/zfr_lib/lint/debian.py:162
#, python-format
msgid "VERSION matches changelog %s"
msgstr "VERSION ตรงกับบันทึกการเปลี่ยนแปลง %s"

#: src/zfr_lib/lint/debian.py:172
msgid "bash project Depends missing bash-shlib"
msgstr "โครงการ bash ไม่มี bash-shlib ใน Depends"

#: src/zfr_lib/lint/debian.py:174
msgid "Depends: bash, bash-shlib, ${misc:Depends}"
msgstr "Depends: bash, bash-shlib, ${misc:Depends}"

#: src/zfr_lib/lint/debian.py:178
msgid "Depends includes bash-shlib"
msgstr "Depends มี bash-shlib"

#: src/zfr_lib/lint/i18n_check.py:56
#, python-format
msgid "l10n level %s: no locale coverage required"
msgstr "ระดับ l10n %s: ไม่ต้องครอบคลุมโลแคล"

#: src/zfr_lib/lint/i18n_check.py:65
#, python-format
msgid "l10n level %(level)s (%(count)d locales)"
msgstr "ระดับ l10n %(level)s (%(count)d โลแคล)"

#: src/zfr_lib/lint/i18n_check.py:78
msgid "no po/ directory (optional unless the project uses gettext)"
msgstr "ไม่มีไดเรกทอรี po/ (ทางเลือก เว้นแต่โปรเจกต์ใช้ gettext)"

#: src/zfr_lib/lint/i18n_check.py:79
#, python-format
msgid ""
"If the app is translated, add po/ with LINGUAS + *.po and i18n.gettext() in "
"meson.build. Required locales at %(level)s: %(locales)s (source language "
"%(source)s)."
msgstr ""
"หากแปลแอปแล้ว ให้เพิ่ม po/ พร้อม LINGUAS + *.po และ i18n.gettext() ใน meson.build "
"โลแคลที่ต้องมีที่ %(level)s: %(locales)s (ภาษาต้นทาง %(source)s)"

#: src/zfr_lib/lint/i18n_check.py:97
msgid "po/ exists but po/LINGUAS is missing or empty"
msgstr "มี po/ แต่ po/LINGUAS ขาดหรือว่าง"

#: src/zfr_lib/lint/i18n_check.py:99
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"สร้าง po/LINGUAS โดยระบุอย่างน้อย:\n"
"%(locales)s\n"
"(อังกฤษ/%(source)s เป็นแหล่ง msgid จึงไม่ใส่ในรายการ)"

#: src/zfr_lib/lint/i18n_check.py:114
#, python-format
msgid "po/LINGUAS missing %(level)s locale(s): %(locales)s"
msgstr "po/LINGUAS ขาดโลแคล %(level)s: %(locales)s"

#: src/zfr_lib/lint/i18n_check.py:117
#, python-format
msgid ""
"Level %(level)s requires: %(locales)s (source %(source)s; zh-cn→zh_CN, zh-"
"tw→zh_TW). Append the missing lines to LINGUAS and add matching po/"
"<locale>.po."
msgstr ""
"ระดับ %(level)s ต้องการ: %(locales)s (แหล่ง %(source)s; zh-cn→zh_CN, zh-"
"tw→zh_TW) เติมบรรทัดที่ขาดใน LINGUAS และเพิ่ม po/<locale>.po ที่ตรงกัน"

#: src/zfr_lib/lint/i18n_check.py:132
#, python-format
msgid "po/LINGUAS covers %s locale set"
msgstr "po/LINGUAS ครอบคลุมชุดโลแคล %s"

#: src/zfr_lib/lint/i18n_check.py:147
#, python-format
msgid "LINGUAS entries without po/<locale>.po: %s"
msgstr "รายการ LINGUAS ที่ไม่มี po/<locale>.po: %s"

#: src/zfr_lib/lint/i18n_check.py:149
msgid ""
"For each locale: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-"
"translator && msgmerge -U po/<locale>.po <domain>.pot"
msgstr ""
"สำหรับแต่ละโลแคล: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-"
"translator && msgmerge -U po/<locale>.po <domain>.pot"

#: src/zfr_lib/lint/i18n_check.py:160
#, python-format
msgid "%(level)s locale .po files present (%(count)d)"
msgstr "มีไฟล์ .po ของโลแคล %(level)s (%(count)d)"

#: src/zfr_lib/lint/i18n_check.py:192
#, python-format
msgid "missing whole-document man translations for %(level)s: %(files)s"
msgstr "ขาดคำแปล man ทั้งเอกสารสำหรับ %(level)s: %(files)s"

#: src/zfr_lib/lint/i18n_check.py:195
#, python-format
msgid ""
"Hand-translate docs/<locale>/<name>.adoc (full document, not po4a). "
"%(level)s requires: %(locales)s."
msgstr ""
"แปลด้วยมือ docs/<locale>/<name>.adoc (ทั้งเอกสาร ไม่ใช่ po4a) %(level)s ต้องการ: "
"%(locales)s"

#: src/zfr_lib/lint/i18n_check.py:205
#, python-format
msgid "%s whole-document man translations present"
msgstr "มีคำแปล man ทั้งเอกสาร %s"

#: src/zfr_lib/lint/i18n_check.py:214
#, python-format
msgid "man translation still contains the English Name line: %s"
msgstr "คำแปล man ยังมีบรรทัด Name ภาษาอังกฤษ: %s"

#: src/zfr_lib/lint/i18n_check.py:217
msgid "Translate the Name line; do not leave the English wording."
msgstr "แปลบรรทัด Name อย่าทิ้งข้อความภาษาอังกฤษไว้"

#: src/zfr_lib/lint/identity.py:57
#, python-format
msgid "%(label)s is %(val)r, expected %(expected)r (directory name)"
msgstr "%(label)s คือ %(val)r คาดหวัง %(expected)r (ชื่อไดเรกทอรี)"

#: src/zfr_lib/lint/identity.py:60
#, python-format
msgid ""
"Set %(label)s to %(expected)r, or rename the directory. Use `zfr rename "
"%(expected)s` if leftover template names remain."
msgstr ""
"ตั้ง %(label)s เป็น %(expected)r หรือเปลี่ยนชื่อไดเรกทอรี ถ้ายังมีชื่อจากเทมเพลต ให้ใช้ `zfr "
"rename %(expected)s`"

#: src/zfr_lib/lint/identity.py:66
#, python-format
msgid "%(label)s=%(val)s"
msgstr "%(label)s=%(val)s"

#: src/zfr_lib/lint/identity.py:69
#, python-format
msgid "meson project name=%s"
msgstr "ชื่อโครงการ meson=%s"

#: src/zfr_lib/lint/identity.py:75
#, python-format
msgid "debian Source=%(source)r != meson project=%(meson)r"
msgstr "debian Source=%(source)r != โครงการ meson=%(meson)r"

#: src/zfr_lib/lint/identity.py:78
msgid "Keep Source, Package, and meson project() name identical."
msgstr "ให้ Source, Package และชื่อ meson project() ตรงกัน"

#: src/zfr_lib/lint/identity.py:82
#, python-format
msgid "Source=%s"
msgstr "Source=%s"

#: src/zfr_lib/lint/identity.py:95
#, python-format
msgid "spec Name=%(spec)r != debian/meson name %(want)r"
msgstr "spec Name=%(spec)r != ชื่อ debian/meson %(want)r"

#: src/zfr_lib/lint/identity.py:99
#, python-format
msgid "Set Name: %s in the spec (same as debian Source)."
msgstr "ตั้ง Name: %s ใน spec (เหมือน debian Source)"

#: src/zfr_lib/lint/identity.py:103
#, python-format
msgid "spec Name=%s"
msgstr "spec Name=%s"

#: src/zfr_lib/lint/__init__.py:99
msgid "validate project packaging and zephyr layout (walks parents from cwd)"
msgstr "ตรวจสอบการแพ็กเกจโปรเจกต์และเลย์เอาต์ zephyr (เดินขึ้นไปจาก cwd)"

#: src/zfr_lib/lint/__init__.py:100
msgid ""
"Check the current zephyr project for missing files and packaging/style "
"mistakes. Walks from cwd toward parent directories. CSR colors when stdout "
"is a TTY."
msgstr ""
"ตรวจโปรเจกต์ zephyr ปัจจุบันหาไฟล์ที่หายและข้อผิดพลาดการแพ็กเกจ/สไตล์ เดินจาก cwd "
"ไปยังไดเรกทอรีแม่ สี CSR เมื่อ stdout เป็น TTY"

#: src/zfr_lib/lint/__init__.py:104
msgid "show passing checks too"
msgstr "แสดงการตรวจที่ผ่านด้วย"

#: src/zfr_lib/lint/__init__.py:105
msgid "only print errors"
msgstr "พิมพ์เฉพาะข้อผิดพลาด"

#: src/zfr_lib/lint/__init__.py:106
msgid "treat warnings as failures (exit 1)"
msgstr "ถือคำเตือนเป็นความล้มเหลว (exit 1)"

#: src/zfr_lib/lint/__init__.py:113
msgid ""
"required gettext/manpage locale coverage L0–L3 (default: L1; project file "
"may override)"
msgstr "ความครอบคลุม gettext/คู่มือที่ต้องการ L0–L3 (ค่าเริ่มต้น L1; ไฟล์โปรเจกต์อาจแทนที่ได้)"

#: src/zfr_lib/lint/lang_bits.py:31
#, python-format
msgid "legacy example module %s; use commons or a specific name"
msgstr "มอดูลตัวอย่างรุ่นเก่า %s ใช้ commons หรือชื่อที่เจาะจง"

#: src/zfr_lib/lint/lang_bits.py:33
msgid ""
"Rename to src/commons.* (template convention) or a project-specific module "
"name."
msgstr "เปลี่ยนชื่อเป็น src/commons.* (ธรรมเนียมเทมเพลต) หรือชื่อมอดูลเฉพาะโปรเจกต์"

#: src/zfr_lib/lint/lang_bits.py:44
#, python-format
msgid "%s is only a template example for shared helpers"
msgstr "%s เป็นเพียงตัวอย่างเทมเพลตสำหรับตัวช่วยที่ใช้ร่วมกัน"

#: src/zfr_lib/lint/lang_bits.py:46
msgid ""
"common_lib / commons mean “extract reusable pieces”, but filenames should be "
"concrete. Rename to a specific module in real projects (e.g. stream_copy.py, "
"bulk.h). clib/cpplib keep lib.c/lib.cpp as their shared library entry."
msgstr ""
"common_lib / commons หมายถึง “แยกชิ้นส่วนที่ใช้ซ้ำได้” แต่ชื่อไฟล์ควรเจาะจง "
"ในโปรเจกต์จริงให้เปลี่ยนเป็นมอดูลเฉพาะ (เช่น stream_copy.py, bulk.h) clib/cpplib คง "
"lib.c/lib.cpp เป็นทางเข้าไลบรารีที่ใช้ร่วมกัน"

#: src/zfr_lib/lint/layout.py:35
msgid "Add a top-level meson.build with project(...)."
msgstr "เพิ่ม meson.build ระดับบนสุดที่มี project(...)"

#: src/zfr_lib/lint/layout.py:36
msgid "Copy LICENSE from the language template (AGPL-3.0-or-later)."
msgstr "คัดลอก LICENSE จากเทมเพลตภาษา (AGPL-3.0-or-later)"

#: src/zfr_lib/lint/layout.py:37
msgid "Add README.md describing this project."
msgstr "เพิ่ม README.md ที่อธิบายโปรเจกต์นี้"

#: src/zfr_lib/lint/layout.py:38
msgid "Add README-zh.md (Chinese summary), matching other zephyr templates."
msgstr "เพิ่ม README-zh.md (สรุปภาษาจีน) ให้สอดคล้องกับเทมเพลต zephyr อื่น"

#: src/zfr_lib/lint/layout.py:39
msgid "Add debian/ packaging (copy debian/ from the language template)."
msgstr "เพิ่มการแพ็กเกจ debian/ (คัดลอก debian/ จากเทมเพลตภาษา)"

#: src/zfr_lib/lint/layout.py:40
msgid "Add debian/changelog (zfr create writes one; or use dch)."
msgstr "เพิ่ม debian/changelog (zfr create จะเขียนให้ หรือใช้ dch)"

#: src/zfr_lib/lint/layout.py:41
msgid "Add debian/copyright in machine-readable format, License: AGPL-3+."
msgstr "เพิ่ม debian/copyright ในรูปแบบที่เครื่องอ่านได้ License: AGPL-3+"

#: src/zfr_lib/lint/layout.py:42
msgid ""
"Add debian/rules using dh --buildsystem=meson --builddirectory=debian/build."
msgstr ""
"เพิ่ม debian/rules โดยใช้ dh --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/layout.py:43
msgid "Add debian/source/format (typically '3.0 (native)')."
msgstr "เพิ่ม debian/source/format (โดยทั่วไปเป็น '3.0 (native)')"

#: src/zfr_lib/lint/layout.py:47
#, python-format
msgid "present: %s"
msgstr "มีอยู่: %s"

#: src/zfr_lib/lint/layout.py:50
#, python-format
msgid "missing %s"
msgstr "ไม่มี %s"

#: src/zfr_lib/lint/layout.py:56
#, python-format
msgid "AsciiDoc man sources: %s"
msgstr "ต้นฉบับ man แบบ AsciiDoc: %s"

#: src/zfr_lib/lint/layout.py:63
msgid "no docs/*.adoc man page source"
msgstr "ไม่มีต้นฉบับหน้า man docs/*.adoc"

#: src/zfr_lib/lint/layout.py:65
msgid ""
"Add docs/<puff>.adoc and a meson custom_target with asciidoctor -b manpage "
"(see any language template)."
msgstr ""
"เพิ่ม docs/<puff>.adoc และ meson custom_target ที่ใช้ asciidoctor -b manpage "
"(ดูเทมเพลตภาษาใดก็ได้)"

#: src/zfr_lib/lint/layout.py:78
#, python-format
msgid "bash completion: %s"
msgstr "การเติมคำ bash: %s"

#: src/zfr_lib/lint/layout.py:86
msgid "no *.bash bash-completion script at project root"
msgstr "ไม่มีสคริปต์ bash-completion แบบ *.bash ที่รากโปรเจกต์"

#: src/zfr_lib/lint/layout.py:87
msgid ""
"Add <puff>.bash and install it to datadir/bash-completion/completions "
"renamed to the command name (see meson.build in the template)."
msgstr ""
"เพิ่ม <puff>.bash แล้วติดตั้งไปที่ datadir/bash-completion/completions "
"โดยเปลี่ยนชื่อเป็นชื่อคำสั่ง (ดู meson.build ในเทมเพลต)"

#: src/zfr_lib/lint/layout.py:93
msgid "VERSION file present"
msgstr "มีไฟล์ VERSION"

#: src/zfr_lib/lint/layout.py:99
msgid "no VERSION file (changelog snapshot for tarball builds)"
msgstr "ไม่มีไฟล์ VERSION (ภาพนิ่ง changelog สำหรับการสร้าง tarball)"

#: src/zfr_lib/lint/layout.py:101
msgid ""
"Create VERSION with the latest debian/changelog version (one line). "
"Enable .githooks/pre-commit: git config core.hooksPath .githooks"
msgstr ""
"สร้าง VERSION ด้วยรุ่นล่าสุดจาก debian/changelog (บรรทัดเดียว) เปิดใช้ .githooks/pre-"
"commit: git config core.hooksPath .githooks"

#: src/zfr_lib/lint/layout.py:195
msgid "no .githooks/pre-commit to sync VERSION from debian/changelog"
msgstr "ไม่มี .githooks/pre-commit เพื่อซิงก์ VERSION จาก debian/changelog"

#: src/zfr_lib/lint/layout.py:197
msgid ""
"Walk up to the directory that contains .git, then put pre-commit in that "
"tree's .githooks (or core.hooksPath). The hook must update VERSION from "
"debian/changelog. `zfr create` copies one and sets git config "
"core.hooksPath .githooks."
msgstr ""
"เดินขึ้นไปยังไดเรกทอรีที่มี .git แล้ววาง pre-commit ใน .githooks ของทรีนั้น (หรือ "
"core.hooksPath) ฮุกต้องอัปเดต VERSION จาก debian/changelog `zfr create` "
"จะคัดลอกอันหนึ่งและตั้ง git config core.hooksPath .githooks"

#: src/zfr_lib/lint/layout.py:210
#, python-format
msgid "pre-commit syncs VERSION from debian/changelog (%s)"
msgstr "pre-commit ซิงก์ VERSION จาก debian/changelog (%s)"

#: src/zfr_lib/lint/layout.py:218
#, python-format
msgid "%s exists but does not sync VERSION from debian/changelog"
msgstr "มี %s แต่ไม่ได้ซิงก์ VERSION จาก debian/changelog"

#: src/zfr_lib/lint/layout.py:220
msgid ""
"The hook should read debian/changelog (dpkg-parsechangelog) and write "
"VERSION. See the zephyr .githooks/pre-commit template."
msgstr ""
"ฮุกควรอ่าน debian/changelog (dpkg-parsechangelog) แล้วเขียน VERSION ดูเทมเพลต "
"zephyr .githooks/pre-commit"

#: src/zfr_lib/lint/leftovers.py:49
#, python-format
msgid "%s keeps the template placeholder banner (apps must rewrite it)"
msgstr "%s ยังคงแบนเนอร์ตัวยึดของเทมเพลตไว้ (แอปต้องเขียนใหม่)"

#: src/zfr_lib/lint/leftovers.py:52
msgid ""
"After `zfr create`/`zfr rename`, rewrite this README and remove the "
"generated-from-template banner. Templates should keep this banner."
msgstr ""
"หลัง `zfr create`/`zfr rename` ให้เขียน README นี้ใหม่และลบแบนเนอร์ generated-from-"
"template เทมเพลตควรเก็บแบนเนอร์นี้ไว้"

#: src/zfr_lib/lint/leftovers.py:61
#, python-format
msgid "%s still has the template placeholder banner"
msgstr "%s ยังมีแบนเนอร์ตัวยึดของเทมเพลตอยู่"

#: src/zfr_lib/lint/leftovers.py:64
#, python-format
msgid ""
"Rewrite %s for this project. Remove the generated-from-template banner and "
"describe the real commands, build, and license."
msgstr ""
"เขียน %s ใหม่สำหรับโปรเจกต์นี้ ลบแบนเนอร์ generated-from-template และอธิบายคำสั่งจริง "
"การสร้าง และสัญญาอนุญาต"

#: src/zfr_lib/lint/leftovers.py:69
#, python-format
msgid "%s has no template banner"
msgstr "%s ไม่มีแบนเนอร์เทมเพลต"

#: src/zfr_lib/lint/leftovers.py:101
#, python-format
msgid "%s tree may contain zephyr/some_puff1 placeholders (expected)"
msgstr "ทรี %s อาจมีตัวยึด zephyr/some_puff1 (เป็นที่คาดไว้)"

#: src/zfr_lib/lint/leftovers.py:127 src/zfr_lib/lint/template.py:95
#, python-format
msgid " (+%d more)"
msgstr " (+อีก %d)"

#: src/zfr_lib/lint/leftovers.py:132
#, python-format
msgid ""
"found %(hits)d leftover template token(s) (zephyr/%(token)s): "
"%(preview)s%(more)s"
msgstr ""
"พบโทเค็นเทมเพลตที่เหลือ %(hits)d รายการ (zephyr/%(token)s): %(preview)s%(more)s"

#: src/zfr_lib/lint/leftovers.py:134
msgid ""
"Run `zfr rename <project> [puff ...]` or replace remaining zephyr/some_puff1 "
"identifiers. After create, leftover tokens mean instantiation failed."
msgstr ""
"รัน `zfr rename <project> [puff ...]` หรือแทนที่ตัวระบุ zephyr/some_puff1 ที่เหลือ "
"หลัง create หากยังมีโทเค็นเหลือ แปลว่าการสร้างอินสแตนซ์ล้มเหลว"

#: src/zfr_lib/lint/leftovers.py:138
msgid "no leftover zephyr/some_puff1 tokens"
msgstr "ไม่มีโทเค็น zephyr/some_puff1 เหลือ"

#: src/zfr_lib/lint/meson.py:41
msgid "project() present"
msgstr "มี project()"

#: src/zfr_lib/lint/meson.py:47
msgid "meson.build has no project() call"
msgstr "meson.build ไม่มีการเรียก project()"

#: src/zfr_lib/lint/meson.py:49
msgid ""
"project() must be the first Meson call. Copy the header from the language "
"template."
msgstr "project() ต้องเป็นการเรียก Meson ครั้งแรก คัดลอกส่วนหัวจากเทมเพลตภาษา"

#: src/zfr_lib/lint/meson.py:54
#, python-format
msgid "license %s"
msgstr "สัญญาอนุญาต %s"

#: src/zfr_lib/lint/meson.py:60
msgid "meson license is not AGPL-3.0-or-later"
