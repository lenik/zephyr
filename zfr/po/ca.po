msgstr "nom del directori del projecte nou"

#: src/create.py:325
msgid "puff names (default: one puff named like the package; use --no-puff for none)"
msgstr "noms de puff (per defecte: un puff amb el nom del paquet; utilitza --no-puff per cap)"

#: src/detect.py:15
msgid "print detected language for the current directory"
msgstr "imprimeix l'idioma detectat per al directori actual"

#: src/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "Imprimeix l'idioma detectat del projecte actual i detalls del disseny a stderr."

#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "escriu l'arxiu a DIR (per defecte: meson-dist o %_topdir/SOURCES ($HOME/rpmbuild) amb --rpm)"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "Directori de compilació Meson (per defecte: /build si coincideix amb aquest arbre de codi, sinó <project>/build)"

#: src/dist.py:81
msgid "archive format (default: xz)"
msgstr "format d'arxiu (per defecte: xz)"

#: src/dist.py:87
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "anomena l'arxiu NAME-VERSION.tar.xz i l'escriu a %_topdir/SOURCES ($HOME/rpmbuild) tret que s'indiqui -o"

#: src/dist.py:96
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "passa --allow-dirty a meson dist (per defecte: permet)"

#: src/dist.py:101
msgid "run tests during meson dist (default: --no-tests)"
msgstr "executa proves durant meson dist (per defecte: --no-tests)"

#: src/dist.py:418
msgid "build a source tarball (meson dist, or this project only)"
msgstr "construeix un tarball de codi font (meson dist o només aquest projecte)"

#: src/dist.py:420
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. When ``.tarignore`` exists (gitignore-style), always pack the project tree and apply those excludes. Prints the archive path on stdout."
msgstr "Construeix un arxiu font del projecte zephyr actual (puja des de cwd). Usa meson dist quan aquest directori és l'arrel del projecte git; altrament empaqueta només aquest projecte perquè les plantilles d'idioma imbricades no incloguin el meta-repo pare. Imprimeix la ruta de l'arxiu a stdout."

