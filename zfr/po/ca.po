msgstr ""
"Planifiqueu l’extracció d’auxiliars o submòduls abans que el fitxer creixi "
"més."

#: src/zfr_lib/lint/source_size.py:75
msgid "no oversized source files"
msgstr "no hi ha fitxers font excessius"

