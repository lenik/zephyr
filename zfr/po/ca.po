msgid "install derived .mo from --po-dir into $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"
msgstr "instal·la .mo derivada des de --po-dir a $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"

#: src/i18n/cmd.py:231
msgid "with --install-derived, locale subdirectory under prefix (default: share/locale)"
msgstr "amb --install-derived, subdirecció local sota prefix (per omissió: share/locale)"

#: src/i18n/cmd.py:233
msgid "with --build, print only"
msgstr "amb --build, només imprimeix"

