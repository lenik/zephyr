#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "imprimeix informació del projecte actual (puja des de cwd)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Imprimeix informació del projecte zephyr actual (puja des de cwd). Colors CSR quan stdout és un TTY. Els camps habituals d'empaquetatge es llegeixen de debian o RPM."

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "mostra els camps d'empaquetatge Debian analitzats"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "mostra els camps d'empaquetatge RPM analitzats"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "ressaltat CSR (console SGR) (per defecte: auto = TTY i sense NO_COLOR)"

#: src/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "crea puff(s) des de la plantilla d'idioma"

#: src/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Detecta l'idioma i afegeix puff(s) des de pkgdatadir/<lang>."

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "noms nous de puff(s) (snake_case recomanat)"

#: src/build.py:15
msgid "detect build system and compile the project"
msgstr "detectar el sistema de compilació i compilar el projecte"

#: src/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "Detecta el sistema de compilació del projecte (meson, cmake, autotools, cargo, go, npm, make) i executa una compilació local."

#: src/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "canvia a DIR abans de detectar el sistema de compilació"

#: src/build.py:35
msgid "build directory (default: <project>/build)"
msgstr "Directori de compilació Meson (per defecte: /build si coincideix amb aquest arbre de codi, sinó <project>/build)"

#: src/build.py:42 src/package.py:120
msgid "print planned commands without running them"
msgstr "imprimeix els canvis planificats sense escriure fitxers"

#: src/build.py:48
msgid "verbose build output where supported"
msgstr "sortida de compilació detallada allà on es permet"

#: src/build.py:53
msgid "print detected build system and exit"
msgstr "imprimir el sistema de compilació detectat i sortir"

#: src/build.py:58
msgid "preview files meson would install (DESTDIR tree; replaces scripts/look.sh)"
msgstr "previsualitza els fitxers que meson instal·laria (arbre DESTDIR; substitueix scripts/look.sh)"

#: src/build.py:67
msgid "with --look, limit tree depth to N levels (implies --look; default is unlimited)"
msgstr "amb --look, limita la profunditat de l’arbre a N nivells (implica --look; per defecte il·limitat)"

#: src/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "imprimeix o elimina projecte/usuari lint.comments amb un consell de treball d'IA"

#: src/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr "Imprimeix comentaris de suggeriments de pelussa de .config/zfr/lint.comments (projecte) i ~/.config/zfr/lint.comments (usuari), després una pista d'IA per aplicar les suggerències i eliminar els fitxers de comentaris consumits. Els arguments opcionals ZLxxxx filtren quines seccions mostrar. Prompt típic: \"funcionen els comentaris zfr?\""

#: src/comments_cmd.py:35
msgid "only these rule ids (default: all)"
msgstr "llindar bool 0-100 (per defecte: %s)"

#: src/comments_cmd.py:42 src/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "directori del projecte (per defecte: caminar des del cwd)"

#: src/comments_cmd.py:49
msgid "user comments only (~/.config/zfr/lint.comments)"
msgstr "només comentaris d'usuari (~/.config/zfr/lint.comments)"

#: src/comments_cmd.py:55
msgid "project comments only (.config/zfr/lint.comments)"
msgstr "només comentaris del projecte (.config/zfr/lint.comments)"

#: src/comments_cmd.py:61
msgid "delete matching comments (files or selected sections)"
msgstr "eliminar comentaris coincidents (fitxers o seccions seleccionades)"

#: src/comments_cmd.py:67
msgid "omit the AI hint trailer"
msgstr "omiteu el tràiler de suggeriments d'IA"

#: src/comments_cmd.py:93
msgid "No matching lint.comments to delete."
msgstr "No hi ha comentaris de lint que coincideixin per eliminar."

#: src/comments_cmd.py:96
#, python-format
msgid "Deleted: %s"
msgstr "hi és: %s"

