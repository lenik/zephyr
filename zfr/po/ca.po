#: src/zfr:32
msgid ""
"Zephyr template helper (CLI name: zfr). Create projects and manage example "
"puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr ""
"Auxiliar de plantilles Zephyr (nom CLI: zfr). Crea projectes i gestiona "
"puffs d'exemple. Els arbres instanciats continuen cridant zfr; zfr no és un "
"token de canvi de nom."

#: src/zfr:46
msgid "show this help"
msgstr "mostra aquesta ajuda"

#: src/zfr_lib/about.py:496
msgid "print current project information (walks parents from cwd)"
msgstr "imprimeix informació del projecte actual (puja des de cwd)"

#: src/zfr_lib/about.py:498
msgid ""
"Print information about the current zephyr project (walks from cwd toward "
"parent directories). CSR colors when stdout is a TTY. Common packaging "
"fields are parsed from debian or RPM."
msgstr ""
"Imprimeix informació del projecte zephyr actual (puja des de cwd). Colors "
"CSR quan stdout és un TTY. Els camps habituals d'empaquetatge es llegeixen "
"de debian o RPM."

#: src/zfr_lib/about.py:505
msgid "show parsed Debian packaging fields"
msgstr "mostra els camps d'empaquetatge Debian analitzats"

#: src/zfr_lib/about.py:506
msgid "show parsed RPM packaging fields"
msgstr "mostra els camps d'empaquetatge RPM analitzats"

#: src/zfr_lib/about.py:511
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "ressaltat CSR (console SGR) (per defecte: auto = TTY i sense NO_COLOR)"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "crea puff(s) des de la plantilla d'idioma"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Detecta l'idioma i afegeix puff(s) des de pkgdatadir/<lang>."

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "noms nous de puff(s) (snake_case recomanat)"

#: src/zfr_lib/create.py:311
msgid "create a new project from a language template"
msgstr "crea un projecte nou des d'una plantilla d'idioma"

#: src/zfr_lib/create.py:312
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "Crea un directori de projecte nou des de pkgdatadir/<lang>."

#: src/zfr_lib/create.py:319
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "idioma de la plantilla (per defecte: python; un de: %s)"

#: src/zfr_lib/create.py:323
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "distribució del changelog debian (per defecte: %s)"

#: src/zfr_lib/create.py:327
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "versió inicial del paquet i etiqueta git (per defecte: %s)"

#: src/zfr_lib/create.py:331
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "nom de l'autor al changelog/git (per defecte: %s)"

#: src/zfr_lib/create.py:335
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "correu de l'autor al changelog/git (per defecte: %s)"

#: src/zfr_lib/create.py:337
msgid "new project directory name"
msgstr "nom del directori del projecte nou"

#: src/zfr_lib/create.py:340
msgid "optional puff names to add after creating the project"
msgstr "noms opcionals de puff(s) per afegir després de crear el projecte"

#: src/zfr_lib/detect.py:15
msgid "print detected language for the current directory"
msgstr "imprimeix l'idioma detectat per al directori actual"

#: src/zfr_lib/detect.py:16
msgid ""
"Print the detected language of the current project and layout details on "
"stderr."
msgstr ""
"Imprimeix l'idioma detectat del projecte actual i detalls del disseny a "
"stderr."

#: src/zfr_lib/dist.py:60
msgid ""
"write the archive into DIR (default: meson-dist, or rpmbuild/SOURCES with --"
"rpm)"
msgstr ""
"escriu l'arxiu a DIR (per defecte: meson-dist o rpmbuild/SOURCES amb --rpm)"

#: src/zfr_lib/dist.py:70
msgid ""
"Meson build directory (default: /build when it matches this source tree, "
"else <project>/build)"
msgstr ""
"Directori de compilació Meson (per defecte: /build si coincideix amb aquest "
"arbre de codi, sinó <project>/build)"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "format d'arxiu (per defecte: xz)"

#: src/zfr_lib/dist.py:86
msgid ""
"name the archive NAME-VERSION.tar.xz and write it to rpmbuild/SOURCES unless "
"-o is given"
msgstr ""
"anomena l'arxiu NAME-VERSION.tar.xz i l'escriu a rpmbuild/SOURCES tret que "
"s'indiqui -o"

#: src/zfr_lib/dist.py:94
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "passa --allow-dirty a meson dist (per defecte: permet)"

#: src/zfr_lib/dist.py:99
msgid "run tests during meson dist (default: --no-tests)"
msgstr "executa proves durant meson dist (per defecte: --no-tests)"

#: src/zfr_lib/dist.py:343
msgid "build a source tarball (meson dist, or this project only)"
msgstr ""
"construeix un tarball de codi font (meson dist o només aquest projecte)"

#: src/zfr_lib/dist.py:345
msgid ""
"Build a source archive of the current zephyr project (walks from cwd toward "
"parent directories). Uses meson dist when this directory is the git project "
"root; otherwise packs this project only so nested language templates do not "
"ship the parent meta-repo. Prints the archive path on stdout."
msgstr ""
"Construeix un arxiu font del projecte zephyr actual (puja des de cwd). Usa "
"meson dist quan aquest directori és l'arrel del projecte git; altrament "
"empaqueta només aquest projecte perquè les plantilles d'idioma imbricades no "
"incloguin el meta-repo pare. Imprimeix la ruta de l'arxiu a stdout."

#: src/zfr_lib/ize/__init__.py:65
msgid "refactor this project to current zephyr style"
msgstr "refactoritza aquest projecte al estil zephyr actual"

#: src/zfr_lib/ize/__init__.py:66
msgid ""
"Refactor the current project to match current zephyr style: missing debian/"
"rpm files, meson targets, AsciiDoc man pages, and Meson version "
"substitutions. Walks from cwd toward parents."
msgstr ""
"Refactoritza el projecte actual per adaptar-lo a l'estil zephyr actual: "
"fitxers debian/rpm absents, objectius meson, pàgines man AsciiDoc i "
"substitucions de versió Meson. Puja des de cwd."

#: src/zfr_lib/ize/__init__.py:70
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "plantilla d'idioma per alinear (per defecte: detect; un de: %s)"

#: src/zfr_lib/ize/__init__.py:71
msgid "print planned changes without writing files"
msgstr "imprimeix els canvis planificats sense escriure fitxers"

#: src/zfr_lib/ize/__init__.py:72
msgid "also print skipped files"
msgstr "imprimeix també els fitxers omesos"

#: src/zfr_lib/ize/__init__.py:78
msgid ""
"run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr ""
"run 2meson to convert Autotools/CMake to Meson when present (default: on)"

#: src/zfr_lib/ize/__init__.py:80
msgid "do not convert groff .1 man pages to docs/*.adoc"
msgstr "no convertir pàgines man groff .1 a docs/*.adoc"

#: src/zfr_lib/ize/__init__.py:81
msgid "do not turn hardcoded versions into @VERSION@ / config.h"
msgstr "no convertir versions codificades en @VERSION@ / config.h"

#: src/zfr_lib/ize/__init__.py:82 src/zfr_lib/lint/__init__.py:115
msgid "CSR (console SGR) highlighting (default: auto)"
msgstr "ressaltat CSR (console SGR) (per defecte: auto)"

#: src/zfr_lib/l10n.py:93
#, python-format
msgid "l10n level must be L0–L3 (or 0–3), not %r"
msgstr "el nivell l10n ha de ser L0–L3 (o 0–3), no %r"

#: src/zfr_lib/lang/antlr.py:42 src/zfr_lib/lang/as.py:30
#: src/zfr_lib/lang/bison.py:38 src/zfr_lib/lang/clib.py:34
