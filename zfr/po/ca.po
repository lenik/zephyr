msgstr ""
"Summary de l’spec no coincideix amb la primera línia de debian Description"

#: src/zfr_lib/lint/rpm.py:120
#, python-format
msgid "Summary:        %s"
msgstr "Summary:        %s"

#: src/zfr_lib/lint/rpm.py:125
