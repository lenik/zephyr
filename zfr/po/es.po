#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "imprimir información del proyecto actual (recorre padres desde cwd)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Imprimir información sobre el proyecto zephyr actual (recorre desde cwd hacia directorios padre). Colores CSR cuando stdout es un TTY. Los campos de empaquetado comunes se analizan desde debian o RPM."

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "mostrar campos de empaquetado Debian analizados"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "mostrar campos de empaquetado RPM analizados"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "resaltado CSR (console SGR) (predeterminado: auto = TTY y sin NO_COLOR)"

#: src/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "instanciar puff(s) desde la plantilla de idioma"

#: src/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Detectar idioma y añadir puff(s) desde pkgdatadir/<lang>."

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "nombre(s) de puff nuevo(s) (se recomienda snake_case)"

#: src/build.py:15
msgid "detect build system and compile the project"
msgstr "detectar el sistema de build y compilar el proyecto"

#: src/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "Detecta el sistema de build del proyecto (meson, cmake, autotools, cargo, go, npm, make) y ejecuta una compilación local."

#: src/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "cambiar a DIR antes de detectar el sistema de build"

#: src/build.py:35
msgid "build directory (default: <project>/build)"
msgstr "directorio de compilación Meson (predeterminado: /build cuando coincide con este árbol de fuentes, si no <project>/build)"

#: src/build.py:42 src/package.py:120
msgid "print planned commands without running them"
msgstr "imprimir cambios planificados sin escribir archivos"

#: src/build.py:48
msgid "verbose build output where supported"
msgstr "salida de build detallada cuando se admite"

#: src/build.py:53
msgid "print detected build system and exit"
msgstr "mostrar el sistema de build detectado y salir"

#: src/build.py:58
msgid "preview files meson would install (DESTDIR tree; replaces scripts/look.sh)"
msgstr "previsualizar los archivos que meson instalaría (árbol DESTDIR; reemplaza scripts/look.sh)"

