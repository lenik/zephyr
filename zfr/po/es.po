#: src/detect.py:15
msgid "print detected language for the current directory"
msgstr "imprimir idioma detectado para el directorio actual"

#: src/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "Imprimir el idioma detectado del proyecto actual y detalles del diseño en stderr."

#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "escribir el archivo en DIR (predeterminado: meson-dist, o %_topdir/SOURCES ($HOME/rpmbuild) con --rpm)"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "directorio de compilación Meson (predeterminado: /build cuando coincide con este árbol de fuentes, si no <project>/build)"

#: src/dist.py:81
msgid "archive format (default: xz)"
msgstr "formato de archivo (predeterminado: xz)"

#: src/dist.py:87
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "nombrar el archivo NAME-VERSION.tar.xz y escribirlo en %_topdir/SOURCES ($HOME/rpmbuild) salvo que se indique -o"

#: src/dist.py:96
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "pasar --allow-dirty a meson dist (predeterminado: permitir)"

#: src/dist.py:101
msgid "run tests during meson dist (default: --no-tests)"
msgstr "ejecutar pruebas durante meson dist (predeterminado: --no-tests)"

#: src/dist.py:418
msgid "build a source tarball (meson dist, or this project only)"
msgstr "construir tarball de fuentes (meson dist, o solo este proyecto)"

#: src/dist.py:420
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. When ``.tarignore`` exists (gitignore-style), always pack the project tree and apply those excludes. Prints the archive path on stdout."
msgstr "Construir un archivo de fuentes del proyecto zephyr actual (recorre desde cwd hacia directorios padre). Usa meson dist cuando este directorio es la raíz del proyecto git; de lo contrario empaqueta solo este proyecto para que las plantillas de idioma anidadas no envíen el meta-repo padre. Imprime la ruta del archivo en stdout."

