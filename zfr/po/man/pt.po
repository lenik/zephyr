#. type: Labeled list
#: docs/zfr.adoc:314
#, no-wrap
msgid "*ZFR_PKGDATADIR*"
msgstr ""

#. type: Plain text
#: docs/zfr.adoc:316
msgid "Override the templates root (normally */usr/share/zephyr*)."
msgstr ""

#. type: Labeled list
#: docs/zfr.adoc:317
#, no-wrap
