#: docs/zfr.adoc:335
#, no-wrap
msgid "Files"
msgstr "檔案"

#. type: Labeled list
#: docs/zfr.adoc:337
#, no-wrap
msgid "*/usr/share/zephyr/<lang>/*"
msgstr "*/usr/share/zephyr/<lang>/*"

#. type: Plain text
#: docs/zfr.adoc:339
msgid "Installed language templates."
msgstr "已安裝的語言模板。"

#. type: Labeled list
#: docs/zfr.adoc:340
#, no-wrap
msgid "*/usr/bin/zfr*, */usr/bin/zfr-\\**"
msgstr "*/usr/bin/zfr*, */usr/bin/zfr-\\**"

#. type: Plain text
#: docs/zfr.adoc:342
msgid "CLI and thin wrappers."
msgstr "命令列工具及其薄封裝。"

#. type: Labeled list
#: docs/zfr.adoc:343
#, no-wrap
msgid "*/usr/share/doc/zephyr/*"
msgstr "*/usr/share/doc/zephyr/*"

#. type: Plain text
#: docs/zfr.adoc:345
msgid "Package documentation (LICENSE, README)."
msgstr "軟體包文件（LICENSE、README）。"

#. type: Labeled list
#: docs/zfr.adoc:346
#, fuzzy, no-wrap
msgid "*/usr/share/man/<locale>/man1/zfr.1*"
msgstr "*/usr/share/man/<locale>/man1/zfr.1*"

#. type: Plain text
#: docs/zfr.adoc:348
msgid "Localized manual pages (po4a from *docs/zfr.adoc*)."
msgstr "本地化手冊頁（由 *docs/zfr.adoc* 經 po4a 生成）。"

#. type: Title ==
#: docs/zfr.adoc:349
#, no-wrap
msgid "Exit status"
msgstr "退出狀態"

#. type: Labeled list
#: docs/zfr.adoc:351
#, no-wrap
msgid "*0*"
msgstr "*0*"

#. type: Plain text
#: docs/zfr.adoc:354
