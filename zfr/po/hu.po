msgstr "Adjon hozzá tests/smoke.sh fájlt és meson test() bejegyzést a stdin/stdout másoláshoz."

#: src/zfr_lib/lang/bash.py:65
#, python-format
msgid "src scripts: %s"
msgstr "src parancsfájlok: %s"

#: src/zfr_lib/lang/bash.py:78
msgid "root scripts: %s"
msgstr "src parancsfájlok: %s"

#: src/zfr_lib/lang/bash.py:89
#, python-format
msgid "setup-only package (%s); no bindir script puffs"
msgstr "a változás -only csomag (%s); nem bindir szírpők"

