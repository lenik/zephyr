msgstr "Kisebb átnézési diffek, világosabb modulhatárok, könnyebb unit tesztek és kevesebb merge-konfliktus a forgalmas fájlokon."

#: src/zfr_lib/lint/docs.py:40
msgid "Thresholds"
msgstr "Küszöbök"

#: src/zfr_lib/lint/docs.py:42
