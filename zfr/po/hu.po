"át konkrét modulra (pl. stream_copy.py, bulk.h). A clib/cpplib a lib.c/"
"lib.cpp fájlokat tartja a közös könyvtár belépési pontjának."

#: src/zfr_lib/lint/layout.py:35
msgid "Add a top-level meson.build with project(...)."
msgstr "Adjon gyökérszintű meson.build fájlt project(...)-tel."

#: src/zfr_lib/lint/layout.py:36
