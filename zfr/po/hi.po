msgstr "TOPDIR?= $(shell rpm --eval '%{_topdir}' 2>/dev/null) ifeq ($(strip $(TOPDIR)), TOPDIR:= $(HOME)/rpmbuild endif और सिर्फ इस पैकेज के आर्च्टिकेट्स को शुद्ध करना (न rm -rf $(TOPDIR)). या चलाए `zfr ize`."

