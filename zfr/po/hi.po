#: src/zfr_lib/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "बिल्ड सिस्टम का पता लगाने से पहले DIR में बदलें"

#: src/zfr_lib/build.py:35
#, fuzzy
msgid "build directory (default: <project>/build)"
msgstr "Meson बिल्ड डायरेक्टरी (डिफ़ॉल्ट: /build जब यह इस स्रोत ट्री से मेल खाता है, अन्यथा <project>/build)"

#: src/zfr_lib/build.py:42 src/zfr_lib/package.py:120
#, fuzzy
