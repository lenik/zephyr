msgstr "Build-Depends में %s जोड़ें (zephyr पैकेज Meson + AsciiDoc मैन पेज से बनते हैं)।"

#: src/zfr_lib/lint/debian.py:54
msgid "debhelper-compat present"
msgstr "debhelper-compat मौजूद है"

#: src/zfr_lib/lint/debian.py:60
msgid "Build-Depends missing debhelper-compat (= 13)"
msgstr "Build-Depends में debhelper-compat (= 13) नहीं है"

#: src/zfr_lib/lint/debian.py:62
msgid "Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"
msgstr "Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"

#: src/zfr_lib/lint/debian.py:80
msgid "Package stanza missing Architecture"
msgstr "Package स्टैंज़ा में Architecture नहीं है"

#: src/zfr_lib/lint/debian.py:82
msgid "Architecture: all  (scripts) or any (compiled)."
msgstr "Architecture: all  (स्क्रिप्ट) या any (संकलित)।"

#: src/zfr_lib/lint/debian.py:91
#, python-format
msgid "Architecture: %s (bash + Meson executable)"
msgstr "Architecture: %s (बश + Meson चलाने वाली)"

#: src/zfr_lib/lint/debian.py:100
#, python-format
msgid "bash packages should be Architecture: all (got %s)"
msgstr "bash पैकेज Architecture: all होने चाहिए (मिला %s)"

#: src/zfr_lib/lint/debian.py:102
msgid "Architecture: all"
msgstr "Architecture: all"

#: src/zfr_lib/lint/debian.py:110
#, python-format
msgid "%s packages are usually Architecture: any (got all)"
msgstr "%s पैकेज आमतौर पर Architecture: any होते हैं (मिला all)"

#: src/zfr_lib/lint/debian.py:112 src/zfr_lib/lint/debian.py:128
msgid "Architecture: any"
msgstr "Architecture: any"

#: src/zfr_lib/lint/debian.py:123
msgid "Architecture: all but Meson has executable(); ELF binaries need Architecture: any (same class of bug as RPM BuildArch: noarch)"
msgstr "Architecture: सभी केवल Meson के लिए एक्सेक्यूटेबल () है; ELF बिनारीज़ की जरूरत है Architecture: किसी को (आरपीम BuildArch के रूप में बग के समान वर्ग: noarch)"

#: src/zfr_lib/lint/debian.py:133
#, python-format
msgid "Architecture: %s"
msgstr "फ़ील्ड Architecture: %s"

#: src/zfr_lib/lint/debian.py:138
#, python-format
msgid "Homepage: %s"
msgstr "फ़ील्ड Homepage: %s"

#: src/zfr_lib/lint/debian.py:144
msgid "no Homepage"
msgstr "Homepage नहीं है"

#: src/zfr_lib/lint/debian.py:146
msgid "Set Homepage: to the project URL."
msgstr "Homepage: को परियोजना URL पर सेट करें।"

#: src/zfr_lib/lint/debian.py:152
msgid "dh meson debian/build"
msgstr "dh meson debian/build के साथ"

#: src/zfr_lib/lint/debian.py:158
msgid "debian/rules is not dh --buildsystem=meson --builddirectory=debian/build"
msgstr "debian/rules dh --buildsystem=meson --builddirectory=debian/build नहीं है"

#: src/zfr_lib/lint/debian.py:161
#, no-python-format
msgid ""
"Use:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"उपयोग करें:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:167
msgid "copyright mentions AGPL"
msgstr "कॉपीराइट में AGPL का उल्लेख है"

#: src/zfr_lib/lint/debian.py:173
msgid "debian/copyright does not mention AGPL"
msgstr "debian/copyright में AGPL का उल्लेख नहीं है"

#: src/zfr_lib/lint/debian.py:175
msgid "Use the template debian/copyright (License: AGPL-3+)."
msgstr "टेम्पलेट debian/copyright का उपयोग करें (License: AGPL-3+)।"

#: src/zfr_lib/lint/debian.py:181
#, python-format
msgid "source format %s"
msgstr "स्रोत प्रारूप %s"

#: src/zfr_lib/lint/debian.py:190
#, python-format
msgid "VERSION=%(file)r != changelog %(changelog)r"
msgstr "VERSION=%(file)r != चेंजलॉग %(changelog)r"

#: src/zfr_lib/lint/debian.py:192
msgid "VERSION should match the latest debian/changelog entry (pre-commit hook updates it). Git describe may still differ."
msgstr "VERSION को debian/changelog की नवीनतम प्रविष्टि से मेल खाना चाहिए (pre-commit हुक इसे अद्यतन करता है)। Git describe अभी भी भिन्न हो सकता है।"

#: src/zfr_lib/lint/debian.py:198
#, python-format
msgid "VERSION matches changelog %s"
msgstr "VERSION चेंजलॉग %s से मेल खाता है"

#: src/zfr_lib/lint/debian.py:211
msgid "bash-shlib used in sources but missing from Depends"
msgstr "bash-shlib स्रोत में प्रयुक्त है लेकिन Depends से गुम है"

#: src/zfr_lib/lint/debian.py:213
msgid "Depends: bash, bash-shlib, ${misc:Depends}"
msgstr "Depends: bash, bash-shlib, ${misc:Depends}"

#: src/zfr_lib/lint/debian.py:218
msgid "Depends includes bash-shlib"
msgstr "Depends में bash-shlib शामिल है"

#: src/zfr_lib/lint/debian.py:225
msgid "Depends lists bash-shlib but sources do not use it"
msgstr "Depends सूची bash-shlib लेकिन स्रोत इसे नहीं प्रयोग करते हैं"

#: src/zfr_lib/lint/debian.py:227
msgid "Drop bash-shlib from Depends unless scripts `. shlib` / shlib-import."
msgstr "Depends से bash-shlib छोड़ें जब तक स्क्रिप्ट `. shlib` / shlib-import न करें."

#: src/zfr_lib/lint/debian.py:237
msgid "Priority: extra is deprecated"
msgstr "Priority: extra अप्रचलित है"

#: src/zfr_lib/lint/debian.py:239
msgid "Priority: optional (run `zfr ize` to fix)."
msgstr "Priority: वैकल्पिक (अधिवृत्त के लिए चलाएँ `zfr ize`)."

#: src/zfr_lib/lint/debian.py:243
#, python-format
msgid "Priority: %s"
msgstr "भूमिका: %s"

#: src/zfr_lib/lint/debian.py:250
msgid "extended Description present"
msgstr "विस्तारित Description मौजूद"

#: src/zfr_lib/lint/debian.py:257
msgid "Description missing extended paragraph"
msgstr "Description में विस्तारित अनुच्छेद नहीं है"

#: src/zfr_lib/lint/debian.py:259
msgid "Add an indented continuation line after the synopsis (run `zfr ize`)."
msgstr "सिंकॉपस के बाद एक हाशिया में जारी रखने वाले पंक्ति जोड़ें ( `zfr ize` चलाएं)."

#: src/zfr_lib/lint/docs.py:25
msgid "Long files fight ownership"
msgstr "लंबी फ़ाइलें स्वामित्व को कठिन बनाती हैं"

#: src/zfr_lib/lint/docs.py:27
msgid "Very long source files are hard to review, test, and own. Zephyr prefers cohesive modules under a package subdirectory with a thin entry-point file — the same shape create/ize expect."
msgstr "बहुत लंबी स्रोत फ़ाइलों की समीक्षा, परीक्षण और स्वामित्व कठिन होता है। Zephyr पैकेज उपनिर्देशिका के अंतर्गत सुसंगत मॉड्यूल और एक पतली प्रवेश-बिंदु फ़ाइल पसंद करता है — वही आकार जो create/ize अपेक्षा करते हैं।"

#: src/zfr_lib/lint/docs.py:33
msgid "What improving it buys you"
msgstr "सुधार से आपको क्या मिलता है"

#: src/zfr_lib/lint/docs.py:35
msgid "Smaller review diffs, clearer module boundaries, easier unit tests, and fewer merge conflicts on busy files."
msgstr "छोटे रिव्यू डिफ़, स्पष्ट मॉड्यूल सीमाएँ, आसान यूनिट टेस्ट, और व्यस्त फ़ाइलों पर कम मर्ज संघर्ष।"

#: src/zfr_lib/lint/docs.py:40
msgid "Thresholds"
msgstr "सीमाएँ"

#: src/zfr_lib/lint/docs.py:42
msgid "Lint counts non-empty lines (skipping build/debian/po/…). A note appears around ~600 lines; a warning around ~1000. Template example modules are skipped."
msgstr "Lint खाली न होने वाली पंक्तियाँ गिनता है (build/debian/po/… छोड़कर)। लगभग ~600 पंक्तियों पर नोट; लगभग ~1000 पर चेतावनी। टेम्पलेट उदाहरण मॉड्यूल छोड़े जाते हैं।"

#: src/zfr_lib/lint/docs.py:48
msgid "Fixing is manual"
msgstr "सुधार मैन्युअल है"

#: src/zfr_lib/lint/docs.py:50
msgid "Split the file and update meson/install/import lists yourself. `zfr ize` does not auto-split sources."
msgstr "फ़ाइल विभाजित करें और meson/install/import सूचियाँ स्वयं अपडेट करें। `zfr ize` स्रोत स्वतः विभाजित नहीं करता।"

#: src/zfr_lib/lint/docs.py:57
msgid "Hardcoded /usr breaks prefixes"
msgstr "हार्डकोडेड /usr प्रिफ़िक्स तोड़ देता है"

#: src/zfr_lib/lint/docs.py:59
msgid "Absolute FHS paths (/usr/share, /usr/bin, …) fail under DESTDIR, non-standard prefixes, and Meson configure_file staging."
msgstr "निरपेक्ष FHS पथ (/usr/share, /usr/bin, …) DESTDIR, गैर-मानक प्रिफ़िक्स, और Meson configure_file स्टेजिंग के तहत विफल होते हैं।"

#: src/zfr_lib/lint/docs.py:64
msgid "Preferred shape"
msgstr "पसंदीदा आकार"

#: src/zfr_lib/lint/docs.py:66
msgid "Scripts use @PREFIX@ / @DATADIR@ / @LOCALEDIR@ (or equivalent) and are installed from *.in via Meson."
msgstr "स्क्रिप्ट @PREFIX@ / @DATADIR@ / @LOCALEDIR@ (या समकक्ष) उपयोग करती हैं और Meson के माध्यम से *.in से स्थापित होती हैं।"

#: src/zfr_lib/lint/docs.py:71
msgid "What Solve does"
msgstr "Solve क्या करता है"

#: src/zfr_lib/lint/docs.py:73
msgid "Ize renames affected scripts to *.in and wires configure_file. Re-check shebangs and any tests that assumed live paths."
msgstr "ize प्रभावित स्क्रिप्ट को *.in में नाम बदलता है और configure_file जोड़ता है। shebang और जीवित पथ मानने वाले परीक्षण पुनः जाँचें।"

#: src/zfr_lib/lint/docs.py:80
msgid "Version literals drift"
msgstr "संस्करण लिटरल भटक जाते हैं"

#: src/zfr_lib/lint/docs.py:82
msgid "A hardcoded release string diverges from debian/changelog and Meson project_version() the moment you bump."
msgstr "हार्डकोडेड रिलीज़ स्ट्रिंग bump करते ही debian/changelog और Meson project_version() से अलग हो जाती है।"

#: src/zfr_lib/lint/docs.py:87
msgid "Single source of truth"
msgstr "सत्य का एकमात्र स्रोत"

#: src/zfr_lib/lint/docs.py:89
msgid "Prefer @VERSION@ / PROJECT_VERSION substituted at build time so `--version`, wrappers, and packages stay aligned."
msgstr "बिल्ड समय पर प्रतिस्थापित @VERSION@ / PROJECT_VERSION पसंद करें ताकि `--version`, रैपर और पैकेज संरेखित रहें।"

#: src/zfr_lib/lint/docs.py:94
msgid "Risks when converting"
msgstr "रूपांतरण के जोखिम"

#: src/zfr_lib/lint/docs.py:96
msgid "C/C++ usually needs config.h; scripts need *.in. Dry-run ize (`-n`) on large trees before writing."
msgstr "C/C++ को आमतौर पर config.h चाहिए; स्क्रिप्ट को *.in। लिखने से पहले बड़े ट्री पर dry-run ize (`-n`) चलाएँ।"

#: src/zfr_lib/lint/docs.py:103
msgid "Substitution without a consumer is incomplete"
msgstr "उपभोक्ता के बिना प्रतिस्थापन अधूरा है"

#: src/zfr_lib/lint/docs.py:105
msgid "Meson must both define VERSION/PROJECT_VERSION and have sources that actually read it — otherwise packaged binaries still lie."
msgstr "Meson को VERSION/PROJECT_VERSION परिभाषित करना और वास्तव में पढ़ने वाले स्रोत दोनों चाहिए — वरना पैकेज्ड बाइनरी अब भी झूठ बोलेंगी।"

#: src/zfr_lib/lint/docs.py:110
msgid "How it is checked"
msgstr "जाँच कैसे होती है"

#: src/zfr_lib/lint/docs.py:112
msgid "Looks for configuration_data keys and for @VERSION@ / PROJECT_VERSION usage in installed sources."
msgstr "configuration_data कुंजियाँ और स्थापित स्रोतों में @VERSION@ / PROJECT_VERSION उपयोग खोजता है।"

#: src/zfr_lib/lint/docs.py:117
msgid "Closing the loop"
msgstr "लूप बंद करना"

#: src/zfr_lib/lint/docs.py:119
msgid "Add the missing half (subst or consumer). Solve maps to the subst ize steps when available."
msgstr "गायब आधा जोड़ें (subst या उपभोक्ता)। उपलब्ध होने पर Solve subst ize चरणों से मैप करता है।"

#: src/zfr_lib/lint/docs.py:126
msgid "Inline posync is unmaintainable"
msgstr "इनलाइन posync रखरखाव योग्य नहीं"

#: src/zfr_lib/lint/docs.py:128
msgid "A bash -euc heredoc inside meson.build duplicates across templates and is painful to debug. The contract is scripts/posync.sh + run_target('posync')."
msgstr "meson.build के अंदर bash -euc heredoc टेम्पलेटों में दोहराया जाता है और डिबग करना कष्टदायक है। अनुबंध है scripts/posync.sh + run_target('posync')।"

#: src/zfr_lib/lint/docs.py:134
msgid "Payoff"
msgstr "लाभ"

#: src/zfr_lib/lint/docs.py:136
msgid "One script to run msgmerge/xgettext locally; ninja posync stays short; CI can call the script directly."
msgstr "स्थानीय रूप से msgmerge/xgettext चलाने के लिए एक स्क्रिप्ट; ninja posync छोटा रहता है; CI स्क्रिप्ट को सीधे कॉल कर सकता है।"

#: src/zfr_lib/lint/docs.py:143
msgid "Ize extracts the body to scripts/posync.sh and points the run_target at it. Verify POTFILES and language flags afterward."
msgstr "ize बॉडी को scripts/posync.sh में निकालता है और run_target उस ओर इंगित करता है। बाद में POTFILES और भाषा फ़्लैग जाँचें।"

#: src/zfr_lib/lint/docs.py:150
msgid "Maintenance scripts belong under scripts/"
msgstr "रखरखाव स्क्रिप्ट scripts/ के अंतर्गत होनी चाहिए"

#: src/zfr_lib/lint/docs.py:152
msgid "look / install-symlinks / deploy helpers at the repo root clutter the packaging surface. Zephyr keeps them under scripts/."
msgstr "रिपो रूट पर look / install-symlinks / deploy सहायक पैकेजिंग सतह को अव्यवस्थित करते हैं। Zephyr उन्हें scripts/ के अंतर्गत रखता है।"

#: src/zfr_lib/lint/docs.py:157
msgid "Detection"
msgstr "पहचान"

#: src/zfr_lib/lint/docs.py:159
msgid "Flags root *.sh maintenance names and inline run_target bodies that should be externalized."
msgstr "रूट *.sh रखरखाव नाम और इनलाइन run_target बॉडी फ़्लैग करता है जिन्हें बाहरी बनाना चाहिए।"

#: src/zfr_lib/lint/docs.py:164
msgid "After moving"
msgstr "स्थानांतरण के बाद"

#: src/zfr_lib/lint/docs.py:166
msgid "Update docs and any CI that called the old paths. Solve rewrites Meson run_targets to scripts/…"
msgstr "दस्तावेज़ और पुराने पथ कॉल करने वाले किसी भी CI को अपडेट करें। Solve Meson run_targets को scripts/… में पुनर्लेखित करता है।"

#: src/zfr_lib/lint/docs.py:180
msgid "No Solve mapping"
msgstr "कोई Solve मैपिंग नहीं"

#: src/zfr_lib/lint/docs.py:182
msgid "This finding has no `zfr ize --only …` shortcut. Follow the fix text (or a broader `zfr ize` if several related gaps exist), then re-lint."
msgstr "इस निष्कर्ष के लिए कोई `zfr ize --only …` शॉर्टकट नहीं। सुधार पाठ का पालन करें (या कई संबंधित अंतराल हों तो व्यापक `zfr ize`), फिर पुनः lint करें।"

#: src/zfr_lib/lint/docs.py:190
msgid "Solve / ize"
msgstr "हल करें / ize"

#: src/zfr_lib/lint/docs.py:192
#, python-format
msgid ""
"Clicking Solve runs only: %(targets)s.\n"
"Equivalent CLI: `%(cmd)s`\n"
"Use `-n` for a dry plan. Output is captured with fdmux (ordered stdout/stderr)."
msgstr ""
"Solve क्लिक करने पर केवल यह चलता है: %(targets)s.\n"
"समकक्ष CLI: `%(cmd)s`\n"
"ड्राई प्लान के लिए `-n` उपयोग करें। आउटपुट fdmux से कैप्चर होता है (क्रमित stdout/stderr)।"

#: src/zfr_lib/lint/docs.py:206 src/zfr_lib/lint/docs.py:407
msgid "varies"
msgstr "भिन्न होता है"

#: src/zfr_lib/lint/docs.py:209
#, python-format
msgid "Checker `%s` in `zfr lint`."
msgstr "`zfr lint` में चेकर `%s`।"

#: src/zfr_lib/lint/docs.py:212
msgid "Debian is the APT contract"
msgstr "Debian APT अनुबंध है"

#: src/zfr_lib/lint/docs.py:214
msgid "control / rules / copyright / source format decide how the package builds and what users install. Zephyr standardizes on Meson + dh `--buildsystem=meson --builddirectory=debian/build`."
msgstr "control / rules / copyright / source format तय करते हैं कि पैकेज कैसे बनता है और उपयोगकर्ता क्या स्थापित करते हैं। Zephyr Meson + dh `--buildsystem=meson --builddirectory=debian/build` पर मानकीकृत करता है।"

#: src/zfr_lib/lint/docs.py:220 src/zfr_lib/lint/docs.py:251
#: src/zfr_lib/lint/docs.py:273 src/zfr_lib/lint/docs.py:296
#, python-format
msgid "This check: %s"
msgstr "यह जाँच: %s"

#: src/zfr_lib/lint/docs.py:221
#, python-format
msgid "Default severity hint: %s."
msgstr "डिफ़ॉल्ट गंभीरता संकेत: %s।"

#: src/zfr_lib/lint/docs.py:224
msgid "Why it matters"
msgstr "यह क्यों मायने रखता है"

#: src/zfr_lib/lint/docs.py:226
msgid "Wrong Architecture, missing Build-Depends, or a non-Meson rules file fail debuild or produce unloadable packages even when local compiles succeed."
msgstr "गलत Architecture, गायब Build-Depends, या गैर-Meson rules फ़ाइल debuild विफल करती है या स्थानीय कंपाइल सफल होने पर भी अनलोड करने योग्य पैकेज बनाती है।"

#: src/zfr_lib/lint/docs.py:232
msgid "When editing packaging"
msgstr "पैकेजिंग संपादित करते समय"

#: src/zfr_lib/lint/docs.py:234
msgid "Ize may rewrite from templates — always diff Maintainer, Depends, and Architecture before upload."
msgstr "ize टेम्पलेट से पुनर्लेखन कर सकता है — अपलोड से पहले हमेशा Maintainer, Depends, और Architecture का diff देखें।"

#: src/zfr_lib/lint/docs.py:240
#, python-format
msgid "Checker `%s`."
msgstr "चेकर `%s`।"

#: src/zfr_lib/lint/docs.py:243
msgid "RPM must mirror Meson/Debian"
msgstr "RPM को Meson/Debian को प्रतिबिंबित करना चाहिए"

#: src/zfr_lib/lint/docs.py:245
#, python-format
msgid "spec %files, BuildArch, and Version have to describe the same payload Meson installs. Project-local rpmbuild TOPDIR and stale file lists are common failure modes."
