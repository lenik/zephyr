msgid "with --build, also msgfmt derived .po into LC_MESSAGES (for Meson)"
msgstr "配合 --build，同时将派生 .po msgfmt 到 LC_MESSAGES（供 Meson 使用）"

#: src/i18n/cmd.py:217
msgid "gettext domain for --compile-mo / --install-derived"
msgstr "--compile-mo / --install-derived 的 gettext 域"

#: src/i18n/cmd.py:223
msgid "install derived .mo from --po-dir into $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"
msgstr "将 --po-dir 中的派生 .mo 安装到 $MESON_INSTALL_DESTDIR_PREFIX（Meson add_install_script）"

#: src/i18n/cmd.py:231
msgid "with --install-derived, locale subdirectory under prefix (default: share/locale)"
msgstr "配合 --install-derived，prefix 下的 locale 子目录（默认：share/locale）"

