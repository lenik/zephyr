msgstr "从父语言生成派生 locale 的 PO/man 文件（跳过 LINGUAS 中列出的语言环境）"

#: src/i18n/cmd.py:202
msgid "output directory for derived .po files (default: build/po or $MESON_BUILD_ROOT/po)"
msgstr "派生 .po 文件的输出目录（默认：build/po 或 $MESON_BUILD_ROOT/po）"

#: src/i18n/cmd.py:207
msgid "write a stamp file listing derived paths (for Meson custom_target)"
msgstr "写入列出派生路径的戳记文件（供 Meson custom_target 使用）"

