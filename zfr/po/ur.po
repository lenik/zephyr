msgstr "docs/<locale>/<name>.adoc کو ہاتھ سے ترجمہ کریں (پوری دستاویز، po4a نہیں)۔ %(level)s درکار: %(locales)s۔"

#: src/zfr_lib/lint/i18n_check.py:256
#, python-format
