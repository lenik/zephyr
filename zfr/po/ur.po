#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "موجودہ منصوبے کی معلومات دکھاؤ (موجودہ ڈائریکٹری سے اوپر ڈھونڈتا ہے)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "موجودہ zephyr منصوبے کی معلومات دکھاتا ہے (موجودہ ڈائریکٹری سے اوپر کی ڈائریکٹریوں کی طرف ڈھونڈتا ہے)۔ stdout ٹرمینل ہو تو CSR رنگ۔ عام پیکجنگ خانے debian یا RPM سے پڑھے جاتے ہیں۔"

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "Debian پیکجنگ خانے دکھاؤ"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "RPM پیکجنگ خانے دکھاؤ"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (کنسول SGR) رنگ (طے شدہ: auto = ٹرمینل اور NO_COLOR نہیں)"

