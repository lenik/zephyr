#, python-format
msgid "spec Name=%(spec)r != debian/meson name %(want)r"
msgstr "spec Name=%(spec)r != debian/meson نام %(want)r"

#: src/zfr_lib/lint/identity.py:99
#, python-format
msgid "Set Name: %s in the spec (same as debian Source)."
msgstr "spec میں Name: %s سیٹ کریں (debian Source جیسا)۔"

#: src/zfr_lib/lint/identity.py:103
#, python-format
msgid "spec Name=%s"
msgstr "spec Name=%s"

#: src/zfr_lib/lint/__init__.py:118
msgid "validate project packaging and zephyr layout (walks parents from cwd)"
msgstr "منصوبے کی پیکجنگ اور zephyr ترتیب جانچو (موجودہ ڈائریکٹری سے اوپر ڈھونڈتا ہے)"

#: src/zfr_lib/lint/__init__.py:120
msgid "Check the current zephyr project for missing files and packaging/style mistakes. Walks from cwd toward parent directories. CSR colors when stdout is a TTY. Style-contract blurbs default on for non-interactive stdout and AI-integrated terminals (Cursor, VS Code, Windsurf, …); off for a plain interactive shell. Override with -i/-I."
msgstr "موجودہ zephyr منصوبے میں غائب فائلیں اور پیکجنگ/انداز کی غلطیاں دیکھتا ہے۔ موجودہ ڈائریکٹری سے اوپر ڈھونڈتا ہے۔ stdout ٹرمینل ہو تو CSR رنگ۔"

#: src/zfr_lib/lint/__init__.py:131
msgid "show passing checks too"
msgstr "کامیاب جانچ بھی دکھاؤ"

#: src/zfr_lib/lint/__init__.py:132
msgid "only print errors"
msgstr "صرف غلطیاں دکھاؤ"

#: src/zfr_lib/lint/__init__.py:133
msgid "treat warnings as failures (exit 1)"
msgstr "تنبیہات کو ناکامی سمجھو (خروج 1)"

#: src/zfr_lib/lint/__init__.py:138
msgid "list numbered lint standards (ZL*) as a table and exit"
msgstr "نمبر لینٹ معیارز (ZL*) کی فہرست ٹائبلی اور نکالیں"

#: src/zfr_lib/lint/__init__.py:144
msgid "show details for lint standard NUM (e.g. ZL026, 26) and exit"
msgstr "لِنٹ مارڈ NUM کے لئے تفصیل دکھائیں (مثال کے طور پر ZL026, 26) اور نکالیں"

#: src/zfr_lib/lint/__init__.py:152
msgid "required gettext/manpage locale coverage L0–L3 (default: L1; project file may override)"
msgstr "ضروری gettext/دستور locale کوریج L0–L3 (طے شدہ L1؛ منصوبے کی فائل بدل سکتی ہے)"

#: src/zfr_lib/lint/__init__.py:160
msgid "show zephyr style-contract / next-steps blurbs (default for pipes and AI terminals)"
msgstr "زفیر سائل -contract / پیچھے -steps سلب (پائپ اور AI ٹرمینالس کے ڈیفٹ)"

#: src/zfr_lib/lint/__init__.py:167
msgid "hide zephyr style-contract / next-steps blurbs (default for plain interactive shell)"
msgstr "زفیر سٹیلی کو چھپانا -contract / نگاہ-steps slawbs (سند انتظام شیل کے لئے مطابق)"

#: src/zfr_lib/lint/__init__.py:177
msgid "suppress rule ID(s) or code(s), comma-separated (repeatable)"
msgstr "رد کرنے کے ID یا کوڈ، کما-separated (مردور)"

#: src/zfr_lib/lint/__init__.py:191
#, python-format
msgid "unknown lint standard: %s"
msgstr "نامعلوم lint مارڈ: %s"

#: src/zfr_lib/lint/lang_bits.py:31
#, python-format
msgid "legacy example module %s; use commons or a specific name"
msgstr "پرانا مثالی ماڈیول %s؛ commons یا کوئی مخصوص نام استعمال کریں"

#: src/zfr_lib/lint/lang_bits.py:33
msgid "Rename to src/commons.* (template convention) or a project-specific module name."
msgstr "src/commons.* (سانچے کی روایت) یا منصوبے کے مخصوص ماڈیول نام پر تبدیل کریں۔"

#: src/zfr_lib/lint/lang_bits.py:44
msgid "%s is only a template example; can be removed if unnecessary"
msgstr "%s مشترکہ معاونین کے لیے صرف سانچے کی مثال ہے"

#: src/zfr_lib/lint/lang_bits.py:46
msgid "commons.* is only a template example for shared helpers and can be removed if unnecessary. Prefer a concrete module name in real projects (e.g. stream_copy.py, bulk.h). clib/cpplib keep lib.c/lib.cpp as their shared library entry."
msgstr "common_lib / commons کا مطلب ہے “دوبارہ استعمال ہونے والے ٹکڑے نکالنا”، مگر فائل نام مخصوص ہونے چاہئیں۔ حقیقی منصوبوں میں مخصوص ماڈیول پر نام بدلیں (مثلاً stream_copy.py، bulk.h)۔ clib/cpplib مشترکہ لائبریری کے داخلے کے طور پر lib.c/lib.cpp رکھتے ہیں۔"

#: src/zfr_lib/lint/layout.py:35
msgid "Add a top-level meson.build with project(...)."
msgstr "اوپر project(...) والا meson.build شامل کریں۔"

#: src/zfr_lib/lint/layout.py:36
msgid "Copy LICENSE from the language template (AGPL-3.0-or-later)."
msgstr "زبان کے سانچے سے LICENSE کاپی کریں (AGPL-3.0-or-later)۔"

#: src/zfr_lib/lint/layout.py:37
msgid "Add README.md describing this project."
msgstr "اس منصوبے کی وضاحت والا README.md شامل کریں۔"

#: src/zfr_lib/lint/layout.py:38
msgid "Add README-zh.md (Chinese summary), matching other zephyr templates."
msgstr "دیگر zephyr سانچوں کی طرح README-zh.md (چینی خلاصہ) شامل کریں۔"

#: src/zfr_lib/lint/layout.py:39
msgid "Add debian/ packaging (copy debian/ from the language template)."
msgstr "debian/ پیکیجنگ شامل کریں (زبان کے سانچے سے debian/ کاپی کریں)۔"

#: src/zfr_lib/lint/layout.py:40
msgid "Add debian/changelog (zfr create writes one; or use dch)."
msgstr "debian/changelog شامل کریں (zfr create لکھتا ہے؛ یا dch استعمال کریں)۔"

#: src/zfr_lib/lint/layout.py:41
msgid "Add debian/copyright in machine-readable format, License: AGPL-3+."
msgstr "مشین سے پڑھنے کے قابل شکل میں debian/copyright شامل کریں، License: AGPL-3+۔"

#: src/zfr_lib/lint/layout.py:42
msgid "Add debian/rules using dh --buildsystem=meson --builddirectory=debian/build."
msgstr "dh --buildsystem=meson --builddirectory=debian/build استعمال کر کے debian/rules شامل کریں۔"

#: src/zfr_lib/lint/layout.py:43
msgid "Add debian/source/format (typically '3.0 (native)')."
msgstr "debian/source/format شامل کریں (عام طور پر '3.0 (native)')۔"

#: src/zfr_lib/lint/layout.py:47
#, python-format
msgid "present: %s"
msgstr "موجود ہے: %s"

#: src/zfr_lib/lint/layout.py:50
#, python-format
msgid "missing %s"
msgstr "%s غائب"

#: src/zfr_lib/lint/layout.py:56
#, python-format
msgid "AsciiDoc man sources: %s"
msgstr "AsciiDoc مین ذرائع: %s"

#: src/zfr_lib/lint/layout.py:63
msgid "no docs/*.adoc man page source"
msgstr "docs/*.adoc مین صفحہ کا ماخذ نہیں"

#: src/zfr_lib/lint/layout.py:65
msgid "Add docs/<puff>.adoc and a meson custom_target with asciidoctor -b manpage (see any language template)."
msgstr "docs/<puff>.adoc اور asciidoctor -b manpage کے ساتھ meson custom_target شامل کریں (کوئی بھی زبان ٹیمپلیٹ دیکھیں)۔"

#: src/zfr_lib/lint/layout.py:90
#, python-format
msgid "bash completion: %s"
msgstr "bash تکمیل: %s"

#: src/zfr_lib/lint/layout.py:101
msgid "no *.bash bash-completion script at project root"
msgstr "پروجیکٹ جڑ میں کوئی *.bash bash-completion اسکرپٹ نہیں"

#: src/zfr_lib/lint/layout.py:103
msgid "Add <puff>.bash (or completions/<puff>.in) and install it to datadir/bash-completion/completions renamed to the command name (see meson.build in the template)."
msgstr "<puff>.bash شامل کریں اور کمانڈ نام پر نام بدل کر datadir/bash-completion/completions میں نصب کریں (ٹیمپلیٹ کا meson.build دیکھیں)۔"

#: src/zfr_lib/lint/layout.py:111
msgid "VERSION file present"
msgstr "VERSION فائل موجود ہے"

#: src/zfr_lib/lint/layout.py:117
msgid "no VERSION file (changelog snapshot for tarball builds)"
msgstr "VERSION فائل نہیں (ٹarball تعمیرات کے لیے changelog اسنیپ شاٹ)"

#: src/zfr_lib/lint/layout.py:119
msgid "Create VERSION with the latest debian/changelog version (one line). Enable .githooks/pre-commit: git config core.hooksPath .githooks"
msgstr "تازہ ترین debian/changelog ورژن کے ساتھ VERSION بنائیں (ایک سطر)۔ .githooks/pre-commit فعال کریں: git config core.hooksPath .githooks"

#: src/zfr_lib/lint/layout.py:213
msgid "no .githooks/pre-commit to sync VERSION from debian/changelog"
msgstr "debian/changelog سے VERSION ہم آہنگ کرنے کے لیے .githooks/pre-commit نہیں"

#: src/zfr_lib/lint/layout.py:215
msgid "Walk up to the directory that contains .git, then put pre-commit in that tree's .githooks (or core.hooksPath). The hook must update VERSION from debian/changelog. `zfr create` copies one and sets git config core.hooksPath .githooks."
msgstr ".git والی ڈائرکٹری تک اوپر جائیں، پھر اس درخت کے .githooks (یا core.hooksPath) میں pre-commit رکھیں۔ ہک کو debian/changelog سے VERSION اپ ڈیٹ کرنا ہوگا۔ `zfr create` ایک نقل کرتا ہے اور git config core.hooksPath .githooks سیٹ کرتا ہے۔"

#: src/zfr_lib/lint/layout.py:228
#, python-format
msgid "pre-commit syncs VERSION from debian/changelog (%s)"
msgstr "pre-commit debian/changelog سے VERSION ہم آہنگ کرتا ہے (%s)"

#: src/zfr_lib/lint/layout.py:236
#, python-format
msgid "%s exists but does not sync VERSION from debian/changelog"
msgstr "%s موجود ہے لیکن debian/changelog سے VERSION ہم آہنگ نہیں کرتا"

#: src/zfr_lib/lint/layout.py:238
msgid "The hook should read debian/changelog (dpkg-parsechangelog) and write VERSION. See the zephyr .githooks/pre-commit template."
msgstr "ہک کو debian/changelog پڑھنا چاہیے (dpkg-parsechangelog) اور VERSION لکھنا چاہیے۔ zephyr .githooks/pre-commit ٹیمپلیٹ دیکھیں۔"

#: src/zfr_lib/lint/leftovers.py:49
#, python-format
msgid "%s keeps the template placeholder banner (apps must rewrite it)"
msgstr "%s ٹیمپلیٹ پلیس ہولڈر بینر رکھتا ہے (ایپس کو اسے دوبارہ لکھنا ہوگا)"

#: src/zfr_lib/lint/leftovers.py:52
msgid "After `zfr create`/`zfr rename`, rewrite this README and remove the generated-from-template banner. Templates should keep this banner."
msgstr "`zfr create`/`zfr rename` کے بعد اس README کو دوبارہ لکھیں اور generated-from-template بینر ہٹائیں۔ ٹیمپلیٹس کو یہ بینر رکھنا چاہیے۔"

#: src/zfr_lib/lint/leftovers.py:61
#, python-format
msgid "%s still has the template placeholder banner"
msgstr "%s میں اب بھی ٹیمپلیٹ پلیس ہولڈر بینر ہے"

#: src/zfr_lib/lint/leftovers.py:64
#, python-format
msgid "Rewrite %s for this project. Remove the generated-from-template banner and describe the real commands, build, and license."
msgstr "اس پروجیکٹ کے لیے %s دوبارہ لکھیں۔ generated-from-template بینر ہٹائیں اور حقیقی کمانڈز، تعمیر اور لائسنس بیان کریں۔"

#: src/zfr_lib/lint/leftovers.py:69
#, python-format
msgid "%s has no template banner"
msgstr "%s میں ٹیمپلیٹ بینر نہیں"

#: src/zfr_lib/lint/leftovers.py:101
#, python-format
msgid "%s tree may contain zephyr/some_puff1 placeholders (expected)"
msgstr "%s درخت میں zephyr/some_puff1 پلیس ہولڈر ہو سکتے ہیں (متوقع)"

#: src/zfr_lib/lint/leftovers.py:127 src/zfr_lib/lint/template.py:120
#, python-format
msgid " (+%d more)"
msgstr " (+%d مزید)"

#: src/zfr_lib/lint/leftovers.py:132
#, python-format
msgid "found %(hits)d leftover template token(s) (zephyr/%(token)s): %(preview)s%(more)s"
msgstr "%(hits)d باقی ماندہ ٹیمپلیٹ ٹوکن ملے (zephyr/%(token)s): %(preview)s%(more)s"

#: src/zfr_lib/lint/leftovers.py:134
msgid "Run `zfr rename <project> [puff ...]` or replace remaining zephyr/some_puff1 identifiers. After create, leftover tokens mean instantiation failed."
msgstr "`zfr rename <project> [puff ...]` چلائیں یا باقی zephyr/some_puff1 شناخت کار بدل دیں۔ create کے بعد باقی ٹوکن کا مطلب ہے کہ فوری سازی ناکام ہوئی۔"

#: src/zfr_lib/lint/leftovers.py:138
msgid "no leftover zephyr/some_puff1 tokens"
msgstr "کوئی باقی zephyr/some_puff1 ٹوکن نہیں"

#: src/zfr_lib/lint/meson.py:41
msgid "project() present"
msgstr "project() موجود ہے"

#: src/zfr_lib/lint/meson.py:47
msgid "meson.build has no project() call"
msgstr "meson.build میں project() کال نہیں"

#: src/zfr_lib/lint/meson.py:49
msgid "project() must be the first Meson call. Copy the header from the language template."
msgstr "project() پہلی Meson کال ہونی چاہیے۔ زبان ٹیمپلیٹ سے سرخی کاپی کریں۔"

#: src/zfr_lib/lint/meson.py:54
#, python-format
msgid "license %s"
msgstr "لائسنس %s"

#: src/zfr_lib/lint/meson.py:60
msgid "meson license is not AGPL-3.0-or-later"
msgstr "meson لائسنس AGPL-3.0-or-later نہیں"

#: src/zfr_lib/lint/meson.py:63
#, python-format
msgid "Set license: '%s' in project()."
msgstr "project() میں license: '%s' سیٹ کریں۔"

#: src/zfr_lib/lint/meson.py:69
#, python-format
msgid "%s set"
msgstr "%s سیٹ ہے"

#: src/zfr_lib/lint/meson.py:75
#, python-format
msgid "missing %s (used for man pages)"
msgstr "%s غائب (مین صفحات کے لیے استعمال)"

#: src/zfr_lib/lint/meson.py:77
#, python-format
msgid "Set %s next to project(), then pass -a project-author/email/year to asciidoctor."
msgstr "project() کے پاس %s سیٹ کریں، پھر asciidoctor کو -a project-author/email/year دیں۔"

#: src/zfr_lib/lint/meson.py:82
msgid "version uses `zfr version`"
msgstr "ورژن `zfr version` استعمال کرتا ہے"

#: src/zfr_lib/lint/meson.py:88
msgid "version still uses inline git describe; zephyr style is `zfr version`"
msgstr "ورژن اب بھی ان لائن git describe استعمال کرتا ہے؛ zephyr انداز `zfr version` ہے"

#: src/zfr_lib/lint/meson.py:91
msgid ""
"In project(version: run_command(...)), prefer:\n"
"  v=$(zfr version 2>/dev/null || true)\n"
"  with fallback v=\"0.0.0\" # FIXED TO 0.0.0, DO NOT MODIFY\n"
"See bash/meson.build in the zephyr tree."
msgstr ""
"project(version: run_command(...)) میں ترجیح دیں:\n"
"  v=$(zfr version 2>/dev/null || true)\n"
"  فال بیک کے ساتھ v=\"0.0.0\" # FIXED TO 0.0.0, DO NOT MODIFY\n"
"zephyr درخت میں bash/meson.build دیکھیں۔"

#: src/zfr_lib/lint/meson.py:102
msgid "could not find `zfr version` or git describe in project version"
msgstr "پروجیکٹ ورژن میں `zfr version` یا git describe نہیں ملا"

#: src/zfr_lib/lint/meson.py:104
msgid "Use `zfr version` for project() version (see bash/meson.build)."
msgstr "project() ورژن کے لیے `zfr version` استعمال کریں (bash/meson.build دیکھیں)۔"

#: src/zfr_lib/lint/meson.py:109
msgid "0.0.0 fallback present"
msgstr "0.0.0 فال بیک موجود ہے"

#: src/zfr_lib/lint/meson.py:115
msgid "no explicit 0.0.0 fallback for missing git/VERSION"
msgstr "غائب git/VERSION کے لیے واضح 0.0.0 فال بیک نہیں"

#: src/zfr_lib/lint/meson.py:117
msgid "Keep fallback v=\"0.0.0\" # FIXED TO 0.0.0, DO NOT MODIFY"
msgstr "فال بیک رکھیں v=\"0.0.0\" # FIXED TO 0.0.0, DO NOT MODIFY"

#: src/zfr_lib/lint/meson.py:122
msgid "asciidoctor man pages"
msgstr "asciidoctor مین صفحات"

#: src/zfr_lib/lint/meson.py:128
msgid "meson.build does not invoke asciidoctor"
msgstr "meson.build asciidoctor کو نہیں بلاتا"

