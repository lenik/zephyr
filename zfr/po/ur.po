#: src/zfr:32
msgid ""
"Zephyr template helper (CLI name: zfr). Create projects and manage example "
"puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr ""
"Zephyr ٹیمپلیٹ مددگار (CLI نام: zfr)۔ منصوبے بنائیں اور مثالی puff منظم "
"کریں۔ بنائے گئے درخت zfr کو بلاتے رہتے ہیں؛ zfr rename ٹوکن نہیں ہے۔"

#: src/zfr:45
msgid "show this help"
msgstr "یہ مدد دکھائیں"

#: src/zfr_lib/about.py:496
msgid "print current project information (walks parents from cwd)"
msgstr "موجودہ منصوبے کی معلومات پرنٹ کریں (cwd سے والدین تک)"

#: src/zfr_lib/about.py:498
msgid ""
"Print information about the current zephyr project (walks from cwd toward "
"parent directories). CSR colors when stdout is a TTY. Common packaging "
"fields are parsed from debian or RPM."
msgstr ""
"موجودہ zephyr منصوبے کی معلومات پرنٹ کریں (cwd سے والدین ڈائریکٹریز کی طرف)۔"
" stdout TTY ہونے پر CSR رنگ۔ debian یا RPM سے عام پیکیجنگ فیلڈز پارس ہوتے "
"ہیں۔"

#: src/zfr_lib/about.py:505
msgid "show parsed Debian packaging fields"
msgstr "پارس شدہ Debian پیکیجنگ فیلڈز دکھائیں"

#: src/zfr_lib/about.py:506
msgid "show parsed RPM packaging fields"
msgstr "پارس شدہ RPM پیکیجنگ فیلڈز دکھائیں"

#: src/zfr_lib/about.py:511
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (console SGR) نمایاں (طےشدہ: auto = TTY اور NO_COLOR نہیں)"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "زبان کے ٹیمپلیٹ سے puff(s) بنائیں"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "زبان پہچانیں اور pkgdatadir/<lang> سے puff(s) شامل کریں۔"

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "نئے puff نام (snake_case تجویز)"

#: src/zfr_lib/create.py:291
msgid "create a new project from a language template"
msgstr "زبان کے ٹیمپلیٹ سے نیا منصوبہ بنائیں"

#: src/zfr_lib/create.py:292
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "pkgdatadir/<lang> سے نیا منصوبہ ڈائریکٹری بنائیں۔"

#: src/zfr_lib/create.py:298
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "ٹیمپلیٹ زبان (طےشدہ: python; ان میں سے ایک: %s)"

#: src/zfr_lib/create.py:302
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "debian changelog تقسیم (طےشدہ: %s)"

#: src/zfr_lib/create.py:306
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "ابتدائی پیکیج ورژن اور git ٹیگ (طےشدہ: %s)"

#: src/zfr_lib/create.py:310
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "changelog/git مصنف نام (طےشدہ: %s)"

#: src/zfr_lib/create.py:314
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "changelog/git مصنف ای میل (طےشدہ: %s)"

#: src/zfr_lib/create.py:316
msgid "new project directory name"
msgstr "نئے منصوبے ڈائریکٹری کا نام"

#: src/zfr_lib/create.py:319
msgid "optional puff names to add after creating the project"
msgstr "منصوبہ بنانے کے بعد شامل کرنے کے لیے اختیاری puff نام"

#: src/zfr_lib/detect.py:15
msgid "print detected language for the current directory"
msgstr "موجودہ ڈائریکٹری کے لیے پہچانی گئی زبان پرنٹ کریں"

#: src/zfr_lib/detect.py:16
msgid ""
"Print the detected language of the current project and layout details on "
"stderr."
msgstr ""
"موجودہ منصوبے کی پہچانی گئی زبان اور لےآؤٹ تفصیلات stderr پر پرنٹ کریں۔"

#: src/zfr_lib/dist.py:60
msgid ""
"write the archive into DIR (default: meson-dist, or rpmbuild/SOURCES with "
"--rpm)"
msgstr ""
"DIR میں آرکائیو لکھیں (طےشدہ: meson-dist، یا --rpm کے ساتھ rpmbuild/SOURCES)"

#: src/zfr_lib/dist.py:70
msgid ""
"Meson build directory (default: /build when it matches this source tree, "
"else <project>/build)"
msgstr ""
"Meson بلڈ ڈائریکٹری (طےشدہ: /build جب یہ سورس ٹری سے میل کھائے، ورنہ "
"<project>/build)"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "آرکائیو فارمیٹ (طےشدہ: xz)"

#: src/zfr_lib/dist.py:86
msgid ""
"name the archive NAME-VERSION.tar.xz and write it to rpmbuild/SOURCES unless"
" -o is given"
msgstr ""
"آرکائیو کا نام NAME-VERSION.tar.xz رکھیں اور -o نہ دیا ہو تو "
"rpmbuild/SOURCES میں لکھیں"

#: src/zfr_lib/dist.py:94
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "meson dist کو --allow-dirty پاس کریں (طےشدہ: allow)"

#: src/zfr_lib/dist.py:99
msgid "run tests during meson dist (default: --no-tests)"
msgstr "meson dist کے دوران ٹیسٹ چلائیں (طےشدہ: --no-tests)"

#: src/zfr_lib/dist.py:343
msgid "build a source tarball (meson dist, or this project only)"
msgstr "سورس tarball بنائیں (meson dist، یا صرف یہ منصوبہ)"

#: src/zfr_lib/dist.py:345
msgid ""
"Build a source archive of the current zephyr project (walks from cwd toward "
"parent directories). Uses meson dist when this directory is the git project "
"root; otherwise packs this project only so nested language templates do not "
"ship the parent meta-repo. Prints the archive path on stdout."
msgstr ""
"موجودہ zephyr منصوبے کا سورس آرکائیو بنائیں (cwd سے والدین ڈائریکٹریز کی "
"طرف)۔ جب یہ ڈائریکٹری git منصوبے کی جڑ ہو تو meson dist استعمال کرتا ہے؛ "
"ورنہ صرف یہ منصوبہ پیک کرتا ہے تاکہ nested زبان کے ٹیمپلیٹس والدین meta-repo"
" نہ بھیجیں۔ stdout پر آرکائیو کا راستہ پرنٹ کرتا ہے۔"

#: src/zfr_lib/ize/__init__.py:60
msgid "refactor this project to current zephyr style"
msgstr "اس منصوبے کو موجودہ zephyr انداز میں refactor کریں"

#: src/zfr_lib/ize/__init__.py:61
msgid ""
"Refactor the current project to match current zephyr style: missing "
"debian/rpm files, meson targets, AsciiDoc man pages, and Meson version "
"substitutions. Walks from cwd toward parents."
msgstr ""
"موجودہ منصوبے کو موجودہ zephyr انداز سے ملائیں: غائب debian/rpm فائلیں، "
"meson targets، AsciiDoc man صفحات، اور Meson ورژن تبدیلیاں۔ cwd سے والدین کی"
" طرف۔"

#: src/zfr_lib/ize/__init__.py:65
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "ہم آہنگی کے لیے زبان کا ٹیمپلیٹ (طےشدہ: detect; ان میں سے ایک: %s)"

#: src/zfr_lib/ize/__init__.py:66
msgid "print planned changes without writing files"
msgstr "فائلیں لکھے بغیر منصوبہ بند تبدیلیاں پرنٹ کریں"

#: src/zfr_lib/ize/__init__.py:67
msgid "also print skipped files"
msgstr "چھوڑی گئی فائلیں بھی پرنٹ کریں"

#: src/zfr_lib/ize/__init__.py:68
msgid "do not convert groff .1 man pages to docs/*.adoc"
msgstr "groff .1 man صفحات کو docs/*.adoc میں تبدیل نہ کریں"

#: src/zfr_lib/ize/__init__.py:69
msgid "do not turn hardcoded versions into @VERSION@ / config.h"
msgstr "ہارڈ کوڈ ورژنز کو @VERSION@ / config.h میں نہ بدلیں"

#: src/zfr_lib/ize/__init__.py:70 src/zfr_lib/lint/__init__.py:98
msgid "CSR (console SGR) highlighting (default: auto)"
msgstr "CSR (console SGR) نمایاں (طےشدہ: auto)"

#: src/zfr_lib/lint/__init__.py:90
msgid "validate project packaging and zephyr layout (walks parents from cwd)"
msgstr "منصوبے کی پیکیجنگ اور zephyr لےآؤٹ کی تصدیق (cwd سے والدین تک)"

#: src/zfr_lib/lint/__init__.py:91
msgid ""
"Check the current zephyr project for missing files and packaging/style "
"mistakes. Walks from cwd toward parent directories. CSR colors when stdout "
"is a TTY."
msgstr ""
"موجودہ zephyr منصوبے میں غائب فائلیں اور پیکیجنگ/انداز کی غلطیاں چیک کریں۔ "
"cwd سے والدین ڈائریکٹریز کی طرف۔ stdout TTY ہونے پر CSR رنگ۔"

#: src/zfr_lib/lint/__init__.py:95
msgid "show passing checks too"
msgstr "کامیاب چیک بھی دکھائیں"

#: src/zfr_lib/lint/__init__.py:96
msgid "only print errors"
msgstr "صرف غلطیاں پرنٹ کریں"

#: src/zfr_lib/lint/__init__.py:97
msgid "treat warnings as failures (exit 1)"
msgstr "انتباہات کو ناکامی سمجھیں (exit 1)"

#: src/zfr_lib/release.py:26
msgid "Debian binary-only build (no .dsc)"
msgstr "Debian صرف بائنری بلڈ (کوئی .dsc نہیں)"

#: src/zfr_lib/release.py:32
msgid "Reuse build cache"
msgstr "بلڈ کیش دوبارہ استعمال کریں"

#: src/zfr_lib/release.py:38
msgid "Reuse existing artifacts; build only if missing"
msgstr "موجودہ آرٹifacts دوبارہ استعمال کریں؛ غائب ہونے پر ہی بلڈ کریں"

#: src/zfr_lib/release.py:43
msgid "Build unsigned packages"
msgstr "غیر دستخط شدہ پیکیجز بنائیں"

#: src/zfr_lib/release.py:50
msgid "dput upload host for .changes (debian)"
msgstr ".changes کے لیے dput اپلوڈ ہوسٹ (debian)"

#: src/zfr_lib/release.py:56
msgid "Build debian package with build4 (Docker)"
msgstr "build4 (Docker) سے debian پیکیج بنائیں"

#: src/zfr_lib/release.py:63
#, python-format
msgid "build4 target image (default: %s)"
msgstr "build4 ہدف امیج (طےشدہ: %s)"

#: src/zfr_lib/release.py:70
msgid "Run build4 over SSH on SERVER (implies -d)"
msgstr "SERVER پر SSH سے build4 چلائیں (-d شامل)"

#: src/zfr_lib/release.py:76
msgid "Build in local, no tag/push/release"
msgstr "مقامی طور پر بلڈ، کوئی tag/push/release نہیں"

#: src/zfr_lib/release.py:82
msgid "Replace existing release and tag if present"
msgstr "موجودہ release اور tag کو تبدیل کریں اگر موجود ہوں"

#: src/zfr_lib/release.py:88
msgid "Skip sudo dpkg -i (still find debs/changes)"
msgstr "sudo dpkg -i چھوڑیں (پھر بھی debs/changes ڈھونڈتا ہے)"

#: src/zfr_lib/release.py:94
msgid "Skip git tag create/push"
msgstr "git tag بنانا/push چھوڑیں"

#: src/zfr_lib/release.py:100
msgid "Skip dput upload to deb pool (-u reuses build artifacts)"
msgstr ""
"deb pool میں dput اپلوڈ چھوڑیں (-u بلڈ artifacts دوبارہ استعمال کرتا ہے)"

#: src/zfr_lib/release.py:106
msgid "Skip GitHub release"
msgstr "GitHub release چھوڑیں"

#: src/zfr_lib/release.py:112
msgid "Skip VSIX marketplace publish"
msgstr "VSIX marketplace اشاعت چھوڑیں"

#: src/zfr_lib/release.py:118
msgid "Skip RPM build (rpm/Makefile)"
msgstr "RPM بلڈ چھوڑیں (rpm/Makefile)"

#: src/zfr_lib/release.py:124
msgid "Skip Debian debuild"
msgstr "Debian debuild چھوڑیں"

#: src/zfr_lib/release.py:131
msgid "Verbose logging"
msgstr "تفصیلی لاگنگ"

#: src/zfr_lib/release.py:138
msgid "Less output"
msgstr "کم آؤٹ پUT"

#: src/zfr_lib/release.py:205
msgid "create a GitHub release (parse options, exec gh-makerelease)"
msgstr "GitHub release بنائیں (اختیارات پارس کریں، gh-makerelease exec)"

#: src/zfr_lib/release.py:207
msgid ""
"Parse gh-makerelease options, rebuild argv, and exec gh-makerelease. Does "
"not implement tagging, packaging, or uploads."
msgstr ""
"gh-makerelease اختیارات پارس کریں، argv دوبارہ بنائیں، اور gh-makerelease "
"exec کریں۔ tagging، packaging، یا uploads نافذ نہیں کرتا۔"

#: src/zfr_lib/remove.py:20
msgid "remove puff(s) from the current project"
msgstr "موجودہ منصوبے سے puff(s) ہٹائیں"

#: src/zfr_lib/remove.py:21
msgid "Remove puff files for NAME(s) from the current project."
msgstr "موجودہ منصوبے سے NAME(s) کے puff فائلیں ہٹائیں۔"

#: src/zfr_lib/remove.py:25
msgid "puff name(s) to remove"
msgstr "ہٹانے کے لیے puff نام"

#: src/zfr_lib/rename.py:51
msgid "rename zephyr project and example puff names"
msgstr "zephyr منصوبے اور مثالی puff ناموں کا نام بدلیں"

#: src/zfr_lib/rename.py:52
msgid "Rename zephyr → ProjectName and some_puff1 → example names."
msgstr "zephyr → ProjectName اور some_puff1 → مثالی ناموں کا نام بدلیں۔"

#: src/zfr_lib/rename.py:56
msgid "new project name (replaces 'zephyr')"
msgstr "نیا منصوبہ نام ('zephyr' کی جگہ)"

#: src/zfr_lib/rename.py:57
msgid "new example names (each replaces template some_puff1)"
msgstr "نئے مثالی نام (ہر ایک ٹیمپلیٹ some_puff1 کی جگہ)"

#: src/zfr_lib/shape.py:259
msgid ""
"print zephyr package shape score 0-100 (packagedir vs repodir in monorepos)"
msgstr ""
"zephyr پیکیج شکل اسکور 0-100 پرنٹ کریں (monorepos میں packagedir بمقابلہ "
"repodir)"

#: src/zfr_lib/shape.py:261
msgid ""
"Score how completely the current directory matches zephyr package style "
"(0-100). In monorepos, scores the packagedir."
msgstr ""
"اسکور کریں کہ موجودہ ڈائریکٹری zephyr پیکیج انداز سے کتنا میل کھاتی ہے "
"(0-100)۔ monorepos میں، packagedir کو اسکور کرتا ہے۔"

#: src/zfr_lib/shape.py:267
msgid "print 1 if score >= threshold, else 0"
msgstr "1 پرنٹ کریں اگر score >= threshold، ورنہ 0"

#: src/zfr_lib/shape.py:268
msgid "print packagedir/repodir/role on stderr"
msgstr "stderr پر packagedir/repodir/role پرنٹ کریں"

#: src/zfr_lib/shape.py:269
#, python-format
msgid "bool threshold 0-100 (default: %s)"
msgstr "bool threshold 0-100 (طےشدہ: %s)"

#: src/zfr_lib/version.py:51
msgid "print current project version (walks parents from cwd)"
msgstr "موجودہ منصوبے کا ورژن پرنٹ کریں (cwd سے والدین تک)"

#: src/zfr_lib/version.py:52
msgid ""
"Print the current project version (walks from cwd toward parent "
"directories)."
msgstr "موجودہ منصوبے کا ورژن پرنٹ کریں (cwd سے والدین ڈائریکٹریز کی طرف)۔"

#: src/zfr_lib/version.py:57
msgid "use git describe (default when git and .git are available)"
msgstr "git describe استعمال کریں (طےشدہ جب git اور .git دستیاب ہوں)"

#: src/zfr_lib/version.py:58
msgid "use debian/changelog (default when git or .git is unavailable)"
msgstr "debian/changelog استعمال کریں (طےشدہ جب git یا .git دستیاب نہ ہو)"

#: src/zfr_lib/version.py:59
msgid "print an RPM-compatible Version (hyphens mapped to underscores)"
msgstr "RPM-مطابق Version پرنٹ کریں (ہائفن انڈر سکور میں)"
