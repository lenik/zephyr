msgstr "%s کے مکمل دستاویز man تراجم موجود"

#: src/zfr_lib/lint/i18n_check.py:265
#, python-format
msgid "man translation still contains the English Name line: %s"
msgstr "man ترجمے میں اب بھی انگریزی Name سطر ہے: %s"

#: src/zfr_lib/lint/i18n_check.py:268
msgid "Translate the Name line; do not leave the English wording."
msgstr "Name سطر کا ترجمہ کریں؛ انگریزی عبارت نہ رہنے دیں۔"

#: src/zfr_lib/lint/i18n_check.py:276
msgid "no po/: man locale translations not required"
msgstr "کوئی po/ نہیں: انسان لوجیل ترجمے کی ضرورت نہیں ہے"

#: src/zfr_lib/lint/identity.py:57
#, python-format
msgid "%(label)s is %(val)r, expected %(expected)r (directory name)"
msgstr "%(label)s ہے %(val)r، متوقع %(expected)r (ڈائریکٹری کا نام)"

#: src/zfr_lib/lint/identity.py:60
#, python-format
msgid "Set %(label)s to %(expected)r, or rename the directory. Use `zfr rename %(expected)s` if leftover template names remain."
msgstr "%(label)s کو %(expected)r کر دیں، یا ڈائریکٹری کا نام بدل دیں۔ سانچے کے نام رہ جائیں تو `zfr rename %(expected)s` استعمال کریں۔"

#: src/zfr_lib/lint/identity.py:66
#, python-format
msgid "%(label)s=%(val)s"
msgstr "%(label)s=%(val)s"

#: src/zfr_lib/lint/identity.py:69
#, python-format
