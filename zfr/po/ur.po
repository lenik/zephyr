msgstr "gettext کلٹوج استعمال --no-wrap (کسی لائن پیپن نہیں)"

#: src/zfr_lib/lint/i18n_check.py:243
#, python-format
msgid "missing whole-document man translations for %(level)s: %(files)s"
msgstr "%(level)s کے لیے مکمل دستاویز man تراجم غائب: %(files)s"

#: src/zfr_lib/lint/i18n_check.py:246
#, python-format
