msgstr "Version в spec е твърдо зададен; стилът zephyr вмъква `zfr version`"

#: src/zfr_lib/lint/rpm.py:76
#, no-python-format
msgid "Use Version: %{version} with %{!?version:%global version 0.0.0} and freeze via rpm/Makefile (`zfr version` / `zfr version -r`)."
msgstr "Използвайте Version: %{version} с %{!?version:%global version 0.0.0} и замразете чрез rpm/Makefile (`zfr version` / `zfr version -r`)."

