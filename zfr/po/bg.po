msgstr "бюджет на работата: пропуснете или оставете -j самостоятелно за автоматично (debuild/dpkg-buildpackage получават чисто -j); -j N щифтове общо разпределение на бюджета между едновременно планирани работници"

#: src/lang/_c_bas.py:187
msgid "no int main() in src/; skip bas i18n main checks"
msgstr "няма инт майн () в src/; прескачайте основни проверки на бас i18n"

#: src/lang/_c_bas.py:208
#, python-format
msgid "main missing bas i18n setup: %s"
msgstr "основна липсваща баз i18n настройка: %s"

#: src/lang/_c_bas.py:211
msgid "In main: #include <bas/locale/i18n.h> and <bas/proc/env.h>; const char *exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR from meson config.h). Run `zfr ize`."
msgstr "В главно: #include <bas/locale/i18n.h> и <bas/proc/env.h>; конст знак * exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR от meson config.h). Изпълни `zfr ize`."

#: src/lang/_c_bas.py:222
msgid "bas i18n main setup (self_exe + init_i18n)"
msgstr "основна настройка на баз i18n (self_exe + init_i18n)"

#: src/lang/_c_bas.py:233
msgid "no define_logger() in src/"
msgstr "няма define_logger() в src/"

#: src/lang/_c_bas.py:236
msgid "In one .c/.cpp: #include <bas/log/deflog.h> then define_logger(); libraries may use __attribute__((weak)) define_logger(); Run `zfr ize`."
msgstr "В един .c/.cpp: #include <bas/log/deflog.h> след това define_logger(); библиотеки могат да използват _attribute_(feak) define_logger(); Изпълни `zfr ize`."

#: src/lang/_c_bas.py:250
msgid "define_logger() present"
msgstr "project() е налице"

#: src/lang/_c_bas.py:252
msgid "weak define_logger() present (library)"
msgstr "има weak define_logger() (библиотека)"

#: src/lang/_c_bas.py:258
msgid "define_logger() without #include <bas/log/deflog.h>"
msgstr "define_logger () без #include <bas/log/deflog.h>"

#: src/lang/_c_bas.py:260
msgid "Add #include <bas/log/deflog.h> before define_logger();"
msgstr "Добавяне #include <bas/log/deflog.h> преди define_logger();"

#: src/lang/_c_bas.py:276
msgid "meson.build missing LOCALEDIR in config.h"
msgstr "meson.build липсва LOCALEDIR в конфигурация.h"

#: src/lang/_c_bas.py:279
msgid "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Run `zfr ize`."
msgstr "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Изпълни `zfr ize`."

#: src/lang/_c_bas.py:289
msgid "meson LOCALEDIR present"
msgstr "има meson LOCALEDIR"

#: src/lang/_c_bas.py:306
#, python-format
msgid "gettext string has leading/trailing spaces: %r"
msgstr "gettext Структура има leading/trailing простори: %r"

#: src/lang/_c_bas.py:310
msgid "Keep padding outside _(): e.g. fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\n\"), out);"
msgstr ""
"Дръжте на падификация във _(): например fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\\n"
"\"), out);"

#: src/lang/_c_bas.py:320
msgid "gettext _() strings have no leading/trailing spaces"
msgstr "gettext _ () нитове няма leading/trailing простори"

#: src/lang/antlr.py:42 src/lang/as.py:30 src/lang/bison.py:38 src/lang/c.py:24
