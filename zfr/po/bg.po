#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "извеждане на информация за текущия проект (търси нагоре от cwd)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Извежда информация за текущия zephyr проект (търси нагоре от cwd). CSR цветове, когато stdout е TTY. Общите полета за пакетиране се четат от debian или RPM."

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "показване на анализираните полета за Debian пакетиране"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "показване на анализираните полета за RPM пакетиране"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (console SGR) подчертаване (по подразбиране: auto = TTY и без NO_COLOR)"

#: src/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "създаване на puff(ове) от езиковия шаблон"

#: src/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Разпознава езика и добавя puff(ове) от pkgdatadir/<lang>."

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "нови имена на puff(ове) (препоръчително snake_case)"

#: src/build.py:15
msgid "detect build system and compile the project"
msgstr "открийте системата за изграждане и компилирайте проекта"

#: src/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "Открийте системата за изграждане на проекта (meson, cmake, autotools, cargo, go, npm, make) и стартирайте локално компилиране."

#: src/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "превключете на DIR преди да откриете системата за изграждане"

#: src/build.py:35
msgid "build directory (default: <project>/build)"
msgstr "Meson build каталог (по подразбиране: /build, ако съответства на това дърво с изходен код, иначе <project>/build)"

#: src/build.py:42 src/package.py:120
msgid "print planned commands without running them"
msgstr "извеждане на планираните промени без запис на файлове"

#: src/build.py:48
msgid "verbose build output where supported"
msgstr "подробен изход при изграждане, където е поддържан"

#: src/build.py:53
msgid "print detected build system and exit"
msgstr "покажи открита система за изграждане и излез"

#: src/build.py:58
msgid "preview files meson would install (DESTDIR tree; replaces scripts/look.sh)"
msgstr "преглед на файловете, които meson ще инсталира (дърво DESTDIR; замества scripts/look.sh)"

#: src/build.py:67
msgid "with --look, limit tree depth to N levels (implies --look; default is unlimited)"
msgstr "с --look ограничава дълбочината на дървото до N нива (подразумева --look; по подразбиране без лимит)"

#: src/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "покажи или изтрий проект/потребителски lint.коментари с подсказка за работа с AI"

#: src/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr "Печатайте коментари с предложения за lint от .config/zfr/lint.comments (проект) и ~/.config/zfr/lint.comments (потребител), след това AI подсказка за прилагане на предложенията и изтриване на използваните файлове с коментари. Опционални ZLxxxx аргументи филтрират кои секции да се показват. Типичен пример за подканване: “do zfr-comments work.”"

#: src/comments_cmd.py:35
msgid "only these rule ids (default: all)"
msgstr "bool праг 0-100 (по подразбиране: %s)"

#: src/comments_cmd.py:42 src/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "директория на проекта (по подразбиране: започва от текущата работна директория)"

#: src/comments_cmd.py:49
msgid "user comments only (~/.config/zfr/lint.comments)"
msgstr "само коментари на потребители (~/.config/zfr/lint.comments)"

#: src/comments_cmd.py:55
msgid "project comments only (.config/zfr/lint.comments)"
msgstr "само коментари по проекта (.config/zfr/lint.comments)"

#: src/comments_cmd.py:61
msgid "delete matching comments (files or selected sections)"
msgstr "изтрий съвпадащите коментари (файлове или избрани секции)"

#: src/comments_cmd.py:67
msgid "omit the AI hint trailer"
msgstr "пропуснете трейлъра с подсказка от ИИ"

#: src/comments_cmd.py:93
msgid "No matching lint.comments to delete."
msgstr "Няма съвпадащи lint.коментари за изтриване."

#: src/comments_cmd.py:96
#, python-format
msgid "Deleted: %s"
msgstr "налице: %s"

#: src/create.py:287
msgid "create a new project from a language template"
msgstr "създаване на нов проект от езиков шаблон"

#: src/create.py:288
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "Създава нов проектен каталог от pkgdatadir/<lang>."

#: src/create.py:295
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "език на шаблона (по подразбиране: python; един от: %s)"

#: src/create.py:299
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "дистрибуция в debian changelog (по подразбиране: %s)"

#: src/create.py:303
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "начална версия на пакета и git етикет (по подразбиране: %s)"

#: src/create.py:307
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "име на автора в changelog/git (по подразбиране: %s)"

#: src/create.py:311
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "имейл на автора в changelog/git (по подразбиране: %s)"

#: src/create.py:317
msgid "do not instantiate a default puff (leave some_puff1 tokens for a later zfr add)"
msgstr "не инициализирайте подразбиращ се puff (оставете някои some_puff1 токени за по-късно добавяне на zfr)"

#: src/create.py:321
msgid "new project directory name"
msgstr "име на новия проектен каталог"

#: src/create.py:325
msgid "puff names (default: one puff named like the package; use --no-puff for none)"
msgstr "имена на пушове (по подразбиране: един пуш с името на опаковката; използвайте --no-puff за без име)"

#: src/detect.py:15
msgid "print detected language for the current directory"
msgstr "извеждане на разпознатия език за текущия каталог"

#: src/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "Извежда разпознатия език на текущия проект и подробности за оформлението на stderr."

#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "запис на архива в DIR (по подразбиране: meson-dist или %_topdir/SOURCES ($HOME/rpmbuild) с --rpm)"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "Meson build каталог (по подразбиране: /build, ако съответства на това дърво с изходен код, иначе <project>/build)"

#: src/dist.py:81
msgid "archive format (default: xz)"
msgstr "формат на архива (по подразбиране: xz)"

#: src/dist.py:87
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "именува архива NAME-VERSION.tar.xz и го записва в %_topdir/SOURCES ($HOME/rpmbuild), освен ако е зададено -o"

#: src/dist.py:96
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "предаване на --allow-dirty на meson dist (по подразбиране: разрешено)"

#: src/dist.py:101
msgid "run tests during meson dist (default: --no-tests)"
msgstr "изпълнение на тестове по време на meson dist (по подразбиране: --no-tests)"

#: src/dist.py:418
msgid "build a source tarball (meson dist, or this project only)"
msgstr "създаване на изходен tarball (meson dist или само този проект)"

#: src/dist.py:420
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. When ``.tarignore`` exists (gitignore-style), always pack the project tree and apply those excludes. Prints the archive path on stdout."
msgstr "Създава изходен архив на текущия zephyr проект (търси нагоре от cwd). Използва meson dist, когато този каталог е коренът на git проекта; иначе пакетира само този проект, за да не включват вложените езикови шаблони родителското meta-repo. Извежда пътя до архива на stdout."

#: src/i18n/cmd.py:42
msgid "no implemented locales (po/LINGUAS + po/*.po)"
msgstr "няма прилаган локали (po/LINGUAS + po/*.po)"

#: src/i18n/cmd.py:47
msgid "  [derived]"
msgstr "  [производен]"

