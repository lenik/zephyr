msgstr "ланцовка за презход: %(chain)s"

#: src/i18n/cmd.py:66
#, python-format
msgid "children (->): %(kids)s"
msgstr "Деца (->): %(kids)s"

#: src/i18n/cmd.py:70
#, python-format
msgid "catalog: %(path)s"
msgstr "Каталог: %(path)s"

#: src/i18n/cmd.py:72
#, python-format
msgid "po stats: %(translated)d/%(total)d translated, %(missing)d missing"
msgstr "po статистики: %(translated)d/%(total)d преведен, %(missing)d липсва"

#: src/i18n/cmd.py:75
msgid "no .po catalog in this project"
msgstr "не .po каталога в този проект"

#: src/i18n/cmd.py:93
#, python-format
msgid "locale not found: %s"
msgstr "локално не е намерено: %s"

#: src/i18n/cmd.py:147
#, python-format
msgid "would build %d derived locale file(s)"
msgstr "бих изградил %d достигнато локално(и) файл(и)"

#: src/i18n/cmd.py:167
msgid "manage implemented gettext locales"
msgstr "управляване на изпълнени gettext локали"

#: src/i18n/cmd.py:169
msgid "List, add, delete, and build derived locales in the current project. Use zfr translate to query or update message strings."
msgstr "Списък, добавяне, изтриване и изградяне на използвани локали в текущия проект. Използвайте zfr преводите за запитване или обновяване на низите на съобщенията."

#: src/i18n/cmd.py:179
msgid "list all implemented locales in this project"
msgstr "списък на всички изпълнени локали в този проект"

#: src/i18n/cmd.py:185
msgid "delete a locale (LINGUAS, .po, man/)"
msgstr "изтриване на локална локална (LINGUAS, .po, docs/)"

#: src/i18n/cmd.py:191
msgid "add a new locale"
msgstr "Добавяне на нов локал"

#: src/i18n/cmd.py:197
msgid "build derived locale PO/man files from parents (skip locales in LINGUAS)"
msgstr "изгради локално PO/man файлове от родителите (скопирани локали в LINGUAS)"

#: src/i18n/cmd.py:202
msgid "output directory for derived .po files (default: build/po or $MESON_BUILD_ROOT/po)"
msgstr "директориен изход за изпълнени файлове .po (подразделен: build/po или $MESON_BUILD_ROOT/po)"

#: src/i18n/cmd.py:207
msgid "write a stamp file listing derived paths (for Meson custom_target)"
msgstr "записване на списъка на лента на файловете на излизани пътувания (за Meson custom_target)"

#: src/i18n/cmd.py:212
msgid "with --build, also msgfmt derived .po into LC_MESSAGES (for Meson)"
msgstr "с --build, също msgfmt, изглеждано .po в LC_MESSAGES (за Meson)"

#: src/i18n/cmd.py:217
msgid "gettext domain for --compile-mo / --install-derived"
msgstr "Домен gettext за --compile-mo / --install-derived"

#: src/i18n/cmd.py:223
msgid "install derived .mo from --po-dir into $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"
msgstr "инсталиране .mo от --po-dir в $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"

#: src/i18n/cmd.py:231
msgid "with --install-derived, locale subdirectory under prefix (default: share/locale)"
msgstr "с --install-derived, локална поддиректура под prefix (предвиден: share/locale)"

#: src/i18n/cmd.py:233
msgid "with --build, print only"
msgstr "С --build, само отпечатък"

#: src/i18n/cmd.py:234
msgid "with --build, overwrite existing"
msgstr "с --build, препишете съществуващи"

#: src/i18n/cmd.py:235
msgid "locale to inspect"
msgstr "локално за проверка"

#: src/i18n/cmd.py:241
msgid "--install-derived requires --po-dir and --domain"
msgstr "--install-derived изисква --po-dir и --domain"

#: src/ize/__init__.py:76
msgid "refactor this project to current zephyr style"
msgstr "рефакториране на този проект към текущия zephyr стил"

#: src/ize/__init__.py:77
msgid "Refactor the current project to match current zephyr style: missing debian/rpm files, meson targets, AsciiDoc man pages, Meson version substitutions, and lint-level gettext coverage (LINGUAS + .po). Does not scaffold man/<locale> man translations. Walks from cwd toward parents."
msgstr "Рефакторира текущия проект според актуалния zephyr стил: липсващи debian/rpm файлове, meson цели, AsciiDoc man страници и Meson замествания на версии. Търси нагоре от cwd."

#: src/ize/__init__.py:81
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "езиков шаблон за съгласуване (по подразбиране: detect; един от: %s)"

#: src/ize/__init__.py:82
msgid "print planned changes without writing files"
msgstr "извеждане на планираните промени без запис на файлове"

#: src/ize/__init__.py:87
msgid "list numbered ize standards (ZI*) as a table and exit"
msgstr "списък на номерирани стандарти на изиза (ZI*) като таблица и изход"

#: src/ize/__init__.py:93
msgid "show details for ize standard NUM (e.g. ZI0015, 15) and exit"
msgstr "показате подробности за изизане стандарт NUM (например ZI0015, 15) и излез"

#: src/ize/__init__.py:100
msgid "bump patch version (debian/changelog + VERSION), git add -A, and commit ize changes with a verbose message"
msgstr "версия на bump plash (debian/changelog + VERSION), git добавя -A и издаване на промени с словно съобщение"

#: src/ize/__init__.py:109
msgid "changelog author for --commit (Name or 'Name <email>'); default: reuse the previous debian/changelog trailer"
msgstr "автор на изменение за --commit (Име или 'Име <email>'); размер: възстановяване на предишния debian/changelog приема"

#: src/ize/__init__.py:113
msgid "also print skipped files"
msgstr "извеждане и на пропуснатите файлове"

#: src/ize/__init__.py:119
msgid "run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr "изпълнявайте 2meson за превъртане Autotools/CMake на Meson, когато имате (предвиден: on)"

#: src/ize/__init__.py:121
msgid "do not convert groff .1 man pages to man/*.adoc"
msgstr "без конвертиране на groff .1 man страници в docs/*.adoc"

#: src/ize/__init__.py:122
