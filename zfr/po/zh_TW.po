#: src/zfr:32
msgid "Zephyr template helper (CLI name: zfr). Create projects and manage example puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr "Zephyr 範本助手（CLI 名稱：zfr）。建立專案並管理範例 puff。實例化的目錄樹仍呼叫 zfr；zfr 不是重新命名標記。"

#: src/zfr:46
msgid "show this help"
msgstr "顯示此說明"

#: src/zfr_lib/about.py:496
msgid "print current project information (walks parents from cwd)"
msgstr "列印目前專案資訊（從 cwd 向上遍歷父目錄）"

#: src/zfr_lib/about.py:498
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "列印目前 zephyr 專案資訊（從 cwd 向父目錄遍歷）。stdout 為 TTY 時使用 CSR 顏色。從 debian 或 RPM 解析常見打包欄位。"

#: src/zfr_lib/about.py:505
msgid "show parsed Debian packaging fields"
msgstr "顯示已解析的 Debian 打包欄位"

#: src/zfr_lib/about.py:506
msgid "show parsed RPM packaging fields"
msgstr "顯示已解析的 RPM 打包欄位"

#: src/zfr_lib/about.py:511
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (console SGR) 醒目顯示（預設：auto = TTY 且無 NO_COLOR）"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "從語言範本實例化 puff"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "偵測語言並從 pkgdatadir/<lang> 新增 puff。"

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "新 puff 名稱（建議 snake_case）"

#: src/zfr_lib/create.py:311
msgid "create a new project from a language template"
msgstr "從語言範本建立新專案"

#: src/zfr_lib/create.py:312
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "從 pkgdatadir/<lang> 建立新專案目錄。"

#: src/zfr_lib/create.py:319
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "範本語言（預設：python；可選：%s）"

#: src/zfr_lib/create.py:323
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "debian changelog 發行版（預設：%s）"

#: src/zfr_lib/create.py:327
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "初始套件版本與 git 標籤（預設：%s）"

#: src/zfr_lib/create.py:331
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "changelog/git 作者姓名（預設：%s）"

#: src/zfr_lib/create.py:335
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "changelog/git 作者電子郵件（預設：%s）"

#: src/zfr_lib/create.py:337
msgid "new project directory name"
msgstr "新專案目錄名稱"

#: src/zfr_lib/create.py:340
msgid "optional puff names to add after creating the project"
msgstr "建立專案後要新增的可選 puff 名稱"

#: src/zfr_lib/detect.py:15
msgid "print detected language for the current directory"
msgstr "列印目前目錄偵測到的語言"

#: src/zfr_lib/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "將目前專案偵測到的語言與版面詳情列印到 stderr。"

#: src/zfr_lib/dist.py:60
msgid "write the archive into DIR (default: meson-dist, or %_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "將封存寫入 DIR（預設：meson-dist，或使用 --rpm 時寫入 %_topdir/SOURCES ($HOME/rpmbuild)）"

#: src/zfr_lib/dist.py:70
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "Meson 建置目錄（預設：與此原始碼樹相符時為 /build，否則為 <project>/build）"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "封存格式（預設：xz）"

#: src/zfr_lib/dist.py:86
msgid "name the archive NAME-VERSION.tar.xz and write it to %_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "將封存命名為 NAME-VERSION.tar.xz 並寫入 %_topdir/SOURCES ($HOME/rpmbuild)（除非指定 -o）"

#: src/zfr_lib/dist.py:94
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "向 meson dist 傳遞 --allow-dirty（預設：allow）"

#: src/zfr_lib/dist.py:99
msgid "run tests during meson dist (default: --no-tests)"
msgstr "在 meson dist 期間執行測試（預設：--no-tests）"

#: src/zfr_lib/dist.py:343
msgid "build a source tarball (meson dist, or this project only)"
msgstr "建置原始碼 tarball（meson dist，或僅本專案）"

#: src/zfr_lib/dist.py:345
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. Prints the archive path on stdout."
msgstr "建置目前 zephyr 專案的原始碼封存（從 cwd 向父目錄遍歷）。當此目錄為 git 專案根時使用 meson dist；否則僅打包本專案，以免嵌套語言範本附帶父 meta-repo。在 stdout 列印封存路徑。"

#: src/zfr_lib/ize/__init__.py:65
msgid "refactor this project to current zephyr style"
msgstr "將此專案重構為目前 zephyr 風格"

#: src/zfr_lib/ize/__init__.py:66
msgid "Refactor the current project to match current zephyr style: missing debian/rpm files, meson targets, AsciiDoc man pages, and Meson version substitutions. Walks from cwd toward parents."
msgstr "重構目前專案以符合目前 zephyr 風格：缺失的 debian/rpm 檔案、meson 目標、AsciiDoc man 頁面與 Meson 版本替換。從 cwd 向父目錄遍歷。"

#: src/zfr_lib/ize/__init__.py:70
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "要對齊的語言範本（預設：detect；可選：%s）"

#: src/zfr_lib/ize/__init__.py:71
msgid "print planned changes without writing files"
msgstr "列印計畫變更而不寫入檔案"

#: src/zfr_lib/ize/__init__.py:72
msgid "also print skipped files"
msgstr "同時列印略過的檔案"

#: src/zfr_lib/ize/__init__.py:78
msgid "run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr "存在 Autotools/CMake 時執行 2meson 轉換為 Meson（預設：開啟）"

#: src/zfr_lib/ize/__init__.py:80
msgid "do not convert groff .1 man pages to docs/*.adoc"
msgstr "不要將 groff .1 man 頁面轉換為 docs/*.adoc"

#: src/zfr_lib/ize/__init__.py:81
msgid "do not turn hardcoded versions into @VERSION@ / config.h"
msgstr "不要將硬編碼版本轉換為 @VERSION@ / config.h"

#: src/zfr_lib/ize/__init__.py:82 src/zfr_lib/lint/__init__.py:115
msgid "CSR (console SGR) highlighting (default: auto)"
msgstr "CSR (console SGR) 醒目顯示（預設：auto）"

#: src/zfr_lib/l10n.py:93
#, python-format
msgid "l10n level must be L0–L3 (or 0–3), not %r"
msgstr "l10n 等級必須為 L0–L3（或 0–3），不可為 %r"

#: src/zfr_lib/lang/antlr.py:42 src/zfr_lib/lang/as.py:30
#: src/zfr_lib/lang/bison.py:38 src/zfr_lib/lang/clib.py:34
#: src/zfr_lib/lang/cobol.py:32 src/zfr_lib/lang/cpplib.py:34
#: src/zfr_lib/lang/cpp.py:21 src/zfr_lib/lang/c.py:21 src/zfr_lib/lang/d.py:32
#: src/zfr_lib/lang/fortran.py:32 src/zfr_lib/lang/gcc.py:48
#: src/zfr_lib/lang/kotlin.py:22 src/zfr_lib/lang/lua.py:22
#: src/zfr_lib/lang/nim.py:24 src/zfr_lib/lang/pascal.py:32
#: src/zfr_lib/lang/python.py:21
msgid "tests/ present"
msgstr "已存在 tests/"

#: src/zfr_lib/lang/antlr.py:47 src/zfr_lib/lang/as.py:35
#: src/zfr_lib/lang/bison.py:43 src/zfr_lib/lang/clib.py:35
#: src/zfr_lib/lang/cpplib.py:35 src/zfr_lib/lang/cpp.py:22
#: src/zfr_lib/lang/c.py:22 src/zfr_lib/lang/gcc.py:53
msgid "no tests/ directory"
msgstr "缺少 tests/ 目錄"

#: src/zfr_lib/lang/antlr.py:49
msgid "Add tests/TestCommons.java or fixture checks for parser output."
msgstr "請新增 tests/TestCommons.java，或針對剖析器輸出加入測試夾具檢查。"

#: src/zfr_lib/lang/as.py:37
msgid "Add tests/smoke.sh and meson test() for stdin/stdout copy."
msgstr "請新增 tests/smoke.sh，並以 meson test() 檢查 stdin/stdout 複製。"

#: src/zfr_lib/lang/bash.py:45
#, python-format
msgid "src scripts: %s"
msgstr "src 指令稿：%s"

#: src/zfr_lib/lang/bash.py:46
msgid "no src/*.in scripts"
msgstr "缺少 src/*.in 指令稿"

#: src/zfr_lib/lang/bash.py:47
msgid "Keep configured scripts as src/<puff>.in with @PACKAGE@/@VERSION@ and meson configure_file + install_mode rwxr-xr-x."
msgstr "請把需設定的指令稿維持為含 @PACKAGE@/@VERSION@ 的 src/<puff>.in，並搭配 meson configure_file + install_mode rwxr-xr-x。"

#: src/zfr_lib/lang/bison.py:45
msgid "Add tests/ with fixture checks for parser dump/format output."
msgstr "請新增 tests/，並以測試夾具核對剖析器的 dump/format 輸出。"

#: src/zfr_lib/lang/clib.py:36 src/zfr_lib/lang/cpplib.py:36
#: src/zfr_lib/lang/cpp.py:23 src/zfr_lib/lang/c.py:23
#: src/zfr_lib/lang/gcc.py:55
msgid "Add tests/ and meson test() entries like the C family templates."
msgstr "請比照 C 家族範本新增 tests/ 與 meson test() 項目。"

#: src/zfr_lib/lang/cobol.py:37
msgid "no tests/ (cobol template uses cobc + meson test)"
msgstr "缺少 tests/（cobol 範本使用 cobc + meson test）"

#: src/zfr_lib/lang/cobol.py:39
msgid "Add tests/test_commons.sh or similar smoke test for cobc."
msgstr "請為 cobc 新增 tests/test_commons.sh 或同等的煙霧測試。"

#: src/zfr_lib/lang/d.py:37
msgid "no tests/ (D template uses ldc/dmd + meson test)"
msgstr "缺少 tests/（D 範本使用 ldc/dmd + meson test）"

#: src/zfr_lib/lang/d.py:39
msgid "Add tests/test_commons.d and meson test() executable."
msgstr "請新增 tests/test_commons.d 與 meson test() 可執行檔。"

#: src/zfr_lib/lang/fortran.py:37
msgid "no tests/ (fortran template uses gfortran + meson test)"
msgstr "缺少 tests/（fortran 範本使用 gfortran + meson test）"

#: src/zfr_lib/lang/fortran.py:39
msgid "Add tests/test_commons.f90 and meson test() executable."
msgstr "請新增 tests/test_commons.f90 與 meson test() 可執行檔。"

#: src/zfr_lib/lang/go.py:22
msgid "missing go.mod"
msgstr "找不到 go.mod"

#: src/zfr_lib/lang/go.py:23
msgid "Add go.mod; meson should `go build` with -X main.buildVersion from meson.project_version()."
msgstr "請新增 go.mod；meson 應以 meson.project_version() 提供的 -X main.buildVersion 執行 `go build`。"

#: src/zfr_lib/lang/kotlin.py:23
msgid "no tests/ (kotlin template uses kotlinc + meson test)"
msgstr "缺少 tests/（kotlin 範本使用 kotlinc + meson test）"

#: src/zfr_lib/lang/kotlin.py:24
msgid "Add tests/Test*.kt and meson test() compiling with kotlinc."
msgstr "請新增 tests/Test*.kt，並以 kotlinc 編譯 meson test()。"

#: src/zfr_lib/lang/lua.py:23
msgid "no tests/ (lua template uses lua tests + meson test)"
msgstr "缺少 tests/（lua 範本使用 lua 測試 + meson test）"

#: src/zfr_lib/lang/lua.py:24
msgid "Add tests/test_*.lua and meson test() invoking lua with LUA_PATH=src/?.lua."
msgstr "請新增 tests/test_*.lua，並以 LUA_PATH=src/?.lua 呼叫 lua 的 meson test()。"

#: src/zfr_lib/lang/nim.py:25
msgid "no tests/ (nim template uses unittest + meson test)"
msgstr "缺少 tests/（nim 範本使用 unittest + meson test）"

#: src/zfr_lib/lang/nim.py:26
msgid "Add tests/test_*.nim and meson test() with nim r."
msgstr "請新增 tests/test_*.nim，並以 nim r 搭配 meson test()。"

#: src/zfr_lib/lang/pascal.py:37
msgid "no tests/ (pascal template uses fpc + meson test)"
msgstr "缺少 tests/（pascal 範本使用 fpc + meson test）"

#: src/zfr_lib/lang/pascal.py:39
msgid "Add tests/test_commons.pas and meson test() with fpc."
msgstr "請新增 tests/test_commons.pas，並以 fpc 搭配 meson test()。"

#: src/zfr_lib/lang/python.py:22
msgid "no tests/ (python template uses unittest + meson test)"
msgstr "缺少 tests/（python 範本使用 unittest + meson test）"

#: src/zfr_lib/lang/python.py:23
msgid "Add tests/test_*.py and meson test() with PYTHONPATH=src."
msgstr "請新增 tests/test_*.py，並以 PYTHONPATH=src 搭配 meson test()。"

#: src/zfr_lib/lang/rust.py:22
msgid "missing Cargo.toml"
msgstr "找不到 Cargo.toml"

#: src/zfr_lib/lang/rust.py:23
msgid "Rust zephyr projects keep Cargo.toml plus meson custom_target for the binary."
msgstr "Rust 的 zephyr 專案會保留 Cargo.toml，並以 meson custom_target 產出二進位檔。"

#: src/zfr_lib/lang/zig.py:23
msgid "missing build.zig"
msgstr "找不到 build.zig"

#: src/zfr_lib/lang/zig.py:24
msgid "Add build.zig; meson should invoke `zig build -Doptimize=ReleaseFast`."
msgstr "請新增 build.zig；meson 應執行 `zig build -Doptimize=ReleaseFast`。"

#: src/zfr_lib/lint/debian.py:42
#, python-format
msgid "Build-Depends has %s"
msgstr "Build-Depends 已列入 %s"

#: src/zfr_lib/lint/debian.py:48
#, python-format
msgid "Build-Depends missing %s"
msgstr "Build-Depends 未列出 %s"

#: src/zfr_lib/lint/debian.py:50
#, python-format
msgid "Add %s to Build-Depends (zephyr packages build with Meson + AsciiDoc man pages)."
msgstr "請將 %s 列入 Build-Depends（zephyr 套件以 Meson 建置，並用 AsciiDoc 產出手冊頁）。"

#: src/zfr_lib/lint/debian.py:54
msgid "debhelper-compat present"
msgstr "已包含 debhelper-compat"

#: src/zfr_lib/lint/debian.py:60
msgid "Build-Depends missing debhelper-compat (= 13)"
msgstr "Build-Depends 未列出 debhelper-compat (= 13)"

#: src/zfr_lib/lint/debian.py:62
msgid "Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"
msgstr "Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"

#: src/zfr_lib/lint/debian.py:72
msgid "Package stanza missing Architecture"
msgstr "Package 段落未標 Architecture"

#: src/zfr_lib/lint/debian.py:74
msgid "Architecture: all  (scripts) or any (compiled)."
msgstr "Architecture: all  （指令稿）或 any（編譯程式）。"

#: src/zfr_lib/lint/debian.py:82
#, python-format
msgid "bash packages should be Architecture: all (got %s)"
msgstr "bash 套件應為 Architecture: all（實際得到 %s）"

#: src/zfr_lib/lint/debian.py:84
msgid "Architecture: all"
msgstr "Architecture: all"

#: src/zfr_lib/lint/debian.py:92
#, python-format
msgid "%s packages are usually Architecture: any (got all)"
msgstr "%s 套件一般應為 Architecture: any（實際得到 all）"

#: src/zfr_lib/lint/debian.py:94
msgid "Architecture: any"
msgstr "Architecture: any"

#: src/zfr_lib/lint/debian.py:98
#, python-format
msgid "Architecture: %s"
msgstr "欄位 Architecture: %s"

#: src/zfr_lib/lint/debian.py:102
#, python-format
msgid "Homepage: %s"
msgstr "欄位 Homepage: %s"

#: src/zfr_lib/lint/debian.py:108
msgid "no Homepage"
msgstr "缺少 Homepage"

#: src/zfr_lib/lint/debian.py:110
msgid "Set Homepage: to the project URL."
msgstr "請將 Homepage: 設成專案網址。"

#: src/zfr_lib/lint/debian.py:116
msgid "dh meson debian/build"
msgstr "已採用 dh meson debian/build"

#: src/zfr_lib/lint/debian.py:122
msgid "debian/rules is not dh --buildsystem=meson --builddirectory=debian/build"
msgstr "debian/rules 並非 dh --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:125
#, no-python-format
msgid ""
"Use:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"請使用：\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:131
msgid "copyright mentions AGPL"
msgstr "版權聲明提及 AGPL"

#: src/zfr_lib/lint/debian.py:137
msgid "debian/copyright does not mention AGPL"
msgstr "debian/copyright 並未提及 AGPL"

#: src/zfr_lib/lint/debian.py:139
msgid "Use the template debian/copyright (License: AGPL-3+)."
msgstr "使用範本 debian/copyright（License: AGPL-3+）。"

#: src/zfr_lib/lint/debian.py:145
#, python-format
msgid "source format %s"
msgstr "原始碼格式 %s"

#: src/zfr_lib/lint/debian.py:154
#, python-format
msgid "VERSION=%(file)r != changelog %(changelog)r"
msgstr "VERSION=%(file)r != 變更紀錄 %(changelog)r"

#: src/zfr_lib/lint/debian.py:156
msgid "VERSION should match the latest debian/changelog entry (pre-commit hook updates it). Git describe may still differ."
msgstr "VERSION 應與 debian/changelog 的最新條目一致（pre-commit 掛鉤會更新它）。Git describe 仍可能不同。"

#: src/zfr_lib/lint/debian.py:162
#, python-format
msgid "VERSION matches changelog %s"
msgstr "VERSION 與變更紀錄 %s 一致"

#: src/zfr_lib/lint/debian.py:172
msgid "bash project Depends missing bash-shlib"
msgstr "bash 專案的 Depends 缺少 bash-shlib"

#: src/zfr_lib/lint/debian.py:174
msgid "Depends: bash, bash-shlib, ${misc:Depends}"
msgstr "Depends: bash, bash-shlib, ${misc:Depends}"

#: src/zfr_lib/lint/debian.py:178
msgid "Depends includes bash-shlib"
msgstr "Depends 含有 bash-shlib"

#: src/zfr_lib/lint/i18n_check.py:56
#, python-format
msgid "l10n level %s: no locale coverage required"
msgstr "l10n 級別 %s：不要求語系涵蓋"

#: src/zfr_lib/lint/i18n_check.py:65
#, python-format
msgid "l10n level %(level)s (%(count)d locales)"
msgstr "l10n 級別 %(level)s（%(count)d 個語系）"

#: src/zfr_lib/lint/i18n_check.py:78
msgid "no po/ directory (optional unless the project uses gettext)"
msgstr "沒有 po/ 目錄（除非專案使用 gettext，否則可選）"

#: src/zfr_lib/lint/i18n_check.py:79
#, python-format
msgid "If the app is translated, add po/ with LINGUAS + *.po and i18n.gettext() in meson.build. Required locales at %(level)s: %(locales)s (source language %(source)s)."
msgstr "若應用程式已翻譯，請新增含 LINGUAS + *.po 的 po/，並在 meson.build 中呼叫 i18n.gettext()。%(level)s 所需語系：%(locales)s（來源語言 %(source)s）。"

#: src/zfr_lib/lint/i18n_check.py:97
msgid "po/ exists but po/LINGUAS is missing or empty"
msgstr "已有 po/ 但 po/LINGUAS 缺失或為空"

#: src/zfr_lib/lint/i18n_check.py:99
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"建立 po/LINGUAS，至少列出：\n"
"%(locales)s\n"
"（英語/%(source)s 是 msgid 來源語言，不列入清單。）"

#: src/zfr_lib/lint/i18n_check.py:114
#, python-format
msgid "po/LINGUAS missing %(level)s locale(s): %(locales)s"
msgstr "po/LINGUAS 缺少 %(level)s 語系：%(locales)s"

#: src/zfr_lib/lint/i18n_check.py:117
#, python-format
msgid "Level %(level)s requires: %(locales)s (source %(source)s; zh-cn→zh_CN, zh-tw→zh_TW). Append the missing lines to LINGUAS and add matching po/<locale>.po."
