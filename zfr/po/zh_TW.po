msgstr "從父語言生成派生 locale 的 PO/man 文件（跳過 LINGUAS 中列出的語言環境）"

#: src/i18n/cmd.py:202
msgid "output directory for derived .po files (default: build/po or $MESON_BUILD_ROOT/po)"
msgstr "派生 .po 文件的輸出目錄（默認：build/po 或 $MESON_BUILD_ROOT/po）"

#: src/i18n/cmd.py:207
msgid "write a stamp file listing derived paths (for Meson custom_target)"
msgstr "寫入列出派生路徑的戳記文件（供 Meson custom_target 使用）"

