msgstr "spec 的 License 不是 AGPL-3.0-or-later"

#: src/zfr_lib/lint/rpm.py:91
#, python-format
msgid "License:        %s"
msgstr "License:        %s"

#: src/zfr_lib/lint/rpm.py:102
#, python-format
