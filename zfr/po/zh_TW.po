msgstr "錯誤"

#: src/zfr_lib/lint/report.py:117
msgid "warn"
msgstr "警告"

#: src/zfr_lib/lint/report.py:118
msgid "note"
msgstr "備註"

#: src/zfr_lib/lint/report.py:119
msgid "ok"
msgstr "正常"

#: src/zfr_lib/lint/report.py:132
msgid "fix:"
msgstr "修正:"

#: src/zfr_lib/lint/report.py:139
msgid "Next steps (zephyr style)"
msgstr "後續步驟（zephyr 風格）"

#: src/zfr_lib/lint/report.py:145
msgid "Hint: after edits, re-run `zfr lint` from the project (or a subdirectory). `zfr about -d -r` dumps packaging fields. Version for Meson/RPM is `zfr version`. `zfr ize` applies missing debian/rpm/meson/man/version-subst upgrades."
msgstr "提示：修改後請在專案（或其子目錄）中重新執行 `zfr lint`。`zfr about -d -r` 會傾印打包欄位。Meson/RPM 的版本用 `zfr version`。`zfr ize` 會套用缺少的 debian/rpm/meson/man/version-subst 升級。"

#: src/zfr_lib/lint/rpm.py:41
msgid "no rpm/*.spec (optional, but zephyr style includes RPM next to debian/)"
msgstr "沒有 rpm/*.spec（可選，但 zephyr 風格會在 debian/ 旁放 RPM）"

#: src/zfr_lib/lint/rpm.py:44
#, no-python-format
msgid "Copy rpm/ from a language template; name the spec after the package (rpm/<Source>.spec, not zephyr.spec) and keep a Makefile using `zfr version`. Align Name/Summary/Requires/URL with debian/control. Or run `zfr ize`."
msgstr "從語言範本複製 rpm/；依套件命名 spec（rpm/<Source>.spec，不是 zephyr.spec），並保留使用 `zfr version` 的 Makefile。將 Name/Summary/Requires/URL 與 debian/control 對齊。或執行 `zfr ize`。"

#: src/zfr_lib/lint/rpm.py:63
#, no-python-format, python-brace-format
msgid "spec Version is dynamic %{version}"
msgstr "spec 的 Version 是動態 %{version}"

#: src/zfr_lib/lint/rpm.py:72
msgid "spec Version is hardcoded; zephyr style injects `zfr version`"
msgstr "spec 的 Version 寫死了；zephyr 風格會注入 `zfr version`"

#: src/zfr_lib/lint/rpm.py:76
#, no-python-format
msgid "Use Version: %{version} with %{!?version:%global version 0.0.0} and freeze via rpm/Makefile (`zfr version` / `zfr version -r`)."
msgstr "使用 Version: %{version} 搭配 %{!?version:%global version 0.0.0}，並透過 rpm/Makefile 凍結（`zfr version` / `zfr version -r`）。"

