#: src/zfr:32
msgid ""
"Zephyr template helper (CLI name: zfr). Create projects and manage example "
"puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr ""
"Zephyr şablon yardımcısı (CLI adı: zfr). Proje oluşturun ve örnek puff'ları "
"yönetin. Örneklenen ağaçlar zfr'yi çağırmaya devam eder; zfr bir yeniden "
"adlandırma belirteci değildir."

#: src/zfr:46
msgid "show this help"
msgstr "bu yardımı göster"

#: src/zfr_lib/about.py:496
msgid "print current project information (walks parents from cwd)"
msgstr "geçerli proje bilgisini yazdır (cwd'den üstlere gider)"

#: src/zfr_lib/about.py:498
msgid ""
"Print information about the current zephyr project (walks from cwd toward "
"parent directories). CSR colors when stdout is a TTY. Common packaging "
"fields are parsed from debian or RPM."
msgstr ""
"Geçerli zephyr projesi hakkında bilgi yazdır (cwd'den üst dizinlere gider). "
"stdout bir TTY olduğunda CSR renkleri. Yaygın paketleme alanları debian veya "
"RPM'den ayrıştırılır."

#: src/zfr_lib/about.py:505
msgid "show parsed Debian packaging fields"
msgstr "ayrıştırılmış Debian paketleme alanlarını göster"

#: src/zfr_lib/about.py:506
msgid "show parsed RPM packaging fields"
msgstr "ayrıştırılmış RPM paketleme alanlarını göster"

#: src/zfr_lib/about.py:511
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (console SGR) vurgulama (varsayılan: auto = TTY ve NO_COLOR yok)"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "dil şablonundan puff örnekle"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Dili algıla ve pkgdatadir/<lang> konumundan puff ekle."

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "yeni puff ad(lar)ı (snake_case önerilir)"

#: src/zfr_lib/create.py:311
msgid "create a new project from a language template"
msgstr "dil şablonundan yeni proje oluştur"

#: src/zfr_lib/create.py:312
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "pkgdatadir/<lang> konumundan yeni proje dizini oluştur."

#: src/zfr_lib/create.py:319
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "şablon dili (varsayılan: python; şunlardan biri: %s)"

#: src/zfr_lib/create.py:323
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "debian changelog dağıtımı (varsayılan: %s)"

#: src/zfr_lib/create.py:327
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "başlangıç paket sürümü ve git etiketi (varsayılan: %s)"

#: src/zfr_lib/create.py:331
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "changelog/git yazar adı (varsayılan: %s)"

#: src/zfr_lib/create.py:335
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "changelog/git yazar e-postası (varsayılan: %s)"

#: src/zfr_lib/create.py:337
msgid "new project directory name"
msgstr "yeni proje dizini adı"

#: src/zfr_lib/create.py:340
msgid "optional puff names to add after creating the project"
msgstr "proje oluşturulduktan sonra eklenecek isteğe bağlı puff adları"

#: src/zfr_lib/detect.py:15
msgid "print detected language for the current directory"
msgstr "geçerli dizin için algılanan dili yazdır"

#: src/zfr_lib/detect.py:16
msgid ""
"Print the detected language of the current project and layout details on "
"stderr."
msgstr ""
"Geçerli projenin algılanan dili ve düzen ayrıntılarını stderr'e yazdır."

#: src/zfr_lib/dist.py:60
msgid ""
"write the archive into DIR (default: meson-dist, or rpmbuild/SOURCES with --"
"rpm)"
msgstr ""
"arşivi DIR'ye yaz (varsayılan: meson-dist veya --rpm ile rpmbuild/SOURCES)"

#: src/zfr_lib/dist.py:70
msgid ""
"Meson build directory (default: /build when it matches this source tree, "
"else <project>/build)"
msgstr ""
"Meson derleme dizini (varsayılan: bu kaynak ağacıyla eşleşirse /build, aksi "
"halde <project>/build)"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "arşiv biçimi (varsayılan: xz)"

#: src/zfr_lib/dist.py:86
msgid ""
"name the archive NAME-VERSION.tar.xz and write it to rpmbuild/SOURCES unless "
"-o is given"
msgstr ""
"arşive NAME-VERSION.tar.xz adını ver ve -o verilmediyse rpmbuild/SOURCES'a "
"yaz"

#: src/zfr_lib/dist.py:94
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "meson dist'e --allow-dirty geçir (varsayılan: allow)"

#: src/zfr_lib/dist.py:99
msgid "run tests during meson dist (default: --no-tests)"
msgstr "meson dist sırasında testleri çalıştır (varsayılan: --no-tests)"

#: src/zfr_lib/dist.py:343
msgid "build a source tarball (meson dist, or this project only)"
msgstr "kaynak tarball oluştur (meson dist veya yalnızca bu proje)"

#: src/zfr_lib/dist.py:345
msgid ""
"Build a source archive of the current zephyr project (walks from cwd toward "
"parent directories). Uses meson dist when this directory is the git project "
"root; otherwise packs this project only so nested language templates do not "
"ship the parent meta-repo. Prints the archive path on stdout."
msgstr ""
"Geçerli zephyr projesinin kaynak arşivini oluştur (cwd'den üst dizinlere "
"gider). Bu dizin git proje kökü olduğunda meson dist kullanır; aksi halde "
"yalnızca bu projeyi paketler, böylece iç içe dil şablonları üst meta-repo'yu "
"göndermez. Arşiv yolunu stdout'a yazar."

#: src/zfr_lib/ize/__init__.py:65
msgid "refactor this project to current zephyr style"
msgstr "bu projeyi güncel zephyr stiline refactor et"

#: src/zfr_lib/ize/__init__.py:66
msgid ""
"Refactor the current project to match current zephyr style: missing debian/"
"rpm files, meson targets, AsciiDoc man pages, and Meson version "
"substitutions. Walks from cwd toward parents."
msgstr ""
"Geçerli projeyi güncel zephyr stiline uyarla: eksik debian/rpm dosyaları, "
"meson hedefleri, AsciiDoc man sayfaları ve Meson sürüm değiştirmeleri. "
"cwd'den üstlere gider."

#: src/zfr_lib/ize/__init__.py:70
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "hizalanacak dil şablonu (varsayılan: detect; şunlardan biri: %s)"

#: src/zfr_lib/ize/__init__.py:71
msgid "print planned changes without writing files"
msgstr "dosya yazmadan planlanan değişiklikleri yazdır"

#: src/zfr_lib/ize/__init__.py:72
msgid "also print skipped files"
msgstr "atlanan dosyaları da yazdır"

#: src/zfr_lib/ize/__init__.py:78
msgid ""
"run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr ""
"run 2meson to convert Autotools/CMake to Meson when present (default: on)"

#: src/zfr_lib/ize/__init__.py:80
msgid "do not convert groff .1 man pages to docs/*.adoc"
msgstr "groff .1 man sayfalarını docs/*.adoc'a dönüştürme"

#: src/zfr_lib/ize/__init__.py:81
msgid "do not turn hardcoded versions into @VERSION@ / config.h"
msgstr "sabit kodlanmış sürümleri @VERSION@ / config.h'e dönüştürme"

#: src/zfr_lib/ize/__init__.py:82 src/zfr_lib/lint/__init__.py:115
msgid "CSR (console SGR) highlighting (default: auto)"
msgstr "CSR (console SGR) vurgulama (varsayılan: auto)"

#: src/zfr_lib/l10n.py:93
#, python-format
msgid "l10n level must be L0–L3 (or 0–3), not %r"
msgstr "l10n düzeyi L0–L3 (veya 0–3) olmalı, %r olamaz"

#: src/zfr_lib/lang/antlr.py:42 src/zfr_lib/lang/as.py:30
#: src/zfr_lib/lang/bison.py:38 src/zfr_lib/lang/clib.py:34
#: src/zfr_lib/lang/cobol.py:32 src/zfr_lib/lang/cpplib.py:34
#: src/zfr_lib/lang/cpp.py:21 src/zfr_lib/lang/c.py:21 src/zfr_lib/lang/d.py:32
#: src/zfr_lib/lang/fortran.py:32 src/zfr_lib/lang/gcc.py:48
#: src/zfr_lib/lang/kotlin.py:22 src/zfr_lib/lang/lua.py:22
#: src/zfr_lib/lang/nim.py:24 src/zfr_lib/lang/pascal.py:32
#: src/zfr_lib/lang/python.py:21
msgid "tests/ present"
msgstr "tests/ mevcut"

#: src/zfr_lib/lang/antlr.py:47 src/zfr_lib/lang/as.py:35
#: src/zfr_lib/lang/bison.py:43 src/zfr_lib/lang/clib.py:35
#: src/zfr_lib/lang/cpplib.py:35 src/zfr_lib/lang/cpp.py:22
#: src/zfr_lib/lang/c.py:22 src/zfr_lib/lang/gcc.py:53
msgid "no tests/ directory"
msgstr "tests/ dizini yok"

#: src/zfr_lib/lang/antlr.py:49
msgid "Add tests/TestCommons.java or fixture checks for parser output."
msgstr ""
"Ayrıştırıcı çıktısı için tests/TestCommons.java veya fixture denetimleri "
"ekleyin."

#: src/zfr_lib/lang/as.py:37
msgid "Add tests/smoke.sh and meson test() for stdin/stdout copy."
msgstr "stdin/stdout kopyası için tests/smoke.sh ve meson test() ekleyin."

#: src/zfr_lib/lang/bash.py:45
#, python-format
msgid "src scripts: %s"
msgstr "src betikleri: %s"

#: src/zfr_lib/lang/bash.py:46
msgid "no src/*.in scripts"
msgstr "src/*.in betikleri yok"

#: src/zfr_lib/lang/bash.py:47
msgid ""
"Keep configured scripts as src/<puff>.in with @PACKAGE@/@VERSION@ and meson "
"configure_file + install_mode rwxr-xr-x."
msgstr ""
"Yapılandırılan betikleri @PACKAGE@/@VERSION@ içeren src/<puff>.in olarak "
"tutun; meson configure_file + install_mode rwxr-xr-x kullanın."

#: src/zfr_lib/lang/bison.py:45
msgid "Add tests/ with fixture checks for parser dump/format output."
msgstr ""
"Ayrıştırıcının dump/format çıktısı için fixture denetimleri içeren tests/ "
"ekleyin."

#: src/zfr_lib/lang/clib.py:36 src/zfr_lib/lang/cpplib.py:36
#: src/zfr_lib/lang/cpp.py:23 src/zfr_lib/lang/c.py:23
#: src/zfr_lib/lang/gcc.py:55
msgid "Add tests/ and meson test() entries like the C family templates."
msgstr ""
"C ailesi şablonlarındaki gibi tests/ ve meson test() girdileri ekleyin."

#: src/zfr_lib/lang/cobol.py:37
msgid "no tests/ (cobol template uses cobc + meson test)"
msgstr "tests/ yok (cobol şablonu cobc + meson test kullanır)"

#: src/zfr_lib/lang/cobol.py:39
msgid "Add tests/test_commons.sh or similar smoke test for cobc."
msgstr "cobc için tests/test_commons.sh veya benzer bir duman testi ekleyin."

#: src/zfr_lib/lang/d.py:37
msgid "no tests/ (D template uses ldc/dmd + meson test)"
msgstr "tests/ yok (D şablonu ldc/dmd + meson test kullanır)"

#: src/zfr_lib/lang/d.py:39
msgid "Add tests/test_commons.d and meson test() executable."
msgstr "tests/test_commons.d ve meson test() çalıştırılabilirini ekleyin."

#: src/zfr_lib/lang/fortran.py:37
msgid "no tests/ (fortran template uses gfortran + meson test)"
msgstr "tests/ yok (fortran şablonu gfortran + meson test kullanır)"

#: src/zfr_lib/lang/fortran.py:39
msgid "Add tests/test_commons.f90 and meson test() executable."
msgstr "tests/test_commons.f90 ve meson test() çalıştırılabilirini ekleyin."

#: src/zfr_lib/lang/go.py:22
msgid "missing go.mod"
msgstr "go.mod eksik"

#: src/zfr_lib/lang/go.py:23
msgid ""
"Add go.mod; meson should `go build` with -X main.buildVersion from "
"meson.project_version()."
msgstr ""
"go.mod ekleyin; meson, meson.project_version() kaynağından -X "
"main.buildVersion ile `go build` çalıştırmalıdır."

#: src/zfr_lib/lang/kotlin.py:23
msgid "no tests/ (kotlin template uses kotlinc + meson test)"
msgstr "tests/ yok (kotlin şablonu kotlinc + meson test kullanır)"

#: src/zfr_lib/lang/kotlin.py:24
msgid "Add tests/Test*.kt and meson test() compiling with kotlinc."
msgstr "kotlinc ile derlenen tests/Test*.kt ve meson test() ekleyin."

#: src/zfr_lib/lang/lua.py:23
msgid "no tests/ (lua template uses lua tests + meson test)"
msgstr "tests/ yok (lua şablonu lua testleri + meson test kullanır)"

#: src/zfr_lib/lang/lua.py:24
msgid ""
"Add tests/test_*.lua and meson test() invoking lua with LUA_PATH=src/?.lua."
msgstr ""
"LUA_PATH=src/?.lua ile lua çalıştıran tests/test_*.lua ve meson test() "
"ekleyin."

#: src/zfr_lib/lang/nim.py:25
msgid "no tests/ (nim template uses unittest + meson test)"
msgstr "tests/ yok (nim şablonu unittest + meson test kullanır)"

#: src/zfr_lib/lang/nim.py:26
msgid "Add tests/test_*.nim and meson test() with nim r."
msgstr "nim r ile tests/test_*.nim ve meson test() ekleyin."

#: src/zfr_lib/lang/pascal.py:37
msgid "no tests/ (pascal template uses fpc + meson test)"
msgstr "tests/ yok (pascal şablonu fpc + meson test kullanır)"

#: src/zfr_lib/lang/pascal.py:39
msgid "Add tests/test_commons.pas and meson test() with fpc."
msgstr "fpc ile tests/test_commons.pas ve meson test() ekleyin."

#: src/zfr_lib/lang/python.py:22
msgid "no tests/ (python template uses unittest + meson test)"
msgstr "tests/ yok (python şablonu unittest + meson test kullanır)"

#: src/zfr_lib/lang/python.py:23
msgid "Add tests/test_*.py and meson test() with PYTHONPATH=src."
msgstr "PYTHONPATH=src ile tests/test_*.py ve meson test() ekleyin."

#: src/zfr_lib/lang/rust.py:22
msgid "missing Cargo.toml"
msgstr "Cargo.toml eksik"

#: src/zfr_lib/lang/rust.py:23
msgid ""
"Rust zephyr projects keep Cargo.toml plus meson custom_target for the binary."
msgstr ""
"Rust zephyr projeleri ikili için Cargo.toml ile birlikte meson custom_target "
"tutar."

#: src/zfr_lib/lang/zig.py:23
msgid "missing build.zig"
msgstr "build.zig eksik"

#: src/zfr_lib/lang/zig.py:24
msgid "Add build.zig; meson should invoke `zig build -Doptimize=ReleaseFast`."
msgstr ""
"build.zig ekleyin; meson `zig build -Doptimize=ReleaseFast` komutunu "
"çalıştırmalıdır."

#: src/zfr_lib/lint/debian.py:42
#, python-format
msgid "Build-Depends has %s"
msgstr "Build-Depends %s içeriyor"

#: src/zfr_lib/lint/debian.py:48
#, python-format
msgid "Build-Depends missing %s"
msgstr "Build-Depends içinde %s yok"

#: src/zfr_lib/lint/debian.py:50
#, python-format
msgid ""
"Add %s to Build-Depends (zephyr packages build with Meson + AsciiDoc man "
"pages)."
msgstr ""
"Build-Depends alanına %s ekleyin (zephyr paketleri Meson + AsciiDoc kılavuz "
"sayfalarıyla derlenir)."

#: src/zfr_lib/lint/debian.py:54
msgid "debhelper-compat present"
msgstr "debhelper-compat mevcut"

#: src/zfr_lib/lint/debian.py:60
msgid "Build-Depends missing debhelper-compat (= 13)"
msgstr "Build-Depends içinde debhelper-compat (= 13) yok"

#: src/zfr_lib/lint/debian.py:62
msgid "Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"
msgstr ""
"Build-Depends: debhelper-compat (= 13), meson, ninja-build, asciidoctor"

#: src/zfr_lib/lint/debian.py:72
msgid "Package stanza missing Architecture"
msgstr "Package kıtasında Architecture yok"

#: src/zfr_lib/lint/debian.py:74
msgid "Architecture: all  (scripts) or any (compiled)."
msgstr "Architecture: all  (betikler) veya any (derlenmiş)."

#: src/zfr_lib/lint/debian.py:82
#, python-format
msgid "bash packages should be Architecture: all (got %s)"
msgstr "bash paketleri Architecture: all olmalı (alınan %s)"

#: src/zfr_lib/lint/debian.py:84
msgid "Architecture: all"
msgstr "Architecture: all"

#: src/zfr_lib/lint/debian.py:92
#, python-format
msgid "%s packages are usually Architecture: any (got all)"
msgstr "%s paketleri genelde Architecture: any olur (alınan all)"

#: src/zfr_lib/lint/debian.py:94
msgid "Architecture: any"
msgstr "Architecture: any"

#: src/zfr_lib/lint/debian.py:98
#, python-format
msgid "Architecture: %s"
msgstr "Architecture alanı: %s"

#: src/zfr_lib/lint/debian.py:102
#, python-format
msgid "Homepage: %s"
msgstr "Homepage alanı: %s"

#: src/zfr_lib/lint/debian.py:108
msgid "no Homepage"
msgstr "Homepage yok"

#: src/zfr_lib/lint/debian.py:110
msgid "Set Homepage: to the project URL."
msgstr "Homepage: alanını proje URL’sine ayarlayın."

#: src/zfr_lib/lint/debian.py:116
msgid "dh meson debian/build"
msgstr "dh meson debian/build kullanıyor"

#: src/zfr_lib/lint/debian.py:122
msgid ""
"debian/rules is not dh --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"debian/rules, dh --buildsystem=meson --builddirectory=debian/build değil"

#: src/zfr_lib/lint/debian.py:125
#, no-python-format
msgid ""
"Use:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"
msgstr ""
"Kullanın:\n"
"#!/usr/bin/make -f\n"
"\n"
"%:\n"
"\tdh $@ --buildsystem=meson --builddirectory=debian/build"

#: src/zfr_lib/lint/debian.py:131
msgid "copyright mentions AGPL"
msgstr "copyright AGPL’den bahsediyor"

#: src/zfr_lib/lint/debian.py:137
msgid "debian/copyright does not mention AGPL"
msgstr "debian/copyright AGPL’den bahsetmiyor"

#: src/zfr_lib/lint/debian.py:139
msgid "Use the template debian/copyright (License: AGPL-3+)."
msgstr "debian/copyright şablonunu kullanın (License: AGPL-3+)."

#: src/zfr_lib/lint/debian.py:145
#, python-format
msgid "source format %s"
msgstr "kaynak biçimi %s"

#: src/zfr_lib/lint/debian.py:154
#, python-format
msgid "VERSION=%(file)r != changelog %(changelog)r"
msgstr "VERSION=%(file)r != değişiklik günlüğü %(changelog)r"

#: src/zfr_lib/lint/debian.py:156
msgid ""
"VERSION should match the latest debian/changelog entry (pre-commit hook "
"updates it). Git describe may still differ."
msgstr ""
"VERSION, debian/changelog içindeki en son girdiyle eşleşmelidir (pre-commit "
"kancası onu günceller). Git describe hâlâ farklı olabilir."

#: src/zfr_lib/lint/debian.py:162
#, python-format
msgid "VERSION matches changelog %s"
msgstr "VERSION değişiklik günlüğü %s ile eşleşiyor"

#: src/zfr_lib/lint/debian.py:172
msgid "bash project Depends missing bash-shlib"
msgstr "bash projesinin Depends alanında bash-shlib yok"

#: src/zfr_lib/lint/debian.py:174
msgid "Depends: bash, bash-shlib, ${misc:Depends}"
msgstr "Depends: bash, bash-shlib, ${misc:Depends}"

#: src/zfr_lib/lint/debian.py:178
msgid "Depends includes bash-shlib"
msgstr "Depends bash-shlib içeriyor"

#: src/zfr_lib/lint/i18n_check.py:56
#, python-format
msgid "l10n level %s: no locale coverage required"
msgstr "l10n düzeyi %s: yerel ayar kapsamı gerekmez"

#: src/zfr_lib/lint/i18n_check.py:65
#, python-format
msgid "l10n level %(level)s (%(count)d locales)"
msgstr "l10n düzeyi %(level)s (%(count)d yerel ayar)"

#: src/zfr_lib/lint/i18n_check.py:78
msgid "no po/ directory (optional unless the project uses gettext)"
msgstr "po/ dizini yok (proje gettext kullanmıyorsa isteğe bağlı)"

#: src/zfr_lib/lint/i18n_check.py:79
#, python-format
msgid ""
"If the app is translated, add po/ with LINGUAS + *.po and i18n.gettext() in "
"meson.build. Required locales at %(level)s: %(locales)s (source language "
"%(source)s)."
msgstr ""
"Uygulama çevrildiyse meson.build içinde i18n.gettext() ile po/ altına "
"LINGUAS + *.po ekleyin. %(level)s düzeyinde gereken yerel ayarlar: "
"%(locales)s (kaynak dil %(source)s)."

#: src/zfr_lib/lint/i18n_check.py:97
msgid "po/ exists but po/LINGUAS is missing or empty"
msgstr "po/ var ama po/LINGUAS eksik veya boş"

#: src/zfr_lib/lint/i18n_check.py:99
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"En az şunları listeleyen po/LINGUAS oluşturun:\n"
"%(locales)s\n"
"(İngilizce/%(source)s msgid kaynağıdır ve listelenmez.)"

#: src/zfr_lib/lint/i18n_check.py:114
#, python-format
msgid "po/LINGUAS missing %(level)s locale(s): %(locales)s"
msgstr "po/LINGUAS’ta eksik %(level)s yerel ayar(lar): %(locales)s"

#: src/zfr_lib/lint/i18n_check.py:117
#, python-format
msgid ""
"Level %(level)s requires: %(locales)s (source %(source)s; zh-cn→zh_CN, zh-"
"tw→zh_TW). Append the missing lines to LINGUAS and add matching po/"
"<locale>.po."
msgstr ""
