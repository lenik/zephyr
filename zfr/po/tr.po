msgstr "po/ dizini yok (proje gettext kullanmıyorsa isteğe bağlı)"

#: src/zfr_lib/lint/i18n_check.py:85
#, python-format
msgid "If the app is translated, add po/ with LINGUAS + *.po and i18n.gettext() in meson.build. Required locales at %(level)s: %(locales)s (source language %(source)s)."
msgstr "Uygulama çevrildiyse meson.build içinde i18n.gettext() ile po/ altına LINGUAS + *.po ekleyin. %(level)s düzeyinde gereken yerel ayarlar: %(locales)s (kaynak dil %(source)s)."

