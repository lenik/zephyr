msgstr "arşivi DIR'ye yaz (varsayılan: meson-dist veya --rpm ile %_topdir/SOURCES ($HOME/rpmbuild))"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "Meson derleme dizini (varsayılan: bu kaynak ağacıyla eşleşirse /build, aksi halde <project>/build)"

