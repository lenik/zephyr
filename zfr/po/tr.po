msgstr "po/<locale>.po’suz LINGUAS girdileri: %s"

#: src/zfr_lib/lint/i18n_check.py:161
msgid "For each locale: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-translator && msgmerge -U --no-wrap po/<locale>.po <domain>.pot"
msgstr "Her yerel ayar için: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-translator && msgmerge -U po/<locale>.po <domain>.pot"

#: src/zfr_lib/lint/i18n_check.py:177
