msgstr "po/ var ama po/LINGUAS eksik veya boş"

#: src/zfr_lib/lint/i18n_check.py:105
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"En az şunları listeleyen po/LINGUAS oluşturun:\n"
"%(locales)s\n"
"(İngilizce/%(source)s msgid kaynağıdır ve listelenmez.)"

#: src/zfr_lib/lint/i18n_check.py:124
#, python-format
msgid "po/LINGUAS missing %(level)s locale(s): %(locales)s"
msgstr "po/LINGUAS’ta eksik %(level)s yerel ayar(lar): %(locales)s"

