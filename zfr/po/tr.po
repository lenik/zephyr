msgstr "%(title)s. Her dil, ağacın paketlendirilebilir kalması için idiomatik işaretler tutar (tests/, Cargo.toml, bas i18n yardımcıları, bash *.in, …)."

#: src/zfr_lib/lint/docs.py:347
msgid "Details"
msgstr "Ayrıntılar"

#: src/zfr_lib/lint/docs.py:350
#, python-format
msgid "Implemented as `%s`; severity hint %s."
msgstr "`%s` olarak uygulanır; önem ipucu %s."

#: src/zfr_lib/lint/docs.py:358
msgid "One name across ecosystems"
msgstr "Ekosistemler boyunca tek ad"

#: src/zfr_lib/lint/docs.py:360
msgid "Directory name, meson project(), debian Source, and RPM Name must agree. Mismatches confuse rename, release, and repos."
msgstr "Dizin adı, meson project(), debian Source ve RPM Name uyuşmalıdır. Uyuşmazlıklar rename, release ve depoları karıştırır."

#: src/zfr_lib/lint/docs.py:365
#, python-format
msgid "Check: %s"
msgstr "Kontrol: %s"

#: src/zfr_lib/lint/docs.py:366
#, python-format
msgid "`%s` compares identity fields."
msgstr "`%s` kimlik alanlarını karşılaştırır."

