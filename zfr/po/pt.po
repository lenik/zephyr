#: src/zfr:51
msgid "Zephyr template helper (CLI name: zfr). Create projects and manage example puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr "Assistente de modelos Zephyr (nome CLI: zfr). Criar projetos e gerir puffs de exemplo. Árvores instanciadas continuam a chamar zfr; zfr não é um token de renomeação."

#: src/zfr:66
msgid "show this help"
msgstr "mostrar esta ajuda"

#: src/zfr_lib/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "imprimir informações do projeto atual (sobe pelos pais a partir de cwd)"

#: src/zfr_lib/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Imprimir informações sobre o projeto zephyr atual (sobe de cwd para diretórios pai). Cores CSR quando stdout é um TTY. Campos de empacotamento comuns são analisados a partir de debian ou RPM."

#: src/zfr_lib/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "mostrar campos de empacotamento Debian analisados"

#: src/zfr_lib/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "mostrar campos de empacotamento RPM analisados"

#: src/zfr_lib/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "realce CSR (console SGR) (predefinição: auto = TTY e sem NO_COLOR)"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "instanciar puff(s) a partir do modelo de idioma"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Detetar idioma e adicionar puff(s) a partir de pkgdatadir/<lang>."

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "nome(s) de puff novo(s) (snake_case recomendado)"

#: src/zfr_lib/create.py:311
msgid "create a new project from a language template"
msgstr "criar um projeto novo a partir de um modelo de idioma"

#: src/zfr_lib/create.py:312
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "Criar um diretório de projeto novo a partir de pkgdatadir/<lang>."

#: src/zfr_lib/create.py:319
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "idioma do modelo (predefinição: python; um de: %s)"

#: src/zfr_lib/create.py:323
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "distribuição debian changelog (predefinição: %s)"

#: src/zfr_lib/create.py:327
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "versão inicial do pacote e tag git (predefinição: %s)"

#: src/zfr_lib/create.py:331
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "nome do autor changelog/git (predefinição: %s)"

#: src/zfr_lib/create.py:335
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "email do autor changelog/git (predefinição: %s)"

#: src/zfr_lib/create.py:337
msgid "new project directory name"
msgstr "nome do diretório do projeto novo"

#: src/zfr_lib/create.py:340
msgid "optional puff names to add after creating the project"
msgstr "nomes de puff opcionais a adicionar após criar o projeto"

#: src/zfr_lib/detect.py:15
msgid "print detected language for the current directory"
msgstr "imprimir idioma detetado para o diretório atual"

#: src/zfr_lib/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "Imprimir o idioma detetado do projeto atual e detalhes de layout em stderr."

#: src/zfr_lib/dist.py:60
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "escrever o arquivo em DIR (predefinição: meson-dist, ou %_topdir/SOURCES ($HOME/rpmbuild) com --rpm)"

#: src/zfr_lib/dist.py:70
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "diretório de compilação Meson (predefinição: /build quando corresponde a esta árvore de fontes, senão <project>/build)"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "formato de arquivo (predefinição: xz)"

#: src/zfr_lib/dist.py:86
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "nomear o arquivo NAME-VERSION.tar.xz e escrevê-lo em %_topdir/SOURCES ($HOME/rpmbuild) salvo se -o for dado"

#: src/zfr_lib/dist.py:95
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "passar --allow-dirty a meson dist (predefinição: allow)"

#: src/zfr_lib/dist.py:100
msgid "run tests during meson dist (default: --no-tests)"
msgstr "executar testes durante meson dist (predefinição: --no-tests)"

#: src/zfr_lib/dist.py:376
msgid "build a source tarball (meson dist, or this project only)"
msgstr "construir tarball de fontes (meson dist, ou apenas este projeto)"

#: src/zfr_lib/dist.py:378
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. Prints the archive path on stdout."
msgstr "Construir um arquivo de fontes do projeto zephyr atual (sobe de cwd para diretórios pai). Usa meson dist quando este diretório é a raiz do projeto git; caso contrário empacota apenas este projeto para que modelos de idioma aninhados não incluam o meta-repo pai. Imprime o caminho do arquivo em stdout."

#: src/zfr_lib/i18n/cmd.py:42
msgid "no implemented locales (po/LINGUAS + po/*.po)"
msgstr "ningún idioma implementado (po/LINGUAS + po/*.po)"

#: src/zfr_lib/i18n/cmd.py:47
msgid "  [derived]"
msgstr "  [derivado]"

#: src/zfr_lib/i18n/cmd.py:57
#, python-format
msgid "tier %(tier)s"
msgstr "nivel %(tier)s"

#: src/zfr_lib/i18n/cmd.py:60
#, python-format
msgid "derived from: %(parent)s"
msgstr "derivado de: %(parent)s"

#: src/zfr_lib/i18n/cmd.py:63
#, python-format
msgid "fallback chain: %(chain)s"
msgstr "cadena de respaldo: %(chain)s"

#: src/zfr_lib/i18n/cmd.py:66
#, python-format
msgid "children (->): %(kids)s"
msgstr "hijos (->): %(kids)s"

#: src/zfr_lib/i18n/cmd.py:70
#, python-format
msgid "catalog: %(path)s"
msgstr "catálogo: %(path)s"

#: src/zfr_lib/i18n/cmd.py:72
#, python-format
msgid "po stats: %(translated)d/%(total)d translated, %(missing)d missing"
msgstr "estadísticas po: %(translated)d/%(total)d traducidos, %(missing)d faltantes"

#: src/zfr_lib/i18n/cmd.py:75
msgid "no .po catalog in this project"
msgstr "no hay catálogo .po en este proyecto"

#: src/zfr_lib/i18n/cmd.py:93
#, python-format
msgid "locale not found: %s"
msgstr "idioma no encontrado: %s"

#: src/zfr_lib/i18n/cmd.py:147
#, python-format
msgid "would build %d derived locale file(s)"
msgstr "generaría %d archivo(s) de locale derivado(s)"

#: src/zfr_lib/i18n/cmd.py:167
msgid "manage implemented gettext locales"
msgstr "gestionar configuraciones regionales gettext implementadas"

#: src/zfr_lib/i18n/cmd.py:169
msgid "List, add, delete, and build derived locales in the current project. Use zfr translate to query or update message strings."
msgstr "Listar, añadir, eliminar y generar locales derivados en el proyecto. Use zfr translate para consultar o actualizar cadenas."

#: src/zfr_lib/i18n/cmd.py:179
msgid "list all implemented locales in this project"
msgstr "listar todos los idiomas implementados en este proyecto"

#: src/zfr_lib/i18n/cmd.py:185
msgid "delete a locale (LINGUAS, .po, docs/)"
msgstr "eliminar un idioma (LINGUAS, .po, docs/)"

#: src/zfr_lib/i18n/cmd.py:191
msgid "add a new locale"
msgstr "añadir un idioma"

#: src/zfr_lib/i18n/cmd.py:197
msgid "build derived locale PO/man files from parents (skip locales in LINGUAS)"
msgstr "generar archivos PO/man derivados desde los padres (omitir locales listados en LINGUAS)"

#: src/zfr_lib/i18n/cmd.py:202
msgid "output directory for derived .po files (default: build/po or $MESON_BUILD_ROOT/po)"
msgstr "directorio de saída para arquivos .po derivados (predeterminado: build/po ou $MESON_BUILD_ROOT/po)"

#: src/zfr_lib/i18n/cmd.py:207
msgid "write a stamp file listing derived paths (for Meson custom_target)"
msgstr "Escribir um arquivo de sentagem de rotas derivadas (para Meson custom_target)"

#: src/zfr_lib/i18n/cmd.py:212
msgid "with --build, also msgfmt derived .po into LC_MESSAGES (for Meson)"
msgstr "com --build, também msgfmt derivado .po em LC_MESSAGES (para Meson)"

#: src/zfr_lib/i18n/cmd.py:217
msgid "gettext domain for --compile-mo / --install-derived"
msgstr "Domínio gettext para --compile-mo / --install-derived"

#: src/zfr_lib/i18n/cmd.py:223
msgid "install derived .mo from --po-dir into $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"
msgstr "instalar .mo de --po-dir para $MESON_INSTALL_DESTDIR_PREFIX (Meson Add_install_script)"

#: src/zfr_lib/i18n/cmd.py:231
msgid "with --install-derived, locale subdirectory under prefix (default: share/locale)"
msgstr "com --install-derived, subdiretório local sob prefix (predeterminado: share/locale)"

#: src/zfr_lib/i18n/cmd.py:233
msgid "with --build, print only"
msgstr "con --build, solo imprimir"

#: src/zfr_lib/i18n/cmd.py:234
msgid "with --build, overwrite existing"
msgstr "con --build, sobrescribir existente"

#: src/zfr_lib/i18n/cmd.py:235
msgid "locale to inspect"
msgstr "idioma a inspeccionar"

#: src/zfr_lib/i18n/cmd.py:241
msgid "--install-derived requires --po-dir and --domain"
msgstr "--install-derived requer --po-dir e --domain"

#: src/zfr_lib/ize/engine/__init__.py:85
msgid "suppressed via -u/--uncheck"
msgstr "suprimido via -u/--uncheck"

#: src/zfr_lib/ize/__init__.py:74
msgid "refactor this project to current zephyr style"
msgstr "refatorar este projeto para o estilo zephyr atual"

#: src/zfr_lib/ize/__init__.py:75
msgid "Refactor the current project to match current zephyr style: missing debian/rpm files, meson targets, AsciiDoc man pages, Meson version substitutions, and lint-level gettext/man locale coverage (LINGUAS, .po, docs/<locale>). Walks from cwd toward parents."
msgstr "Refatorar o projeto atual para corresponder ao estilo zephyr atual: ficheiros debian/rpm em falta, alvos meson, páginas man AsciiDoc e substituições de versão Meson. Sobe de cwd para pais."

#: src/zfr_lib/ize/__init__.py:79
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "modelo de idioma para alinhar (predefinição: detect; um de: %s)"

#: src/zfr_lib/ize/__init__.py:80
msgid "print planned changes without writing files"
msgstr "imprimir alterações planeadas sem escrever ficheiros"

#: src/zfr_lib/ize/__init__.py:85
msgid "list numbered ize standards (ZI*) as a table and exit"
msgstr "lista de normas numeradas de ize (ZI*) como mesa e saída"

#: src/zfr_lib/ize/__init__.py:91
msgid "show details for ize standard NUM (e.g. ZI015, 15) and exit"
msgstr "mostrar detalhes para ize padr NUM (por exemplo ZI015, 15) e sair"

#: src/zfr_lib/ize/__init__.py:98
msgid "bump patch version (debian/changelog + VERSION), git add -A, and commit ize changes with a verbose message"
msgstr "versão de bump plash (debian/changelog + VERSION), git adicionar -A, e committe alterações com uma mensagem verbose"

#: src/zfr_lib/ize/__init__.py:107
msgid "changelog author for --commit (Name or 'Name <email>'); default: reuse the previous debian/changelog trailer"
msgstr "Autor de cambio de --commit (Nome ou 'Nome <email>'); predeterminado: reutiliza o retiro anterior debian/changelog"

#: src/zfr_lib/ize/__init__.py:111
msgid "also print skipped files"
msgstr "também imprimir ficheiros ignorados"

#: src/zfr_lib/ize/__init__.py:117
msgid "run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr "executa 2meson para converter Autotools/CMake para Meson quando presente (predeterminado: on)"

#: src/zfr_lib/ize/__init__.py:119
msgid "do not convert groff .1 man pages to docs/*.adoc"
msgstr "não converter páginas man groff .1 para docs/*.adoc"

#: src/zfr_lib/ize/__init__.py:120
msgid "do not turn hardcoded versions into @VERSION@ / config.h"
msgstr "não converter versões hardcoded em @VERSION@ / config.h"

#: src/zfr_lib/ize/__init__.py:127
msgid "suppress ize rule ID(s) or code(s), comma-separated (repeatable)"
msgstr "suprimir ID(s) de regla o código(s), separados por comas (repetible)"

#: src/zfr_lib/ize/__init__.py:129 src/zfr_lib/lint/__init__.py:179
