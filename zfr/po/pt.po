msgstr "meson.build falta LOCALEDIR na configuração.h"

#: src/zfr_lib/lang/_c_bas.py:279
msgid "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Run `zfr ize`."
msgstr "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Executar `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:289
msgid "meson LOCALEDIR present"
msgstr "LOCALEDIR do meson presente"

#: src/zfr_lib/lang/_c_bas.py:306
#, python-format
