#: src/zfr:51
msgid "Zephyr template helper (CLI name: zfr). Create projects and manage example puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr "Trợ lý mẫu Zephyr (tên CLI: zfr). Tạo dự án và quản lý puff mẫu. Cây đã khởi tạo vẫn gọi zfr; zfr không phải token đổi tên."

#: src/zfr:66
msgid "show this help"
msgstr "hiển thị trợ giúp này"

#: src/zfr_lib/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "in thông tin dự án hiện tại (duyệt thư mục cha từ cwd)"

#: src/zfr_lib/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "In thông tin về dự án zephyr hiện tại (duyệt từ cwd lên thư mục cha). Màu CSR khi stdout là TTY. Các trường đóng gói phổ biến được phân tích từ debian hoặc RPM."

#: src/zfr_lib/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "hiển thị các trường đóng gói Debian đã phân tích"

#: src/zfr_lib/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "hiển thị các trường đóng gói RPM đã phân tích"

#: src/zfr_lib/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "tô sáng CSR (console SGR) (mặc định: auto = TTY và không NO_COLOR)"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "khởi tạo puff từ mẫu ngôn ngữ"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Phát hiện ngôn ngữ và thêm puff từ pkgdatadir/<lang>."

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "tên puff mới (khuyến nghị snake_case)"

#: src/zfr_lib/create.py:311
msgid "create a new project from a language template"
msgstr "tạo dự án mới từ mẫu ngôn ngữ"

#: src/zfr_lib/create.py:312
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "Tạo thư mục dự án mới từ pkgdatadir/<lang>."

#: src/zfr_lib/create.py:319
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "ngôn ngữ mẫu (mặc định: python; một trong: %s)"

#: src/zfr_lib/create.py:323
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "phân phối debian changelog (mặc định: %s)"

#: src/zfr_lib/create.py:327
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "phiên bản gói ban đầu và git tag (mặc định: %s)"

#: src/zfr_lib/create.py:331
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "tên tác giả changelog/git (mặc định: %s)"

#: src/zfr_lib/create.py:335
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "email tác giả changelog/git (mặc định: %s)"

#: src/zfr_lib/create.py:337
msgid "new project directory name"
msgstr "tên thư mục dự án mới"

#: src/zfr_lib/create.py:340
msgid "optional puff names to add after creating the project"
msgstr "tên puff tùy chọn để thêm sau khi tạo dự án"

#: src/zfr_lib/detect.py:15
msgid "print detected language for the current directory"
msgstr "in ngôn ngữ phát hiện cho thư mục hiện tại"

#: src/zfr_lib/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "In ngôn ngữ phát hiện của dự án hiện tại và chi tiết bố cục ra stderr."

#: src/zfr_lib/dist.py:60
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "ghi kho lưu trữ vào DIR (mặc định: meson-dist, hoặc %_topdir/SOURCES ($HOME/rpmbuild) với --rpm)"

#: src/zfr_lib/dist.py:70
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "thư mục build Meson (mặc định: /build khi khớp cây nguồn này, nếu không thì <project>/build)"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "định dạng kho lưu trữ (mặc định: xz)"

#: src/zfr_lib/dist.py:86
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "đặt tên kho lưu trữ NAME-VERSION.tar.xz và ghi vào %_topdir/SOURCES ($HOME/rpmbuild) trừ khi có -o"

#: src/zfr_lib/dist.py:95
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "truyền --allow-dirty cho meson dist (mặc định: allow)"

#: src/zfr_lib/dist.py:100
msgid "run tests during meson dist (default: --no-tests)"
msgstr "chạy kiểm thử trong meson dist (mặc định: --no-tests)"

#: src/zfr_lib/dist.py:376
msgid "build a source tarball (meson dist, or this project only)"
msgstr "tạo tarball nguồn (meson dist, hoặc chỉ dự án này)"

#: src/zfr_lib/dist.py:378
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. Prints the archive path on stdout."
msgstr "Tạo kho lưu trữ nguồn của dự án zephyr hiện tại (duyệt từ cwd lên thư mục cha). Dùng meson dist khi thư mục này là gốc dự án git; nếu không chỉ đóng gói dự án này để mẫu ngôn ngữ lồng nhau không gửi meta-repo cha. In đường dẫn kho lưu trữ ra stdout."

#: src/zfr_lib/i18n/cmd.py:42
msgid "no implemented locales (po/LINGUAS + po/*.po)"
msgstr "không có locale đã triển khai (po/LINGUAS + po/*.po)"

#: src/zfr_lib/i18n/cmd.py:47
msgid "  [derived]"
msgstr "  [dẫn xuất]"

#: src/zfr_lib/i18n/cmd.py:57
#, python-format
msgid "tier %(tier)s"
msgstr "bậc %(tier)s"

#: src/zfr_lib/i18n/cmd.py:60
#, python-format
msgid "derived from: %(parent)s"
msgstr "phái sinh từ: %(parent)s"

#: src/zfr_lib/i18n/cmd.py:63
#, python-format
msgid "fallback chain: %(chain)s"
msgstr "chuỗi dự phòng: %(chain)s"

#: src/zfr_lib/i18n/cmd.py:66
#, python-format
msgid "children (->): %(kids)s"
msgstr "con (->): %(kids)s"

#: src/zfr_lib/i18n/cmd.py:70
#, python-format
msgid "catalog: %(path)s"
msgstr "danh mục: %(path)s"

#: src/zfr_lib/i18n/cmd.py:72
#, python-format
msgid "po stats: %(translated)d/%(total)d translated, %(missing)d missing"
msgstr "thống kê po: %(translated)d/%(total)d đã dịch, %(missing)d thiếu"

#: src/zfr_lib/i18n/cmd.py:75
msgid "no .po catalog in this project"
msgstr "không có danh mục .po trong dự án"

#: src/zfr_lib/i18n/cmd.py:93
#, python-format
msgid "locale not found: %s"
msgstr "không tìm thấy locale: %s"

#: src/zfr_lib/i18n/cmd.py:147
#, python-format
msgid "would build %d derived locale file(s)"
msgstr "sẽ tạo %d tệp locale phái sinh"

#: src/zfr_lib/i18n/cmd.py:167
msgid "manage implemented gettext locales"
msgstr "quản lý locale gettext đã triển khai"

#: src/zfr_lib/i18n/cmd.py:169
msgid "List, add, delete, and build derived locales in the current project. Use zfr translate to query or update message strings."
msgstr "Liệt kê, thêm, xóa và tạo locale phái sinh trong dự án. Dùng zfr translate để truy vấn hoặc cập nhật chuỗi."

#: src/zfr_lib/i18n/cmd.py:179
msgid "list all implemented locales in this project"
msgstr "liệt kê mọi locale đã triển khai trong dự án"

#: src/zfr_lib/i18n/cmd.py:185
msgid "delete a locale (LINGUAS, .po, docs/)"
msgstr "xóa locale (LINGUAS, .po, docs/)"

#: src/zfr_lib/i18n/cmd.py:191
msgid "add a new locale"
msgstr "thêm locale mới"

#: src/zfr_lib/i18n/cmd.py:197
msgid "build derived locale PO/man files from parents (skip locales in LINGUAS)"
msgstr "tạo PO/man phái sinh từ locale cha (bỏ qua locale có trong LINGUAS)"

#: src/zfr_lib/i18n/cmd.py:202
msgid "output directory for derived .po files (default: build/po or $MESON_BUILD_ROOT/po)"
msgstr "Tập tin xuất hiện cho tập tin .po (mặc định: build/po or $MESON_BUILD_ROOT/po)"

#: src/zfr_lib/i18n/cmd.py:207
msgid "write a stamp file listing derived paths (for Meson custom_target)"
msgstr "viết một danh sách tập tin đường được ghi (nơi Meson custom_target)"

#: src/zfr_lib/i18n/cmd.py:212
msgid "with --build, also msgfmt derived .po into LC_MESSAGES (for Meson)"
msgstr "với --build, cũng msgfmt được ghi vào LC_MESSAGES (cởi Meson)"

#: src/zfr_lib/i18n/cmd.py:217
msgid "gettext domain for --compile-mo / --install-derived"
msgstr "gettext địa chỉ cho --compile-mo / --install-derived"

#: src/zfr_lib/i18n/cmd.py:223
msgid "install derived .mo from --po-dir into $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"
msgstr "dựa lý .mo từ --po-dir vào $MESON_INSTALL_DESTDIR_PREFIX (Meson Add_install_script)"

#: src/zfr_lib/i18n/cmd.py:231
msgid "with --install-derived, locale subdirectory under prefix (default: share/locale)"
msgstr "với --install-derived, dưới tập tin dưới prefix (mặc định: share/locale)"

#: src/zfr_lib/i18n/cmd.py:233
msgid "with --build, print only"
msgstr "với --build, chỉ in"

#: src/zfr_lib/i18n/cmd.py:234
msgid "with --build, overwrite existing"
msgstr "với --build, ghi đè hiện có"

#: src/zfr_lib/i18n/cmd.py:235
msgid "locale to inspect"
msgstr "locale cần xem"

#: src/zfr_lib/i18n/cmd.py:241
msgid "--install-derived requires --po-dir and --domain"
msgstr "--install-derived cần --po-dir và --domain"

#: src/zfr_lib/ize/engine/__init__.py:85
msgid "suppressed via -u/--uncheck"
msgstr "đã tắt qua -u/--uncheck"

#: src/zfr_lib/ize/__init__.py:74
msgid "refactor this project to current zephyr style"
msgstr "refactor dự án này theo phong cách zephyr hiện tại"

#: src/zfr_lib/ize/__init__.py:75
msgid "Refactor the current project to match current zephyr style: missing debian/rpm files, meson targets, AsciiDoc man pages, Meson version substitutions, and lint-level gettext/man locale coverage (LINGUAS, .po, docs/<locale>). Walks from cwd toward parents."
msgstr "Refactor dự án hiện tại theo phong cách zephyr hiện tại: thiếu tệp debian/rpm, target meson, trang man AsciiDoc và thay thế phiên bản Meson. Duyệt từ cwd lên cha."

#: src/zfr_lib/ize/__init__.py:79
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "mẫu ngôn ngữ để căn chỉnh (mặc định: detect; một trong: %s)"

#: src/zfr_lib/ize/__init__.py:80
msgid "print planned changes without writing files"
msgstr "in các thay đổi đã lên kế hoạch mà không ghi tệp"

#: src/zfr_lib/ize/__init__.py:85
msgid "list numbered ize standards (ZI*) as a table and exit"
msgstr "danh sách các tiêu chuẩn thize (ZI*) như bàn và ra ngoài"

#: src/zfr_lib/ize/__init__.py:91
msgid "show details for ize standard NUM (e.g. ZI015, 15) and exit"
msgstr "cho các chi tiết cho ize mặt đường NUM (t.ex. ZI015, 15) và ra ngoài"

#: src/zfr_lib/ize/__init__.py:98
msgid "bump patch version (debian/changelog + VERSION), git add -A, and commit ize changes with a verbose message"
msgstr "bản bản phátch (debian/changelog + VERSION), git thêm -A, và thiết lập thay đổi với một thông điệp thiết"

#: src/zfr_lib/ize/__init__.py:107
msgid "changelog author for --commit (Name or 'Name <email>'); default: reuse the previous debian/changelog trailer"
msgstr "Chữ ghi điện thoại cho --commit (Tên hoặc 'Tên <email>'); mặc định: cửa thêm phục debian/changelog trước"

#: src/zfr_lib/ize/__init__.py:111
msgid "also print skipped files"
msgstr "cũng in các tệp đã bỏ qua"

#: src/zfr_lib/ize/__init__.py:117
msgid "run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr "chạy 2meson để chuyển Autotools/CMake sang Meson khi có (mặc định: bật)"

#: src/zfr_lib/ize/__init__.py:119
msgid "do not convert groff .1 man pages to docs/*.adoc"
msgstr "không chuyển trang man groff .1 sang docs/*.adoc"

#: src/zfr_lib/ize/__init__.py:120
msgid "do not turn hardcoded versions into @VERSION@ / config.h"
msgstr "không chuyển phiên bản hardcode thành @VERSION@ / config.h"

#: src/zfr_lib/ize/__init__.py:127
msgid "suppress ize rule ID(s) or code(s), comma-separated (repeatable)"
msgstr "ẩn ID quy tắc hoặc mã, phân tách bằng dấu phẩy (lặp lại được)"

#: src/zfr_lib/ize/__init__.py:129 src/zfr_lib/lint/__init__.py:179
#: src/zfr_lib/translate/__init__.py:211
msgid "CSR (console SGR) highlighting (default: auto)"
msgstr "tô sáng CSR (console SGR) (mặc định: auto)"

#: src/zfr_lib/ize/__init__.py:141
#, python-format
msgid "unknown ize standard: %s"
msgstr "tiêu chuẩn ize không rõ: %s"

#: src/zfr_lib/lang/antlr.py:42 src/zfr_lib/lang/as.py:30
#: src/zfr_lib/lang/bison.py:38 src/zfr_lib/lang/clib.py:37
#: src/zfr_lib/lang/cobol.py:32 src/zfr_lib/lang/cpplib.py:37
#: src/zfr_lib/lang/cpp.py:24 src/zfr_lib/lang/c.py:24 src/zfr_lib/lang/d.py:32
#: src/zfr_lib/lang/fortran.py:32 src/zfr_lib/lang/gcc.py:48
#: src/zfr_lib/lang/kotlin.py:22 src/zfr_lib/lang/lua.py:22
#: src/zfr_lib/lang/nim.py:24 src/zfr_lib/lang/pascal.py:32
#: src/zfr_lib/lang/python.py:21
msgid "tests/ present"
msgstr "có tests/"

#: src/zfr_lib/lang/antlr.py:47 src/zfr_lib/lang/as.py:35
#: src/zfr_lib/lang/bison.py:43 src/zfr_lib/lang/clib.py:43
#: src/zfr_lib/lang/cpplib.py:43 src/zfr_lib/lang/cpp.py:30
#: src/zfr_lib/lang/c.py:30 src/zfr_lib/lang/gcc.py:53
msgid "no tests/ directory"
msgstr "không có thư mục tests/"

#: src/zfr_lib/lang/antlr.py:49
msgid "Add tests/TestCommons.java or fixture checks for parser output."
msgstr "Thêm tests/TestCommons.java hoặc kiểm tra fixture cho đầu ra của trình phân tích."

#: src/zfr_lib/lang/as.py:37
msgid "Add tests/smoke.sh and meson test() for stdin/stdout copy."
msgstr "Thêm tests/smoke.sh và meson test() cho việc sao chép stdin/stdout."

#: src/zfr_lib/lang/bash.py:65
#, python-format
msgid "src scripts: %s"
msgstr "tập lệnh src: %s"

#: src/zfr_lib/lang/bash.py:78
msgid "root scripts: %s"
msgstr "tập lệnh src: %s"

#: src/zfr_lib/lang/bash.py:89
#, python-format
msgid "setup-only package (%s); no bindir script puffs"
msgstr "tạo gói -only (%s); không có phát sổ bindir"

#: src/zfr_lib/lang/bash.py:105
msgid "Meson executable + .c present; script .in not required"
msgstr "Meson phát triển + .c; sổ .in không cần thiết"

#: src/zfr_lib/lang/bash.py:114
msgid "no configure_file/executable; script .in not required"
msgstr "không phải configure_file/executable; sổ .in không cần thiết"

#: src/zfr_lib/lang/bash.py:121
msgid "no src/*.in or root *.in scripts"
msgstr "không có tập lệnh src/*.in"

#: src/zfr_lib/lang/bash.py:124
msgid "Keep configured scripts as src/<puff>.in (preferred) or <puff>.in with @PACKAGE@/@VERSION@ and meson configure_file + install_mode rwxr-xr-x."
msgstr "Giữ các tập lệnh cấu hình dạng src/<puff>.in với @PACKAGE@/@VERSION@ và meson configure_file + install_mode rwxr-xr-x."

#: src/zfr_lib/lang/bison.py:45
msgid "Add tests/ with fixture checks for parser dump/format output."
msgstr "Thêm tests/ với kiểm tra fixture cho đầu ra dump/format của trình phân tích."

#: src/zfr_lib/lang/_c_bas.py:187
msgid "no int main() in src/; skip bas i18n main checks"
msgstr "không có int main() trong src/; chạy chế chính bas i18n"

#: src/zfr_lib/lang/_c_bas.py:208
#, python-format
msgid "main missing bas i18n setup: %s"
msgstr "cơ hội bas i18n thất bại chính: %s"

#: src/zfr_lib/lang/_c_bas.py:211
msgid "In main: #include <bas/locale/i18n.h> and <bas/proc/env.h>; const char *exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR from meson config.h). Run `zfr ize`."
msgstr "Trên chính: #include <bas/locale/i18n.h> và <bas/proc/env.h>; const bản * exe = self_exe(); init_i18n(LOCALEDIR); (LOCALEDIR từ meson cấp.h). Chạy `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:222
msgid "bas i18n main setup (self_exe + init_i18n)"
msgstr "cấu hình chính (self_exe + init_i18n)"

#: src/zfr_lib/lang/_c_bas.py:233
msgid "no define_logger() in src/"
msgstr "không có define_logger() trong src/"

#: src/zfr_lib/lang/_c_bas.py:236
msgid "In one .c/.cpp: #include <bas/log/deflog.h> then define_logger(); libraries may use __attribute__((weak)) define_logger(); Run `zfr ize`."
msgstr "Trong một .c/.cpp: #include <bas/log/deflog.h> sau đó define_logger(); các viết sách có thể dùng _attribute_(feak) define_logger(); Chạy `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:250
msgid "define_logger() present"
msgstr "có project()"

#: src/zfr_lib/lang/_c_bas.py:252
msgid "weak define_logger() present (library)"
msgstr "có define_logger() weak (thư viện)"

#: src/zfr_lib/lang/_c_bas.py:258
msgid "define_logger() without #include <bas/log/deflog.h>"
msgstr "define_logger() không có #include <bas/log/deflog.h>"

#: src/zfr_lib/lang/_c_bas.py:260
msgid "Add #include <bas/log/deflog.h> before define_logger();"
msgstr "Thêm #include <bas/log/deflog.h> trước define_logger();"

#: src/zfr_lib/lang/_c_bas.py:276
msgid "meson.build missing LOCALEDIR in config.h"
msgstr "meson.build mất LOCALEDIR trong cấp.h"

#: src/zfr_lib/lang/_c_bas.py:279
msgid "localedir = prefix / get_option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Run `zfr ize`."
msgstr "localedir = prefix / get_ option('localedir'); config_h.set_quoted('LOCALEDIR', localedir); Chạy `zfr ize`."

#: src/zfr_lib/lang/_c_bas.py:289
msgid "meson LOCALEDIR present"
msgstr "meson đã có LOCALEDIR"

#: src/zfr_lib/lang/_c_bas.py:306
#, python-format
msgid "gettext string has leading/trailing spaces: %r"
msgstr "gettext giữ leading/trailing vòng: %r"

#: src/zfr_lib/lang/_c_bas.py:310
msgid "Keep padding outside _(): e.g. fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\n\"), out);"
msgstr ""
"Tiếp tục tục phân phá_n: t.ex. fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\\n"
"\"), out);"

#: src/zfr_lib/lang/_c_bas.py:320
msgid "gettext _() strings have no leading/trailing spaces"
msgstr "gettext _() không có leading/trailing vòng"

#: src/zfr_lib/lang/clib.py:45 src/zfr_lib/lang/cpplib.py:45
#: src/zfr_lib/lang/cpp.py:32 src/zfr_lib/lang/c.py:32
#: src/zfr_lib/lang/gcc.py:55
msgid "Add tests/ and meson test() entries like the C family templates."
msgstr "Thêm tests/ và các mục meson test() giống các mẫu họ C."

