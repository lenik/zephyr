msgstr ""
"Hou opplaat buiten _(): bijvoorbeeld fputs(\"  -v, --verbose      \", out); fputs(_(\"repeat for more verbose loggings\\\n"
"\"), out);"

#: src/zfr_lib/lang/_c_bas.py:320
msgid "gettext _() strings have no leading/trailing spaces"
msgstr "gettext _()-strengen hebben geen leading/trailing-ruimten"

