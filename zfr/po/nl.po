#: src/zfr:32
msgid "Zephyr template helper (CLI name: zfr). Create projects and manage example puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr "Zephyr-sjabloonhelper (CLI-naam: zfr). Maakt projecten aan en beheert voorbeeld-puffs. Geïnstantieerde bomen blijven zfr aanroepen; zfr is geen hernoem-token."

#: src/zfr:46
msgid "show this help"
msgstr "deze hulp tonen"

#: src/zfr_lib/about.py:496
msgid "print current project information (walks parents from cwd)"
msgstr "huidige projectinformatie afdrukken (zoekt omhoog vanaf cwd)"

#: src/zfr_lib/about.py:498
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Drukt informatie over het huidige zephyr-project af (zoekt omhoog vanaf cwd). CSR-kleuren wanneer stdout een TTY is. Gangbare verpakkingsvelden worden gelezen uit debian of RPM."

#: src/zfr_lib/about.py:505
msgid "show parsed Debian packaging fields"
msgstr "geparseerde Debian-verpakkingsvelden tonen"

#: src/zfr_lib/about.py:506
msgid "show parsed RPM packaging fields"
msgstr "geparseerde RPM-verpakkingsvelden tonen"

#: src/zfr_lib/about.py:511
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (console SGR)-markering (standaard: auto = TTY en geen NO_COLOR)"

#: src/zfr_lib/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "puff(s) aanmaken vanuit de taalsjabloon"

#: src/zfr_lib/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "Detecteert taal en voegt puff(s) toe vanuit pkgdatadir/<lang>."

#: src/zfr_lib/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "nieuwe puff-namen (snake_case aanbevolen)"

#: src/zfr_lib/create.py:311
msgid "create a new project from a language template"
msgstr "nieuw project aanmaken vanuit een taalsjabloon"

#: src/zfr_lib/create.py:312
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "Maakt een nieuwe projectmap aan vanuit pkgdatadir/<lang>."

#: src/zfr_lib/create.py:319
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "sjabloontaal (standaard: python; een van: %s)"

#: src/zfr_lib/create.py:323
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "debian changelog-distributie (standaard: %s)"

#: src/zfr_lib/create.py:327
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "initiële pakketversie en git-tag (standaard: %s)"

#: src/zfr_lib/create.py:331
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "changelog/git-auteursnaam (standaard: %s)"

#: src/zfr_lib/create.py:335
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "changelog/git-auteure-mail (standaard: %s)"

#: src/zfr_lib/create.py:337
msgid "new project directory name"
msgstr "naam van nieuwe projectmap"

#: src/zfr_lib/create.py:340
msgid "optional puff names to add after creating the project"
msgstr "optionele puff-namen om toe te voegen na het aanmaken van het project"

#: src/zfr_lib/detect.py:15
msgid "print detected language for the current directory"
msgstr "gedetecteerde taal voor huidige map afdrukken"

#: src/zfr_lib/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "Drukt de gedetecteerde taal van het huidige project en layoutdetails af op stderr."

#: src/zfr_lib/dist.py:60
msgid "write the archive into DIR (default: meson-dist, or %_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "schrijf het archief naar DIR (standaard: meson-dist of %_topdir/SOURCES ($HOME/rpmbuild) met --rpm)"

#: src/zfr_lib/dist.py:70
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "Meson-buildmap (standaard: /build als die bij deze bronboom hoort, anders <project>/build)"

#: src/zfr_lib/dist.py:80
msgid "archive format (default: xz)"
msgstr "archiefformat (standaard: xz)"

#: src/zfr_lib/dist.py:86
msgid "name the archive NAME-VERSION.tar.xz and write it to %_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "noem het archief NAME-VERSION.tar.xz en schrijf het naar %_topdir/SOURCES ($HOME/rpmbuild) tenzij -o is opgegeven"

#: src/zfr_lib/dist.py:94
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "geef --allow-dirty door aan meson dist (standaard: toestaan)"

#: src/zfr_lib/dist.py:99
msgid "run tests during meson dist (default: --no-tests)"
msgstr "voer tests uit tijdens meson dist (standaard: --no-tests)"

#: src/zfr_lib/dist.py:343
msgid "build a source tarball (meson dist, or this project only)"
msgstr "bouwt een bron-tarball (meson dist, of alleen dit project)"

#: src/zfr_lib/dist.py:345
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. Prints the archive path on stdout."
msgstr "Bouwt een bronarchief van het huidige zephyr-project (zoekt omhoog vanaf cwd). Gebruikt meson dist wanneer deze map de git-projectroot is; anders pakt alleen dit project in zodat geneste taalsjablonen niet het bovenliggende meta-repo meeleveren. Drukt het archiefpad af op stdout."

#: src/zfr_lib/ize/__init__.py:65
msgid "refactor this project to current zephyr style"
msgstr "refactor dit project naar de huidige zephyr-stijl"

#: src/zfr_lib/ize/__init__.py:66
msgid "Refactor the current project to match current zephyr style: missing debian/rpm files, meson targets, AsciiDoc man pages, and Meson version substitutions. Walks from cwd toward parents."
msgstr "Refactort het huidige project naar de huidige zephyr-stijl: ontbrekende debian/rpm-bestanden, meson-targets, AsciiDoc-manpagina's en Meson-versiesubstituties. Zoekt omhoog vanaf cwd."

#: src/zfr_lib/ize/__init__.py:70
#, python-format
msgid "language template to align with (default: detect; one of: %s)"
msgstr "taalsjabloon om op af te stemmen (standaard: detect; een van: %s)"

#: src/zfr_lib/ize/__init__.py:71
msgid "print planned changes without writing files"
msgstr "geplande wijzigingen afdrukken zonder bestanden te schrijven"

#: src/zfr_lib/ize/__init__.py:72
msgid "also print skipped files"
msgstr "sla overgeslagen bestanden ook afdrukken"

#: src/zfr_lib/ize/__init__.py:78
msgid "run 2meson to convert Autotools/CMake to Meson when present (default: on)"
msgstr "run 2meson to convert Autotools/CMake to Meson when present (default: on)"

#: src/zfr_lib/ize/__init__.py:80
msgid "do not convert groff .1 man pages to docs/*.adoc"
msgstr "converteer groff .1-manpagina's niet naar docs/*.adoc"

#: src/zfr_lib/ize/__init__.py:81
msgid "do not turn hardcoded versions into @VERSION@ / config.h"
msgstr "zet hardcoded versies niet om naar @VERSION@ / config.h"

#: src/zfr_lib/ize/__init__.py:82 src/zfr_lib/lint/__init__.py:115
msgid "CSR (console SGR) highlighting (default: auto)"
msgstr "CSR (console SGR)-markering (standaard: auto)"

#: src/zfr_lib/l10n.py:93
#, python-format
msgid "l10n level must be L0–L3 (or 0–3), not %r"
msgstr "l10n-niveau moet L0–L3 (of 0–3) zijn, niet %r"

#: src/zfr_lib/lang/antlr.py:42 src/zfr_lib/lang/as.py:30
#: src/zfr_lib/lang/bison.py:38 src/zfr_lib/lang/clib.py:34
#: src/zfr_lib/lang/cobol.py:32 src/zfr_lib/lang/cpplib.py:34
