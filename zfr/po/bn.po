#: src/zfr_lib/translate/__init__.py:198
msgid "list msgids/translations matching REGEX, case-sensitive (keys only with -k)"
msgstr "msgids/translations মিল খুলুন REGEX, হরফ -sensitive (শুধুমাত্র -k সাহায্যে কি)"

