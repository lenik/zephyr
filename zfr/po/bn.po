msgstr "Depends: bash, bash-shlib, ${misc:Depends}"

#: src/zfr_lib/lint/debian.py:178
msgid "Depends includes bash-shlib"
msgstr "Depends-এ bash-shlib আছে"

#: src/zfr_lib/lint/i18n_check.py:56
#, python-format
msgid "l10n level %s: no locale coverage required"
msgstr "l10n স্তর %s: কোনো লোকেল কভারেজ প্রয়োজন নেই"

#: src/zfr_lib/lint/i18n_check.py:65
#, python-format
msgid "l10n level %(level)s (%(count)d locales)"
msgstr "l10n স্তর %(level)s (%(count)d লোকেল)"

#: src/zfr_lib/lint/i18n_check.py:78
msgid "no po/ directory (optional unless the project uses gettext)"
msgstr "po/ ডিরেক্টরি নেই (ঐচ্ছিক, প্রকল্প gettext ব্যবহার না করলে)"

#: src/zfr_lib/lint/i18n_check.py:79
#, python-format
msgid "If the app is translated, add po/ with LINGUAS + *.po and i18n.gettext() in meson.build. Required locales at %(level)s: %(locales)s (source language %(source)s)."
msgstr "অ্যাপ অনুবাদিত হলে meson.build-এ i18n.gettext() সহ po/-তে LINGUAS + *.po যোগ করুন। %(level)s-এ প্রয়োজনীয় লোকেল: %(locales)s (উৎস ভাষা %(source)s)।"

#: src/zfr_lib/lint/i18n_check.py:97
msgid "po/ exists but po/LINGUAS is missing or empty"
msgstr "po/ আছে কিন্তু po/LINGUAS নেই বা খালি"

#: src/zfr_lib/lint/i18n_check.py:99
#, python-format
msgid ""
"Create po/LINGUAS listing at least:\n"
"%(locales)s\n"
"(English/%(source)s is the msgid source and is not listed.)"
msgstr ""
"অন্তত এগুলো তালিকাভুক্ত করে po/LINGUAS তৈরি করুন:\n"
"%(locales)s\n"
"(ইংরেজি/%(source)s msgid-এর উৎস, তালিকায় থাকে না।)"

#: src/zfr_lib/lint/i18n_check.py:114
#, python-format
msgid "po/LINGUAS missing %(level)s locale(s): %(locales)s"
msgstr "po/LINGUAS-এ %(level)s লোকেল নেই: %(locales)s"

#: src/zfr_lib/lint/i18n_check.py:117
#, python-format
msgid "Level %(level)s requires: %(locales)s (source %(source)s; zh-cn→zh_CN, zh-tw→zh_TW). Append the missing lines to LINGUAS and add matching po/<locale>.po."
msgstr "স্তর %(level)s প্রয়োজন: %(locales)s (উৎস %(source)s; zh-cn→zh_CN, zh-tw→zh_TW)। অনুপস্থিত লাইন LINGUAS-এ যোগ করুন এবং মিলিয়ে po/<locale>.po রাখুন।"

#: src/zfr_lib/lint/i18n_check.py:132
#, python-format
msgid "po/LINGUAS covers %s locale set"
msgstr "po/LINGUAS %s লোকেল সেট কভার করে"

#: src/zfr_lib/lint/i18n_check.py:147
#, python-format
msgid "LINGUAS entries without po/<locale>.po: %s"
msgstr "po/<locale>.po ছাড়া LINGUAS এন্ট্রি: %s"

#: src/zfr_lib/lint/i18n_check.py:149
msgid "For each locale: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-translator && msgmerge -U po/<locale>.po <domain>.pot"
msgstr "প্রতিটি লোকেলের জন্য: msginit -i <domain>.pot -o po/<locale>.po -l <locale> --no-translator && msgmerge -U po/<locale>.po <domain>.pot"

#: src/zfr_lib/lint/i18n_check.py:160
#, python-format
msgid "%(level)s locale .po files present (%(count)d)"
msgstr "%(level)s লোকেলের .po ফাইল আছে (%(count)d)"

#: src/zfr_lib/lint/i18n_check.py:192
#, python-format
msgid "missing whole-document man translations for %(level)s: %(files)s"
msgstr "%(level)s-এর জন্য পূর্ণ নথি man অনুবাদ নেই: %(files)s"

#: src/zfr_lib/lint/i18n_check.py:195
#, python-format
msgid "Hand-translate docs/<locale>/<name>.adoc (full document, not po4a). %(level)s requires: %(locales)s."
msgstr "হাতে অনুবাদ করুন docs/<locale>/<name>.adoc (সম্পূর্ণ নথি, po4a নয়)। %(level)s প্রয়োজন: %(locales)s।"

#: src/zfr_lib/lint/i18n_check.py:205
#, python-format
msgid "%s whole-document man translations present"
msgstr "%s-এর পূর্ণ নথি man অনুবাদ আছে"

#: src/zfr_lib/lint/i18n_check.py:214
#, python-format
msgid "man translation still contains the English Name line: %s"
msgstr "man অনুবাদে এখনও ইংরেজি Name লাইন আছে: %s"

#: src/zfr_lib/lint/i18n_check.py:217
msgid "Translate the Name line; do not leave the English wording."
msgstr "Name লাইনটি অনুবাদ করুন; ইংরেজি শব্দ রেখে দেবেন না।"

#: src/zfr_lib/lint/identity.py:57
#, python-format
msgid "%(label)s is %(val)r, expected %(expected)r (directory name)"
msgstr "%(label)s হলো %(val)r, প্রত্যাশিত %(expected)r (ডিরেক্টরির নাম)"

#: src/zfr_lib/lint/identity.py:60
#, python-format
msgid "Set %(label)s to %(expected)r, or rename the directory. Use `zfr rename %(expected)s` if leftover template names remain."
msgstr "%(label)s-কে %(expected)r করুন, অথবা ডিরেক্টরির নাম বদলান। টেমপ্লেট নাম বাকি থাকলে `zfr rename %(expected)s` ব্যবহার করুন।"

#: src/zfr_lib/lint/identity.py:66
#, python-format
msgid "%(label)s=%(val)s"
msgstr "%(label)s=%(val)s"

#: src/zfr_lib/lint/identity.py:69
#, python-format
msgid "meson project name=%s"
msgstr "meson প্রকল্পের নাম=%s"

#: src/zfr_lib/lint/identity.py:75
#, python-format
msgid "debian Source=%(source)r != meson project=%(meson)r"
msgstr "debian Source=%(source)r != meson প্রকল্প=%(meson)r"

#: src/zfr_lib/lint/identity.py:78
msgid "Keep Source, Package, and meson project() name identical."
msgstr "Source, Package এবং meson project() নাম একই রাখুন।"

#: src/zfr_lib/lint/identity.py:82
#, python-format
msgid "Source=%s"
msgstr "Source=%s"

#: src/zfr_lib/lint/identity.py:95
#, python-format
msgid "spec Name=%(spec)r != debian/meson name %(want)r"
msgstr "spec Name=%(spec)r != debian/meson নাম %(want)r"

#: src/zfr_lib/lint/identity.py:99
#, python-format
msgid "Set Name: %s in the spec (same as debian Source)."
msgstr "spec-এ Name: %s সেট করুন (debian Source-এর মতো)।"

#: src/zfr_lib/lint/identity.py:103
#, python-format
msgid "spec Name=%s"
msgstr "spec Name=%s"

#: src/zfr_lib/lint/__init__.py:99
msgid "validate project packaging and zephyr layout (walks parents from cwd)"
msgstr "প্রকল্প প্যাকেজিং ও zephyr বিন্যাস যাচাই করো (বর্তমান ডিরেক্টরি থেকে উপরে খোঁজে)"

#: src/zfr_lib/lint/__init__.py:100
msgid "Check the current zephyr project for missing files and packaging/style mistakes. Walks from cwd toward parent directories. CSR colors when stdout is a TTY."
msgstr "বর্তমান zephyr প্রকল্পে অনুপস্থিত ফাইল ও প্যাকেজিং/রীতির ভুল খোঁজে। বর্তমান ডিরেক্টরি থেকে উপরে খোঁজে। stdout টার্মিনাল হলে CSR রং।"

#: src/zfr_lib/lint/__init__.py:104
msgid "show passing checks too"
msgstr "পাস করা পরীক্ষাও দেখাও"

#: src/zfr_lib/lint/__init__.py:105
msgid "only print errors"
msgstr "শুধু ত্রুটি দেখাও"

#: src/zfr_lib/lint/__init__.py:106
msgid "treat warnings as failures (exit 1)"
msgstr "সতর্কতাকে ব্যর্থতা ধরো (প্রস্থান ১)"

#: src/zfr_lib/lint/__init__.py:113
msgid "required gettext/manpage locale coverage L0–L3 (default: L1; project file may override)"
msgstr "প্রয়োজনীয় gettext/ম্যানুয়াল locale কভারেজ L0–L3 (ডিফল্ট L1; প্রকল্প ফাইল ওভাররাইড করতে পারে)"

#: src/zfr_lib/lint/lang_bits.py:31
#, python-format
msgid "legacy example module %s; use commons or a specific name"
msgstr "পুরনো উদাহরণ মডিউল %s; commons বা নির্দিষ্ট নাম ব্যবহার করুন"

#: src/zfr_lib/lint/lang_bits.py:33
msgid "Rename to src/commons.* (template convention) or a project-specific module name."
msgstr "src/commons.* (টেমপ্লেট রীতি) বা প্রকল্প-নির্দিষ্ট মডিউল নামে পাল্টান।"

#: src/zfr_lib/lint/lang_bits.py:44
#, python-format
msgid "%s is only a template example for shared helpers"
msgstr "%s শুধু ভাগ করা সহায়কের টেমপ্লেট উদাহরণ"

#: src/zfr_lib/lint/lang_bits.py:46
msgid "common_lib / commons mean “extract reusable pieces”, but filenames should be concrete. Rename to a specific module in real projects (e.g. stream_copy.py, bulk.h). clib/cpplib keep lib.c/lib.cpp as their shared library entry."
msgstr "common_lib / commons মানে “পুনর্ব্যবহারযোগ্য অংশ আলাদা করা”, কিন্তু ফাইলনাম হতে হবে সুনির্দিষ্ট। বাস্তব প্রকল্পে নির্দিষ্ট মডিউলে নাম বদলান (যেমন stream_copy.py, bulk.h)। clib/cpplib ভাগ করা লাইব্রেরির প্রবেশ হিসেবে lib.c/lib.cpp রাখে।"

#: src/zfr_lib/lint/layout.py:35
msgid "Add a top-level meson.build with project(...)."
msgstr "শীর্ষে project(...)-সহ meson.build যোগ করুন।"

#: src/zfr_lib/lint/layout.py:36
msgid "Copy LICENSE from the language template (AGPL-3.0-or-later)."
msgstr "ভাষার টেমপ্লেট থেকে LICENSE কপি করুন (AGPL-3.0-or-later)।"

#: src/zfr_lib/lint/layout.py:37
msgid "Add README.md describing this project."
msgstr "এই প্রকল্প বর্ণনা করে README.md যোগ করুন।"

#: src/zfr_lib/lint/layout.py:38
msgid "Add README-zh.md (Chinese summary), matching other zephyr templates."
msgstr "অন্য zephyr টেমপ্লেটের মতো README-zh.md (চীনা সারাংশ) যোগ করুন।"

#: src/zfr_lib/lint/layout.py:39
msgid "Add debian/ packaging (copy debian/ from the language template)."
msgstr "debian/ প্যাকেজিং যোগ করুন (ভাষার টেমপ্লেট থেকে debian/ কপি করুন)।"

#: src/zfr_lib/lint/layout.py:40
msgid "Add debian/changelog (zfr create writes one; or use dch)."
msgstr "debian/changelog যোগ করুন (zfr create লেখে; অথবা dch ব্যবহার করুন)।"

#: src/zfr_lib/lint/layout.py:41
msgid "Add debian/copyright in machine-readable format, License: AGPL-3+."
msgstr "মেশিন-পাঠযোগ্য আকারে debian/copyright যোগ করুন, License: AGPL-3+।"

#: src/zfr_lib/lint/layout.py:42
msgid "Add debian/rules using dh --buildsystem=meson --builddirectory=debian/build."
msgstr "dh --buildsystem=meson --builddirectory=debian/build ব্যবহার করে debian/rules যোগ করুন।"

#: src/zfr_lib/lint/layout.py:43
msgid "Add debian/source/format (typically '3.0 (native)')."
msgstr "debian/source/format যোগ করুন (সাধারণত '3.0 (native)')।"

#: src/zfr_lib/lint/layout.py:47
#, python-format
msgid "present: %s"
msgstr "উপস্থিত: %s"

#: src/zfr_lib/lint/layout.py:50
#, python-format
msgid "missing %s"
msgstr "%s অনুপস্থিত"

#: src/zfr_lib/lint/layout.py:56
#, python-format
msgid "AsciiDoc man sources: %s"
msgstr "AsciiDoc ম্যান উৎস: %s"

#: src/zfr_lib/lint/layout.py:63
msgid "no docs/*.adoc man page source"
msgstr "docs/*.adoc ম্যান পাতার উৎস নেই"

#: src/zfr_lib/lint/layout.py:65
msgid "Add docs/<puff>.adoc and a meson custom_target with asciidoctor -b manpage (see any language template)."
msgstr "docs/<puff>.adoc এবং asciidoctor -b manpage সহ একটি meson custom_target যোগ করুন (যেকোনো ভাষার টেমপ্লেট দেখুন)।"

#: src/zfr_lib/lint/layout.py:78
#, python-format
msgid "bash completion: %s"
msgstr "bash সমাপন: %s"

#: src/zfr_lib/lint/layout.py:86
msgid "no *.bash bash-completion script at project root"
msgstr "প্রকল্পের মূলতে কোনো *.bash bash-completion স্ক্রিপ্ট নেই"

#: src/zfr_lib/lint/layout.py:87
msgid "Add <puff>.bash and install it to datadir/bash-completion/completions renamed to the command name (see meson.build in the template)."
msgstr "<puff>.bash যোগ করুন এবং কমান্ডের নামে নাম পরিবর্তন করে datadir/bash-completion/completions-এ ইনস্টল করুন (টেমপ্লেটের meson.build দেখুন)।"

#: src/zfr_lib/lint/layout.py:93
msgid "VERSION file present"
msgstr "VERSION ফাইল উপস্থিত"

#: src/zfr_lib/lint/layout.py:99
msgid "no VERSION file (changelog snapshot for tarball builds)"
msgstr "VERSION ফাইল নেই (টারবল বিল্ডের জন্য changelog স্ন্যাপশট)"

#: src/zfr_lib/lint/layout.py:101
msgid "Create VERSION with the latest debian/changelog version (one line). Enable .githooks/pre-commit: git config core.hooksPath .githooks"
msgstr "সর্বশেষ debian/changelog সংস্করণ দিয়ে VERSION তৈরি করুন (এক লাইন)। .githooks/pre-commit সক্রিয় করুন: git config core.hooksPath .githooks"

#: src/zfr_lib/lint/layout.py:195
msgid "no .githooks/pre-commit to sync VERSION from debian/changelog"
msgstr "debian/changelog থেকে VERSION সিঙ্ক করার জন্য .githooks/pre-commit নেই"

#: src/zfr_lib/lint/layout.py:197
msgid "Walk up to the directory that contains .git, then put pre-commit in that tree's .githooks (or core.hooksPath). The hook must update VERSION from debian/changelog. `zfr create` copies one and sets git config core.hooksPath .githooks."
msgstr ".git থাকা ডিরেক্টরি পর্যন্ত উপরে যান, তারপর সেই ট্রির .githooks-এ (বা core.hooksPath) pre-commit রাখুন। হুককে debian/changelog থেকে VERSION হালনাগাদ করতে হবে। `zfr create` একটি কপি করে এবং git config core.hooksPath .githooks সেট করে।"

#: src/zfr_lib/lint/layout.py:210
#, python-format
msgid "pre-commit syncs VERSION from debian/changelog (%s)"
msgstr "pre-commit debian/changelog থেকে VERSION সিঙ্ক করে (%s)"

#: src/zfr_lib/lint/layout.py:218
