msgstr "RPM-উপযোগী Version দেখাও (হাইফেন আন্ডারস্কোর)"

#, python-format
#~ msgid "l10n level must be L0–L3 (or 0–3), not %r"
#~ msgstr "l10n স্তর হতে হবে L0–L3 (বা 0–3), %r নয়"

#~ msgid "bash project Depends missing bash-shlib"
#~ msgstr "bash প্রকল্পের Depends-এ bash-shlib নেই"

#, python-format
#~ msgid "Level %(level)s requires: %(locales)s (source %(source)s; zh-cn→zh_CN, zh-tw→zh_TW). Append the missing lines to LINGUAS and add matching po/<locale>.po."
#~ msgstr "স্তর %(level)s প্রয়োজন: %(locales)s (উৎস %(source)s; zh-cn→zh_CN, zh-tw→zh_TW)। অনুপস্থিত লাইন LINGUAS-এ যোগ করুন এবং মিলিয়ে po/<locale>.po রাখুন।"

#, python-format
#~ msgid "po/LINGUAS covers %s locale set"
#~ msgstr "po/LINGUAS %s লোকেল সেট কভার করে"

#~ msgid "Check the current zephyr project for missing files and packaging/style mistakes. Walks from cwd toward parent directories. CSR colors when stdout is a TTY."
#~ msgstr "বর্তমান zephyr প্রকল্পে অনুপস্থিত ফাইল ও প্যাকেজিং/রীতির ভুল খোঁজে। বর্তমান ডিরেক্টরি থেকে উপরে খোঁজে। stdout টার্মিনাল হলে CSR রং।"

#~ msgid "i18n: English source; zfr lint -l/--l10n-level L0–L3 (default L1). L1=10 locales, L2=20, L3=30. Defaults in .config/zfr/lint.options."
#~ msgstr "i18n: ইংরেজি উৎস; zfr lint -l/--l10n-level L0–L3 (ডিফল্ট L1)। L1=10 লোকেল, L2=20, L3=30। ডিফল্ট .config/zfr/lint.options-এ।"

#~ msgid "bash spec Requires missing bash-shlib"
#~ msgstr "bash spec-এ Requires-এ bash-shlib নেই"

#~ msgid "Split this file into smaller modules; keep each unit focused and testable."
#~ msgstr "এই ফাইলটি ছোট মডিউলে ভাগ করুন; প্রতিটি একককে কেন্দ্রীভূত ও পরীক্ষণযোগ্য রাখুন।"

#~ msgid "Plan extraction of helpers or submodules before the file grows further."
#~ msgstr "ফাইল আরও বড় হওয়ার আগে সহায়ক বা সাবমডিউল আলাদা করার পরিকল্পনা করুন।"

#~ msgid "i18n: English source; zfr lint -l/--l10n-level L0–L3 (default L1). L1=Tier I primaries (8), L2=+Tier II (17), L3=+Tier III (35). Child locales auto-derive via zfr locale. Defaults in .config/zfr/lint.options."
#~ msgstr "i18n: ইংরেজি উৎস; zfr lint -l/--l10n-level L0–L3 (ডিফল্ট L1)। L1=10 লোকেল, L2=20, L3=30। ডিফল্ট .config/zfr/lint.options-এ।"

#~ msgid "Level %(level)s requires primaries: %(locales)s (source %(source)s; legacy es→es_MX, pt→pt_BR). Run `zfr locale --derive` to auto-generate child locales."
#~ msgstr "স্তর %(level)s প্রয়োজন: %(locales)s (উৎস %(source)s; zh-cn→zh_CN, zh-tw→zh_TW)। অনুপস্থিত লাইন LINGUAS-এ যোগ করুন এবং মিলিয়ে po/<locale>.po রাখুন।"
