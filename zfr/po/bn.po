#: src/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "বর্তমান প্রকল্পের তথ্য দেখাও (বর্তমান ডিরেক্টরি থেকে উপরে খোঁজে)"

#: src/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "বর্তমান zephyr প্রকল্পের তথ্য দেখায় (বর্তমান ডিরেক্টরি থেকে উপরের ডিরেক্টরিতে খোঁজে)। stdout টার্মিনাল হলে CSR রং। সাধারণ প্যাকেজিং ক্ষেত্র debian বা RPM থেকে পড়া হয়।"

#: src/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "Debian প্যাকেজিং ক্ষেত্র দেখাও"

#: src/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "RPM প্যাকেজিং ক্ষেত্র দেখাও"

#: src/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (কনসোল SGR) রং (ডিফল্ট: auto = টার্মিনাল এবং NO_COLOR নেই)"

#: src/add.py:20
msgid "instantiate puff(s) from the language template"
msgstr "ভাষা-ছাঁচ থেকে puff যোগ করো"

#: src/add.py:21
msgid "Detect language and add puff(s) from pkgdatadir/<lang>."
msgstr "ভাষা চিনে pkgdatadir/<lang> থেকে puff যোগ করো।"

#: src/add.py:25
msgid "new puff name(s) (snake_case recommended)"
msgstr "নতুন puff নাম (snake_case সুপারিশ)"

#: src/build.py:15
msgid "detect build system and compile the project"
msgstr "বিল্ড সিস্টেম সনাক্ত করুন এবং প্রকল্পটি কম্পাইল করুন"

#: src/build.py:17
msgid "Detect the project build system (meson, cmake, autotools, cargo, go, npm, make) and run a local compile."
msgstr "প্রকল্পের বিল্ড সিস্টেম (meson, cmake, autotools, cargo, go, npm, make) সনাক্ত করুন এবং স্থানীয় কম্পাইল চালান।"

#: src/build.py:28
msgid "change to DIR before detecting the build system"
msgstr "বিল্ড সিস্টেম সনাক্ত করার আগে DIR-এ পরিবর্তন করুন"

#: src/build.py:35
msgid "build directory (default: <project>/build)"
msgstr "Meson বিল্ড ডিরেক্টরি (এই উৎসবৃক্ষের সাথে মিললে ডিফল্ট /build, না হলে <project>/build)"

#: src/build.py:42 src/package.py:120
msgid "print planned commands without running them"
msgstr "ফাইল না লিখে পরিকল্পনা দেখাও"

#: src/build.py:48
msgid "verbose build output where supported"
msgstr "যেখানেই সমর্থন করা হয় সেখানে বর্ণনামূলক বিল্ড আউটপুট"

#: src/build.py:53
msgid "print detected build system and exit"
msgstr "সনাক্ত করা বিল্ড সিস্টেম মুদ্রণ করুন এবং প্রস্থান করুন"

#: src/build.py:58
msgid "preview files meson would install (DESTDIR tree; replaces scripts/look.sh)"
msgstr "meson যে ফাইল ইনস্টল করবে তার পূর্বরূপ (DESTDIR ট্রি; scripts/look.sh প্রতিস্থাপন)"

#: src/build.py:67
msgid "with --look, limit tree depth to N levels (implies --look; default is unlimited)"
msgstr "--look সহ গাছের গভীরতা N স্তরে সীমিত করুন (--look বোঝায়; ডিফল্ট সীমাহীন)"

#: src/comments_cmd.py:20
msgid "print or delete project/user lint.comments with an AI work hint"
msgstr "প্রকল্প/ব্যবহারকারীর লিন্ট.কমেন্ট প্রিন্ট বা মুছে দিন একটি AI কাজ সংক্রান্ত নির্দেশনা সহ"

#: src/comments_cmd.py:22
msgid "Print lint suggestion comments from .config/zfr/lint.comments (project) and ~/.config/zfr/lint.comments (user), then an AI hint to apply the suggestions and delete the consumed comments files. Optional ZLxxxx arguments filter which sections to show. Typical prompt: “do zfr-comments work.”"
msgstr ".config/zfr/lint.comments (প্রকল্প) এবং ~/.config/zfr/lint.comments (ব্যবহারকারী) থেকে লিন্ট পরামর্শ মন্তব্য প্রিন্ট করুন, তারপর পরামর্শগুলি প্রয়োগ করার জন্য একটি এআই ইঙ্গিত এবং ব্যবহৃত মন্তব্য ফাইলগুলি মুছে ফেলুন। ঐচ্ছিক ZLxxxx আর্গুমেন্ট কোন সেকশনগুলি দেখাতে হবে তা ফিল্টার করতে পারে। সাধারণ প্রম্পট: “do zfr-comments work.”"

#: src/comments_cmd.py:35
msgid "only these rule ids (default: all)"
msgstr "বুলিয়ান সীমা ০–১০০ (ডিফল্ট: %s)"

#: src/comments_cmd.py:42 src/lintsel.py:284
msgid "project directory (default: walk from cwd)"
msgstr "প্রকল্পের ডিরেক্টরি (ডিফল্ট: cwd থেকে চলমান)"

#: src/comments_cmd.py:49
msgid "user comments only (~/.config/zfr/lint.comments)"
msgstr "শুধুমাত্র ব্যবহারকারীর মন্তব্য (~/.config/zfr/lint.comments)"

#: src/comments_cmd.py:55
msgid "project comments only (.config/zfr/lint.comments)"
msgstr "শুধুমাত্র প্রকল্প মন্তব্য (.config/zfr/lint.comments)"

#: src/comments_cmd.py:61
msgid "delete matching comments (files or selected sections)"
msgstr "মেলানো মন্তব্য (ফাইল বা নির্বাচিত অংশ) মুছে দিন"

#: src/comments_cmd.py:67
msgid "omit the AI hint trailer"
msgstr "এআই ইঙ্গিত ট্রেলারটি বাদ দিন"

#: src/comments_cmd.py:93
msgid "No matching lint.comments to delete."
msgstr "মুছতে কোনো মিলিত lint.comments নেই।"

#: src/comments_cmd.py:96
#, python-format
msgid "Deleted: %s"
msgstr "উপস্থিত: %s"

#: src/create.py:287
msgid "create a new project from a language template"
msgstr "ভাষা-ছাঁচ থেকে নতুন প্রকল্প তৈরি করো"

#: src/create.py:288
msgid "Create a new project directory from pkgdatadir/<lang>."
msgstr "pkgdatadir/<lang> থেকে নতুন প্রকল্প ডিরেক্টরি তৈরি করো।"

#: src/create.py:295
#, python-format
msgid "template language (default: python; one of: %s)"
msgstr "ছাঁচের ভাষা (ডিফল্ট: python; এগুলোর একটি: %s)"

#: src/create.py:299
#, python-format
msgid "debian changelog distribution (default: %s)"
msgstr "debian changelog বিতরণ (ডিফল্ট: %s)"

#: src/create.py:303
#, python-format
msgid "initial package version and git tag (default: %s)"
msgstr "প্রথম প্যাকেজ সংস্করণ ও git ট্যাগ (ডিফল্ট: %s)"

#: src/create.py:307
#, python-format
msgid "changelog/git author name (default: %s)"
msgstr "changelog/git লেখকের নাম (ডিফল্ট: %s)"

#: src/create.py:311
#, python-format
msgid "changelog/git author email (default: %s)"
msgstr "changelog/git লেখকের ইমেইল (ডিফল্ট: %s)"

#: src/create.py:317
msgid "do not instantiate a default puff (leave some_puff1 tokens for a later zfr add)"
msgstr "ডিফল্ট পাফ উদাহরণ তৈরি করবেন না (পরবর্তী zfr সংযোজনের জন্য কিছু some_puff1 টোকেন রেখে দিন)"

#: src/create.py:321
msgid "new project directory name"
msgstr "নতুন প্রকল্প ডিরেক্টরির নাম"

#: src/create.py:325
msgid "puff names (default: one puff named like the package; use --no-puff for none)"
msgstr "পাফের নাম (ডিফল্ট: একটি পাফ যা প্যাকেজের মতো নামকরণ করা হয়েছে; কোনওটির জন্য --no-puff ব্যবহার করুন)"

#: src/detect.py:15
msgid "print detected language for the current directory"
msgstr "বর্তমান ডিরেক্টরির চিহ্নিত ভাষা দেখাও"

#: src/detect.py:16
msgid "Print the detected language of the current project and layout details on stderr."
msgstr "বর্তমান প্রকল্পের চিহ্নিত ভাষা ও বিন্যাসের বিবরণ stderr-এ দেখাও।"

#: src/dist.py:61
msgid "write the archive into DIR (default: meson-dist, or %%_topdir/SOURCES with --rpm; usually $HOME/rpmbuild)"
msgstr "আর্কাইভ DIR-এ লেখো (ডিফল্ট: meson-dist, অথবা --rpm-এ %_topdir/SOURCES ($HOME/rpmbuild))"

#: src/dist.py:71
msgid "Meson build directory (default: /build when it matches this source tree, else <project>/build)"
msgstr "Meson বিল্ড ডিরেক্টরি (এই উৎসবৃক্ষের সাথে মিললে ডিফল্ট /build, না হলে <project>/build)"

#: src/dist.py:81
msgid "archive format (default: xz)"
msgstr "আর্কাইভ বিন্যাস (ডিফল্ট: xz)"

#: src/dist.py:87
msgid "name the archive NAME-VERSION.tar.xz and write it to %%_topdir/SOURCES ($HOME/rpmbuild by default; ~/.rpmmacros) unless -o is given"
msgstr "আর্কাইভের নাম NAME-VERSION.tar.xz; -o না থাকলে %_topdir/SOURCES ($HOME/rpmbuild)-এ লেখো"

#: src/dist.py:96
msgid "pass --allow-dirty to meson dist (default: allow)"
msgstr "meson dist-এ --allow-dirty পাঠাও (ডিফল্ট: অনুমতি)"

#: src/dist.py:101
msgid "run tests during meson dist (default: --no-tests)"
msgstr "meson dist-এর সময় পরীক্ষা চালাও (ডিফল্ট: --no-tests)"

#: src/dist.py:418
msgid "build a source tarball (meson dist, or this project only)"
msgstr "উৎস আর্কাইভ তৈরি করো (meson dist, অথবা শুধু এই প্রকল্প)"

#: src/dist.py:420
msgid "Build a source archive of the current zephyr project (walks from cwd toward parent directories). Uses meson dist when this directory is the git project root; otherwise packs this project only so nested language templates do not ship the parent meta-repo. When ``.tarignore`` exists (gitignore-style), always pack the project tree and apply those excludes. Prints the archive path on stdout."
msgstr "বর্তমান zephyr প্রকল্পের উৎস আর্কাইভ তৈরি করে (বর্তমান ডিরেক্টরি থেকে উপরে খোঁজে)। এই ডিরেক্টরি git প্রকল্পমূল হলে meson dist ব্যবহার করে; না হলে শুধু এই প্রকল্প বাঁধে, যাতে ভিতরের ভাষা-ছাঁচ মাতৃ মেটা-রিপো না পাঠায়। আর্কাইভের পথ stdout-এ দেখায়।"

#: src/i18n/cmd.py:42
msgid "no implemented locales (po/LINGUAS + po/*.po)"
msgstr "কোনো প্রয়োগ করা লোকেইল নেই (po/LINGUAS + po/*.po)"

#: src/i18n/cmd.py:47
msgid "  [derived]"
msgstr "  [ডিরিভেড]"

#: src/i18n/cmd.py:57
#, python-format
msgid "tier %(tier)s"
msgstr "রেভ %(tier)s"

#: src/i18n/cmd.py:60
#, python-format
msgid "derived from: %(parent)s"
msgstr "প্রাপ্ত হয়েছে: %(parent)s"

#: src/i18n/cmd.py:63
#, python-format
msgid "fallback chain: %(chain)s"
msgstr "ফলব্যাক চ্যান্ড: %(chain)s"

#: src/i18n/cmd.py:66
#, python-format
msgid "children (->): %(kids)s"
msgstr "চাইল্ড (->): %(kids)s"

#: src/i18n/cmd.py:70
#, python-format
msgid "catalog: %(path)s"
msgstr "ক্যাটালগ: %(path)s"

#: src/i18n/cmd.py:72
#, python-format
msgid "po stats: %(translated)d/%(total)d translated, %(missing)d missing"
msgstr "postats: %(translated)d/%(total)d অনুবাদ করা হয়েছে, %(missing)d অনুবৃত্তিত হয়নি"

#: src/i18n/cmd.py:75
msgid "no .po catalog in this project"
msgstr "এই প্রকল্পের মধ্যে কোনো .po ক্যাটালগ উপস্থিত নেই"

#: src/i18n/cmd.py:93
#, python-format
msgid "locale not found: %s"
msgstr "লোকেইল পাওয়া যায়নি: %s"

#: src/i18n/cmd.py:147
#, python-format
msgid "would build %d derived locale file(s)"
msgstr "%d প্রাপ্ত স্থানীয় ফাইল(গুলি) নির্মাণ করা হবে"

#: src/i18n/cmd.py:167
msgid "manage implemented gettext locales"
msgstr "প্রয়োগ করা gettext লোকেইল পরিচালনা করুন"

#: src/i18n/cmd.py:169
msgid "List, add, delete, and build derived locales in the current project. Use zfr translate to query or update message strings."
msgstr "বর্তমান প্রকল্পের মধ্যে উপস্থিত লাইক্যাল তালিকা, যোগ, মুছে ফেলুন এবং বিল্ড করুন। বার্তার পংক্তি অনুবাদ প্রশ্ন অথবা আপডেট করার জন্য zfr অনুবাদ করুন।"

#: src/i18n/cmd.py:179
msgid "list all implemented locales in this project"
msgstr "এই প্রকল্পের মধ্যে সমস্ত প্রয়োগ করা লোকেইল তালিকাভুক্ত করা হবে"

#: src/i18n/cmd.py:185
msgid "delete a locale (LINGUAS, .po, man/)"
msgstr "একটি লোকেইল মুছে ফেলুন (LINGUAS, .po, docs/)"

#: src/i18n/cmd.py:191
msgid "add a new locale"
msgstr "নতুন লোকেইল যোগ করুন"

#: src/i18n/cmd.py:197
msgid "build derived locale PO/man files from parents (skip locales in LINGUAS)"
msgstr "বার্তার মাত্রা থেকে প্রাপ্ত স্থানীয় PO/man ফাইল বিল্ড করা হবে ( LINGUAS-এর লোকেইল স্থাপন)"

#: src/i18n/cmd.py:202
msgid "output directory for derived .po files (default: build/po or $MESON_BUILD_ROOT/po)"
msgstr "উদ্ধার করা .po ফাইলের জন্য আউটপুট ডিরেক্টরি (ডিফল্ট: build/po অথবা $MESON_BUILD_ROOT/po)"

#: src/i18n/cmd.py:207
msgid "write a stamp file listing derived paths (for Meson custom_target)"
msgstr "স্ট্যাম্প ফাইলের তালিকা উৎপন্ন পথ লিখুন (Meson custom_target-র জন্য)"

#: src/i18n/cmd.py:212
msgid "with --build, also msgfmt derived .po into LC_MESSAGES (for Meson)"
msgstr "--build-র সাথে, msgfmt এর মধ্যে .po প্রাপ্ত হয়েছে LC_MESSAGES (Meson-র জন্য)"

#: src/i18n/cmd.py:217
msgid "gettext domain for --compile-mo / --install-derived"
msgstr "--compile-mo / --install-derived-র জন্য gettext ডোমেইন"

#: src/i18n/cmd.py:223
msgid "install derived .mo from --po-dir into $MESON_INSTALL_DESTDIR_PREFIX (Meson add_install_script)"
msgstr "--po-dir থেকে $MESON_INSTALL_DESTDIR_PREFIX-এ প্রাপ্ত .mo ইনস্টল করুন (Meson Add_install_script)"

#: src/i18n/cmd.py:231
msgid "with --install-derived, locale subdirectory under prefix (default: share/locale)"
msgstr "--install-derived, prefix-র মধ্যে লোকেইল সাবডিরেক্টরির সাথে (ডিফল্ট: share/locale)"

#: src/i18n/cmd.py:233
msgid "with --build, print only"
msgstr "--build-র সাথে, শুধুমাত্র মুদ্রণ করুন"

#: src/i18n/cmd.py:234
msgid "with --build, overwrite existing"
msgstr "--build-র সাহায্যে, উপস্থিত লেখার উপর লিখুন"

#: src/i18n/cmd.py:235
msgid "locale to inspect"
msgstr "পরীক্ষা করার জন্য লোকেইল"

#: src/i18n/cmd.py:241
msgid "--install-derived requires --po-dir and --domain"
msgstr "--install-derived-র প্রয়োজন --po-dir ও --domain"

#: src/ize/__init__.py:76
msgid "refactor this project to current zephyr style"
msgstr "এই প্রকল্পকে বর্তমান zephyr রীতিতে মেলাতে বদলাও"

#: src/ize/__init__.py:77
msgid "Refactor the current project to match current zephyr style: missing debian/rpm files, meson targets, AsciiDoc man pages, Meson version substitutions, and lint-level gettext coverage (LINGUAS + .po). Does not scaffold man/<locale> man translations. Walks from cwd toward parents."
