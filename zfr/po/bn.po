#: src/zfr_lib/release.py:76
msgid "Build in local, no tag/push/release (implies -U -P)"
msgstr "শুধু স্থানীয়ভাবে তৈরি করো; ট্যাগ, পুশ, GitHub রিলিজ নয়"

#: src/zfr_lib/release.py:82
msgid "Alias for -l -I (local build, skip install)"
msgstr "-l -I-র জন্য উপনাম (স্থানীয় বিল্ড, ইনস্টল উপেক্ষা করুন)"

#: src/zfr_lib/release.py:88
msgid "Replace existing release and tag if present"
msgstr "বিদ্যমান রিলিজ ও ট্যাগ থাকলে প্রতিস্থাপন করো"

#: src/zfr_lib/release.py:94
msgid "Skip sudo dpkg -i (still find debs/changes)"
msgstr "sudo dpkg -i এড়িয়ে যাও (তবু debs/changes খুঁজে পাবে)"

#: src/zfr_lib/release.py:100
msgid "Skip git tag create/push"
msgstr "git ট্যাগ তৈরি/পুশ এড়িয়ে যাও"

#: src/zfr_lib/release.py:106
msgid "Skip dput upload to deb pool (-u reuses build artifacts)"
msgstr "deb পুলে dput আপলোড এড়িয়ে যাও (-u বিদ্যমান নির্মাণফল আবার ব্যবহার করে)"

#: src/zfr_lib/release.py:112
msgid "Skip GitHub release"
msgstr "GitHub রিলিজ এড়িয়ে যাও"

#: src/zfr_lib/release.py:118
msgid "Skip VSIX marketplace publish"
msgstr "VSIX মার্কেট প্রকাশ এড়িয়ে যাও"

#: src/zfr_lib/release.py:124
msgid "Skip RPM build (packaging/rpm/Makefile)"
msgstr "RPM নির্মাণ এড়িয়ে যাও (rpm/Makefile)"

#: src/zfr_lib/release.py:130
msgid "Skip Debian debuild"
msgstr "Debian debuild এড়িয়ে যাও"

#: src/zfr_lib/release.py:137
msgid "Verbose logging"
msgstr "বিস্তারিত লগ"

#: src/zfr_lib/release.py:144
msgid "Less output"
msgstr "কম আউটপুট"

#: src/zfr_lib/release.py:222
msgid "create a GitHub release (parse options, exec gh-makerelease)"
msgstr "GitHub রিলিজ তৈরি করো (অপশন পড়ে gh-makerelease চালাও)"

#: src/zfr_lib/release.py:224
msgid "Parse gh-makerelease options, rebuild argv, and exec gh-makerelease. Does not implement tagging, packaging, or uploads."
msgstr "gh-makerelease অপশন পড়ে argv আবার গুঁজে gh-makerelease চালায়। ট্যাগ, প্যাকেজিং, আপলোড এখানে হয় না।"

#: src/zfr_lib/remove.py:20
msgid "remove puff(s) from the current project"
msgstr "বর্তমান প্রকল্প থেকে puff সরাও"

#: src/zfr_lib/remove.py:21
msgid "Remove puff files for NAME(s) from the current project."
msgstr "বর্তমান প্রকল্প থেকে NAME-এর puff ফাইল সরাও।"

#: src/zfr_lib/remove.py:25
msgid "puff name(s) to remove"
msgstr "সরাতে puff নাম"

#: src/zfr_lib/rename.py:51
msgid "rename zephyr project and example puff names"
msgstr "zephyr প্রকল্প ও নমুনা puff নাম বদলাও"

#: src/zfr_lib/rename.py:52
msgid "Rename zephyr → ProjectName and some_puff1 → example names."
msgstr "zephyr-কে প্রকল্পের নামে এবং some_puff1-কে নমুনা নামে বদলাও।"

#: src/zfr_lib/rename.py:56
msgid "new project name (replaces 'zephyr')"
msgstr "নতুন প্রকল্পের নাম ('zephyr' সরায়)"

#: src/zfr_lib/rename.py:57
msgid "new example names (each replaces template some_puff1)"
msgstr "নতুন নমুনা নাম (প্রতিটি ছাঁচ some_puff1 সরায়)"

#: src/zfr_lib/shape.py:275
msgid "print zephyr package shape score 0-100 (packagedir vs repodir in monorepos)"
msgstr "zephyr প্যাকেজ আকৃতি স্কোর ০–১০০ দেখাও (এক রিপোতে packagedir vs repodir)"

#: src/zfr_lib/shape.py:277
msgid "Score how completely the current directory matches zephyr package style (0-100). In monorepos, scores the packagedir."
msgstr "বর্তমান ডিরেক্টরি zephyr প্যাকেজ রীতির কতটা কাছাকাছি তা ০–১০০ স্কোর। এক রিপোতে packagedir-এর স্কোর।"

#: src/zfr_lib/shape.py:283
msgid "print 1 if score >= threshold, else 0"
msgstr "স্কোর সীমার কম না হলে ১, না হলে ০ দেখাও"

#: src/zfr_lib/shape.py:284
msgid "print packagedir/repodir/role on stderr"
msgstr "packagedir/repodir/role stderr-এ দেখাও"

#: src/zfr_lib/shape.py:285
#, python-format
msgid "bool threshold 0-100 (default: %s)"
msgstr "বুলিয়ান সীমা ০–১০০ (ডিফল্ট: %s)"

#: src/zfr_lib/terminal.py:75
msgid "enable AI-oriented hints (default for AI terminals and non-interactive stdout)"
msgstr "AI-oriented ইঙ্গিত সক্রিয় করুন (AI টার্মিনাল ও -interactive stdout-র জন্য ডিফল্ট মান)"

#: src/zfr_lib/terminal.py:82
msgid "disable AI-oriented hints (default for a plain interactive shell)"
msgstr "AI-oriented ইঙ্গিত নিষ্ক্রিয় করা হবে (প্লেইন ইন্টারেক্টরিভ শেলের জন্য ডিফল্ট)"

