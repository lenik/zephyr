#: src/zfr_lib/lint/docs.py:252
#, python-format
msgid "Severity hint: %s."
msgstr "Nápověda závažnosti: %s."

#: src/zfr_lib/lint/docs.py:255
msgid "Typical fallout"
msgstr "Typické důsledky"

#: src/zfr_lib/lint/docs.py:257
msgid ""
"Unpackaged files, wrong noarch/ELF, leftover rpmbuild/, or Debian substvars "
