#: src/zfr:51
msgid "Zephyr template helper (CLI name: zfr). Create projects and manage example puffs. Instantiated trees keep calling zfr; zfr is not a rename token."
msgstr "Pomocník pro šablony Zephyr (název CLI: zfr). Vytváří projekty a spravuje ukázkové puffs. Instanciované stromy dál volají zfr; zfr není zástupný symbol pro přejmenování."

#: src/zfr:66
msgid "show this help"
msgstr "zobrazit tuto nápovědu"

#: src/zfr_lib/about.py:498
msgid "print current project information (walks parents from cwd)"
msgstr "vytisknout informace o aktuálním projektu (hledá směrem nahoru od cwd)"

#: src/zfr_lib/about.py:500
msgid "Print information about the current zephyr project (walks from cwd toward parent directories). CSR colors when stdout is a TTY. Common packaging fields are parsed from debian or RPM."
msgstr "Vytiskne informace o aktuálním zephyr projektu (hledá směrem nahoru od cwd). CSR barvy, když je stdout TTY. Běžná pole balení se načtou z debian nebo RPM."

#: src/zfr_lib/about.py:507
msgid "show parsed Debian packaging fields"
msgstr "zobrazit analyzovaná pole Debian balení"

#: src/zfr_lib/about.py:508
msgid "show parsed RPM packaging fields"
msgstr "zobrazit analyzovaná pole RPM balení"

#: src/zfr_lib/about.py:513
msgid "CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)"
msgstr "CSR (console SGR) zvýraznění (výchozí: auto = TTY a bez NO_COLOR)"

