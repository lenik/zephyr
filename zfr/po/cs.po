#: src/zfr_lib/lint/report.py:145
msgid "Hint: after edits, re-run `zfr lint` from the project (or a subdirectory). `zfr about -d -r` dumps packaging fields. Version for Meson/RPM is `zfr version`. `zfr ize` applies missing debian/rpm/meson/man/version-subst upgrades."
msgstr "Tip: po úpravách znovu spusťte `zfr lint` z projektu (nebo podadresáře). `zfr about -d -r` vypíše pole balíčkování. Verze pro Meson/RPM je `zfr version`. `zfr ize` doplní chybějící úpravy debian/rpm/meson/man/version-subst."

#: src/zfr_lib/lint/rpm.py:41
msgid "no rpm/*.spec (optional, but zephyr style includes RPM next to debian/)"
msgstr "chybí rpm/*.spec (volitelné, ale styl zephyr má RPM vedle debian/)"

#: src/zfr_lib/lint/rpm.py:44
#, no-python-format
msgid "Copy rpm/ from a language template; name the spec after the package (rpm/<Source>.spec, not zephyr.spec) and keep a Makefile using `zfr version`. Align Name/Summary/Requires/URL with debian/control. Or run `zfr ize`."
msgstr "Zkopírujte rpm/ z jazykové šablony; pojmenujte spec podle balíčku (rpm/<Source>.spec, ne zephyr.spec) a ponechte Makefile používající `zfr version`. Slaďte Name/Summary/Requires/URL s debian/control. Nebo spusťte `zfr ize`."

#: src/zfr_lib/lint/rpm.py:63
#, no-python-format, python-brace-format
msgid "spec Version is dynamic %{version}"
msgstr "Version ve specu je dynamické %{version}"

#: src/zfr_lib/lint/rpm.py:72
msgid "spec Version is hardcoded; zephyr style injects `zfr version`"
msgstr "Version ve specu je natvrdo; styl zephyr vkládá `zfr version`"

#: src/zfr_lib/lint/rpm.py:76
#, no-python-format
msgid "Use Version: %{version} with %{!?version:%global version 0.0.0} and freeze via rpm/Makefile (`zfr version` / `zfr version -r`)."
msgstr "Použijte Version: %{version} s %{!?version:%global version 0.0.0} a zmrazte přes rpm/Makefile (`zfr version` / `zfr version -r`)."

#: src/zfr_lib/lint/rpm.py:82
#, python-format
msgid "License %s"
msgstr "Licence %s"

#: src/zfr_lib/lint/rpm.py:88
msgid "spec License is not AGPL-3.0-or-later"
msgstr "License ve specu není AGPL-3.0-or-later"

#: src/zfr_lib/lint/rpm.py:91
#, python-format
msgid "License:        %s"
msgstr "License:        %s"

#: src/zfr_lib/lint/rpm.py:102
#, python-format
msgid "spec URL=%(url)r != debian Homepage=%(homepage)r"
msgstr "spec URL=%(url)r != debian Homepage=%(homepage)r"

#: src/zfr_lib/lint/rpm.py:105
msgid "Set URL: to the same Homepage as debian/control."
msgstr "Nastavte URL: na stejný Homepage jako v debian/control."

#: src/zfr_lib/lint/rpm.py:117
msgid "spec Summary does not match debian Description first line"
msgstr "Summary ve specu neodpovídá prvnímu řádku debian Description"

#: src/zfr_lib/lint/rpm.py:120
#, python-format
msgid "Summary:        %s"
msgstr "Summary:        %s"

#: src/zfr_lib/lint/rpm.py:125
msgid "spec uses Meson (not autotools)"
msgstr "spec používá Meson (ne autotools)"

#: src/zfr_lib/lint/rpm.py:131
msgid "spec still uses autotools; zephyr packages build with Meson"
msgstr "spec stále používá autotools; balíčky zephyr se staví Mesonem"

#: src/zfr_lib/lint/rpm.py:134
#, no-python-format, python-brace-format
msgid ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"
msgstr ""
"%build: meson setup build --prefix=%{_prefix} ... && meson compile -C build\n"
"%install: meson install -C build --destdir=%{buildroot}"

#: src/zfr_lib/lint/rpm.py:142
msgid "Makefile uses `zfr version`"
msgstr "Makefile používá `zfr version`"

#: src/zfr_lib/lint/rpm.py:149
msgid "rpm/Makefile does not call `zfr version`"
msgstr "rpm/Makefile nevolá `zfr version`"

#: src/zfr_lib/lint/rpm.py:152
#, no-python-format
msgid ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"
msgstr ""
"VERSION := $(shell cd \"$(SRCDIR)\" && zfr version)\n"
"RPM_VERSION := $(shell cd \"$(SRCDIR)\" && zfr version -r)"

#: src/zfr_lib/lint/rpm.py:161
msgid "no rpm/Makefile convenience targets"
msgstr "chybí pohodlné cíle v rpm/Makefile"

#: src/zfr_lib/lint/rpm.py:163
msgid "Copy bash/rpm/Makefile (srpm/rpm via zfr version)."
msgstr "Zkopírujte bash/rpm/Makefile (srpm/rpm přes zfr version)."

#: src/zfr_lib/lint/rpm.py:172
msgid "bash spec Requires missing bash-shlib"
msgstr "bash spec postrádá Requires bash-shlib"

#: src/zfr_lib/lint/rpm.py:174
msgid "Requires:       bash-shlib  (same as debian Depends)"
msgstr "Requires:       bash-shlib  (stejně jako debian Depends)"

#: src/zfr_lib/lint/source_size.py:55
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); file is very long"
msgstr "%(rel)s má %(lines)d řádků (>%(limit)d); soubor je velmi dlouhý"

#: src/zfr_lib/lint/source_size.py:59
msgid "Split this file into smaller modules; keep each unit focused and testable."
msgstr "Rozdělte tento soubor na menší moduly; každou jednotku držte soustředěnou a testovatelnou."

#: src/zfr_lib/lint/source_size.py:67
#, python-format
msgid "%(rel)s is %(lines)d lines (>%(limit)d); consider modularizing soon"
msgstr "%(rel)s má %(lines)d řádků (>%(limit)d); zvažte brzy modularizaci"

#: src/zfr_lib/lint/source_size.py:71
msgid "Plan extraction of helpers or submodules before the file grows further."
msgstr "Naplánujte vyčlenění pomocníků nebo podmodulů, než soubor dále poroste."

#: src/zfr_lib/lint/source_size.py:75
msgid "no oversized source files"
msgstr "žádné příliš velké zdrojové soubory"

#: src/zfr_lib/lint/template.py:51
msgid "zfr CLI package is not a language template"
msgstr "balíček zfr CLI není jazyková šablona"

#: src/zfr_lib/lint/template.py:93
msgid "structural files from the language template are present"
msgstr "strukturální soubory z jazykové šablony jsou přítomny"

#: src/zfr_lib/lint/template.py:100
#, python-format
msgid "language template %(lang)s has extra scaffolding not in this tree: %(preview)s%(more)s"
msgstr "jazyková šablona %(lang)s má navíc kostru, která v tomto stromu chybí: %(preview)s%(more)s"

#: src/zfr_lib/lint/template.py:102
#, python-format
msgid "Compare with the %(lang)s template under pkgdatadir. Copy missing debian/docs/src/rpm files (rpm/ uses %(name)s.spec, not zephyr.spec), or `zfr add` puffs. Do not copy build/ or debian leftover stamp files. Example commons modules are optional."
msgstr "Porovnejte se šablonou %(lang)s v pkgdatadir. Zkopírujte chybějící soubory debian/docs/src/rpm (rpm/ používá %(name)s.spec, ne zephyr.spec), nebo `zfr add` puffy. Nekopírujte build/ ani zbylé razítkové soubory debian. Ukázkové moduly commons jsou volitelné."

