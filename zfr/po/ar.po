msgid "Replace with meson configure_file placeholders (@PREFIX@, @DATADIR@, @BINDIR@, @LIBDIR@, @LOCALEDIR@, @PKGDATADIR@): rename to *.in and run `zfr ize`."
msgstr "استبدل بعنصر نائب لـ meson configure_file (@PREFIX@ و@DATADIR@ و@BINDIR@ و@LIBDIR@ و@LOCALEDIR@ و@PKGDATADIR@): أعد التسمية إلى *.in وشغّل `zfr ize`."

#: src/zfr_lib/lint/hardcoded.py:219
#, python-format
msgid "hardcoded version %(sample)s in %(rel)s"
msgstr "إصدار مضمّن %(sample)s في %(rel)s"

#: src/zfr_lib/lint/hardcoded.py:224
