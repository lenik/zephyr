"""zfr-ize — refactor a project to current zephyr style."""

from __future__ import annotations

import sys
from pathlib import Path

_TOOLS = Path(__file__).resolve().parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

from zfr_lib.cli import standalone_main  # noqa: E402
from zfr_lib.ize import DESCRIPTION, add_arguments, run  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    return standalone_main("zfr-ize", DESCRIPTION, add_arguments, run, argv)


if __name__ == "__main__":
    raise SystemExit(main())
