#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""zfr — multi-language CLI project template helper.

Subcommands are defined in zfr_lib.<cmd> (argparse + implementation).
This dispatcher only registers them and forwards to args._run.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_TOOLS = Path(__file__).resolve().parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

from zfr_lib import cli_version  # noqa: E402
from zfr_lib.i18n import _, init_i18n  # noqa: E402

init_i18n()

from zfr_lib.registry import COMMANDS  # noqa: E402


def resolve_command_prefix(argv: list[str]) -> list[str]:
    """Expand an unambiguous command prefix (e.g. ``t`` -> ``translate``)."""
    if not argv or argv[0].startswith("-"):
        return argv
    head = argv[0]
    names = {mod.NAME for mod in COMMANDS} | {"help"}
    if head in names:
        return argv
    matches = sorted({mod.NAME for mod in COMMANDS if mod.NAME.startswith(head)})
    if "help".startswith(head):
        matches.append("help")
        matches = sorted(set(matches))
    if len(matches) == 1:
        return [matches[0], *argv[1:]]
    return argv


def build_parser() -> argparse.ArgumentParser:
    from zfr_lib.terminal import add_for_ai_purpose_arguments

    init_i18n()
    p = argparse.ArgumentParser(
        prog="zfr",
        description=_(
            "Zephyr template helper (CLI name: zfr). "
            "Create projects and manage example puffs. "
            "Instantiated trees keep calling zfr; zfr is not a rename token."
        ),
    )
    p.add_argument(
        "-V",
        "--version",
        action="version",
        version="%(prog)s " + cli_version(),
    )
    add_for_ai_purpose_arguments(p)
    sub = p.add_subparsers(dest="cmd", required=True)
    for mod in COMMANDS:
        mod.register(sub)
    sub.add_parser("help", help=_("show this help"))
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        build_parser().print_help()
        return 0
    if argv[0] in ("-V", "--version"):
        print("zfr " + cli_version(), flush=True)
        return 0

    parser = build_parser()
    args = parser.parse_args(resolve_command_prefix(argv))

    if args.cmd == "help":
        parser.print_help()
        return 0
    run = getattr(args, "_run", None)
    if run is None:
        parser.error(f"unknown command: {args.cmd}")
        return 2
    try:
        return int(run(args) or 0)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
