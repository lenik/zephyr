#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""zfr — multi-language CLI project template helper.

Subcommands are defined in <cmd> (argparse + implementation).
This dispatcher only registers them and forwards to args._run.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_TOOLS = Path(__file__).resolve().parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

from i18n import _, init_i18n  # noqa: E402
from registry import (  # noqa: E402
    COMMAND_SPECS,
    command_names,
    get_spec,
    load_command,
)

init_i18n()

_GLOBAL_BOOL = frozenset({"--chat", "--no-chat"})


def resolve_command_prefix(argv: list[str]) -> list[str]:
    """Expand an unambiguous command prefix (e.g. ``t`` -> ``translate``).

    Only exact names or unique prefixes run. Ambiguous prefixes (e.g. ``p``
    matching both ``package`` and ``publish``) raise ``SystemExit`` with the
    candidate list.
    """
    if not argv or argv[0].startswith("-"):
        return argv
    head = argv[0]
    names = set(command_names()) | {"help"}
    if head in names:
        return argv
    matches = sorted({n for n in names if n.startswith(head)})
    if len(matches) == 1:
        return [matches[0], *argv[1:]]
    if len(matches) > 1:
        print(
            f"zfr: error: ambiguous command {head!r}: "
            + ", ".join(matches),
            file=sys.stderr,
        )
        raise SystemExit(2)
    return argv


def _split_globals(argv: list[str]) -> tuple[list[str], list[str]]:
    """Peel leading ``--chat`` / ``--no-chat`` from *argv*."""
    globals_opts: list[str] = []
    i = 0
    while i < len(argv) and argv[i] in _GLOBAL_BOOL:
        globals_opts.append(argv[i])
        i += 1
    return globals_opts, argv[i:]


def _print_top_help() -> None:
    """Fast path for ``zfr -h`` / ``zfr help`` — no command module imports."""
    from cli import SubcommandHelpFormatter, VersionBannerAction
    from terminal import add_for_ai_purpose_arguments

    init_i18n()
    p = argparse.ArgumentParser(
        prog="zfr",
        description=_(
            "Zephyr template helper (CLI name: zfr). "
            "Create projects and manage example puffs. "
            "Instantiated trees keep calling zfr; zfr is not a rename token."
        ),
        formatter_class=SubcommandHelpFormatter,
    )
    p.add_argument("-V", "--version", action=VersionBannerAction)
    add_for_ai_purpose_arguments(p)
    sub = p.add_subparsers(
        dest="cmd",
        required=True,
        metavar="COMMAND",
        title="COMMAND",
    )
    for name in sorted({*(s.name for s in COMMAND_SPECS), "help"}):
        if name == "help":
            sub.add_parser("help", help=_("show this help"))
        else:
            spec = get_spec(name)
            assert spec is not None
            sub.add_parser(name, help=_(spec.help))
    p.print_help()


def build_parser(*, commands: list[str] | None = None) -> argparse.ArgumentParser:
    """Build the CLI parser.

    When *commands* is set, only those modules are imported and registered
    (used for a single-command dispatch). ``None`` registers every command.
    """
    from cli import SubcommandHelpFormatter, VersionBannerAction
    from terminal import add_for_ai_purpose_arguments

    init_i18n()
    p = argparse.ArgumentParser(
        prog="zfr",
        description=_(
            "Zephyr template helper (CLI name: zfr). "
            "Create projects and manage example puffs. "
            "Instantiated trees keep calling zfr; zfr is not a rename token."
        ),
        formatter_class=SubcommandHelpFormatter,
    )
    p.add_argument("-V", "--version", action=VersionBannerAction)
    add_for_ai_purpose_arguments(p)
    sub = p.add_subparsers(
        dest="cmd",
        required=True,
        metavar="COMMAND",
        title="COMMAND",
    )
    wanted = set(commands) if commands is not None else set(command_names())
    by_name = {name: load_command(name) for name in wanted}
    for name in sorted({*by_name, "help"}):
        if name == "help":
            sub.add_parser("help", help=_("show this help"))
        else:
            by_name[name].register(sub)
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    if not argv or argv[0] in ("-h", "--help"):
        _print_top_help()
        return 0
    if argv[0] in ("-V", "--version"):
        from versioning import format_cli_version_banner

        print(format_cli_version_banner(), flush=True)
        return 0

    globals_opts, rest = _split_globals(argv)
    if not rest or rest[0] in ("-h", "--help"):
        _print_top_help()
        return 0
    if rest[0] in ("-V", "--version"):
        from versioning import format_cli_version_banner

        print(format_cli_version_banner(), flush=True)
        return 0

    rest = resolve_command_prefix(rest)
    if not rest:
        _print_top_help()
        return 0

    if rest[0] == "help":
        if len(rest) == 1 or rest[1] in ("-h", "--help"):
            _print_top_help()
            return 0
        # ``zfr help lint`` → show that command's help
        rest = [rest[1], "-h"]

    cmd = rest[0]
    if get_spec(cmd) is None:
        print(f"zfr: error: unknown command {cmd!r}", file=sys.stderr)
        return 2

    # Import only the selected command module.
    parser = build_parser(commands=[cmd])
    args = parser.parse_args([*globals_opts, *rest])

    if args.cmd == "help":
        _print_top_help()
        return 0
    run = getattr(args, "_run", None)
    if run is None:
        parser.error(f"unknown command: {args.cmd}")
        return 2
    try:
        return int(run(args) or 0)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
