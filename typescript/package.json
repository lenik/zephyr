{
  "name": "zephyr",
  "version": "1.0.0",
  "description": "Meson-based TypeScript CLI project template with example app some_puff1",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Lenik <zephyr@bodz.net>",
  "homepage": "https://github.com/lenik/zephyr",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "some_puff1": "./dist/src/some_puff1.js"
  },
  "exports": {
    ".": "./dist/src/commons.js",
    "./commons": "./dist/src/commons.js"
  },
  "files": [
    "dist/src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/tests/*.test.js",
    "docs": "scripts/build-docs.sh docs/some_puff1.adoc dist/docs 1.0.0 2026 Lenik zephyr@bodz.net",
    "prepublishOnly": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "gettext-parser": "^9.1.1",
    "node-gettext": "^3.0.1"
  }
}
