#: src/main.rs:62
msgid ""
"Usage: some_puff1 [OPTION]... [FILE]...\n"
"Concatenate FILE(s) to standard output. With no FILE, or when FILE is -,\n"
"read standard input.\n"
msgstr ""
"Utilisation : some_puff1 [OPTION]... [FILE]...\n"
"Concatene les FILE(s) vers la sortie standard. Sans FILE, ou si FILE vaut "
"-,\n"
"lit l'entree standard.\n"

