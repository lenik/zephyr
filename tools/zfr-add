"""zfr-add — instantiate puff(s) from the installed language template."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_TOOLS = Path(__file__).resolve().parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

from zfr_lib.commands import cmd_add  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="zfr-add",
        description="Detect language and add puff(s) from pkgdatadir/<lang>.",
    )
    p.add_argument(
        "puff_names",
        nargs="+",
        help="new puff name(s) (snake_case recommended)",
    )
    args = p.parse_args(argv)
    cmd_add(list(args.puff_names))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
