# SPDX-License-Identifier: AGPL-3.0-or-later
"""zfr-lint — validate a project against zephyr packaging style."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_TOOLS = Path(__file__).resolve().parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

from zfr_lib.lint import cmd_lint  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="zfr-lint",
        description="Check the current zephyr project for missing files and "
        "packaging/style mistakes. Walks from cwd toward parent directories. "
        "CSR colors when stdout is a TTY.",
    )
    p.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="show passing checks too",
    )
    p.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="only print errors",
    )
    p.add_argument(
        "--strict",
        action="store_true",
        help="treat warnings as failures (exit 1)",
    )
    p.add_argument(
        "--color",
        choices=("auto", "always", "never"),
        default="auto",
        help="CSR (console SGR) highlighting (default: auto = TTY and no NO_COLOR)",
    )
    args = p.parse_args(argv)
    return cmd_lint(
        verbose=args.verbose,
        quiet=args.quiet,
        color=args.color,
        strict=args.strict,
    )


if __name__ == "__main__":
    raise SystemExit(main())
