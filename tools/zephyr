#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""zephyr — multi-language CLI project template helper.

Usage:
  zephyr rename PROJECT_NAME [PUFF_NAME ...]
  zephyr add PUFF_NAME
  zephyr remove PUFF_NAME
  zephyr detect
  zephyr help
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

# Allow running from the source tree without installation.
_TOOLS = Path(__file__).resolve().parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

from zephyr_lib import detect_lang, pkgdatadir  # noqa: E402
from zephyr_lib.commands import cmd_add, cmd_remove, cmd_rename  # noqa: E402

__version__ = "1.1.0"


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="zephyr",
        description="Zephyr template helper: rename projects and manage example puffs.",
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    pr = sub.add_parser("rename", help="rename zephyr project and example puff names")
    pr.add_argument("project_name", help="new project name (replaces 'zephyr')")
    pr.add_argument(
        "puff_names",
        nargs="*",
        help="new example names (each replaces template some_puff1)",
    )

    pa = sub.add_parser("add", help="instantiate a new puff from the language template")
    pa.add_argument("puff_name", help="new puff name (snake_case recommended)")

    prm = sub.add_parser("remove", help="remove a puff from the current project")
    prm.add_argument("puff_name", help="puff name to remove")

    sub.add_parser("detect", help="print detected language for the current directory")
    sub.add_parser("help", help="show this help")
    return p


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        build_parser().print_help()
        return 0

    parser = build_parser()
    args = parser.parse_args(argv)

    if args.cmd == "help":
        parser.print_help()
        return 0
    if args.cmd == "detect":
        lang = detect_lang()
        print(lang, flush=True)
        print(f"pkgdatadir: {pkgdatadir()}", file=sys.stderr)
        return 0
    if args.cmd == "rename":
        if not args.project_name:
            parser.error("PROJECT_NAME required")
        cmd_rename(args.project_name, list(args.puff_names))
        return 0
    if args.cmd == "add":
        cmd_add(args.puff_name)
        return 0
    if args.cmd == "remove":
        cmd_remove(args.puff_name)
        return 0
    parser.error(f"unknown command: {args.cmd}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
