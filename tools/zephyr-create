# SPDX-License-Identifier: AGPL-3.0-or-later
"""zephyr-create — create a new project from an installed language template."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_TOOLS = Path(__file__).resolve().parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

from zephyr_lib import LANGS  # noqa: E402
from zephyr_lib.commands import (  # noqa: E402
    DEFAULT_AUTHOR,
    DEFAULT_DISTRIBUTION,
    DEFAULT_EMAIL,
    DEFAULT_INIT_VERSION,
    cmd_create,
)


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="zephyr-create",
        description="Create a new project directory from pkgdatadir/<lang>.",
    )
    p.add_argument(
        "-l",
        "--lang",
        default="python",
        metavar="LANG",
        help=f"template language (default: python; one of: {', '.join(LANGS)})",
    )
    p.add_argument(
        "-D",
        "--distribution",
        default=DEFAULT_DISTRIBUTION,
        metavar="DIST",
        help=f"debian changelog distribution (default: {DEFAULT_DISTRIBUTION})",
    )
    p.add_argument(
        "-1",
        "--init-version",
        default=DEFAULT_INIT_VERSION,
        metavar="VER",
        help=f"initial package version and git tag (default: {DEFAULT_INIT_VERSION})",
    )
    p.add_argument(
        "-a",
        "--author",
        default=DEFAULT_AUTHOR,
        metavar="AUTHOR",
        help=f"changelog/git author name (default: {DEFAULT_AUTHOR})",
    )
    p.add_argument(
        "-e",
        "--email",
        default=DEFAULT_EMAIL,
        metavar="EMAIL",
        help=f"changelog/git author email (default: {DEFAULT_EMAIL})",
    )
    p.add_argument("project_name", help="new project directory name")
    p.add_argument(
        "puff_names",
        nargs="*",
        help="optional puff names to add after creating the project",
    )
    args = p.parse_args(argv)
    cmd_create(
        args.project_name,
        lang=args.lang,
        puff_names=list(args.puff_names),
        distribution=args.distribution,
        init_version=args.init_version,
        author=args.author,
        email=args.email,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
