"""zfr-rename — rename zephyr project and example puff names."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_TOOLS = Path(__file__).resolve().parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

from zfr_lib.commands import cmd_rename  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="zfr-rename",
        description="Rename zephyr → ProjectName and some_puff1 → Example names.",
    )
    p.add_argument("project_name", help="new project name")
    p.add_argument("puff_names", nargs="*", help="example puff names to rename to")
    args = p.parse_args(argv)
    cmd_rename(args.project_name, list(args.puff_names))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
