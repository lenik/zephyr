# stub — align with debian/control and Meson install
pkgname=zephyr
pkgver=0.0.0  # overridden: $(zfr version)
pkgrel=1
pkgdesc="Meson-based CLI template"
arch=('any')
url="https://github.com/lenik/zephyr"
license=('AGPL-3.0-or-later')
depends=('meson' 'ninja' 'bash')
makedepends=('asciidoctor')
source=("$pkgname-$pkgver.tar.xz")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname-$pkgver"
  zfr version 2>/dev/null | sed 's/^v//' || head -n1 VERSION
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  meson setup build --prefix=/usr --buildtype=plain
  meson compile -C build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" meson install -C build
}
