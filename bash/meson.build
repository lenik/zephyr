project(
    'zephyr',
    version: run_command(
        'sh',
        '-c', '''
        v=$(
            command -v zfr >/dev/null 2>&1 && zfr version 2>/dev/null || true
        )
        if [ -z "$v" ] && [ -f VERSION ]; then
            v=$(head -n1 VERSION | tr -d '\r')
            v=${v#v}
        fi
        if [ -z "$v" ]; then
            v="0.0.0" # FIXED TO 0.0.0, DO NOT MODIFY
        fi
        printf '%s' "$v"
        ''',
        check: false,
    ).stdout().strip(),
    license: 'AGPL-3.0-or-later',
)

project_author = 'Lenik'
project_email = 'zephyr@bodz.net'
project_year = 2026

asciidoctor = find_program('asciidoctor', required: true)
fs = import('fs')

prefix = get_option('prefix')
bindir = prefix / get_option('bindir')
datadir = prefix / get_option('datadir')
mandir = prefix / get_option('mandir')
pkgdocdir = datadir / 'doc' / meson.project_name()

datetime = run_command(
    'sh',
    '-c', '''
    ts=$(git log -1 --format=%ai 2>/dev/null || true)
    if [ -z "$ts" ]; then
        ts=$(date '+%Y-%m-%d %H:%M:%S %z')
    fi
    DATE=${ts%% *}
    rest=${ts#* }
    TIME=${rest%% *}
    printf '%s %s' "$DATE" "$TIME"
    ''',
    check: false,
).stdout().strip().split(' ')

script_cfg = configuration_data()
script_cfg.set('PACKAGE', meson.project_name())
script_cfg.set('VERSION', meson.project_version())
script_cfg.set('DATE', datetime[0])
script_cfg.set('TIME', datetime[1])

app_scripts = [
    'src/some_puff1.in',
]

foreach script : app_scripts
    name = fs.stem(script.split('/')[-1])
    configured = configure_file(
        input: script,
        output: name,
        configuration: script_cfg,
    )
    install_data(configured, install_dir: bindir, install_mode: 'rwxr-xr-x')
endforeach

bash_files = [
    'some_puff1.bash',
]

foreach file : bash_files
    name = fs.stem(file)
    install_data(
        file,
        install_dir: datadir / 'bash-completion' / 'completions',
        rename: name,
    )
endforeach

install_data(
    [
        'LICENSE',
        'README.md',
        'README-zh.md',
    ],
    install_dir: pkgdocdir,
)

custom_target(
    'some_puff1-man',
    input: 'docs/some_puff1.adoc',
    output: 'some_puff1.1',
    command: [
        asciidoctor,
        '-b', 'manpage',
        '-a', 'project-version=' + meson.project_version(),
        '-a', 'project-year=@0@'.format(project_year),
        '-a', 'project-author=' + project_author,
        '-a', 'project-email=' + project_email,
        '-o', '@OUTPUT@',
        '@INPUT@',
    ],
    build_by_default: true,
    install: true,
    install_dir: mandir / 'man1',
)

run_target(
    'look',
    command: [
        'bash',
        '-euc', '''
            tmpdir=$(mktemp -d)
            DESTDIR=$tmpdir meson install -C "@BUILD_ROOT@"
            tree "$tmpdir"
            rm -fr "$tmpdir"
        ''',
    ],
)
